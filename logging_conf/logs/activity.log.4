e': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/14p8xQgpnXW3WlmiHNSbWkVlKo0FZtZ7L/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1YeGTdSQEfx_6nHQKdPKwM13Mjs8My7HY', 'children': []}]}, {'id': '8abdb735-761d-44ae-b40b-fc347152fa50', 'drive_file_id': '1b7NlOAA_MuZeVQvjNwNVTMm_wmv6wIZl', 'name': 'Encuentro Biosfera Nevado de Chillán - Diciembre 2025', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1b7NlOAA_MuZeVQvjNwNVTMm_wmv6wIZl', 'modified_time': datetime.datetime(2026, 6, 30, 16, 27, 5, 370000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1dVk8y1zqZ1xk2NNbmBDmrhwNm9A30_dh', 'children': [{'id': '90eb3866-931f-411f-a13a-711e01261520', 'drive_file_id': '1a-rnEhZNa1DegukyGKnHlS-Yzi7-zvVQ', 'name': 'Reporte Ceremonia Clausura Programas RB Nevados de Chillán 181225.docx', 'mime_type': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/1a-rnEhZNa1DegukyGKnHlS-Yzi7-zvVQ/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 31, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1b7NlOAA_MuZeVQvjNwNVTMm_wmv6wIZl', 'children': []}]}]}, {'id': 'd1fe599c-21dc-4431-a4d1-112a4d0ecc76', 'drive_file_id': '1-8G78ccRPImWv-gvD2-UTrl3EvGu3hUe', 'name': 'Santiago', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1-8G78ccRPImWv-gvD2-UTrl3EvGu3hUe', 'modified_time': datetime.datetime(2026, 6, 30, 16, 27, 4, 161000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1XUgp-TEJnr8QezG4hgC0q5BSeOLMnuso', 'children': [{'id': '62b5fd2e-2e73-44a3-b437-0150c1d516f9', 'drive_file_id': '1_Dcgr6Ef94SPpsRX7lNeRzZQEDHsxhVs', 'name': 'Reunión CA Filantropía Ambiental - Abril 2026', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1_Dcgr6Ef94SPpsRX7lNeRzZQEDHsxhVs', 'modified_time': datetime.datetime(2026, 6, 30, 16, 27, 5, 497000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1-8G78ccRPImWv-gvD2-UTrl3EvGu3hUe', 'children': [{'id': '7c6cc708-d2d7-4a30-a4ac-218d0c0ed64b', 'drive_file_id': '1wQ7iOg2r79uumOQsKKTSr5EozB3clKjY', 'name': 'Reporte Consejo Asesor Filantropía Ambiental 28.04.26.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1wQ7iOg2r79uumOQsKKTSr5EozB3clKjY/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': 'Reporte\nConsejo Asesor Filantropía Ambiental I sesión\nAsistencia : Úrsula Partarrieu, Ingrid Espinoza\nLugar : Universidad Adolfo Ibáñez\nFecha : 28 de abril de 2026\nObjetivo : Primera Sesión del Consejo Asesor en Filantropía Ambiental\nEl Consejo Asesor en Filantropía Ambiental en Chile es una iniciativa del Centro de Filantropía e Inversiones\nSociales (CEFIS) de la Universidad Adolfo Ibáñez, en colaboración con The Pew Charitable Trusts. Su creación\nresponde a la necesidad de fortalecer el rol estratégico de la filantropía para abordar los complejos desafíos\nambientales del país, buscando promover una agenda común y basada en evidencia.\nEste espacio convoca a actores clave del ecosistema filantrópico con el objetivo de fomentar una visión\ncompartida, mayor articulación y un enfoque de largo plazo. El valor central del Consejo reside en su capacidad\npara catalizar condiciones que permitan a la filantropía ambiental alcanzar su meta: conservar la biodiversidad\npara el bienestar humano, reconociendo la interdependencia de las dimensiones ambiental y social para el\ndesarrollo sostenible.\nLa sesión I del Consejo Asesor de Filantropía Ambiental tuvo lugar el 28 de abril, de 10:00 a 11:30 horas, en la\nUniversidad Adolfo Ibáñez, organizada por CEFIS y The Pew Charitable Trust. El Consejo convocó a la siguiente\nlista de fundaciones y organizaciones:\nOrganización Representante(s) Invitado(s)\nTantauco Magdalena Piñera\nConserva Puchegüín Ignacio del Río\nWWF Alejandro Bosshard\nPackard Englé Flores\nTompkins Kristine McDivitt, Carolina Morgado\nFundación Cosmos Diego Urrejola\nIbáñez Atkinson Daniela del Valle\nCortés Solari Francisca Cortés\nExplora Pedro Ibáñez\nPeralta Abogados Roberto Peralta\nFundación Cerro Guido Pía Vergara, Agustín Rosseló\nFundación Luksic Isabella Luksic, Nicolás Mora\nFundación Mar Adentro Madeline Hurtado, Diego Urrejola\nFondo Naturaleza Eugenio Rengifo\nFundación Lepe Consuelo Romano\nColunga Esperanza Cueto\nPlantae Hornauer\nThe Pew Charitable Trust Francisco Solís, Carolina Jarpa\nA continuación se listan los asistentes a la sesión I:\n○ Englé Flores (Packard)\n○ Diego Urrejola (Fundación Cosmos y Mar Adentro)\n○ Daniela del Valle (Ibáñez Atkinson)\n○ Romina (Explora)\n○ Roberto Peralta (Peralta Abogados)\n○ Agustín Rosseló (Fundación Cerro Guido)\n○ Mariana Cena (Fundación Luksic)\n○ Eugenio Rengifo (Fondo Naturaleza)\n○ Francisco Solís y Carolina Jarpa (The Pew Charitable Trust)\nEl objetivo general de la sesión inaugural fue formalizar la instalación del Consejo Asesor como un espacio de\narticulación estratégica, enfocado en la identificación y priorización de líneas de trabajo iniciales para fortalecer\nel ecosistema filantrópico, mejorar su marco habilitante y aumentar su impacto en Chile. Los objetivos\nespecíficos planteados fueron:\n● Generar un marco de entendimiento común sobre el propósito y la proyección del Consejo Asesor.\n● Revisar y priorizar las líneas estratégicas de trabajo para el año 2026.\n● Definir una estructura operativa inicial para proyectar el trabajo en comisiones o mesas temáticas.\nPara la deliberación inicial, durante la sesión se propusieron 3 ejes estratégicos:\n● Fortalecimiento del ecosistema y desarrollo de capacidades.\n● Marco normativo y promoción de las donaciones.\n● Medición de impacto y toma de decisiones basada en evidencia\nEn el desarrollo de la reunión se propusieron los siguientes pilares para el desarrollo del ecosistema:\n● Relación de la filantropía con el Estado\n● Buenas prácticas\n● Marco normativo y beneficios tributarios (Ley N°21.440)', 'description': None, 'parent_drive_file_id': '1_Dcgr6Ef94SPpsRX7lNeRzZQEDHsxhVs', 'children': []}]}, {'id': '7f62e0c3-1577-4af7-81b7-892f2a601800', 'drive_file_id': '1o7hEp3YO1tfEch9W3ZUW3MiHLpjD7BBk', 'name': 'Ceremonias de instituciones públicas y privadas', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1o7hEp3YO1tfEch9W3ZUW3MiHLpjD7BBk', 'modified_time': datetime.datetime(2026, 6, 30, 16, 27, 5, 374000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1-8G78ccRPImWv-gvD2-UTrl3EvGu3hUe', 'children': [{'id': '7c4c525f-8634-4773-b0b7-a81cf5759610', 'drive_file_id': '19JHXpQmU9StTQSdQQrXbpxKua0AC5YFR', 'name': 'Reporte Ceremonia Inicio SBAP 02.02.26.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/19JHXpQmU9StTQSdQQrXbpxKua0AC5YFR/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': 'Reporte\nInicio de operaciones del Servicio de Biodiversidad y Áreas Protegidas (SBAP)\nAsistencia : Úrsula Partarrieu R.\nLugar : Palacio Pereira, Huérfanos 1515, Santiago de Chile.\nFecha : 2 de febrero de 2026\nObjetivo : Atender a la invitación a la ceremonia de inicio de operaciones del SBAP en representación de\nla Fundación Rewilding Chile.\n1. Antecedentes generales\nEl 1 de febrero de 2026 se dio inicio oficial a la operación del Servicio de Biodiversidad y Áreas Protegidas\n(SBAP), creado junto al Sistema Nacional de Áreas Protegidas mediante la Ley Nº 21.600 del Ministerio del\nMedio Ambiente (2023). En este contexto, la Fundación Rewilding Chile fue invitada a participar de la\nceremonia originalmente programada en el Santuario de la Naturaleza Quebrada de la Plata (Maipú),\ncorrespondiente a la primera área protegida de propiedad privada cuya categoría fue homologada a una de las\nseis establecidas por la nueva Ley, en este caso, Monumento Natural.\n2. Reprogramación de la actividad\nDebido a las precipitaciones registradas en la Región Metropolitana, la ceremonia fue pospuesta y\nreprogramada para el lunes 2 de febrero de 2026, realizándose en el marco del conversatorio “Competencias\nen Ecosistemas Acuáticos Continentales”, organizado con motivo del Día Mundial de los Humedales.\n3. Desarrollo de la actividad\nLa actividad tuvo lugar en el auditorio del Palacio Pereira, iniciándose pasadas las 15:00 horas con la\nacreditación y bienvenida. Posteriormente se realizaron las palabras de representantes de la Organización\nAmbientalista y Defensa Quebrada de La Plata, seguidas por las intervenciones del Director Nacional del SBAP y\nla Ministra del Medio Ambiente. Acto seguido, se convocó a las autoridades y organizaciones de la sociedad\ncivil presentes a suscribir el Compromiso con el cuidado de la naturaleza de Chile.\nParticiparon en la firma, entre otros: Jorge Plasencia, Consejo de Monumentos Nacionales, Maximiliano\nProaño, Subsecretaría del Medio Ambiente, Verónica Pardo, Subsecretaría de Turismo, Bruno Raglianti,\nSuperintendencia del Medio Ambiente, Arturo Farías, Servicio de Evaluación Ambiental RM, Flavia Liberona,\nFundación Terram, Catherine Kenrick, Parque Andino Juncal, Diego Urrejola, Fundación COSMOS y ONG FIMA.\nPosteriormente, se desarrollaron dos presentaciones técnicas: Lesly Orellana, encargada de humedales del\nSBAP, presentó la exposición “Nuevas competencias del SBAP en biodiversidad y ecosistemas acuáticos\ncontinentales”, abordando el alcance institucional del nuevo Servicio y sus atribuciones en esta materia, y\nSebastián Jofré, Jefe del Departamento de Ecosistemas Acuáticos del Ministerio del Medio Ambiente, quien\nexpuso sobre el rol del Ministerio del Medio Ambiente en los ecosistemas acuáticos continentales, enfatizando\nla articulación requerida para su adecuada gestión y conservación.\nLa actividad contempló un espacio de diálogo y preguntas del público, seguido de un cierre y café. Durante esta\ninstancia, se recogieron impresiones de las y los asistentes respecto de la creación y entrada en operación del\nnuevo Servicio, las cuales quedaron registradas en la cobertura realizada por el equipo de comunicaciones,\ndisponible en el siguiente enlace:\nhttps://www.instagram.com/reel/DUWcpelDbbi/?igsh=MTRuNm5hdXI5YjVqNA==', 'description': None, 'parent_drive_file_id': '1o7hEp3YO1tfEch9W3ZUW3MiHLpjD7BBk', 'children': []}]}, {'id': 'bce0fc90-9cd5-4d4b-a30a-0caf86a9d8ef', 'drive_file_id': '1va9MfKNcWVRv7RvuzbUc8pHRg4h1I1pf', 'name': 'Reuniones Asi Conserva Chile 2026', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1va9MfKNcWVRv7RvuzbUc8pHRg4h1I1pf', 'modified_time': datetime.datetime(2026, 6, 30, 16, 27, 5, 376000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1-8G78ccRPImWv-gvD2-UTrl3EvGu3hUe', 'children': [{'id': 'e52df559-40a5-4ba6-b42a-3bf961c7059e', 'drive_file_id': '1e0VYjngqQmQV-Cn4DgtXXAsqn4jzvDFg', 'name': 'Reporte Encuentro de Iniciativas de Conservación Voluntaria - Así Conserva Chile 27.03.26.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1e0VYjngqQmQV-Cn4DgtXXAsqn4jzvDFg/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': 'Reporte\nEncuentro de Iniciativas de Conservación Voluntaria - Así Conserva Chile\nEl Encuentro organizado por Así Conserva Chile se realizó los días 27 y 28 de marzo de 2026 en la\nReserva Likandes ubicada en la Región Metropolitana. Las jornadas tuvieron por objetivo constituir\nuna instancia de aprendizaje, intercambio de experiencias y fortalecimiento de redes entre los\nasociados, administradores de iniciativas a nivel nacional y otros actores vinculados a la conservación\nen áreas protegidas. Participar, en representación de la Fundación, fue una excelente oportunidad\npara conocer en detalle la red de iniciativas asociadas, los actores vinculados y la experiencia de cada\nárea protegida en la práctica de la conservación.\nEl día viernes 27 se desarrollaron 4 paneles donde se abordaron temáticas de gestión y conservación\ndel patrimonio natural, con énfasis en los desafíos sociales, financiamiento, turismo sostenible y\ntenencia responsable de mascotas. La actividad se enmarca en el proyecto adjudicado para el\nfortalecimiento de asociaciones gremiales (SERCOTEC).\nEl día 28 se desarrolló la Asamblea de Socios en la que se expusieron los resultados de la gestión\nanual de la asociación y los desafíos que enfrenta en el corto y mediano plazo.\n● La Asociación Así Conserva Chile avanzó en la consolidación de su gobernanza durante\n2025–2026, con un directorio activo y enfocado en fortalecer la organización, ampliar la base\nde socios y participar en la implementación de la Ley SBAP.\n● En paralelo, se fortaleció la comunidad de socios mediante nuevas incorporaciones,\nactividades de capacitación y una participación activa en eventos, redes e instancias de\npolítica pública, posicionando a la Asociación como un actor relevante en la conservación\nprivada y voluntaria en Chile.\n● En materia de proyectos y financiamiento, se lograron avances a través de alianzas y fondos\nadjudicados, junto con iniciativas de apoyo concreto a socios. No obstante, persisten desafíos\nen sostenibilidad financiera, fidelización de socios y escalamiento del impacto institucional.\nSe expusieron los resultados de la iniciativa para crear una nueva página WEB y la propuesta de\nestrategia comunicacional para aumentar la incidencia de la organización y el acercamiento de\nnuevos asociados. Adicionalmente, hubo un espacio para conversar sobre las observaciones de la\nagrupación al Reglamento de Áreas Protegidas, actualmente en Consulta Pública.\nAl respecto, se acordó compartir las observaciones con todas las iniciativas asociadas para\nretroalimentación.', 'description': None, 'parent_drive_file_id': '1va9MfKNcWVRv7RvuzbUc8pHRg4h1I1pf', 'children': []}]}, {'id': '3cc64062-73fa-4273-be51-3f1a0a686439', 'drive_file_id': '1JJ_NQuHBtagDWIqnaMDKIKiC7dCiuoTY', 'name': 'Reuniones institucionales - Abril 2026', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1JJ_NQuHBtagDWIqnaMDKIKiC7dCiuoTY', 'modified_time': datetime.datetime(2026, 6, 30, 16, 27, 5, 380000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1-8G78ccRPImWv-gvD2-UTrl3EvGu3hUe', 'children': [{'id': '20d9dfc7-6fd0-44ad-9df5-5cd10e0caef6', 'drive_file_id': '19Psl1ZLnTcHQn9oEkUBwL1-pQ7jM2_wT', 'name': 'solicitud lobby SBAP_10.04.26.jpg', 'mime_type': 'image/jpeg', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/19Psl1ZLnTcHQn9oEkUBwL1-pQ7jM2_wT/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1JJ_NQuHBtagDWIqnaMDKIKiC7dCiuoTY', 'children': []}, {'id': '1c730b36-6e09-456d-99f4-805e2ff273c1', 'drive_file_id': '1KWZLgV7BSS4G_DcuaJmqIjsyda5DquQN', 'name': 'resumenes e emails_04.05.26.docx', 'mime_type': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/1KWZLgV7BSS4G_DcuaJmqIjsyda5DquQN/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1JJ_NQuHBtagDWIqnaMDKIKiC7dCiuoTY', 'children': []}, {'id': '2131f073-af3c-4034-899d-5619d719de3f', 'drive_file_id': '1VXq22ak_UZiCRaHkmBzp8ox5y4jc_buo', 'name': 'solicitud lobby Martin Becker_01.04.26.jpg', 'mime_type': 'image/jpeg', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1VXq22ak_UZiCRaHkmBzp8ox5y4jc_buo/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1JJ_NQuHBtagDWIqnaMDKIKiC7dCiuoTY', 'children': []}, {'id': '36fce169-91dc-4fcc-a053-6f012be29c8f', 'drive_file_id': '12m26MrhyYMD6JhM0pMNxIExiwqZ9ZiK1', 'name': 'solicitud lobby MBN_01.04.26.jpg', 'mime_type': 'image/jpeg', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/12m26MrhyYMD6JhM0pMNxIExiwqZ9ZiK1/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1JJ_NQuHBtagDWIqnaMDKIKiC7dCiuoTY', 'children': []}, {'id': '2f3ec740-890f-465a-b1ee-76757788590f', 'drive_file_id': '1aA_W7b2gaLdlEx9_6yNG3-Q4AnZfbbeX', 'name': 'solicitud lobby MMA_01.04.26.jpg', 'mime_type': 'image/jpeg', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1aA_W7b2gaLdlEx9_6yNG3-Q4AnZfbbeX/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1JJ_NQuHBtagDWIqnaMDKIKiC7dCiuoTY', 'children': []}, {'id': '7b1784ec-70bb-4c1b-9170-402cbfbf9aee', 'drive_file_id': '1mCK6SUR_XYoWblm3-HDQSB8vdXQRp4b_', 'name': 'solicitud lobby CONAF NACIONAL_01.04.26.jpg', 'mime_type': 'image/jpeg', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1mCK6SUR_XYoWblm3-HDQSB8vdXQRp4b_/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 57, 32, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1JJ_NQuHBtagDWIqnaMDKIKiC7dCiuoTY', 'children': []}]}]}]}, {'id': '011c6f17-4dfa-4b32-a628-77b121c5707f', 'drive_file_id': '1LbHRXG-eyEOE3e7KC4XyiB83VhaTrmOS', 'name': '07. Restauración', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1LbHRXG-eyEOE3e7KC4XyiB83VhaTrmOS', 'modified_time': datetime.datetime(2026, 6, 30, 16, 53, 7, 631000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '16j0klxJnQspJ1mvafpnMaRx7Xd1SRIDO', 'children': [{'id': '375b5349-7d3d-4c5b-8879-5fc4aad853ed', 'drive_file_id': '1TrM2A2nq27dzRbhr_E0cE72z8A_ObUZr', 'name': 'Restauración Las Horquetas', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1TrM2A2nq27dzRbhr_E0cE72z8A_ObUZr', 'modified_time': datetime.datetime(2026, 6, 30, 16, 18, 57, 945000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1LbHRXG-eyEOE3e7KC4XyiB83VhaTrmOS', 'children': [{'id': '3eafaff8-1c40-40fb-a8a4-1aa4322f82d3', 'drive_file_id': '1h4X4ZOx7u963DX2A19H7osaFtut6azl_', 'name': 'Informes Mensuales', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1h4X4ZOx7u963DX2A19H7osaFtut6azl_', 'modified_time': datetime.datetime(2026, 6, 30, 16, 18, 59, 189000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1TrM2A2nq27dzRbhr_E0cE72z8A_ObUZr', 'children': [{'id': 'ff3e26ee-b8c4-48db-9b37-3736d84e957e', 'drive_file_id': '1tY_xLOz45QLwUt94ZPisi95ttjjEOls1', 'name': 'Jose Suárez', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1tY_xLOz45QLwUt94ZPisi95ttjjEOls1', 'modified_time': datetime.datetime(2026, 6, 30, 16, 19, 0, 435000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1h4X4ZOx7u963DX2A19H7osaFtut6azl_', 'children': [{'id': 'cb5b997e-5e97-44cd-a2cf-44bbb237c11e', 'drive_file_id': '134V9XzjaCDT0oS9uKSBaqIvP_ikyZ07h', 'name': 'Informe servicios Restauracion Las Horquetas 10.11.2025.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/134V9XzjaCDT0oS9uKSBaqIvP_ikyZ07h/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 15, tzinfo=datetime.timezone.utc), 'text_content': 'Informe de servicios realizados para el Proyecto de restauración de Las Horquetas, sector de\nCerro Castillo.\nJosé A. Suarez B.\n10 de Noviembre del 2025\n1.- Gestion de Compra de Plantas\nSe realizó la visita a los viveros de Conaf en Puerto Aysén de Conaf y de Fundacion Reforestemos\nen Coyaique Alto para ver las plantas en los viveros y recomendar oportunidades de compra de\nplantas para el Proyecto de restauración de Cerro Castillo. Luego de revisados los stock disponibles,\nlas calidades y los precios ofertados, se decidió por la compra de 4.000 plantas de Calafate y 2.000\nplantas de Lenga en los viveros de Puerto Aysén y Reforestemos respectivamente.\nPlantas de Calafate disponible en Vivero de Conaf Puerto Aysén\nPlantas de Lenga disponible en Vivero de Reforestemos\n2.- Propuesta de ubicación y diseño de depósito de plantas en Sector de Las Horquetas\nEl objetivo es disponer de un lugar para mantener plantas por un periodo variable para el proyecto\nde restauración de Las Horquetas. Esta instalación es una infraestructura sencilla con cierre\nperimetral para resguardar la planta e impedir al daño por liebre. Este lugar debe contar con riego\ny sombreadero desplegable (malla rashel negra para sombra).\nPropuesta\nSe propone una superficie útil de 300 m2 con capacidad de disponer de un máximo de 20.000 plantas\naproximadamente bajo sombra de malla, esto puede aumentar si se considera la superficie bajo\ncopas de los árboles que rodean la estructura y están dentro del perímetro protegido por la malla\nde alambre.\nUbicación\nLa ubicación propuesta permite tener acceso a la fuente de agua (rio) y disponer de un buen acceso,\nademás de no quedar a la vista desde la carretera. Corresponde al Lote A Las Horquetas de\npropiedad de Fundación Rewilding Chile.\nDiseño\nSe trata de una estructura tipo soportante tensada que contaría con cierre perimetral, sombreadero\nde malla rashel 60% de sombra desplegable, una caseta para herramientas y la motobomba de\nriego. El perímetro será cercado con polines de pino y malla gallinera, el sombreadero será\nsoportado por postes de pino impregnado fijados al suelo y tensados con cables de acero. La caseta\ndonde se instalará la motobomba para riego tendrá un radier de 1x2 m x 15 cm y se construirá en\nmadera de pino impregnada.\nPlanta\nPresupuesto\nSe cotizó los materiales en detalle según el diseño propuesto, esto entrega un número que está\ndentro de los 6.650.000 que están programados. El detalle es el que se muestra en la tabla\nsiguiente.\n3.- Asesoría para el control de exóticas para programa de voluntarios\nSe realizó la gestión de fabricación de las herramientas para desarraigar plantas exóticas de pino y\ntras especies.\nPrimera herramienta fabricada y ya probada\nHerramienta en etapa de desarrollo y prueba\nSe realizó una reunión en terreno con la encargada del programa de Voluntariado y el el\nadministrador del Parque Nacional Cerro Castillo para probar el funcionamiento y modo de trabajo\ncon las herramientas.\nSe definieron la actividad a desarrollar y areas de trabajo. Se trata la actividad de eliminar en forma\nmanual las plántulas y/o plantas de pino repoblando en forma natural áreas abiertas entorno a las\nplantaciones de pino y áreas bajas.\nEsta actividad podría realizarse durante todo el año con la única restricción de no tener nieve. Hay\n24,2 ha donde realizar esta actividad tanto en propiedad de FRC como en la faja vial de la ruta 7 en\ntramo dentro del Parque Nacional y fuera del área del Parque. Las respectivas superficies se pueden\nobservar en la siguiente tabla.\nSituación Superficie (ha)\nEn Propiedad de FRC 7,7\nEn ruta 7 faja vial en Parque Nacional Cerro Castillo 12,0\nEn ruta 7 faja vial fuera del Parque Nacional 4,5\nTotal 24,2\nÁreas a cubrir en el sector de Cerro Castillo\nAlgunas de las mejoras fueron la incorporación de grasa para que trabaje con menos roce entre los\nfierros, la incorporación de una cuerda para manipular y posicionar mejor la herramienta y su\n“mandíbula” en la base de la planta.\nAlgunas consideraciones importantes:\nEl trabajo se focalizará en torno a la faja vial (ruta 7) en el sector de Laguna Chiguay, lo que permitirá\nenmarcar esta actividad en el convenio con el Parque Nacional Cerro Castillo. Por esta razón se debe\nconsiderar también el retiro de las plantas extraídas, para lo cual hay que agregar sacos tipo\n“paperos” para retirar las plantas extraídas, estas pueden ser entregadas a la Administración del\nParque y luego ellos entregan a la Municipalidad de Coyhaique. Además se puede agregar la colecta\nde basura en la faja vial.\nSe debe considerar también la adquisición de Conos de seguridad con reflectante para marcar al\nborde de la carretera (berma) el tramo en que se está trabajando. Incorporar el uso de chaquetas\nreflectantes. Además del enfoque del trabajo en un lado de la carretera por cada tramo y luego al\nsector contrario, para minimizar el cruce de los voluntarios en la carretera.\nEl uso de las herramientas será explicado y demostrado en terreno el 23 de octubre en terreno y\nluego se podría repetir con el monitor en fecha a coordinar.', 'description': None, 'parent_drive_file_id': '1tY_xLOz45QLwUt94ZPisi95ttjjEOls1', 'children': []}, {'id': '1150522e-0984-4a46-bc90-e181ac5595f2', 'drive_file_id': '1ZIZ5cDqNycSfJrVQO1jrKZo1eyyLRwK3', 'name': 'Informe servicios JSuarez Restauracion Las Horquetas Mayo 2026.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1ZIZ5cDqNycSfJrVQO1jrKZo1eyyLRwK3/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 15, tzinfo=datetime.timezone.utc), 'text_content': 'Informe de servicios realizados para el Proyecto de restauración de Las Horquetas, sector de\nCerro Castillo.\nEl presente informe detalla las actividades realizadas en mayo del 2026 en el contexto del Proyecto\nde Restauración de las Horquetas. Estas tuvieron relación con los siguientes temas principales:\n1.- Preparación de la carpeta para del ingreso del nuevo Plan de Manejo de Plantaciones Forestales\npara convertir las plantaciones de pino en Bosque Nativo.\n2.- Revisión de oferta de plantas en el mercado local\n3.- Actualización de cotización del aserradero portátil y otros materiales y gestión de compra.\n4.- Actualización del plan de actividades del programa en el sector de Las Horquetas,\nespecíficamente en el Lote A\n5.- Revisión del estado general del depósito de plantas y algunas mejoras planificadas con Daniela\nOlguin la responsable del depósito en terreno. Además se probó el uso de una mini bomba eléctrica\npara mejorar la presión de riego.\n26 de mayo del 2026', 'description': None, 'parent_drive_file_id': '1tY_xLOz45QLwUt94ZPisi95ttjjEOls1', 'children': []}, {'id': '742300d2-1490-469b-a9ac-bbe65c31702e', 'drive_file_id': '1NOq_kJT0TzXuR7y_iUJABPwjqkP5SFiw', 'name': 'Informe_N°30_Febrero 2026  Restauracion de Bosques en Cabo Froward.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1NOq_kJT0TzXuR7y_iUJABPwjqkP5SFiw/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 15, tzinfo=datetime.timezone.utc), 'text_content': 'Informe N°30\nPrograma de restauración de bosques de Cabo Froward\nEl siguiente reporte detalla las actividades realizadas durante el mes de Febrero del 2026 en el marco del\nprograma de restauración de bosques de Cabo Froward en la Región de Magallanes.\n1.- Se trabaja en el ajuste del Plan de actividades 2026 enero – abril y propuesta presupuestaria para cierre\nde actividades del programa. Se revisan actividades a realizar.\n2.- Se revisa el plan de plantación de los sectores definidos para el 2026 en Bahia Fortescue y Cabo Froward.\n3.- Se actualiza cotizaciones de flete de plantas desde El Amarillo a Punta Arenas.\n4.- Se monitorea y realizan algunas mediciones de riego de plantas en vivero.\n2 de Marzo del 2026\nPá gi n a 1 | 1', 'description': None, 'parent_drive_file_id': '1tY_xLOz45QLwUt94ZPisi95ttjjEOls1', 'children': []}, {'id': '1d4eaff9-d153-488d-8209-2c8bf16cec2f', 'drive_file_id': '1KqRGwCg7XZrI0iTTmHS02Wlb4fIhdiXs', 'name': 'Informe_N°28_Diciembre 2025  Restauracion de Bosques en Cabo Froward.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1KqRGwCg7XZrI0iTTmHS02Wlb4fIhdiXs/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 15, tzinfo=datetime.timezone.utc), 'text_content': 'Informe N°28\nPrograma de restauración de bosques de Cabo Froward\nEl siguiente reporte detalla las actividades realizadas durante el mes de Noviembre del 2025 en el marco del\nprograma de restauración de bosques de Cabo Froward en la Región de Magallanes.\n1.- Se trabaja en la revisión de datos colectados en terreno y se coordina el procesamiento de la información\ndendrométrica y cartográfica con Martin Cornejo. En el contexto de la elaboración del plan de manejo para\nensayar la propuesta de manejo silvícola con fines de restauración en bosques secundarios.\n2.- Se colabora en la revisión de los textos del Storymap del programa de Restauración en Cabo Froward.\n3.- Se coordina y ejecuta la compra de 262 plantas de Ciprés de las Guaitecas del vivero de Mañihuales para\nser utilizados en la restauración de bosques en Cabo Froward. Estas fueron trasladadas a El Amarillo para ser\ntrasladas durante el 2026 a Magallanes junto a las plantas producidas en El Amarillo.\n4.- Se planifican las actividades pendientes para el mes de enero 2026 la identificación de las poblaciones de\nCiprés de las Guaitecas en Puerto Natales para realizar colecta de estaquillas y /o semillas de la misma forma\nPágin a 1 | 2\nque la visita a las instalaciones de UMAG en Punta Arenas para comenzar a concretar el trabajo colaborativo\ncon UMAG específicamente para la propagación de Ciprés de Las Guaitecas.\n19 de Diciembre del 2025\nPágin a 2 | 2', 'description': None, 'parent_drive_file_id': '1tY_xLOz45QLwUt94ZPisi95ttjjEOls1', 'children': []}, {'id': '51c448c4-f1d8-476a-bc8f-6cd6080399f3', 'drive_file_id': '1GPYiHv8O3kMKMZhgAPDphcqZAINA2Hcf', 'name': 'Informe servicios Restauracion Las Horquetas dic 2025.docx.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1GPYiHv8O3kMKMZhgAPDphcqZAINA2Hcf/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 15, tzinfo=datetime.timezone.utc), 'text_content': 'Informe de servicios realizados para el Proyecto de restauración de Las Horquetas, sector de\nCerro Castillo.\nJosé A. Suarez B.\n19 de Diciembre del 2025\n1.- Supervision de construccion de depósito de plantas\nSe realizó la supervisión de la construcción e instalación del depósito de plantas en tres etapas\nsucesivas: cierre del perímetro, construcción de caseta e instalación del sombreadero. El trabajo\ntambién implicó revisar y reforzar los tensores de los vientos y apriete de los amarracables para\nsoportar las fuertes rachas de viento que imperan en el sector.\nLos trabajos se realizaron en forma satisfactoria.\nAtte\nJosé A. Suárez', 'description': None, 'parent_drive_file_id': '1tY_xLOz45QLwUt94ZPisi95ttjjEOls1', 'children': []}]}, {'id': '129a9c5d-2064-4568-9dac-d97390e4cf0f', 'drive_file_id': '1ykczhtNm3sibdQKl5425k1MO-JSTdFUf', 'name': 'Daniela Olguin', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1ykczhtNm3sibdQKl5425k1MO-JSTdFUf', 'modified_time': datetime.datetime(2026, 6, 30, 16, 19, 0, 436000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1h4X4ZOx7u963DX2A19H7osaFtut6azl_', 'children': [{'id': 'd69babdd-4130-4675-9146-cb46b79397ae', 'drive_file_id': '1tuLPoAPyZ-YRtcZMHVEA8JbU-0baBv9v', 'name': 'Informe N° 5 Daniela Olguin.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1tuLPoAPyZ-YRtcZMHVEA8JbU-0baBv9v/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 15, tzinfo=datetime.timezone.utc), 'text_content': 'Informe N° 5\nDepósito de Plantas. Proyecto de restauración de Bosques de las\nHorquetas. Sector Cerro Castillo.\nDaniela Olguín Helfmann\nMayo 2026.\nUbicación: Sector Las Horquetas, Propiedades FRC aledañas al Parque Nacional Cerro\nCastillo (Coyhaique, Región de Aysén).\nProfesional: Daniela Olguín Helfmann, Técnica Universitaria en Producción Agropecuaria y\nMonitora Ambiental, Balmaceda.\n1. Introducción y Objetivo\nEl presente documento detalla las actividades realizadas durante la etapa inicial del\ndepósito de plantas ubicado en el sector de Las Horquetas, próximo al acceso a los\nsenderos del Parque Nacional Cerro Castillo.\nEl objetivo principal de este proyecto es la mantención de aproximadamente 2.000\nejemplares de especies nativas, específicamente lenga y calafate (Nothofagus pumilio y\nBerberis microphylla), destinados a la restauración ecológica del parque. Esta iniciativa se\nenmarca en el proceso de transición y sustitución de especies exóticas, particularmente\nPinus spp.\n2. Actividades Realizadas\nDurante los meses de ejecución, las labores se han centrado en las siguientes acciones:\nMonitoreo y mantención\nSe ha continuado con la mantención del depósito, junto con la supervisión periódica del\nestado fitosanitario de las especies nativas establecidas. Esto incluye la evaluación de su\nnivel de vigor, adaptación al sitio y la detección de posibles signos de estrés o presencia de\nagentes patógenos. Respecto al suelo, se mantiene un monitoreo constante para detectar\nposibles limitantes, como compactación o baja retención de humedad.\nEn términos generales, las especies presentan una adecuada adaptación a las condiciones\ndel sitio. Destaca particularmente el calafate, que ha evidenciado una alta resistencia y\nbuena respuesta frente a las condiciones ambientales presentes, manteniendo un desarrollo\nvigoroso y sin señales relevantes de estrés o deterioro fitosanitario. Asimismo, la lenga ha\nmostrado una adecuada resiliencia, evidenciando capacidad de recuperación y adaptación\nfrente a las variaciones ambientales del sector, manteniendo condiciones fitosanitarias\nfavorables.\nEvaluación de sitio:\nSe ha llevado a cabo un seguimiento continuo de las condiciones ambientales del sector,\nconsiderando variables relevantes, tales como: suelo, drenaje, exposición a la luz, vientos y\ncambios bruscos en temperatura, que permitan determinar la viabilidad de futuras\nampliaciones y la eventual incorporación de nuevos ejemplares. Se ha considerado la\npresencia de flora y fauna local, lo cual es clave para asegurar la adaptación de los\nejemplares en su futura etapa de restauración ecológica dentro del parque.\nGestión hídrica:\nEl riego manual y su frecuencia han sido ajustados en función de las necesidades de las\nespecies y las condiciones climáticas del entorno. El área presenta condiciones propias de\nun clima templado-frío, con variaciones térmicas marcadas y precipitaciones estacionales,\nlas cuales influyen directamente en los requerimientos hídricos de las especies. Estas\ncondiciones han sido consideradas en la planificación de las labores de riego y manejo.\nDurante el mes de mayo se han registrado condiciones particularmente frías y secas, por lo\nque se ha mantenido el riego de apoyo con el fin de resguardar el adecuado establecimiento\ny estado fisiológico de las especies. Estas condiciones han sido consideradas en la\nplanificación de las labores de manejo, permitiendo adecuar la frecuencia y volumen de\naplicación según los requerimientos observados en terreno.\n3. Registro Visual y Datos de Campo\n● Detalle y plano de las plántulas\nde Nothofagus pumilio para\nmostrar vigor y\ncoloración.\n● Detalle y plano de las plántulas de Berberis microphylla para mostrar vigor y coloración.\n● Estado del Vivero en el Sector Las Horquetas. (Fotografía panorámica del depósito\nde plantas).', 'description': None, 'parent_drive_file_id': '1ykczhtNm3sibdQKl5425k1MO-JSTdFUf', 'children': []}, {'id': '43e65ddc-f49f-425c-a6a6-11dcd20d7164', 'drive_file_id': '1O0_X9etFItKfRfZK5e_lnCUnCgPEhd4I', 'name': 'Informe N° 4 Daniela Olguin.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1O0_X9etFItKfRfZK5e_lnCUnCgPEhd4I/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 15, tzinfo=datetime.timezone.utc), 'text_content': 'Informe N° 4\nDepósito de Plantas. Proyecto de restauración de Bosques de las\nHorquetas. Sector Cerro Castillo.\nDaniela Olguín Helfmann\nAbril 2026.\nUbicación: Sector Las Horquetas, Propiedades FRC aledañas al Parque Nacional Cerro\nCastillo (Coyhaique, Región de Aysén).\nProfesional: Daniela Olguín Helfmann, Técnica Universitaria en Producción Agropecuaria y\nMonitora Ambiental, Balmaceda.\n1. Introducción y Objetivo\nEl presente documento detalla las actividades realizadas durante la etapa inicial del\ndepósito de plantas ubicado en el sector de Las Horquetas, próximo al acceso a los\nsenderos del Parque Nacional Cerro Castillo.\nEl objetivo principal de este proyecto es la mantención de aproximadamente 2.000\nejemplares de especies nativas, específicamente lenga y calafate (Nothofagus pumilio y\nBerberis microphylla), destinados a la restauración ecológica del parque. Esta iniciativa se\nenmarca en el proceso de transición y sustitución de especies exóticas, particularmente\nPinus spp.\n2. Actividades Realizadas\nDurante los meses de ejecución, las labores se han centrado en las siguientes acciones:\nMonitoreo y mantención\nSe ha continuado con la mantención del depósito, junto con la supervisión periódica del\nestado fitosanitario de las especies nativas establecidas. Esto incluye la evaluación de su\nnivel de vigor, adaptación al sitio y la detección de posibles signos de estrés o presencia de\nagentes patógenos. Respecto al suelo, se mantiene un monitoreo constante para detectar\nposibles limitantes, como compactación o baja retención de humedad.\nEvaluación de sitio:\nSe ha llevado a cabo un seguimiento continuo de las condiciones ambientales del sector,\nconsiderando variables relevantes, tales como: suelo, drenaje, exposición a la luz, vientos y\ncambios bruscos en temperatura, que permitan determinar la viabilidad de futuras\nampliaciones y la eventual incorporación de nuevos ejemplares. Se ha considerado la\npresencia de flora y fauna local, lo cual es clave para asegurar la adaptación de los\nejemplares en su futura etapa de restauración ecológica dentro del parque.\nGestión hídrica:\nEl riego manual y su frecuencia han sido ajustados en función de las necesidades de las\nespecies y las condiciones climáticas del entorno. El área presenta condiciones propias de\nun clima templado-frío, con variaciones térmicas marcadas y precipitaciones estacionales,\nlas cuales influyen directamente en los requerimientos hídricos de las especies. Estas\ncondiciones han sido consideradas en la planificación de las labores de riego y manejo.\n3. Registro Visual y Datos de Campo\n● Detalle y plano de las plántulas\nde Nothofagus pumilio para\nmostrar vigor y\ncoloración.\n● Detalle y plano de las plántulas de\nBerberis microphylla para mostrar vigor y\ncoloración.\n● Estado del Vivero en el Sector Las Horquetas. (Fotografía panorámica del depósito\nde plantas).', 'description': None, 'parent_drive_file_id': '1ykczhtNm3sibdQKl5425k1MO-JSTdFUf', 'children': []}, {'id': 'a1db6642-524a-4efb-8ca4-6fa09f8c8982', 'drive_file_id': '1xpv6l3s-Y-SoACSAV9qZG4HRU3ROfHWv', 'name': 'Informe N1  Daniela Olguin Enero 2026.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1xpv6l3s-Y-SoACSAV9qZG4HRU3ROfHWv/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 14, tzinfo=datetime.timezone.utc), 'text_content': 'Informe N° 1\nDepósito de Plantas. Proyecto de restauración de Bosques de las\nHorquetas. Sector Cerro Castillo.\nDaniela Olguín Helfmann\nEnero 2026.\nUbicación: Sector Las Horquetas, Propiedades FRC aledañas a Parque Nacional Cerro\nCastillo (Coyhaique, Región de Aysén).\nProfesional: Daniela Olguín Helfmann, Técnica Universitaria en Producción Agropecuaria y\nMonitora Ambiental, Balmaceda.\n1. Introducción y Objetivo\nEl presente documento detalla las actividades realizadas durante la etapa inicial del deposito\nde plantas ubicado en el sector de Las Horquetasproximo al acceso a los senderos del Parque\nNacional Cerro Castillo. El objetivo principal es la mantención de cerca de 2,000 ejemplares\nde especies nativas, Lenga y Calafate (Nothofagus pumilio y Berberis microphylla)\ndestinados a la restauración ecológica del parque, en el marco del proceso de transición y\nsustitución de especies exóticas (específicamente Pinus spp.).\n2. Actividades Realizadas\nDurante el mes de enero, las labores se centraron en:\n● Monitoreo y Mantención: Supervisión constante del estado fitosanitario de las\nespecies nativas, monitoreo de condiciones de vigor y adaptacion de las plantas al\nsitio.\n● Evaluación de Sitio: Análisis de las condiciones ambientales del sector para\ndeterminar la viabilidad de futuros enriquecimientos y plantaciones.\n● Detalle de Especies. (Primer plano de las plántulas de Nothofagus pumilio y Berberis\nmicrophylla para mostrar vigor y coloración).\n● Estado del Vivero en el Sector Las Horquetas. (Fotografía panorámica a la entrada\ndel vivero).', 'description': None, 'parent_drive_file_id': '1ykczhtNm3sibdQKl5425k1MO-JSTdFUf', 'children': []}, {'id': 'cb6d9d9f-94a6-4588-aec1-5d738bcad7e0', 'drive_file_id': '1yG0gMavGwoJ__77iFy0DpJ1E7q7V5-VH', 'name': 'Informe N° 2 (Febrero) Daniela Olguin.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1yG0gMavGwoJ__77iFy0DpJ1E7q7V5-VH/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 14, tzinfo=datetime.timezone.utc), 'text_content': 'Informe N° 2\nDepósito de Plantas. Proyecto de restauración de Bosques de las\nHorquetas. Sector Cerro Castillo.\nDaniela Olguín Helfmann\nFebrero 2026.\nUbicación: Sector Las Horquetas, Propiedades FRC aledañas al Parque Nacional Cerro\nCastillo (Coyhaique, Región de Aysén).\nProfesional: Daniela Olguín Helfmann, Técnica Universitaria en Producción Agropecuaria y\nMonitora Ambiental, Balmaceda.\n1. Introducción y Objetivo\nEl presente documento detalla las actividades realizadas durante la etapa inicial del\ndepósito de plantas ubicado en el sector de Las Horquetas, próximo al acceso a los\nsenderos del Parque Nacional Cerro Castillo. El objetivo principal es la mantención de cerca\nde 2,000 ejemplares de especies nativas, Lenga y Calafate (Nothofagus pumilio y\nBerberis microphylla) destinados a la restauración ecológica del parque, en el marco del\nproceso de transición y sustitución de especies exóticas (específicamente Pinus spp.).\n2. Actividades Realizadas\nDurante los meses de ejecución, las labores se han centrado en:\n● Monitoreo y Mantención: Se ha efectuado y continuado con una supervisión\nperiódica del estado fitosanitario de las especies nativas establecidas, evaluando su\nnivel de vigor, adaptación al sitio y posibles signos de estrés o presencia de agentes\npatógenos.\n● Evaluación de Sitio: Se ha realizado un seguimiento continuo de las condiciones\nambientales del sector, considerando variables relevantes para determinar la\nviabilidad de futuras ampliaciones y la eventual incorporación de nuevos ejemplares.\n● Gestión Hídrica: El riego manual y su frecuencia se han ajustado según las\nnecesidades de las especies y las condiciones climáticas.\n3. Registro Visual y Datos de Campo\n● Detalle y plano de las plántulas\nde Nothofagus pumilio para\nmostrar vigor y coloración.\n● Detalle y plano de las plántulas\nde Berberis microphylla para\nmostrar vigor\ny coloración.\n● Estanque flexible de acumulación de agua de 20.000 litros.\n● Estado del Vivero en el Sector Las Horquetas. (Fotografía panorámica a la\nentrada del vivero).', 'description': None, 'parent_drive_file_id': '1ykczhtNm3sibdQKl5425k1MO-JSTdFUf', 'children': []}]}]}, {'id': '3bf48244-8cac-40e1-89a6-4c4c87f25732', 'drive_file_id': '1KrKHw16dqMa6BJx2d2ZzYkKdLyl13EEl', 'name': 'PPT Diseño de propuesta Cerro Castillo_Las Horquetas v30.03.25_16.04.25.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1KrKHw16dqMa6BJx2d2ZzYkKdLyl13EEl/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 14, tzinfo=datetime.timezone.utc), 'text_content': 'Plan de Restauración de bosques para Las Horquetas.\nSector Cerro Castillo\nJosé A. Suárez\nMarzo 2025\n1.- Conversión de plantaciones de pino\n2.- Restauración de Áreas degradadas\nSituación C\nSituación A\nSituación B\nSituación A: Matriz de pino contorta con individuos de lenga\nSuperficie estimada: 12 ha\nAcciones propuestas: corta de faja de 5 a 10 mt entorno a los núcleos de lenga para reforestar con plantas de lenga\na 1.500 pl/ha y sembrar. Protección de plantas contra liebres con ramas de pino.\nSituación B: Matriz de lenga con individuos de pino contorta\nSuperficie estimada: 4 ha\nAcciones propuestas: Corta de liberación, reforestación con plantas de lenga y siembra, protección contra liebres\ncon ramas de pino.\nSituación C: Solo pino\nSuperficie estimada: 8 h\nAcciones Propuestas: Corta de pino para generación de pequeños claros de 15 metros de diámetro (180 – 200 m2),\nreforestación con plantas de lenga y siembra, protección contra liebres con ramas de pino.\nPlan de Restauración de bosques para Las Horquetas.\nSector Cerro Castillo\nJosé A. Suárez\n16 abril 2025\nActividades 2025:\n1.- Elaboración e ingreso de planes de manejo de plantaciones en Conaf (ingreso de planes pequeños para ensayos y planes grandes para el total\nde las plantaciones). INICIO DE TRAMITACION MAYO 2025- 2 MESES DE ELABORACION: INGRESO 30 DE JUNIO. José Suárez\n2.- Elaboración de propuesta de conservación de suelos en áreas degradas (ensayos de plantaciones con Notro y Calafate en áreas degradadas\njunto con el ensayo de estructuras para control de erosión, diques y empalizadas). INICIO DE ACTIVIDAD 16 DE MAYO. ENTREGA DE PROPUESTA\nEN 3 MESES. U. Chile/José Suárez.\n3.- Compra de plantas y depósito: Se iniciaría la compra de plantas durante el 2025. Se requiere implementar un depósito con perímetro cerrado,\nsombreadero y sistema de riego. Esto permitirá disponer de plantas en forma permanente, adaptadas a las condiciones locales.\nInicialmente se comprarían 5.500 plantas entre Lengas, Calafates y Notros ($8.500.000). FECHA DE COMPRA PLANTAS JUNIO -JULIO 2025. FECHA\nDE DEFINICION DEPÓSITO MAYO- JUNIO 2025. CONSTRUCCION DEPOSITO AGOSTO SEPTIEMBRE.\n4.- Planificación de Colecta y compra de semillas para el 2026\nSe propone implementar un plan de colecta de semillas de notro y calafate y compra de semillas de Lenga. PLAN LISTO EN FEBRERO – ABRIL del\n2026.\n5.- Actividades (Corta y plantación)\nDependiendo de los permisos de Conaf podríamos realizar las primeras intervenciones de corta en la plantación de Pino en Noviembre del 2025.\nPrimeras plantaciones 2026. plantación prueba en áreas degradadas AGOSTO – SEPTIEMBRE 2025.\n6.- Faenas para voluntariado: Eliminación de plantas de pino, plantación, colecta de semillas, protección de plantas (solo la primera actividad\ndurante el 2025) .', 'description': None, 'parent_drive_file_id': '1TrM2A2nq27dzRbhr_E0cE72z8A_ObUZr', 'children': []}, {'id': 'b4a40f7d-278f-4b99-80f2-086e34647ee5', 'drive_file_id': '1R7rNsNZGAC6kSOT1IIJpIUitU62QDS3d', 'name': 'INFORME RESTAURACIÓN Y CONTROL DE EROSIÓN EN SECTOR LAS HORQUETAS CERRO CASTILLO.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1R7rNsNZGAC6kSOT1IIJpIUitU62QDS3d/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 14, tzinfo=datetime.timezone.utc), 'text_content': 'INFORME\nPROSPECCIÓN DE LAS ÁREAS PARA EL DISEÑO DE PLAN PILOTO\nPARA LA RESTAURACIÓN DE BOSQUE NATIVO Y RECUPERACIÓN\nDE SUELOS EN EL SECTOR LAS HORQUETAS, PROVINCIA DE\nCOYHAIQUE, REGIÓN DE AYSÉN\nPREPARADO POR:\nPARA:\nAutores: Eduardo Martínez H., Carlos Magni D., Camila Céspedes V.\nCoyhaique, 2025\nContenido\nResumen ............................................................................................................................ 2\n1. VISITAS ....................................................................................................................... 3\nPrimer día (22 de julio) ..................................................................................................... 5\nSegundo día (23 de julio) .................................................................................................. 5\nVisita sector las Horquetas ladera exposición norte. ................................................ 5\nVisita a la reserva nacional Coyhaique ...................................................................... 6\nTercer día (24 de julio) ..................................................................................................... 8\nVisita sector las Horquetas ladera exposición sur ..................................................... 8\nVisita guardería Laguna Chiguay CONAF .................................................................... 9\nCuarto día (25 de julio) .................................................................................................. 10\nVisita predio el Mirador (Mininco) ............................................................................. 10\n2. CONTROL DE EROSIÓN Y TRASLOCACIÓN DE SUELO .............................................. 11\n2.1. Impacto en la estabilidad de laderas ....................................................................... 11\n2.2. Mecanismos de Retención ...................................................................................... 12\n2.3. Métodos propuestos ............................................................................................... 12\n2.4. Experimento ........................................................................................................... 17\n2.5 Evaluación de resultados ......................................................................................... 17\n3. RECOMENDACIONES Y CONCLUSIONES ................................................................. 19\n4. BIBLIOGRAFÍA .......................................................................................................... 21\n5. APÉNDICE FOTOGRÁFICO ........................................................................................ 22\nSector las Horquetas ladera exposición norte. ........................................................ 22\nReserva nacional Coyhaique. ................................................................................... 23\nDescripción de los lugares de instalación de sensores en las Horquetas exposición\nsur. ........................................................................................................................... 25\nPredio el Mirador. ..................................................................................................... 28\n1\nResumen\nSe visitó en terreno distintos lugares dentro de la comuna de Coyhaique con el objetivo de conocer\nexperiencias específicas de restauración de bosque nativo.\nDentro del sector las Horquetas, perteneciente a la fundación Rewilding Chile, se instalaron sensores\nde humedad y temperatura en distintas situaciones, las cuales fueron; Fuera del bosque, en el\necotono (límite), dentro de un renoval de lenga y dentro de una matriz de pino.\nPor último, se planificaron en terreno las acciones específicas a proponer para la situación\ndeterminada.\nSe incluye un análisis de la erosión y las prácticas de control asociadas al diseño de experimentos de\ncampo. Las prácticas recomendadas son obras lineales de retención de sedimentos.\n2\n1. VISITAS\nLas actividades descritas a continuación se enmarcan dentro del convenio de Universidad de Chile\ny fundación Rewilding Chile (FRC). El objetivo específico de la visita al sector las Horquetas (Cerro\nCastillo) entre los días 22 y 26 de julio 2025, es conocer en terreno las problemáticas para el\ndesarrollo de un plan global de restauración.\nEl plan comprende desde la restauración de suelo hasta aportes al plan de conservación de la\nfundación.\nEl objetivo general de la propuesta de restauración comprende el restaurar el hábitat del huemul,\nespecíficamente los bosques caducifolios de Nothofagus, a través de la conversión de ampliar el\nhábitat disponible.\nA continuación, se presenta un mapa con todos los lugares recorridos en los 5 días de trabajo (Figura\n1).\n3\nFigura 1., lugares recorridos los días de terreno, se puede observar el lugar más al norte, el cual es\nel predio el Mirador perteneciente a forestal Mininco, luego la reserva nacional Coyhaique, la\nguardería Laguna Chiguay de CONAF, el Centro de Rescate del Huemul y por último el sector las\nHorquetas.\n4\nPrimer día (22 de julio)\nSe realizó una visita preliminar a las Horquetas, éste sector es colindante al parque nacional cerro\ncastillo (sector las Horquetas), colindante a la carretera austral (ruta 7).\nParticipantes: Equipo de terreno.\nLas plantaciones presentes en el sector las Horquetas en general fueron desarrolladas desde la\ndécada del 50 para mitigar los efectos de los grandes incendios de los bosques de Aysén, lo que\ndesarrolló un fuerte efecto erosivo, lo cual significó la pérdida de miles de hectáreas de suelo. Lo\nanterior se combina con procesos naturales geológicos que conllevan a procesos degradativos que\nocurren de forma natural.\nDentro del sector Cerro Castillo, existe un clima de estepa fría y continental trasandino con\ndegeneración esteparia (SIMBIO, s.f).\nEn cuanto al tipo de suelos, éstos son de tipo volcánicos, principalmente del Suborden Udands que\ntienen, principalmente una capa superficial reciente (1991) de cenizas volcánicas que puede llegar\nhasta 50 cm de profundidad (CIREN, s.f).\nSegundo día (23 de julio)\nVisita sector las Horquetas ladera exposición norte.\nSe visitó el "centro de rescate del huemul" (CRH), ubicado en el predio las Horquetas, el cual se\nencuentra operando desde el año 2022.\nParticipantes: Rody Álvarez de CRH, equipo de terreno.\nSe recorrió la ladera de exposición norte dentro del sector de interés. Se observaron huellas de\nliebre y puma, además se visualizó daño producido por liebres y jabalíes. El sitio cuenta con un\n"encierro" para controlar la población de jabalíes.\nFigura 2. Daño causado por jabalíes en la ladera de exposición sur.\n5\nEs importante destacar que desde hace 2 años se eliminó la ganadería extensiva de veranadas en el\nsector, se puede observar regeneración de lenga, además se observaron interesantes paños\nremanentes de bosques nativo (lenga), los cuales permitirían obtener semillas.\nNo se va a intervenir este sector, pero se considera identificar árboles semilleros.\nSe realiza un vuelo con un dron para evaluar la factibilidad de acciones de conservación.\nFigura 3. Vista del sector las Horquetas desde la ladera norte.\nVisita a la reserva nacional Coyhaique\nEl objetivo de ésta visita es el conocer distintas experiencias de restauración, ensayos genéticos y\nhuertos semilleros clonales realizadas al interior de la reserva.\nLa Reserva Coyhaique fue creada en 1948, nació como respuesta a la necesidad de proteger suelos\nde laderas que quedaron expuestas a la erosión luego de los grandes incendios que afectaron a la\nRegión de Aysén que se produjeron durante la primera mitad del siglo XX. Dentro de la reserva\nexisten plantaciones exóticas de pino Oregón (Pseudotsuga menziesii), pino contorta (Pinus\ncontorta), pino silvestre (Pinus sylvestris) y pino ponderosa (Pinus ponderosa).\nDentro de la visita a la reserva Coyhaique, en primer lugar se visitaron las siguientes situaciones:\n-Ensayo de núcleos con Fundación Reforestemos: Antiguo lugar de acopio de desechos forestales,\nlos cuales fueron enterrados. Al interior de este lugar, se realizaron plantaciones de lenga en núcleos\n(de 100 individuos), existe regeneración de pino dentro del lugar. Además, se dejaron los individuos\nadultos de lenga presentes en el sector, donde se observa un individuo que está produciendo\nsemillas.\n6\nFigura 4. Plantación de lenga en núcleos, se puede observar los desechos forestales enterrados.\n-Plantación en fajas de lenga: Se observa un rodal de pino raleado en fajas (las cuales se realizaron\na favor de la pendiente). Se plantaron tres hileras en la faja de 15 metros y se raleó la interfaja, la\nplantación se realizó hace aproximadamente 10 años. Originalmente el prendimiento no era mayor\nal 30%, porque se utilizó translocación directa. Los desechos de los raleos son manejados con\ntrituradora y enterrados, el producto principal de los raleos es la producción de leña para la\ncomunidad local.\nFigura 5. Plantación en fajas, se observan individuos de lenga de aproximadamente 10 años.\n-Ensayos de procedencia de progenie: Plantado al interior de un bosque adulto de Pinus contorta,\nen el cual se han desarrollado dos raleos sin extracción de madera. El ensayo fue instalado en el año\n2000, y consiste en fajas habilitadas bajo el dosel de una plantación de coníferas pre-existente. Se\nutilizó un diseño estadístico de bloques al azar, en cada uno de los cuales cada progenie fue\nrepresentada por una parcela de un árbol (single tree plot). En este ensayo se representaron las\nprogenies (hijos) de árboles selectos en función de la superioridad de sus características\nproductivas, identificados en tres regiones de procedencias definidas para la XI región. Las regiones\nde procedencia consideradas en el ensayo corresponden a Cerro Catedral, Mallín Grande y Río\n7\nCajón. En la selección de los árboles se utilizaron cuatro categorías de árboles (plus, banco, fundador\ny conservación), a los cuales se les extrajo semillas, se produjo las plantas y se estableció el ensayo\nde progenies (Ipinza y Gutiérrez, 2015).\n-Huertos semilleros: Finalmente, se visita el sitio de huerto semillero clonal de lenga, éste es\nproducto de un estudio de INFOR del cual se rescataron árboles plus de tres procedencias. El método\nutilizado es injertación en patrón natural de lenga a distanciamiento de 5x5 metros, el año 2024 se\nregistró la primera semillación de algunos individuos. Lo anterior es importante puesto que permite\nla obtención de semillas de alta calidad de material conocido y fácil acceso.\nTercer día (24 de julio)\nVisita sector las Horquetas ladera exposición sur\nSe realizó una visita al lugar de interés con el objetivo principal de instalar sensores de temperatura\ny humedad, además de evaluar la factibilidad de las distintas propuestas para restaurar sitios\nespecíficos.\n-Instalación de sensores\nSe instalaron cuatro sensores en total, en un área desprovista de vegetación, en el ecotono (borde\nde bosque), en renoval de lenga con individuos de pino y en matriz de pino. El objetivo de instalar\nsensores es el de evaluar las diferencias de temperatura y humedad relativa del aire en un transecto\nque va desde sectores desprovistos de vegetación, pasando por el ecotono bosque-pradera, interior\nde bosque nativo e interior de matriz de pino. Esto permitirá una primera evaluación de límites\nprobablemente letales para las distintas especies a intervenir.\nLos puntos de instalación de los sensores se presentan en la tabla 1:\nTabla 1, códigos y coordenadas de ubicación de los sensores instalados dentro del sector las\nHorquetas, exposición sur. Datum: WGS84 UTM 19S.\nCódigo del Lugar de instalación Coordenada X Coordenada Y Altura\nsensor (m.s.n.m)\nFT01 Desprovisto de 0274076 4903761 851\nvegetación\nFT04 Borde de renoval 0274002 4903805 847\nFT03 Renoval de lenga 0274012 4903870 878\nFT13 Matriz de pino 0274024 4903912 917\nDentro del apéndice se presentan imágenes fotográficas de los puntos de instalación.\n8\n-Posibilidades y restricciones de realizar los ensayos\nEn cuanto a restricciones, existen las siguientes; Altas pendientes (bosques de protección),\npresencia de liebres y jabalíes, turistas como riesgo potencial en verano (aunque no se hayan\nobservado).\nEs importante coordinar las acciones propuestas en los distintos sectores con los objetivos\nprincipales de la conservación, como por ejemplo, huemul. Para lograr ésto, podemos formular las\nsiguientes preguntas.\n-¿Qué especies a plantar pueden favorecer la presencia de huemul?\n-¿Qué ambientes favorecen la presencia de huemul?\nEs necesario pensar en las restricciones para la presencia de huemul.\nEn cuanto a posibilidades, se determinó que el sector es completamente propicio para realizar\nacciones de restauración.\nVisita guardería Laguna Chiguay CONAF\nSe visitó la guardería Laguna Chiguay de CONAF con el objetivo de visualizar experiencias de\nrestauración por fajas al interior de un rodal de Pinus ponderosa.\nLa guardería Laguna Chiguay corresponde a la administración del parque nacional Cerro Castillo, y\nésta se ubica en el KM 57 de la ruta 7 sur.\nSe observa un rodal de pino raleado en fajas (las cuales se realizaron a favor de la pendiente) de 15\nmetros de ancho. A diferencia de lo realizado en la reserva Coyhaique, las fajas no fueron plantadas\ninmediatamente. Se espera intervenir dentro de poco tiempo la interfaja nuevamente, para\nposteriormente realizar una plantación principalmente con lenga al interior de las fajas.\nFigura 6. Se observan las fajas de 15 metros de ancho realizadas dentro de las dependencias de\nCONAF.\n9\nCuarto día (25 de julio)\nVisita predio el Mirador (Mininco)\nEl objetivo de la visita al predio el Mirador pertenecientes a Mininco, fue conocer diversas\nexperiencias de restauración de bosque nativo.\nEl predio el Mirador ubicado en la cuesta el Alvarado, comuna de Coyhaique, corresponde a una\nplantación de Pinus ponderosa realizada el año 1992, la cual cuenta con una superficie de 18.1 ha.\nDentro de ésta, existen 6 sectores cubiertos por un renoval de lenga de 2.4 ha.\nDentro de la visita al predio, en primer lugar se visitaron las siguientes intervenciones:\n-Anillado de pinos: Ésta medida tiene efecto en el mediano plazo, los pinos mueren paulatinamente,\nlo que aumenta la luminosidad y nutrientes disponibles para el bosque nativo. Además, al abrir el\ndosel paulatinamente, permite evitar efectos negativos producidos por el viento.\nSe observó que a pesar de estar anillados, muchos individuos no han mostrado señales de\ndebilitamiento.\n-Volteo de pinos en competencia directa con plantas nativas: Esta acción es realizada en situación\nde bosques mixtos (matriz de pino con individuos nativos), se eliminan individuos de pino en\ncompetencia directa con árboles nativos mediante volteo dirigido.\n- Plantación de especies nativas en sectores con pinos raleados: Para sectores donde se ralearon\nindividuos de pino, se plantaron especies nativas con una distribución espacial al azar. Para evitar el\ndaño producido por liebres, se realiza un cerco perimetral con ramas de pino alrededor de la\nplantación. Ésta última acción es de alto interés para realizar en reemplazo del uso de tree shelters.\n-Plantación de especies nativas en grupos: Para sectores raleados o con claros, se plantan especies\nnativas con una distribución espacial en grupos. Los grupos están compuestos de 10 a 12 individuos\ncon una distancia de 1 a 1.5 m entre ellas. Al igual que en la situación anterior, acá también se realizó\nun cerco perimetral con ramas de pino alrededor de la plantación.\n-Poda de pinos: se realizó con la finalidad de disminuir la competencia directa de las ramas de pinos\ncon plantas nativas.\n10\n2. CONTROL DE EROSIÓN Y TRASLOCACIÓN DE SUELO\nLa estabilidad de un talud o laderas depende directamente de las propiedades mecánicas del suelo\n(resistencia al corte, cohesión y ángulo de fricción interna). En tanto que la erosión superficial es el\nproceso de desprendimiento y transporte de partículas de suelo, principalmente por la acción del\nagua (impacto de gotas y escorrentía) y, en menor medida, del viento.\n2.1. Impacto en la estabilidad de laderas\nLa erosión laminar o en regueros elimina la capa superficial del suelo, que a menudo es la más rica\nen materia orgánica y vegetación, dejando al descubierto capas menos cohesivas.\nLa modificación de la geometría de la ladera debido a la formación de zanjas o al desprendimiento\nprevio de bloques de suelo afecta la estabilidad del suelo. La formación de cárcavas (regueros\nprofundos) aumenta la pendiente local, lo que incrementa las fuerzas desestabilizadoras y puede\nconcentrar el flujo de agua, iniciando una falla a gran escala (deslizamiento).\nAsimismo, el aumento de infiltración producto de la erosión que puede abrir fisuras y canales,\nfacilita que el agua se infiltre más profundamente, lo que aumenta la presión de poros y reduce\ndrásticamente la resistencia al corte del suelo, un factor clave en los deslizamientos.\nLa estabilización de taludes se refiere a las medidas (estructurales, hidrológicas o superficiales)\naplicadas para asegurar que el talud posea un Factor de Seguridad (FS) adecuado contra la falla de\nmasa (deslizamiento). La retención de sedimentos y el control de la erosión son, en esencia, medidas\nde estabilización superficial del talud. No obstante, medidas de mayor impacto en el paisaje que\ninvolucren una fuerte modificación del paisaje no serán incluidas en esta propuesta orientada a\nsoluciones basadas en la naturaleza.\nLa retención de sedimentos es el proceso físico de capturar las partículas de suelo erosionadas in\nsitu (en el talud) o aguas abajo, evitando su transporte y acumulación en otros lugares como ríos,\ndrenajes u otros suelos. Así, el objetivo principal de la retención de sedimentos es evitar que el\nsedimento entre en los cursos de agua o drene fuera del sitio. Los sedimentos perdidos no\nsolamente contienen partículas minerales (gravas, arenas, limos y arcillas), sino que también\ntransportan materia orgánica, nutrientes y microbiota edáfica.\n11\n2.2. Mecanismos de Retención\nEstos mecanismos se pueden separar en barreras inerte o físicas y barreras vegetales.\nBarreras Físicas: Uso de geomallas, geotextiles, mantos de control de erosión (de fibra natural o\nsintética) que cubren y protegen la superficie, y/o pequeñas estructuras como fajinas o biorrollos\ncolocadas transversalmente a la pendiente para filtrar y ralentizar la escorrentía, permitiendo que\nel sedimento decante, y se retenga aguas arriba de la barrera.\nVegetación: Las raíces de las plantas son el mecanismo de retención más efectivo y permanente, ya\nque fijan las partículas de suelo y mejoran la cohesión.\nLas obras de control de erosión se implementarán principalmente en el Lote A del predio las\nHorquetas. En esta situación, el suelo se encuentra ocupado por plantaciones, bosque nativo,\npraderas y suelo con escasa vegetación (imagen 14). El suelo con escasa vegetación presenta\nevidentes signos erosión. Esta actividad viene a complementar las acciones propuestas en 9.1, pero\nen sectores desprovistos de vegetación.\n2.3. Métodos propuestos\n2.3.1. Empalizadas\nLas empalizadas son obras lineales perpendiculares a la línea de máxima pendiente (en la curva de\nnivel, Figura 7), que cumplen la función de disminuir la velocidad del agua de escorrentía y permitir\nla acumulación de sedimentos aguas arriba. Su materialidad es diversa siendo comunes de madera\naserrada de segunda calidad (lampazos) o bien polines y postes para una mayor durabilidad. Deben\nestar anclados al suelo con estacas de madera o polines. Las estacas también pueden ser de metal,\nen caso de madera se debe optar por madera que pueda soportar por más tiempo la pudrición pues\ndebe anclar la estructura en el suelo del lugar. Tienen largo variable que dependerá del ancho del\nsuelo degradado, siendo múltiplos del largo de la madera disponible. El alto es cercano a los 50 cm.\nComúnmente se puede adicionar una capa de malla sombreadora a la cara de la empalizada que\nrecibe los sedimentos, aun cuando esta puede ser reemplazada por ramas con hojas. La profundidad\nde anclaje debe ser de al menos 40 cm. El distanciamiento de las empalizadas de madera para el\ncontrol de la erosión depende de la pendiente del terreno, la precipitación y el tipo de suelo. No hay\nun espaciamiento único, pudiendo alternarse con barreras vivas (revegetación por siembra o\n12\nplantación), que pueden alternarse con las empalizadas. Las barreras deben ser más numerosas y\ncercanas entre sí en pendientes más pronunciadas.\nSe propone intervenir un largo de suelo erosionado de 20 m a favor de la pendiente, ubicando de 3\na 5 empalizadas repetidas en 3 sectores.\nFigura 7. Empalizadas en Quebrada de la Plata (gentileza Biocys, arriba) y empalizadas con ramas\npost incendio en España.\n13\n2.3.2. Fajnas\nCorresponde a un tratamiento lineal con rollos de ramas (Figura 8). Es un tratamiento que tiene por\nobjetivo disminuir la erosión superficial, disipar la escorrentía superficial, reducir la velocidad del\nflujo hídrico y la acumulación de sedimentos. Esta obra puede aplicarse en laderas de pendientes\nmoderadas, no resultando recomendable para pendientes muy escarpadas. Se pueden utilizar\nresiduos de ramas de diferentes especies existentes en el lugar a intervenir (Francke et al., 2004).\nEn cuanto al anclaje son similares a las empalizadas aun cuando al ser una barrera más porosa, los\nesfuerzos de tracción resultan menores.\nSe propone intervenir un largo de suelo erosionado de 20 m a favor de la pendiente, ubicando de 3\na 5 empalizadas repetidas en 3 sectores. Si el terreno a intervenir tiene un relieve muy irregular se\ndebe confeccionar una microterraza aguas arriba, de tal forma de evitar la canalización del agua por\nlos sectores sin protección. Lo anterior, también aplica para el caso de las empalizadas.\n14\nFigura 8. Fajinas en Quebrada de la Plata, Chile. Como se ve sobre la fajina se ha confeccionado una\nmicroterraza y se ha realizado una plantación en línea.\nRecomendaciones prácticas para obras lineales (fajinas y empalizadas)\nComenzar en la parte superior: La primera terraza o empalizada debe situarse en la parte más alta\ndel terreno.\nUsar curvas de nivel: Las empalizadas deben seguir las curvas de nivel para ser más efectivas.\nAlternar con barreras vivas: Se pueden complementar las estructuras de madera con barreras vivas\n(plantas).\nPodar y usar residuos: Al podar las barreras vivas o cortar los residuos de otras prácticas, estos se\npueden colocar en la parte superior para ayudar a formar una terraza.\nUbicación; se preferirán instalar las obras en los sectores de menor pendiente dentro del perfil\nlongitudinal del suelo a intervenir (Figura 9).\nFigura 9. Ubicación de las obras en el perfil longitudinal.\nPlantación suplementaria con traslocación de suelo\nLa traslocación de suelo de bosque (o transferencia de suelo, Imagen 36) es una técnica de\nbioingeniería y restauración ecológica que consiste en el movimiento estratégico de una cantidad\nde suelo superficial, rico en materia orgánica y microorganismos, desde un ecosistema donante (un\n15\nbosque maduro y saludable) hacia un ecosistema receptor (una plantación o terreno con suelo\ndegradado).\nSu objetivo principal no es solo añadir nutrientes, sino reintroducir la compleja comunidad biológica\nnecesaria para restablecer los ciclos biogeoquímicos y mejorar la salud del suelo degradado.\nEl suelo del bosque actúa como un "inoculante" biológico, siendo la clave para la mejora\nmicrobiológica. Los grupos de simbiontes y microorganismos clave que se transfieren incluyen:\nHongos Micorrízicos, que son esenciales para casi todas las plantas nativas. Establecen una relación\nde simbiosis mutualista con las raíces. La función de estos hongos es aumentar la superficie de\nabsorción de la raíz, facilitando la captación de nutrientes inmóviles como el fósforo (P) y el\nnitrógeno (N). A cambio, la planta suministra azúcares al hongo. La importancia radica que en suelos\ndegradados, la ausencia de estas micorrizas es un factor limitante crítico para el crecimiento de\nespecies nativas.\nPor otro lado, las bacterias Fijadoras de Nitrógeno, incluyen géneros como Rhizobium (simbiótico\ncon leguminosas) y Azotobacter (vida libre). Su función consiste en convertir el nitrógeno\natmosférico N en formas de nitrógeno utilizables por las plantas (como el NH +). Esto puede\n2 4\nresultar relevante para el crecimiento, ya que el nitrógeno suele ser el nutriente más limitante en\nsuelos pobres. El suelo de bosque también puede contener otras comunidades bacterianas y\nfúngicas encargadas de la descomposición de la materia orgánica, liberación de enzimas y control\nde patógenos.\nLa transferencia de suelo de bosque proporciona un doble beneficio químico y estructural.\nNutrientes, aunque el volumen de suelo transferido suele ser pequeño, contiene una concentración\nsignificativa de nutrientes en formas fácilmente asimilables. El Fósforo (P) y Potasio (K) son\nliberados lentamente a medida que la materia orgánica y mineral se descomponen. También se\nincorporan micronutrientes esenciales como B, Cu, Zn, que pueden estar agotados en el suelo\ndegradado.\nEfecto Catalizador: El verdadero valor del suelo de bosque es que los microorganismos que contiene\nhacen que los nutrientes que ya estaban en el suelo degradado sean accesibles para la nueva\nplantación.\nCarbono Orgánico (COS). El suelo superficial de los bosques es extremadamente rico en COS,\nproveniente de hojarasca y biomasa en descomposición. El COS mejora la estructura al actuar como\nun floculante que mejora la estructura del suelo, aumentando la capacidad de retención de agua y\naireación, y reduciendo la densidad aparente, lo que favorece el crecimiento de las raíces.\n16\nFuente de Energía, el COS actúa como un alimento fundamental para la supervivencia y proliferación\nde la nueva comunidad microbiana inoculada. Un nivel adecuado de carbono orgánico es esencial\npara que la traslocación biológica sea exitosa a largo plazo.\n2.4. Experimento\nEntre cada obra lineal se realizarán los siguientes tratamientos:\n• Plantación. 30 plantas de lenga provenientes de vivero sin adición de suelo (testigo)\n• Plantación. 30 plantas de lenga provenientes de vivero con adición de suelo de bosque.\n• Siembra directa. 30 porta siembra (10 semillas cada uno) sin adición de suelo.\n• Siembra directa. 30 porta siembra (10 semillas cada uno) con adición de suelo de bosque.\nLas plantas se dispondrán al azar entre las obras (arriba, medio y abajo) para evitar el efecto de\nbloque. El suelo de bosque se extraerá de los rodales más sanos y cercanos, evitando colectar más\nde 10 litros de suelo por punto, separados al menos 5 m entre puntos. Idealmente, el suelo de\nbosque colectado no debe permanecer más de una semana en los sectores de acopio temporal en\ncampo.\nCada casilla de plantación debe tener al menos 40 cm de profundidad. Los tratamientos que\nincluyan la adición de suelo de bosque deben incluir 2 litros de suelo. Una vez plantados los\nejemplares, se deben proteger con una estructura que cumpla la función de alejar herbívoros.\nFigura 10. Traslocación de suelo de bosque.\n2.5 Evaluación de resultados\nSe medirá la supervivencia de las plantas en los tratamientos de suelo y se estimará la erosión\nmediante parcelas con clavos.\n17\nSe instalarán un total de 6 parcelas de 2 x 2 entre obras, cada clavo se instalará a 50 cm de su vecino,\nresultando en 16 clavos por parcela con el objetivo de monitorear la pérdida o ganancia de suelo a\ntravés del tiempo y así poder evaluar la efectividad de cada método utilizado. Este método permite\ndeterminar el balance entre pérdidas y entradas de suelo en cada tratamiento, permitiendo efectuar\nestimaciones más reales de las pérdidas de suelo, debido a que, al ser un balance, no se sobreestima\nla erosión (Pizarro et al, 2010). Para llevar a cabo la medición de los clavos, se utilizará una regla o\nhuincha metálica, la cual se ubicará al costado de cada clavo, siempre en la parte baja de la ladera y\njusto al borde de la cabeza del clavo. Paralelamente, los valores obtenidos de las alturas en mm se\nfueron registrando en el formulario correspondiente.\nUna vez obtenidos los datos en terreno, se estimará la erosión media, sedimentación media y\nerosión neta a base de las siguientes ecuaciones:\n𝒙=𝒚∗ 𝑫𝒂∗𝟏𝟎\nDonde:\nx : Suelo erosionado o sedimentado [ton/ha].\ny : Altura media del suelo erosionado o sedimentado [mm].\nDa : Densidad aparente del suelo [ton/m].\nErosión y sedimentación media (x): Erosión o sedimentación promedio que se genera en las\nparcelas. Para su cálculo primero se determinará la altura media de los clavos (y), siendo esta la\nsuma de las alturas sobre el total de clavos de la parcela. Estas pueden ser alturas de erosión o altura\nde sedimentación en relación con las diferencias entre las mediciones realizadas entre tormentas\n(Vega, 2008).\nErosión neta (En): Se define como la pérdida de suelo considerando la sedimentación ocurrida, es\ndecir, la diferencia entre la erosión media del suelo y la sedimentación media. Cabe destacar, que\nlos valores positivos de Erosión neta indican la existencia de erosión y los valores negativos\nsedimentación (Vega, 2008). Se expresa como:\n𝑬𝒏=𝑬−𝑺\nDonde:\nEn :Erosión neta [ton/ha].\nE : Erosión media [ton/ha].\nS : Sedimentación media [ton/ha].\n18\n3. RECOMENDACIONES Y CONCLUSIONES\nLa necesidad de obtención de propágulos de alta calidad para las especies de interés del proyecto\nes una prioridad. Una propuesta es utilizar los paños remanentes de bosques nativo que actúen\ncomo fuentes de semillas (presión de propágulos), específicamente lenga, para desarrollar áreas\nproductoras de semillas y selección de árboles semilleros. Adicionalmente, se pueden considerar la\ncolecta en almacigueras naturales y repicar individuos de las especies de interés en contenedores\n(tipo bolsa o tubetes), los cuales serían viverizados por una o más temporadas. Lo anterior a través\nde raleos, escarificación de suelo, fertilizaciones, entre otras prácticas, como medidas de\nrestauración.\nSe deben considerar todos los potenciales desechos de las distintas faenas de eliminación de pinos\nu otras especies no deseadas, así como los desechos de raleos de especies nativas. Lo anterior para\nla producción de piezas como postes, polines, pie derecho, o desechos de ramas que permitan\ngenerar un cerco perimetral de protección para las plantaciones a realizar.\nExiste una importante presencia de claros dentro de la matriz de pino y pequeños rodales\ndiscontinuos de bosque nativo, los cuales son sectores altamente recomendados para iniciar el\nproceso de restauración, pues los sectores a excluir, ya sea de ganado doméstico o lagomorfos, es\nmenor en superficie, además que estos dos tipos de matriz (pino y nativo), producen un efecto de\nprotección lateral y vertical importante para el establecimiento de la plantación.\nDe las técnicas de eliminación de individuos adultos de pinos observados en Forestal Mininco, a\ntravés del anillado de individuos, se puede indicar que es una técnica interesante, sin embargo, se\ndeben explorar otros métodos para acelerar la muerte de los individuos, pues podría ser\ncontraproducente, debido a que serían una importante fuente de semillas dado el estrés de los\nindividuos que comienzan a morir. La eliminación de individuos y la apertura brusca del dosel puede\ntraer consecuencias a la matriz, aumentando en forma desproporcionada los claros que se espera\nhabilitar para plantaciones de especies nativas. Lo que puede afectar el crecimiento de los\nindividuos juveniles plantados.\nSe advierte en los sectores la existencia importante de lagomorfos y jabalíes, los cuales pueden\nproducir efectos negativos en los ensayos de plantación a realizar.\nRespecto a las obras de conservación de suelo se propone la implementación y ensayo de obras\nlineales como son las empalizadas y fajinas, acompañadas de plantación suplementaria en la entre\nhilera con adición de suelo de bosque.\n19\n20\n4. BIBLIOGRAFÍA\nCIREN. s.f. CLASIFICACIÓN DE SUELOS DE VALLES PRODUCTIVOS DE LA REGIÓN DE AYSÉN. [En\nlínea] https://bibliotecadigital.ciren.cl/server/api/core/bitstreams/04e9bca9-fff8-49b9-899f-\n2ad1053b2b77/content.\nIpinza, Gutiérrez (2015). Evaluación genética a los 8 y 11 años de un ensayo de progenies de lenga\n(Nothofagus pumilio) en la Reserva Nacional Coyhaique, Región de Aysén, Chile. En: Conservación\nde Recursos Genéticos Forestales: Principios y Prácticas (pp.277-296) Capítulo: 16. Instituto\nForestal Editors: Braulio Gutiérrez; Roberto Ipinza y Santiago Barros.\nPizarro, R.; Morales, C.; Vega, L.; Valdés, R.; Olivares, C. Y Balocchi, F. 2010. Evaluación de la\nerosión hídrica superficial en zonas áridas y semiáridas de Chile central. Aqua-LAC. 2(2): 1-11.\nSIMBIO. s.f. Parque Nacional “Cerro Castillo”. [En línea]\nhttps://simbio.mma.gob.cl/CbaAP/Details/988#:~:text=En%20la%20zona%20existe%20una,y%20n\nieve%20en%20el%20invierno.\nVega, L. 2008. Evaluación de erosión hídrica superficial por parcelas experimentales en suelos\ndesnudos de la región de Coquimbo. Memoria Ingeniero Forestal. Talca, Chile: Facultad de\nCiencias Forestales, Universidad de Talca. 138p.\n21\n5. APÉNDICE FOTOGRÁFICO\nSector las Horquetas ladera exposición norte.\nIndividuos de lenga con potencial de árboles semilleros.\nEn la imagen de la izquierda se pueden observar huellas de un cachorro de puma, mientras que en\nla imagen del lado derecho se pueden observar huellas de liebre.\n22\nDesprendimiento de suelo.\nReserva nacional Coyhaique.\nNúcleos de plantación de lenga junto con regeneración de pino.\n23\nIndividuo de lenga adulto dentro del sector de los ensayos de plantación con núcleos.\nSe puede observar semillas de lenga, las cuales están presentes en el sector de los ensayos de\nplantación con núcleos.\nEnsayo de procedencia de progenie de lenga.\n24\nÁrboles de lenga dentro de huerto semillero.\nDescripción de los lugares de instalación de sensores en las Horquetas exposición sur.\nSe muestra el sector las Horquetas a orillas del río en una situación desprovista de vegetación.\n25\nInstalación del primer sensor (FT01) en el lugar desprovisto de vegetación.\nInstalación del segundo sensor (FT04) en borde de renoval de lenga.\nSe muestra sector de renoval de lenga, se puede observar un individuo de Pinus contorta.\n26\nInstalación del tercer sensor (FT03) interior de renoval de lenga.\nSe muestra sector matriz de pino.\nInstalación del cuarto sensor (FT13) interior de matriz de pino.\n27\nPredio el Mirador.\nIndividuo anillado con motosierra.\nEn la imágen se puede observar la realización de cercos con ramas, ésto para evitar el ataque de\nlagomorfos. Dentro de éstos cercos se plantaron diferentes especies nativas.\n28\nSe puede apreciar un individuo con su ápice cortado por la acción del viento producto de abrir\nclaros muy amplios.\nDentro de las imágenes se puede observar individuos raleados, donde los troncos fueron dejados\nen el sitio. En la imágen de la derecha se pueden observar plantas de calafate creciendo al costado\nde un tronco.\n29\nDaños producidos por lagomorfos.\n30', 'description': None, 'parent_drive_file_id': '1TrM2A2nq27dzRbhr_E0cE72z8A_ObUZr', 'children': []}, {'id': '080373b5-adc5-41cb-9349-9667abe3ce37', 'drive_file_id': '1mSdv-7lTTgsK_8UXgEQabye5EYKH15xc', 'name': 'Diseño Plan restauración BN - FRC Las Horquetas 18.02.25.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1mSdv-7lTTgsK_8UXgEQabye5EYKH15xc/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 14, tzinfo=datetime.timezone.utc), 'text_content': 'Diseño de plan de restauración de Bosque nativo para 3 propiedades de la\nFundación Rewilding Chile, en sector Las Horquetas, colindantes al\nParque Nacional Cerro Castillo.\nProvincia de Coyhaique. Región de Aysén.\nAutor: José A. Suárez- Ingeniero Forestal\nFebrero, 2025\nÍndice\n1.- Contexto general……………………………………………………………………………… 3\n2.- Contexto histórico……………………………………………………………………………. 4\n3.- Objetivo general………………………………………………………………………………. 6\n4.- Descripción del área de estudio…………………………………………………………….. 6\n4.1.- Identificación de las propiedades……………………………………………………. 6\n4.2.- Uso actual del suelo…………………………………………………………………... 8\n5.- Pino Contorta, especie exótica invasora…………………………………………………… 9\n6.- Características de los bosques de lenga (N. pumilio)….………………………………….. 12\n6.1.- Estructura y dinámica………………………………………..……………………….. 13\n6.2.- Regeneración…………………………………………………………………………. 13\n7.- Caracterización de las plantaciones en el área de estudio (Lote A y Lote B de la FRC).. 14\n8.- Definición estrategia de conversión de plantaciones exóticas a bosque nativo………... 15\n8.1.- Propuestas específicas de plan de conversión de plantación – bosque nativo .. 18\n8.2.- Propuesta de restauración de bosque nativo en áreas degradas……………….. 18\n8.3.- Análisis de la oferta de plantas………………………………………………………. 18\n8.4.- Aproximación de costos asociados al plan restauración………………………….. 18\n9. Conclusiones y próximos pasos……………………………………………………………… 20\n10. Bibliografía……………………………………………………………………………………. 21\n2\n1.- Contexto general\nEste informe se desarrolla para obtener los antecedentes necesarios para elaborar la\npropuesta de restauración del bosque nativo en las propiedades de Fundación Rewilding\nChile (FRC) en el área del valle Las Horquetas en la zona de Cerro Castillo. La zona de\nestudio corresponde a 3 propiedades aledañas a la carretera austral que colindan con el\nParque Nacional Cerro Castillo.\nPara iniciar el trabajo se solicitó a Conaf la información de los expedientes de las\npropiedades, de este modo se pretendía obtener información histórica relevante para\nconocer las propiedades en cuestión y los posibles planes de manejo forestal ingresados\npor los propietarios anteriores.\nSe realizaron dos prospecciones en terreno para toma de datos de la vegetación y las\ncaracterísticas de los predios. Para esto también se realizaron vuelos con dron en diferentes\nsectores para hacer el trabajo fotogramétrico que permitió sacar fotografías verticales, y a\ntravés de un proceso posterior, construir las ortofotos para mejorar el análisis de las\ndiferentes situaciones a evaluar.\nImagen N°1 y N°2: Mediciones de DAP (Diámetro a la Altura del Pecho) de los árboles de las parcelas\nrealizadas. Imagen N°3: Vuelo con Dron Mavic 3 Enterprise para captura de imágenes aéreas.\nPor otra parte, para elaborar esta propuesta se realizaron entrevistas con académicos,\nprofesionales y técnicos de la región que han tenido alguna experiencia en conversión de\nplantaciones exóticas similares al desafío que se presenta en este caso.\nEl trabajo que se propone es relevante porque tiene un carácter de plan piloto dado que\nexisten 627 ha de plantaciones exóticas en el Parque Nacional Cerro Castillo, lo cual\nconvierte este trabajo en laboratorio de pruebas para expandir esta experiencia al Parque\nNacional. En la Imagen N°4, se pueden observar las plantaciones de especies exóticas\nexistentes en el Parque Nacional Cerro Castillo.\n3\nImagen N°4: Plantaciones exóticas en el Parque Nacional Cerro Castillo.\n2.- Contexto histórico\nA principios del siglo pasado en la Región de Aysén, la colonización y la habilitación de\nterrenos para la agricultura y ganadería mediante quemas, afectaron la calidad de sus\nsuelos, dejándolos frágiles y sin protección. Esto, sumado a las condiciones climáticas y la\nabrupta topografía de la región conformada principalmente por cordones andinos y\narchipiélagos, provocaron la pérdida de cerca de tres millones de hectáreas de bosque\nnativo (Gandara, 1978), esta cifra se verificó por Quintanilla (2005) y comprende a la perdida\n60% del bosque nativo de la región (Muñoz, 2013).\nImagen N°5, N°6 y N°7: Evidencias de los incendios que afectaron la zona a principios del siglo pasado.\n4\nLuego, en el año 1957 se realizó un programa de forestación con especies exóticas, con el\nfin de proteger y recuperar el recurso suelo. Los ensayos se iniciaron con cincuenta y una\nespecies de coníferas del hemisferio norte, luego de siete años de estudio, se redujo a diez\nespecies, dentro de las cuales las más relevantes fueron: pino ponderosa (Pinus\nponderosa), pino silvestre (Pinus sylvestris), pino oregón (Pseudotsuga menziesii) y pino\ncontorta (Pinus contorta). Esta forestación se realizó a lo largo de la región ocupando\nterrenos despoblados, estatales e incluso Reservas Nacionales (Gandara, 1978; Peña y\nPauchard, 2001). Actualmente las plantaciones exóticas en la región de Aysén cubren\n32.000 ha y de estas 1.719 ha están del Sistema Nacional de Áreas Protegidas del Estado.\nEste es el caso de las plantaciones establecidas en estos predios.\nImagen N°8 y N°9: Plantaciones a convertir en bosque nativo. En ambas fotos se puede apreciar las\nplantaciones que comparten las propiedades de la FRC y el PN CC\nAdemás de los incendios y las especies exóticas utilizadas para reforestar parte de la zona,\nen el valle Las Horquetas se hizo ganadería en áreas antiguamente cubiertas por bosques\ny habitadas también por el huemul. Muchas de estas áreas hoy se encuentran erosionadas\ny descubiertas de vegetación.\nImagen N°10 y N°11: Áreas con suelos degradados sin cobertura vegetal en las propiedades de FRC y el PN\nCerro Castillo.\n5\n3.- Objetivo general\nEl objetivo general es restaurar el hábitat del huemul, específicamente los bosques\ncaducifolios de Nothofagus, que están dominados por lenga (Nothofagus pumilio) a través\nde la conversión de áreas cubiertas por plantaciones de pino contorta establecidas hace 60\naños en el valle Las Horquetas, y la restauración de bosques en áreas degradadas\ndesprotegidas y con procesos erosivos activos. El objetivo es ampliar el hábitat disponible\ny mejorar las condiciones actuales para esta especie en las propiedades de FRC.\nTabla N°1: Superficie que se propone restaurar para cada situación\nSituación Superficie (ha)\nÁreas erosionadas sin vegetación 187,84\nPlantaciones exóticas a convertir a bosque nativo 24,19\nTotal a Restaurar 212,03\n4.- Descripción del área de estudio\n4.1.- Identificación de las propiedades\nEl presente informe considera el diseño de un plan de restauración de bosques nativos en\n2 situaciones a través de la conversión de plantaciones exóticas a bosque nativo y la\nrestauración de bosque nativo en áreas degradadas en 3 propiedades de Fundación\nRewilding Chile en el sector de Cerro Castillo en el Valle Las Horquetas aledañas a la\nCarretera Austral. Como se puede apreciar en la figura N°1, el Valle Las Horquetas está\nrodeado por el Parque Nacional Cerro Castillo, que hasta el 2019 fue reserva Nacional.\nImagen N°12: Ubicación general y contexto geográfico de las propiedades de FRC en el sector del valle Las\nHorquetas.\n6\nEl enfoque de esta propuesta tiene el carácter de plan piloto para expandir las experiencias\nde las acciones a implementar en estas propiedades a las plantaciones existentes en el\nParque Nacional Cerro Castillo.\nEl área de trabajo se limitó al Lote A de 112,50 ha y al predio Las Horquetas de 116,5 ha.\nEspecíficamente se trabajó en estos predios que tienen plantaciones de pino contorta (P.\ncontorta) que suman una cantidad aproximada de 25 ha. Sin embargo, estas tres\npropiedades del sector sur aledañas a la carretera austral (Lote A, Lote B y Predio Las\nHorquetas), se considerarán, para efectos del diagnóstico y plan de restauración, como una\nsola unidad territorial. Por otra parte, en un plan de restauración integral de estas\npropiedades deberá incorporar también aquellas superficies de suelo no cuentan con\ncobertura vegetal y que están sometidos a procesos erosivos y que constituyen una\nproporción importante de las propiedades.\nImagen N°13: Identificación de las propiedades del sector Las Horquetas aledañas a la Carretera Austral.\n7\n4.2.- Uso actual del suelo\nActualmente estas 3 propiedades cuentan suman 455 ha, de las cuales 118,4 ha (26%)\nestá cubierta por bosques nativos del tipo forestal Lenga, mientras que el 61% de la\nsuperficie corresponde a la combinación de matorral, praderas y áreas erosionadas sin\nsuelo orgánico, un 8% correspondería a estepa y finalmente un 5% a plantaciones de pino\n(24,1 ha).\nImagen N°14: Uso actual del suelo en las propiedades del sector del Valle Las Horquetas.\nTabla N°2: Uso actual del suelo de las propiedades a restaurar\nUso actual Superficie (ha) %\nPraderas y áreas erosionadas 153,0 34\nMatorral 122,3 27\nBosque nativo 118,4 26\nEstepa 37,2 8\nPlantación 24,1 5\nTotal 455,0\n8\n5.- Pino Contorta, especie exótica invasora\nLa especie Pinus contorta Douglas, Pino contorta o Lodgepole pine pertenece a la familia\nPinaceae es originaria de América del Norte. Fue introducida en Chile con fines\nornamentales, control de erosión y fines productivos.\nImagen N°15: Plantación de pino contorta establecida en el sector del Valle Las Horquetas.\nEs una especie muy plástica (de alta adaptabilidad), ampliamente distribuida en el oeste de\nNorteamérica, ubicándose desde el Valle de Yukón en Alaska (64° Latitud Norte y 145°\nLongitud Oeste), hasta las montañas de Baja California (31° Latitud Norte y 114° Longitud\nOeste) y desde la costa del pacifico hasta Dakota del sur (Latitud 44°, Longitud 104°)\n(Muñoz, 2013).\nImagen N°16, N°17 y N°18: Corteza, Conos y Acículas de pino contorta.\n9\nEs un árbol perenne, de hasta 25 m de alto. Hojas simples muy angostas en forma de aguja\n(acículas), de 3-7 cm de largo, dispuestas en pares. Conos femeninos cónicos-ovoides, de\n20-60 mm de largo. Semillas aladas, color café, de aproximadamente 12 mm de largo.\nPresenta un alto potencial Invasor ya que se reproduce a través de semillas contenidas en\nlos conos, las que son dispersadas por viento. La producción de semillas comienza a\ntemprana edad, 5-10 años. Los conos serótinos pueden persistir por décadas en las copas\nde los árboles. Las semillas pueden permanecer hasta 17 años en el banco de semillas\n(Fuentes et al, 2014).\nImagen N°19: Pino contorta regenerando y creciendo naturalmente, evidencia de su carácter invasivo\nespecialmente en ecosistemas abiertos.\nEl pino contorta (P. contorta) es un productor de semillas prolífico y confiable. Los conos\npueden soportar temperaturas bajo cero y no se ven muy afectados por los insectos.\nAproximadamente el 72% de las semillas son viables.\nLa sombra puede inhibir la supervivencia de las plántulas, aunque las plántulas pueden vivir\ndurante muchos años en un sotobosque de sombra ligera. Las plántulas son competidores\nrelativamente pobres contra las gramíneas y pueden quedar excluidas por una cubierta de\ncésped.\nTiene impactos potenciales en los ecosistemas como alteraciones en la diversidad\nestructural, aumento de biomasa, cambio en la dinámica de la vegetación presente y en el\nciclo de nutrientes.\n10\nImagen N°20: Pino contorta no puede invadir áreas con gramíneas o césped.\nPino contorta (P. contorta) invade hábitats como ecosistemas abiertos o con altos niveles\nde perturbación, como orillas de caminos. Se considera como una especie similar a Pinus\nponderosa y P. radiata\nImagen N°21, N°22 y N°23: Pino contorta, no logra regenerarse bajo sombra.\nLas invasiones de plantas en particular, han demostrado ser un agente de cambio\nimportante para la biodiversidad. La evidencia científica sugiere que las plantas introducidas\nque se vuelven invasoras pueden modificar profundamente los ecosistemas donde se\nestablecen, por ejemplo cambiando el ciclo hidrológico o los regímenes de fuego (e.g.\nBrooks et al. 2004, Van Wilgen et al. 2008).\nEl Pino contorta es una especie intolerante a la sombra, es decir no se regenera bajo\nsombra y por el contrario, su regeneración es abundante en suelos expuestos a la luz.\n11\n6.- Características de los bosques de lenga (N. pumilio)\nLa lenga es una especie endémica de los bosques subantárticos, siendo su distribución en\nChile de gran amplitud, cubre alrededor de 2.200 km desde la localidad de Altos de Vilches,\nen la precordillera andina de la Provincia de Talca en la VII Región, hasta el sur de la isla\nHoste, en la XII Región (Ormazábal y Benoit, 1987). Por la cordillera de la costa se\nencuentra en las partes más altas de Nahuelbuta y en la Cordillera Pelada. En su\ndistribución septentrional, se encuentra siempre en el límite altitudinal de la vegetación\narbórea. En cambio en las Regiones XI y XII se desarrolla a menores altitudes,\nencontrándose al nivel del mar en Magallanes (Guerra y Correa, 1973; Rodríguez et al.,\n1983).\nDe acuerdo a la legislación vigente, pertenecen al tipo forestal Lenga aquellos bosques en\nque al menos un 50% de individuos por hectárea corresponden a lenga. Este tipo forestal\nse divide a su vez en tres subtipos, Bosques achaparrados y Krumholz de Lenga, Bosques\nde Lenga puro y Bosques mixtos de Lenga-Coigüe (Donoso, 1981).\nImagen N°24: Lengas (N. pumilio) en el sector de Las Horquetas, Cerro Castillo\n12\n6.1.- Estructura y dinámica\nEn términos de estructura y de dinámica, se pueden encontrar bosques multietáneos\nmultiestratificados y bosques de estructuras coetáneas, que pasan por distintas fases de\ndesarrollo de duración variable. El ciclo natural de desarrollo dura del orden de 200 a 250\naños, repitiéndose las distintas fases en forma similar a través del tiempo. Estas fases se\npueden diferenciar por la estructura y edad de los árboles que las componen, y se describen\na continuación (Schmidt y Urzua, 1982):\n• Desmoronamiento con regeneración: En esta fase se produce una disminución\ngradual de los árboles sobremaduros, lo que permite el establecimiento de la\nregeneración. Esta etapa puede durar 50 a 70 años y culmina en un monte bravo\ndel orden de 2 a 5 m de altura.\n• Desmoronamiento con crecimiento óptimo: Aún subsisten algunos árboles\nsobrevivientes de la primera generación y la segunda generación está constituida\npor un latizal de árboles juveniles que penetran vigorosamente en el estrato\nsuperior. La edad de los árboles juveniles de esta fase llega a los 140 años.\n• Envejecimiento: Fase formada por un sólo estrato superior en estado de fustal, en\nla que los árboles alcanzan edades del orden de los 200 años.\n• Desmoronamiento: La estructura sigue siendo un fustal, pero ahora con árboles\nsobremaduros. La muerte de estos árboles inicia la abertura del dosel superior, lo\nque permite el establecimiento de regeneración y el desarrollo de una nueva\ngeneración.\n6.2.- Regeneración\nEn los bosques de lenga vírgenes y en los bosques intervenidos, la presencia de\nregeneración y el establecimiento de las plantas son normalmente buenos, si se realiza en\nclaros dentro del bosque y bajo un dosel de protección. La ausencia de regeneración en\nsuperficies deforestadas se explica principalmente por el pastoreo y los efectos adversos\ndel viento (Schmidt y Urzúa, 1982).\nLa lenga tiene una tolerancia media a la sombra. Los bosques de lenga son considerados\ncomo buenos productores de semillas, en general. Sin embargo, los rodales más pequeños\ny no tan añosos son inciertos respectos de su semillación (calidad y cantidad). Una\nregeneración satisfactoria depende de una fuente abundante y viable de semillas, en\ncondiciones ambientales favorables junto con un medio conveniente para la germinación\nde las semillas y la capacidad de brotar de la especie (Castillo et al, 2002).\nLa siembra directa es uno de los métodos de restauración activa más económicos. La\ngerminación de semillas se ve favorecida por varios factores ambientales (i.e., temperatura\ny humedad), los que pueden estar afectados por la cobertura arbórea y la hojarasca. Sin\nembargo, los depredadores de semillas ponen en riesgo la eficacia de esta actividad\n(Promis, 2025).\n13\n7.- Caracterización de las plantaciones en el área de estudio (Lote A y Lote B de la\nFRC)\nSe trata de 2 rodales de una superficie total 24,1 ha con densidades variables de Pinus\ncontorta. El Rodal 01 tiene una superficie de 16,3 ha. La edad aproximada de las\nplantaciones es de unos 60 años, en suelos de altas pendientes 15% a 22%, suelos\ndelgados afectados por erosión ya que se trata de suelos que estuvieron sometidos al\nfuego, por lo cual perdieron su cobertura vegetal que además presentan regímenes de\nnieve en invierno lo que aumenta la perdida de suelos. El Rodal 2 tiene una superficie de\n7,8 ha con característica principal de altas pendientes sobre el 100%.\nImagen N°25: Plano de las propiedades identificando los rodales de Pino contorta.\nPara caracterizar las plantaciones se realizaron parcelas de muestreo dasométrico para\nestimar la densidad (cantidad de árboles por ha para cada rodal), el área basal y una\nestimación gruesa de los posibles volúmenes de productos potenciales de obtener\nconsiderando hacer aprovechamiento de la madera de pino que se obtendría en el proceso\nde conversión (Ver tablas N°3 y N°4).\nDada la gran extensión de las áreas degradadas descubiertas de vegetación (187,8 ha), su\ncaracterización se planificará para el realizarse durante el año 2025. Además deberán\ndefinirse las soluciones específicas para retención y protección de suelos de los procesos\nerosivos. Dado que las condiciones para establecer lenga en las áreas degradas son más\ndifíciles, se propone probar en primera instancia, establecer en estas situaciones una\n14\nmezcla de plantas de calafate (Berberis microphylla), notro (Embothrium coccineum) y\nlenga (N. pumilio) para dar protección a estos suelos descubiertos.\nTabla N°3 y 4: Tablas de rodal construidas con la información tomada en terreno.\n8.- Definición estrategia de conversión de plantaciones exóticas a bosque nativo\nLas experiencias de restauración, a través de la conversión de plantación a bosque nativo\nen la región de Aysén se han realizado a través de aberturas parciales al dosel arbóreo;\nprincipalmente a través de fajas, cortas de protección y tala rasa. Posteriormente, para\nrestituir las condiciones vegetales originales, se han realizado plantaciones con especies\narbóreas de estos bosques, tales como lenga (N. pumilio), coihue común (N. dombeyi) y\nñirre (N. antartica).\nEn los rodales analizados y descritos anteriormente se pueden observar 3 situaciones:\n\uf0b7 Situación A: corresponde a una matriz dominante que está compuesta por pino contorta\ny se presentan algunos individuos aislados de lenga o pequeños grupos de 3 individuos.\n15\nImagen N°26: Imagen explicativa de la Situación A. Individuos de Lenga en matriz de Pino.\n\uf0b7 Situación B: es una situación más escasa pero más favorable a la conversión donde la\nmatriz está dominada por lenga (N. pumilio) y estas se encuentran presionadas por\nalgunos individuos de pino contorta (P. contorta).\nImagen N°27 y N°28: Muestras de la situación B, Pinos presionando en matriz de lenga (N. pumilio).\n16\n\uf0b7 Situación C: y corresponde a una situación donde el pino contorta (P. contorta) es la\núnica especie.\nImagen N°29: Situación C, 100% de Pino contorta.\nConsiderando las siguientes características de pino contorta y de su semillación y las\ncaracterísticas de semi tolerancia a la sombra de la lenga, se propone una estrategia\ncombinada de corta, repoblación natural y plantación complementaria en torno a sectores\ncon lengas adultas remanentes. En algunas situaciones se propone probar la escarificación\nde una franja de 5-10 metros entorno a los grupos de lenga o lengas individuales con el fin\nde promover el establecimiento natural de plantas de lenga, esto debería ser acompañado\nde la plantación complementaria a densidades variables de 600 plantas/ha para acelerar el\nproceso de repoblación e impedir la regeneración de Pino, esta acción también podría ser\ncomplementada por siembra directa de semillas de lenga.\nPara dar proteccion a las plantas establecidas se propone la protección de ellas con ramas\nde pino contorta, de manera que estas no se vean afectadas. La propuesta considera la\ncorta progresiva de pino una vez que se vayan consolidando las áreas con nuevas plantas\nde lenga.\nDada la antigüedad de las plantaciones de pino se debe considerar que este trabajo de\nrestauración a nativo es un trabajo de largo aliento. Aun cuando es posible que no se logre\nerradicar nunca el 100% del pino presente en los predios se propone el control anual y\nreiterado de plántulas de pino, para mejorar los resultados del plan de conversión,\nconsiderando además que en las propiedades vecinas hay más presencia de plantaciones\n17\nde Pino contorta que son y serán fuente continua de semillas de pino, dado que se\ndispersan por viento. Esta situación releva la importancia de restaurar y dar pronta\ncobertura a los suelos descubiertos, con el objetivo de impedir la repoblación de pino.\nLa acción de dejar maderas muertas favorece la biología y diversidad del ecosistema y\nayuda, por lo tanto, a la restauración. Esta es una acción que se deberá complementar con\nel uso de parte de la madera y ramas para la construcción de obras de conservación de\nsuelos en el caso de las áreas con procesos erosivos.\n8.1.- Propuestas específicas de plan de conversión de plantación – bosque\nnativo\nEn base a la estrategia definida anteriormente y la caracterización realizada de las\nplantaciones es que se propone el siguiente plan de restauración para cada situación\nidentificada:\n• Situación A: Matriz de pino contorta con individuos de lenga\nSuperficie estimada: 12 ha\nAcciones propuestas: corta de faja de 5 a 10 mt entorno a los núcleos de lenga para\nreforestar con plantas de lenga a 1.500 pl/ha y sembrar. Protección de plantas contra liebres\ncon ramas de pino.\n• Situación B: Matriz de lenga con individuos de pino contorta\nSuperficie estimada: 4 ha\nAcciones propuestas: Corta de liberación, reforestación con plantas de lenga y siembra,\nprotección contra liebres con ramas de pino.\n• Situación C: Solo pino\nSuperficie estimada: 8 h\nAcciones Propuestas: Corta de pino para generación de pequeños claros de 15 metros de\ndiámetro (180 – 200 m2), reforestación con plantas de lenga y siembra, protección contra\nliebres con ramas de pino.\n8.2.- Análisis de la oferta de plantas\nPara establecer el nuevo bosque nativo se requiere disponer de plantas de lenga (N.\npumilio) idealmente de procedencias locales. A una densidad de 1.500 pl/ha, en términos\nde cálculo preliminar se necesitarían una cantidad aproximada de 300.000 plantas, este\nvalor podría reducirse si se logra el establecimiento de plantas a partir de siembras directas\no promoviendo la regeneración natural. Por esta razón además de solicitar cotizaciones de\nplantas en los viveros de la zona se está averiguando respecto de la posibilidad de adquirir\nsemilla de lenga (N. pumilio). Este valor se ha estimado en forma temporal esperando la\nrespuesta de los viveros consultados en la región.\n8.3.- Aproximación de costos asociados al plan de restauración\nEl carácter de aproximación al valor real se debe a que se considera necesario realizar un\nanálisis más detallado de las áreas descubiertas de vegetación a restaurar. Este trabajo se\nrealizará entre los años 2025 y 2027, este diagnóstico incluirá una zonificación para\ncaracterizar las diferentes situaciones y establecer un valor por hectárea de costo de\nrestauración, la programación de actividades y presupuestos anuales asociados.\n18\nEn la etapa de diagnóstico y planificación se considera elaborar una zonificación de la\nrestauración según las diferentes condiciones que se presentan en el terreno y la\noportunidad en que se realizarán las actividades de restauración.\nSe presenta en esta sección una estimación preliminar de los costos asociados al plan, esta\nserá completada y afinada una vez se consolide la propuesta y las acciones asociadas.\nTabla N°5: Carta Gantt de actividades planificadas.\nEn los tres primeros años se pretende realizar completamente el diagnóstico y planificación\ny comenzar con las acciones de implementación de la restauración como compra de\nplantas, semillas y las primeras intervenciones de plantaciones de pino. Esos tres primeros\naños ya cuentan con financiamiento y corresponde a las columnas pintadas en verde en la\ntabla N°6.\nTabla N°6: Estimación preliminar de costos asociados a las diferentes acciones propuestas con una\nplanificación a 10 años en las propiedades de FRC (Lote A y Lote B).\n19\n9.- Conclusiones y próximos pasos\n• Debido al carácter invasivo del pino contorta (P. contorta), se requiere trabajar en\nforma suave para abrir el dosel para promover el desarrollo de lenga (N. pumilio)\n(semi-tolerante a la sombra) sin promover también el desarrollo de pino contorta (P.\ncontorta) que es muy intolerante a la sombra.\n• Dados los bajos volúmenes y la heterogeneidad de las plantaciones de pino se\nrecomienda el uso de la madera como leña, postes para cercos y construcción de\nestructuras para el control de erosión como empalizadas y diques, de esta forma se\npodrá detener los procesos erosivos y fomentar la cobertura vegetal. Adicionalmente\nse propone dejar madera en el piso del bosque madera para promover la\nbiodiversidad y biología del suelo.\n• Por otra parte, se propone el uso de ramas de deshecho para la formación de\ntrincheras de protección para las plantas de lenga (N. pumilio) o notro (E.\ncoccineum) que se plantarán en los predios, con el objetivo de dar protección a las\nplantas frente al ataque de liebres. De esta forma se evitará el gasto en adquisición,\ninstalación y retiro de shelter, que además son de gran impacto visual y ambiental.\n• Se propone establecer un pequeño programa de voluntariado para hacer el control\nmecánico de las plantas de pino que están poblando las zonas abiertas\nespecialmente cerca del rio Blanco y la carretera austral y otras actividades que son\nde bajo riesgo como la protección de plantas con trincheras de ramas, y la\nplantación.\n• Se estima que este plan de restauración debiera tener un horizonte de largo plazo\nmínimo unos 80 años, dado que el ciclo (rotación) de la lenga se estima en unos\n200 años. Sin embargo, el total de las acciones podría completarse en 10 años, aun\ncuando no es tiempo suficiente para evaluar los resultados.\n• Para iniciar las acciones del plan de conversión de Pino a boque nativo se requiere\npresentar en Conaf los estudios técnicos correspondientes estos son los Planes de\nManejo de Plantaciones Forestales.\n• Se espera que este plan restauración de bosque nativo, sea el piloto que se requiere\npara extender la restauración al Parque Nacional Cerro Castillo y al resto de la\nRegión de Aysén.\n20\n10.- Bibliografía\nCastillo, J. y Moreno, G. 2002. Semillas forestales del bosque nativo Chileno. Ed\nUniversitaria. Chile. 241 p.\nChilebosque. 2016. Ficha de descripción de Nothofagus pumilio. Acceso en línea\nhttp://www.chilebosque.cl\nDonoso, C. 1981. Tipos Forestales de los Bosques Nativos de Chile. Documento de Trabajo\nNº 83. Investigación y Desarrollo Forestal (CONAF, PNUD-FAO) (Publicación FAO Chile).\n78 p.\nDonoso, C. 1994. Bosques templados de Chile y Argentina. Variación, Estructura y\nDinámica. Ecología Forestal. Editorial Universitaria. 483 p.\nJames E. Lotan 1990. Facultad de Ciencias Forestales, de la Vida Silvestre y de los\nPastizales de la Universidad de Idaho, Moscú, ID; y William B. Critchfield, genetista de la\nEstación Experimental de Bosques y Pastizales del Pacífico Suroeste, Berkeley, CA., que\naparece en Burns, Russell M. y Barbara H. Honkala, coords. técnicas. 1990. Silvics of North\nAmerica: 1. Conifers. Agriculture Handbook 654. Departamento de Agricultura de los\nEstados Unidos, Servicio Forestal, Washington, DC. vol. 1, 675 pág.\nFuentes N., Sánchez, P., Pauchard, A., Urrutia,J. , Cavieres, L., Marticorena, A. (2014).\nPlantas Invasoras del Centro-Sur de Chile: Una Guía de Campo. Laboratorio de Invasiones\nBiológicas (LIB), Concepción, Chile.\nMuñoz, 2013. Evaluación de tratamientos silvícolas en Pinus contorta Douglas Ex Loudon\nvar. latifolia Engelm ex S. Watson. En la R. N. Coyhaique, Región del General Carlos\nIbañez Del Campo. Memoria de titulo de Ingeniería Forestal.\nOrmazabal, P. y Benoit, C. 1987. El estado de conservación del género Nothofagus en\nChile. Bosque 8(2): 109-120.\nPromis, A. 2025. Comunicación Personal.\nRodriguez, R; Matthei, S y Quezada, M. 1983. Flora arbórea de Chile. Editorial de la\nUniversidad de Concepción – Chile. 355 p.\nSanhueza, P. 2020. En Informe particular. Cuantificación y ubicación de plantaciones\nforestales en unidades del SNASPE de las regiones de Los Lagos, Aysén y Magallanes.\nSchmidt, H. y Uuzua, A. 1982. Transformación y manejo de los bosques de Lenga en\nMagallanes. Universidad de Chile, Facultad de Ciencias Agrarias, Veterinarias y Forestales,\nDepartamento de de Silvicultura y Manejo. Santiago, Chile. Ciencias Agrícolas Nº 11. 62 p.\n21', 'description': None, 'parent_drive_file_id': '1TrM2A2nq27dzRbhr_E0cE72z8A_ObUZr', 'children': []}, {'id': '2192648a-b4ae-4329-aa40-ca5c07a165a9', 'drive_file_id': '1XLpnxnHwpOAxaPF0YqPR-PP7rBSPYbvG', 'name': 'Gestión Planes de Manejo', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1XLpnxnHwpOAxaPF0YqPR-PP7rBSPYbvG', 'modified_time': datetime.datetime(2026, 6, 30, 16, 18, 59, 186000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1TrM2A2nq27dzRbhr_E0cE72z8A_ObUZr', 'children': [{'id': '610f5dd7-c793-4b0c-9561-93d6c8d4d27a', 'drive_file_id': '1cbx7L0hdrXtkQ5Muofn2o4ZD_R50yy4E', 'name': 'Comprobante ingreso PMPF 06.26.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1cbx7L0hdrXtkQ5Muofn2o4ZD_R50yy4E/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 14, tzinfo=datetime.timezone.utc), 'text_content': 'COMPROBANTE DE INGRESO\nNo 109\n11 de Junio de 2026\nLa Solicitud Nº 105/32-112/26 presentada a la Corporación Nacional Forestal con fecha 11 de Junio de 2026, respecto del predio\nLOTE A LAS HORQUETAS, rol de avalúo No 1043-71, de la Comuna de Coihaique, mediante la cual solicita la tramitación de\nla solicitud de PLAN DE MANEJO PLANTACIONES FORESTALES, para una superficie de 16.7 (ha) ha sido ingresada.\nLos antecedentes entregados a la Corporación junto a la solicitud, son los siguientes:\nFOTOCOPIA SIMPLE DEL RUT PERSONA JURÍDICA, CÉDULAS DE IDENTIDAD DEL (LOS) PROPIETARIO(S),\nREPRESENTANTES LEGALES O DEL POSEEDOR EN TRÁMITE DE SANEAMIENTO\nCOPIA DE INSCRIPCIÓN DE DOMINIO DEL PREDIO, CON CERTIFICADO DE VIGENCIA (NO MAYOR A 120 DÍAS\nHÁBILES)\n1 COPIAS DE AUTORIZACIÓN INGRESO PREDIO\n1 COPIAS DE CARTOGRAFIA DIGITAL GEOREFERENCIADA RECEPCIONADA VIA PEN DRIVE\n4 COPIAS DE SOLICITUD PLAN MANEJO PLANTACIONES FORESTALES DL 701/1974\n3 COPIAS DE ESTUDIO TECNICO PLAN MANEJO PLANTACIONES FORESTALES DL 701/1974\n1 COPIAS DE CERTIFICADO DE VIGENCIA PERSONA JURIDICA SIN FINES DE LUCRO DEL PREDIO\n1 COPIAS DE CERTIFICADA DE DIRECTORIO PERSONA JURIDICA SIN FINES DE LUCRO DEL PREDIO\n1 COPIAS DE REDUCCIÓN A ESCRITURA PÚBLICA. REPERTORIO N° 418-2024. LLANQUIHUE. 10 DE FEBRERO 2026\nDEL PREDIO\n1 COPIAS DE REDUCCIÓN A ESCRITURA PÚBLICA. REPERTORIO N° 1178-2024. LLANQUIHUE. 3 DE MARZO 2026 DEL\nPREDIO\n1 COPIAS DE CERTIFICADO DE AVALÚO FISCAL DE LA PROPIEDAD ROL 1043-71\nEl ingreso de esta solicitud se encuentra exenta de pago.\n____________________________________________\np. CORPORACION NACIONAL FORESTAL', 'description': None, 'parent_drive_file_id': '1XLpnxnHwpOAxaPF0YqPR-PP7rBSPYbvG', 'children': []}]}]}, {'id': 'ba1869da-f23b-4e59-9e3e-b2fd6fdaa934', 'drive_file_id': '1IN8ZJZYtTbtMIuqRQ4oBgkhS6lihkNFN', 'name': 'Restauración Cabo Froward', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1IN8ZJZYtTbtMIuqRQ4oBgkhS6lihkNFN', 'modified_time': datetime.datetime(2026, 6, 30, 16, 18, 57, 922000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1LbHRXG-eyEOE3e7KC4XyiB83VhaTrmOS', 'children': [{'id': '349b66b4-fb47-4f65-ab3e-6d3ac0759cb0', 'drive_file_id': '18LMtotWADBv25YNwJV9cvs13tSkdx3IQ', 'name': 'Informes expediciones', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/18LMtotWADBv25YNwJV9cvs13tSkdx3IQ', 'modified_time': datetime.datetime(2026, 6, 30, 16, 18, 59, 209000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1IN8ZJZYtTbtMIuqRQ4oBgkhS6lihkNFN', 'children': [{'id': 'f03445ec-c281-47e4-9d7d-e0f39e0ef8a8', 'drive_file_id': '1jylo4pL_K0rwOzFYJQXzq4lDmhkJIApU', 'name': 'INFORME EXPEDICIONES RESTAURACIÓN III y IV 300724.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1jylo4pL_K0rwOzFYJQXzq4lDmhkJIApU/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 17, tzinfo=datetime.timezone.utc), 'text_content': 'INFORME EXPEDICIONES III Y IV\nRESTAURACION DE BOSQUES NATIVOS\nCabo Froward, Península Brunswick,\nRegión de Magallanes\nJosé Suárez y Lorena Valenzuela\nJulio, 2024.\nÍNDICE\nI. INTRODUCCIÓN 3\nII. OBJETIVOS EXPEDICIONES 4\nIII. METODOLOGÍA 5\n3.1. Expedición III – Colecta de estaquillas\n5\n3.2. Expedición IV – Almacenamiento de C en los ecosistemas boscosos y de\n10\nturberas\n3.3. Instalación sensores de humedad y temperatura 16\n3.4. Toma de muestras ADN Ambiental 17\nIV. AVISTAMIENTO Y REGISTRO DE AVES Y MAMÍFEROS MARINOS 19\nV. RESULTADOS PRELIMINARES Y CONCLUSIONES 23\nVI. ANEXOS 24\n2\nI. INTRODUCCIÓN\nCabo Froward, corresponde al punto continental más austral de América y destaca por ser un punto\nde encuentro de las aguas de Pacífico, Atlántico y Antártico lo que genera una enorme diversidad de\ncondiciones ambientales tanto terrestres como marinas.\nLas tierras, se encuentran en su mayor parte, cubiertas por bosques y túrbales. La especie dominante\nde estos bosques son coihue de Magallanes (Nothofagus betuloides) y canelo (Drimys winteri). Sobre\nel límite arbóreo se desarrolla un bosque achaparrado de lenga y ñirre y una estepa húmeda. Es\nimportante destacar la presencia de la especie arbórea Ciprés de las Guaitecas (Pilgerodenron\nuviferum) especialmente en las turberas, considerada la conífera más austral del mundo, catalogada\npor la IUCN como Vulnerable, e incluida en el Apéndice 1 de CITES.\nEl Programa de Restauración, como parte del trabajo de terreno requiere de la realización de diversas\ncampañas de terreno (expediciones) durante el año. Es por esto que durante este primer semestre se\nhan realizado dos expediciones, la primera en el mes de marzo y la segunda en el mes de mayo.\nLas expediciones se realizaron en la costa de la Península de Brunswick a bordo de la Motonave\nHuracán, en terrenos privados adquiridos por la Fundación Rewilding Chile y en terrenos del actual\nBien Nacional Protegido Cabo Froward.\nAmbos equipos estuvieron conformados por profesionales de la Fundación Rewilding Chile y la\nUniversidad de Chile. En la expedición de marzo participaron ayudantes especializados para la colecta\nde estaquillas de Ciprés de la Guaitecas y en la expedición de mayo participaron académicos y\nestudiantes de la U. de Chile.\nFigura 1. Vista áreas Bahía Cordés, propiedad Fundación Rewilding Chile.\n3\nII. OBJETIVOS EXPEDICIONES\nPara la expedición III realizada en marzo los objetivos planteados fueron:\n- Recolección de germoplasma de Ciprés de la Guaitecas para la futura producción de plantas\npara el Programa de Restauración a realizarse en Cabo Froward.\n- Toma de muestras de agua y suelo para la estimación de biodiversidad en Cabo Froward,\nmediante el análisis de ADN ambiental.\n- Revisión de estado fenológico (estado del proceso de maduración de frutos) de Ciprés de\nlas Guaitecas (P. uviferum) para recolección de semillas.\n- Identificación de futuras áreas para Restauración a través de forestación y otras actividades.\n- Revisión de trampas de colecta de semillas.\nLa expedición IV realizada el mes de mayo sus objetivos fueron:\n- Realizar ensayos de metodologías para toma muestras para el almacenamiento de C en los\necosistemas boscosos y de turberas.\n- Determinar profundidades de distintos tipos de turberas y en distintas condiciones\ngeográficas.\n- Identificar y describir las distintas turberas presentes en el futuro parque nacional.\n- Identificar futuras áreas para la toma muestras para el almacenamiento de C en la próxima\nexpedición.\n- Prospección y avistamiento de fauna asociada los ecosistemas del futuro parque nacional.\n- Revisión de trampas de colecta de semillas y monitoreo de estados fenológicos.\nFigura 2. Vista área sector Bahía Cordés.\n4\nIII. METODOLOGÍA\n3.1. Expedición III – Colecta de estaquillas\n- Área de trabajo\nPara cumplir los objetivos planteados se recorrió la costa de la Península de Brunswick desde el sector\ndesde el BNP Cabo Froward hasta límite noreste de la propiedad de la Fundación, en el sector de\nBahía Cordés. Específicamente se recorrieron la costa suroeste de la Península de Brunswick,\nespecíficamente en el BNP Cabo Froward: Bahía San Nicolás, Bahía El Águila, Río Yumbel y en la\npropiedad de la Fundación Rewilding Chile: Cruz de los Mares y Bahía Cordés. En este último punto\ntambién se exploró la propiedad de interés de Poduje aledaña a la propiedad de la Fundación.\nEn cada sector se colectó puntos de muestreo con GPS de cada lugar muestreado. Además, se\nrealizaron una serie de vuelos de dron para captura de imágenes y videos y se tomaron fotos\nterrestres del trabajo realizado en terreno.\nFigura 3. Áreas exploradas en la expedición III.\n5\n- Metodología de trabajo y caracterización de los sectores\nPara la Expedición III, se reunió un grupo de ayudantes especializados de la Universidad de Chile, que\nen conjunto con José Suarez y Lorena Valenzuela hicieron de colecta de germoplasma. Como primera\nparte se realizó una pequeña inducción a los participantes en relación al objetivo y forma de la colecta.\nSe obtuvieron estaquillas semi-leñosas de unos 10 a 20 cm, con un grosor desde 0,4 mm hasta 0,8\nmm aproximadamente. Luego se preparó la estaquilla donde se elimina una parte de las acículas para\nfavorecer el enraizamiento de las estaquillas y evitar la deshidratación de ésta en el proceso de\nenraizamiento. Posteriormente, una vez que las estaquillas estuvieron listas, fueron dispuestas en\ncontenedores especializados para mantener su hidratación.\nEn total se recolectaron aproximadamente 6.000 estaquillas de ciprés de las Guaitecas (P. uviferum)\npara ser viverizadas en las instalaciones del Vivero Monte Nativo en El Amarillo, Región de Los Lagos,\ny que serán utilizadas en las áreas de restauración del futuro parque nacional Cabo Froward.\nTambién se realizó prospección y avistamiento de fauna asociada los distintos ecosistemas, la revisión\nde trampas de colecta de semillas instaladas en enero del presente año y monitoreo de estados\nfenológicos de las diversas especies arbóreas presentes.\nFigura 4. Trabajo en colecta de estaquillas de Ciprés de las Guaitecas.\n6\nFiguras 5 y 6. Coleta de estaquillas de ciprés de la Guaitecas en Cabo Froward.\nLos sectores donde se hizo colecta de germoplasma, corresponden en general a matrices de turbera\narbórea, con ejemplares adultos de Ciprés de las Guaitecas (P. uviferum) y abundante regeneración\nnatural. Otros sectores trabajados corresponden a turberas de tipo arbórea con ejemplares de Ciprés\nde Las Guaitecas (P. uviferum) y Coihue de Magallanes (N. betuloides). Algunas áreas presentan signos\nde incendios pasados, lo que demuestra que estas áreas fueron explotadas anteriormente. El\nsotobosque estaba conformado por principalmente por especies arbustivas como romerillo\n(Chiliotrichum diffusum), michay (Berberis darwinii) y chaura (Gaultheria antarctica).\nFigura 7. Área de colecta de estaquillas en BNP Cabo Froward.\n7\nFigura 8 Área de colecta de estaquillas en BNP Cabo Froward.\nFigura 9. Área de colecta en Bahía Cordés.\n8\n- Equipo participante de la expedición\nEl equipo participante en esta expedición estivo compuesto por José Suárez asesor del Programa de\nRestauración de la Fundación (encargado Expedición y trabajo técnico) y Lorena Valenzuela\n(encargado Expedición y trabajo técnico-operaciones), cómo ayudantes especializados para la colecta\nde estaquillas de Ciprés de las Guaitecas (P.uviferum) estuvieron Martin Cornejo, Martin Vega,\nMontserrat Aldea y Alonso Rosales.\nRespecto de la tripulación de la embarcación Huracán nos acompañaron Hugo Cárdenas, capitán, y\nsu tripulación, Patricio Cárdenas, Heladio Melipillan, Oscar Cárdenas, Nicolás Cárdenas y Víctor Ojeda.\nFigura 10. Equipo expedición de Restauración III – colecta de estaquillas.\n9\n3.2. Expedición IV – Almacenamiento de C en los ecosistemas boscosos y de turberas.\n- Área de trabajo\nLa costa suroeste de la Península de Brunswick desde el sector desde el BNP Cabo Froward hasta\nlímite norte este de la propiedad de la Fundación, en el sector de Bahía Cordés, específicamente en\nlos sectores de bahía San Nicolás, bahía El Águila y bahía Cordés.\nEn cada sector se colectó puntos de muestreo con GPS de cada lugar muestreado. Además, se\nrealizaron una serie de vuelos de dron para captura de imágenes para construir luego ortofotos\nparciales de turberas muestreadas y hacer luego fotointerpretación en el resto del territorio. También\nse tomaron fotos terrestres del trabajo realizado en terreno.\nFigura 11. Áreas exploradas en la Expedición IV.\n- Metodología y descripción de trabajo\nLa propuesta metodológica proporciona un enfoque integral para el estudio, abordando tanto el\nmapeo de coberturas vegetales como la estimación del almacenamiento de carbono, para lo cual se\nrealizaron inventarios en bosques, midiendo altura y diámetro a la altura del pecho (DAP) a los\nárboles, junto con hacer una descripción de la parcela inventariada.\nPara el caso de los distintos tipos de turberas visitados, se caracterizaron, se midieron varias\nprofundidades y en distintas condiciones geográficas, y se tomaron muestras de suelo. Todo esto para\nla calibración de métodos de caracterización de turberas en terreno, diseño de muestreo en función\n10\nde la superficies y tipología evaluadas, entre otras, para la medición de almacenamiento de Carbono\ny evaluación de superficies de las coberturas vegetaciones dominantes y los distintos tipos de turberas\nen el futuro PN Cabo Froward.\nPor otro lado, también se realizó prospección y avistamiento de fauna asociada los ecosistemas del\nfuturo parque nacional y la revisión de trampas de colecta de semillas y monitoreo de estados\nfenológicos.\nFiguras 12 y 13. Toma de muestras y determinación de profundidad en una turbera.\n11\nFiguras 14, 15, 16 y 17. Levantamiento de información en los distintos bosques presentes en Cabo Froward.\n12\nEn relación a los tipos de tuberas muestreadas corresponden a tuberas esfagnosas o de Sphagnum,\naquellas dominadas por cojines laxos del musgo Sphagnum magellonicum, los cuales pueden estar\nacompañados de otras briofitas, líquenes, juncos, arbustos o árboles enanos; Turberas graminoides,\ndominadas por especies graminoides, como Ciperácea Carex magellanica, Juncáceas como\nMarsipospermum grandiflorum, con una fisonomía de pradera. La vegetación dominante también\npuede estar asociada con briofitas, líquenes y algunos árboles dispersos. Además, se encuentran\nindividuos aislados de árboles como coihue de Magallanes (N. betuloides) y ciprés de las Guaitecas (P.\nuviferum) y por último, turberas pulvinadas, son aquellas dominadas por plantas que crecen en forma\nde cojines compactos y duros como Donatia fascicularis y Astelia pumila, también pueden estar\nasociadas con otras especies de briofitas, herbáceas o arbustivas1.\nFiguras 18. Turbera pulvinada en bahía San Nicolás.\n1 Domínguez, E. y D. Vega-Valdés (eds.). 2015. Funciones y servicios ecosistémicos de las turberas en Magallanes. Colección\nde libros INIA Nº 33. Instituto de Investigaciones Agropecuarias. Centro Regional de Investigación Kampenaike. Punta\nArenas, Chile. 334 pp.\n13\nFigura 19. Turbera esfagnosas en bahía San Nicolás.\nFigura 20. Turbera graminoidea en bahía Cordés.\n14\n- Equipo participante de la expedición\nJosé Suárez (encargado Expedición y trabajo técnico), Lorena Valenzuela (encargado Expedición y\ntrabajo técnico-operaciones), y los académicos del Dpto. de Silvicultura y Conservación de la\nNaturaleza: Eduardo Martínez (Profesor asistente, especialidad Suelo, Agua, Planta), Carlos Magni\n(Profesor asociado, especialidad Genética Forestal), y del Dpto. de Gestión Forestal y Medio\nAmbiente: Cristian Estades (Profesor titular, especialidad Fauna Silvestre), Jaime Hernández (Profesor\ntitular, especialidad Geomática y Ecología del Paisaje), Valentina González Castro (Asistente de\ninvestigación del Laboratorio de Geomática y Ecología del Paisaje) y Javier Hernández (Memorante\ntesis de pregrado).\nRespecto de la tripulación de la embarcación Huracán nos acompañaron Hugo Cárdenas, capitán, y\nsu tripulación, Oscar Cárdenas, Patricio Cárdenas, Víctor Ojeda y Heladio Melipillan.\nFigura 21. Equipo participante de la Expedición IV y tripulación de la embarcación Huracán.\n15\n- Instalación sensores de humedad y temperatura\nDurante la expedición IV se instalaron sensores de medición de humedad y temperatura como prueba\npiloto en diferentes ambientes en zonas abiertas (turberas), semicerrado (transición turbera-\nbosques) y bosques (cerrado). Cuyo objetivo es monitorear y registrar condiciones ambientales en\ndistintos tipos de ambientes (revisar grabación en carpeta de José Suarez). Estos dispositivos cuentan\ncon registrador (data logger) que está conectado a una sonda que es la que mide temperatura y\nhumedad cada 1 hora. Con estos datos se podrá posteriormente hacer un análisis de las condiciones\nclimáticas del sector y su relación en el tiempo.\nFigura 22,23 y 24. Instalación de sensores para medición de temperatura y humedad dentro del futuro PN\nCabo Froward\n16\n- Toma de muestras ADN Ambiental\nLa Fundación en sus esfuerzos de monitorear y caracterizar vida silvestre en el futuro PN Cabo\nFroward, ha decidido complementar el trabajo realizado a la fecha través de la incorporación del\nanálisis de ADN ambiental. El ADN ambiental, está referido al material genético libre que puede ser\nrecuperado desde la matriz ambiental (agua, suelo, sedimento, nieve, entre otros). El ADN proviene\nde una variedad de organismos en diferentes fuentes ambientales, las cuales van desde secreciones\ncorporales (sangre, mucus, propágulos reproductivos, excreciones, desechos celulares, cabello,\ntejido), o desde microorganismos, incluyendo el material genético como moléculas libres de ADN.\nEl material de ADN ambiental se colectó en terreno durante la Expedición III, siguiendo las\ninstrucciones del protocolo de toma de muestras entregado por la empresa ECOGEN, a quien se le\nmandató el servicio. En total se colectaron 9 muestras, 5 correspondientes a matrices ambientales de\nsuelo y 4 a matrices ambientales de agua. Estas muestras serán posteriormente procesadas en el\nlaboratorio de Ecogen.\nLos resultados de este material genético complementarán la información que está recopilando a\ntravés de las distintas expediciones del programa Restauración y Vida Silvestre que se han realizado.\nFiguras 25 y 26. Toma de muestras de ADN ambiental durante la Expedición III.\n17\nFigura 27. Toma de muestras de ADN ambiental durante la Expedición III.\n18\nIV. AVISTAMIENTO Y REGISTRO DE AVES Y MAMÍFEROS\nDurante ambas expediciones realizadas en marzo y mayo, respectivamente, a bordo de la M/N\nHuracán, se realizaron observaciones y registros de aves y mamíferos durante los trayectos de\nnavegación, siempre y cuando las condiciones climáticas lo permitieron. Las observaciones se\nrealizaron desde el puente de mando o desde la cubierta y con el apoyo de binoculares de 15x56. En\ntotal, se registraron 38 avistamientos de aves (Tabla 1) de 25 especies diferentes y 5 avistamientos\nde mamíferos (terrestres y marinos) de un total de 3 especies diferentes (Tabla 2). En este último\navistamiento, destaca el registro de un huemul macho juvenil, bastante curioso, que se acercó a\npocos metros del equipo. Podría tratarse un macho en probable dispersión, de acuerdo a lo indicado\npor Cristian Saucedo.\nTabla 1. Registro de avistamientos de mamíferos (terrestres y marinos), con un total de 5 avistamientos y\n3 especies diferentes.\nNo FECHA NOMBRE COMÚN NOMBRE CIENTÍFICO LUGAR\n1 17.03.24 Delfín austral Lagenorhynchus australis Bahía San Nicolás\n2 08.05.24 Huemul Hippocamelus bisulcus Bahía Cordés\n3 09.05.24 Huemul Hippocamelus bisulcus Bahía Cordés\n4 10.05.24 Delfín austral Lagenorhynchus australis Bahía San Nicolás\n5 10.05.24 Zorro Lycalopex culpaeus Bahía Bouganville\nFigura 28. Ejemplar de huemul avistado en Bahía Cordés.\n19\nFigura 29. Mismo ejemplar de huemul avistado al día siguiente en Bahía Cordés al lado de la motonave\nHuracán.\nFigura 30. Registro de zorro culpeo en Bahía Boungaville.\n20\nTabla 2. Registro de avistamientos de aves marinas, con un total de 38 avistamientos y 25 especies diferentes.\nNo FECHA NOMBRE COMÚN NOMBRE CIENTÍFICO LUGAR\n1 15.03.24 Rayadito Aphrastura spinicauda Bahía Cordés\n2 15.03.24 Becacina Gallinago magellanica Río Yumbel\n3 17.03.24 Petrel gigante antártico Macronectes giganteus Estrecho de Magallanes\n4 17.03.24 Albatros de ceja negra Thalassarche melanophris Estrecho de Magallanes\n5 17.03.24 Petrel plateado Fulmarus glacialoides Estrecho de Magallanes\n6 18.03.24 Martin pescador Megaceryle torquata Bahía Cordés\n7 18.03.24 Tordo Curaeus curaeus Bahía Cordés\n8 18.03.24 Halcón peregrino Falco peregrinus Bahía Cordés\n9 18.03.24 Caranca Chloëphaga hybrida Bahía Cordés\n10 18.03.24 Cormorán imperial Leucocarbo atriceps Bahía Cordés\n11 18.03.24 Rayadito Aphrastura spinicauda Bahía Cordés\n12 18.03.24 Pato quetru no volador Tachyeres pteneres Bahía Cordés\n13 18.03.24 Pinguino de Magallanes Spheniscus magellanicus Estrecho de Magallanes\n14 18.03.24 Pato juarjual Lophonetta specularioides Bahía Cordés\n15 07.05.24 Cachaña Enicognathus ferrugineus Bahía Bougaville\n16 07.05.24 Rayadito Aphrastura spinicauda Bahía Bougaville\n17 07.05.24 Churrin del sur Scytalopus magellanicus Bahía Bougaville\n18 07.05.24 Jilguero Spinus barbata Bahía Bougaville\n19 07.05.24 Diucón Xolmis pyrope Bahía Bougaville\n20 07.05.24 Cachudito Anairetes parulu Bahía Bougaville\n21 07.05.24 Comecebo Pygarrhichas albogularis Bahía Bougaville\n22 07.05.24 Cometocino Phrygilus gayi Bahía Bougaville\n23 08.05.24 Rayadito Aphrastura spinicauda Bahía Cordés\n24 08.05.24 Picaflor Sephanoides sephanoides Bahía Cordés\n25 08.05.24 Pato juarjual Lophonetta specularioides Bahía Cordés\n26 08.05.24 Cormorán imperial Leucocarbo atriceps Bahía Cordés\n27 08.05.24 Colilarga Sylviorthorynchus desmursii Bahía Cordés\n28 08.05.24 Comecebo Pygarrhichas albogularis Bahía Cordés\n29 08.05.24 Rayadito Aphrastura spinicauda Bahía Cordés\n30 08.05.24 Cometocino Phrygilus gayi Bahía Cordés\n31 09.05.24 Martin pescador Megaceryle torquata Bahía Cordés\n32 09.05.24 Caranca Chloëphaga hybrida Bahía Cordés\n33 09.05.24 Tordo Curaeus curaeus Bahía Cordés\n34 09.05.24 Churrete Cinclodes patagonicus Bahía Cordés\n35 09.05.24 Cometocino Phrygilus gayi Bahía Cordés\n36 09.05.24 Rayadito Aphrastura spinicauda Bahía Cordés\n37 09.05.24 Gaviota dominicana Chroicocephalus cirrocephalus Bahía Cordés\n38 10.05.24 Pato juarjual Lophonetta specularioides Bahía San Nicolás\n21\nFiguras 31, 32, 33 y 34. Registro de aves observadas en las expediciones. De izquierda a derecha: tordo\n(Curaeus curaeus), caranca (Chloëphaga hybrida), Pato juarjual (Lophonetta specularioides) y Cometocino\n(Phrygilus gayi) y Halcón peregrino (Falco peregrinus).\n22\nV. RESULTADOS PRELIMINARES Y CONCLUSIONES\n- Los principales resultados obtenidos en estas dos expediciones tienen relación con la\nobtención de material vegetativo para propagación de Ciprés de las Guaitecas por un total\naproximado de 5.000 estaquillas. Estas se encuentran actualmente en proceso de\nenraizamiento en invernadero y estarán aptas para ser utilizadas en un par de temporadas\npor el programa de Restauración de Cabo Froward.\n- Por otra parte, se pone a prueba la metodología de estimación de C acumulado en turberas y\nbosques de Cabo Froward para hacer el trabajo de muestreo en una futura campaña de\nterreno y poder lograr una estimación de la acumulación del C en los diferentes tipos de\necosistemas terrestres.\n- Se avanza también la caracterización y levantamiento de información de terreno estos\necosistemas (inventario forestal, caracterización de bosques y turberas y toma de imágenes\náreas con dron).\n- Se logra el primer avistamiento y registro de un huemul en la zona de Cabo Froward por un\nequipo de la Fundación Rewilding Chile, específicamente en Bahía Córdes, en la propiedad\nrecién adquirida por la Fundación. En primera instancia el avistamiento fue realizado por el\nacadémico Cristian Estades, y luego por todo el equipo. El huemul se encontraba en buen\nestado corpóreo y corresponde a un macho juvenil.\n- Destaca la gran cantidad de avifauna observada, como las aves marinas costeras, aves\npelágicas y aves de bosque. En total se registraron 38 avistamientos de aves (Tabla 1) de 25\nespecies diferentes y 5 avistamientos de mamíferos (terrestres y marinos) de un total de 3\nespecies diferentes (Tabla 2).\n23\nVI. ANEXOS\n- Bitácora de viaje Expedición III\n24\n1\n2\n3\n4\n5\n6\n7\nD ÍA\nJu e v e s\nV ie rn e s\nS á b a d o\nD o m in g o\nL u n e s\nM a rte s\nM ie rc o le s\nF\n1\n1\n1\n1\n1\n1\n2\nE\n4\n5\n6\n7\n8\n9\n0\nC H\n-m\n-m\n-m\n-m\n-m\n-m\n-m\nA\na r\na r\na r\na r\na r\na r\na r\nA C T IV ID A D E S\nE m b a rq u e a la s 2 2 h rs.\nZ a rp e a la s 7 h rs a m p a ra lle g a r a B a . Á g u ila d o n d e h ic im o s la p rim e ra b a ja d a . Lle g a m o s a la s 1 9 h rs a la la n c h a . S e to m a ro n\nla s m u e sn tra s d e A D N d e a c u e rd o a lo c o n v e n id o c o n E c o g e n . A v a n za m o s h a c ia b a h ía e sc o n d id a p a ra e l tra b a jo d e l d ía\nsig u ie n te .\nD e se m b a rc a m o s d e la la n c h a a la s 9 h rs p a ra ir a l se c to r d e e xp la n a d a e n e l se c to r d e B a . B u n g a v ille p a ra c o n su n ia r c o n e l\ntra b a jo d e re c o le c c ió n d e e sta c a s. V o lv e m o s a la e m b a ra c ió n a la s 1 8 h rs.\nP e rc o n ta m o s e n B a . B u n g a v ille p a ra tra b a ja r e n e l m ism o se c to re d e l d ía a n te rio r, y a q u e e s u n b u e n se c to r p a ra c o le c ta d e\ne sta c a s, y a q u e á rb o le s jo v e n e s e n b u e n e sta d o sa n ita rio . V o lv e m o s tip o 1 7 h rs a la la n c h a p a ra a v a n za r h a c ia B a . C o rd é s.\nLle g a m o s 2 3 h rs a l se c to r.\nD e se m b a rc a m o s d e la la n c h a a la s 9 h rs p a ra a la c o le c ta d e e sta c a s e n B a . C o rd é s, e n la p ro ie d a d d e la F u n d a c ió n .\nV o lv e m o s a la e m b a ra c ió n a la s 1 8 h rs.\nD e se m b a rc a m o s d e la la n c h a a la s 9 h rs p a ra a la c o le c ta d e e sta c a s e n o tro se c to r d e B a . C o rd é s, e n la p ro ie d a d d e la\nF u n d a c ió n . V o lv e m o s a la e m b a ra c ió n a la s 1 7 h rs.\nS e c o m ie n za e l re to rn o a B a h ía M a n sa p a ra e l d e se m b a rq u e .\n- Bitácora de viaje Expedición IV\n25\n1\n2\n3\n4\n5\n6\nM\nD ÍA\nL u n e s\nM a rte s\nie rc o le\nJu e v e s\nV ie rn e s\nS á b a d o\ns\nF E C H\n0 6 -m\n0 7 -m\n0 8 -m\n0 9 -m\n1 0 -m\n1 1 -m\nA\na y\na y\na y\na y\na y\na y\nA C T IV ID A D E S\nN o s e m b a rc a m o s a la s 1 6 h rs. S a lim o s a la s 1 7 h rs c o n d e stin o a B a h ía E sc o n d id a . F o n d e a m o s e n e ste lu g a r.\nE n B a h ía B o u n g a v ille su b im o s p o r la q u e b ra d a h a c ia la s tu re b ra s q u e e stá n c e rc a d e l se n d e ro . T ra b a ja m o s e n e sta á re a\nre a liza n d o p a rc e la s d e c a rb o n o e n b o sq u e , e v a lu a c io n d e la p ro n fu n d a d d e la s tu rb e ra s y to m a d e m u e stra s d e su e lo .\nLle g a m o s tip o 1 6 .3 0 h rs. A p ro v e c h a m o s e l b u e n c lim a y za rp a m o s d e in m e d ia to a B a h ía C ó rd e s.\nS a lim o s c o n d e stin o a lo s p u n to s d e fin ifo s p a ra la p a rte c e rc a n a a l río b e rn a b e . S e h a c e n d o s g ru p o , B o sq u e s y S u e lo .\nC ristia n E sta d e s a v ista u n h u e m u l e n la c o sta , a si q u e c u a n d o n o s b a ja m o s a tie rra , D ie g o y B e n ja m in se v a m a v e r e l h e m u l\np a ra o b te n e r m e jo re s re g istro s. E l re sto se v a a tra b a ja r e n p a rc e la s y to m a d e m u e stra s. C u a n d o v o lv im o s d e te rre n o , e l\nh u e m u l se g u ía e n la c o sta . N o s q u e d a m o s e n B a . C o rd e s e sa n o c h e .\nS e tra b a ja e n e l se c to r d e m a s a fu e ra d e B . C o rd e s p a ra la re a liza c ió n d e p a rc e la s, c a ra c te riza c ió n d e tu b e ra s y to m a d e\nm u e stra s. S e lle g a a la e m b a ra c ió n a la s 1 7 h rs. S e re to rn a a la e m b a rc a c ió n a 1 6 h o ra s, u n a v e z a h í c o m e n za m o se l v ia je a\nB a . B o u n g a v ille . LLe g a d a a lu g a r d e fo n d e o 2 0 h rs.\nA la s 9 .3 0 g rs d e sd e B a . B u n g a v ille n o s tra sla d a m o s a B a . S a n N ic o la s. E l e q u ip o su e lo s se q u e d ó e n la s tu rb e ra s y e l e q u ip o\nb o sq u e s a v a n zó h a c ia lo s b o sq u e s c e rc a n o s. T ra b a ja m o s h a sta la s 1 6 .3 0 h rs. E n la n o c h e p u d im o s a p re c ia r la e sp e c ta c u la r\na u ro ra a u stra l.\nR e to rn o a B a h ía M a n sa p a ra d e se m b a rq u e', 'description': None, 'parent_drive_file_id': '18LMtotWADBv25YNwJV9cvs13tSkdx3IQ', 'children': []}, {'id': '180d5b68-19d1-463f-99b3-84f86ce23a9e', 'drive_file_id': '12gLKByGh9KQzNC9niHo9qS438P-uUo-l', 'name': 'Informe Expedición 1 Restauración_26.10.23 (enviado).pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/12gLKByGh9KQzNC9niHo9qS438P-uUo-l/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 17, tzinfo=datetime.timezone.utc), 'text_content': 'EXPEDICION N°1 DE RESTAURACION DE BOSQUES NATIVOS\nCabo Froward, Península Brunswick\nInforme técnico\nInforme elaborado por: José Alfonso Suárez Bolaños, Consultora Monte Nativo Limitada.\nColaboradores: Benjamín Cáceres, Fundación Rewilding Chile\nPablo Sanhueza, Corporación Nacional Forestal\nJaime Hernández, Universidad de Chile\nLissette Cortés, Universidad de Chile\nValentina González, Universidad de Chile\nRevisores: Ingrid Espinoza, Fundación Rewilding Chile\nLorena Valenzuela de Fundación Rewilding Chile\n20 de octubre del 2023\nTabla de Contenido\nI. Introducción ..................................................................................................................................... 3\nII. Los bosques costeros templados lluviosos (Pisano, 1997) ............................................................... 4\na. Historia reciente de los bosques australes ............................................................................... 8\nIII. Objetivo General ............................................................................................................................ 11\nIV. Objetivos Específicos .................................................................................................................. 11\nV. Metodología de trabajo de terreno................................................................................................ 12\nVI. Descripción de sitios ................................................................................................................... 14\n1.- Bahía del Indio – Río Yumbel (P2) ................................................................................................. 14\ni. P2-1. Bosque de Coihue de Magallanes con Canelo. .............................................................. 15\nii. P2-2. Pradera. ......................................................................................................................... 17\niii. P2-3. Bosque de Coihue de Magallanes. ................................................................................ 17\n2.- Bahía Cordés (P3) .......................................................................................................................... 18\niv. P3-0. Turbera.......................................................................................................................... 21\nv. P3-1. Turbera con Coihue de Magallanes y Ciprés de las Guaitecas. ..................................... 21\nvi. P3-2. Turbera con Ciprés de las Guaitecas. ............................................................................ 22\nb. 3.- Bahía Snug- Río del Oro (P4) ................................................................................................. 24\ni. P4-1 Bosque de Coihue de Magallanes. ................................................................................. 25\nii. P4-2 Turbera. ......................................................................................................................... 25\niii. P4-3 Refugio. .......................................................................................................................... 25\n4.- Bahía San Nicolás (P5) ................................................................................................................... 25\niv. P5-1. Renoval de Coihue de Magallanes. ............................................................................... 27\nv. P5-2. Renoval de Coihue de Magallanes. ............................................................................... 28\nvi. P5-3. Renoval de Coihue de Magallanes. ............................................................................... 30\nvii. P5-4. Turbera. ..................................................................................................................... 30\nviii. P5-5. Bosque de Coihue de Magallanes. ............................................................................ 31\nVII. Resultados preliminares y conclusiones ..................................................................................... 32\nVIII. Aprendizajes para una próxima expedición ............................................................................... 33\nIX. Agradecimientos ............................................................................................................................ 33\nX. Referencias Bibliográficas............................................................................................................... 34\nXI. ANEXO 1. Itinerario ........................................................................................................................ 35\nXII. ANEXO 2. Tabla de identificación de puntos descritos ............................................................... 36\n2\nI. Introducción\nEn el marco de la elaboración del plan piloto de restauración de Bosques en Cabo Froward para\nFundación Rewilding Chile se realizaron en el mes de octubre del 2023 dos actividades en la\nRegión de Magallanes. Entre el 3 y el 4 de octubre se realizaron reuniones con profesionales\nde Conaf y visitas a sus dos viveros forestales de la Región, con el objetivo de iniciar gestiones\npara establecer un potencial convenio de producción de plantas.\nPor otra parte, entre el 05 y 11 de octubre, se realizó una navegación costera y exploratoria al\nsur de la Península de Brunswick a bordo de la Motonave Huracán, para hacer una exploración\nen tierra de las propiedades adquiridas por la Fundación Rewilding Chile y en terrenos del actual\nBien Nacional Protegido Cabo Froward. El equipo estuvo conformado por profesionales de la\nFundación Rewilding Chile, la Universidad de Chile y Conaf. El objetivo de esta salida fue el de\nexplorar y recorrer algunos sectores de interés que se encuentran dentro del futuro Parque\nNacional Cabo Froward, para realizar un primer diagnóstico de los ecosistemas boscosos\ncosteros para conocer su estado actual, identificar áreas a restaurar, identificar áreas de\nobtención de germoplasma, diseñar una estrategia, visualizar y definir una logística para\ntrabajar, planificar y realizar acciones de restauración en bosques costeros templados lluviosos\nde esta zona.\nLa restauración ecológica es el proceso de ayudar el restablecimiento de un ecosistema que se\nha degradado, dañado o destruido (SER, 2004). La restauración es una de las acciones más\nimportantes e integrales para potenciar la biodiversidad y la mitigación al cambio climático en\nambientes terrestres. Restaurar va más allá de plantar especies vegetales: su objetivo es\nrestaurar las funciones esenciales del ecosistema, su biodiversidad y ciclos biogeoquímicos e\nhidrológicos asociados, todo lo cual redunda, por ejemplo, en potenciar la capacidad de\nsecuestro de carbono por parte de los ecosistemas nativos (Marquet et al, 2019).\nEl desafío de la restauración ecológica está asociado al de manejar ecosistemas. Esto tiene la\nimplicancia de manejar sistemas naturales complejos con distintos niveles de organización\nbiológica (individuos-comunidades-ecosistemas). Para restaurar un ecosistema, es por lo tanto\nnecesario entender los patrones que determinan el cambio en las comunidades y los procesos\nque los determinan. Si la principal meta de la restauración es mantener la diversidad biológica\ndel paisaje forestal en el largo plazo, necesitamos por lo tanto ampliar nuestro enfoque para\nincluir 1) la variabilidad de los sistemas naturales, 2) la escala temporal y espacial de los\nprocesos ecológicos asociados a ellos, 3) los patrones observados, 4) los disturbios que los\nafectan y 5) los procesos de interacción biótica (Bannister et al, 2013).\nLa restauración de bosques nativos en esta zona es de importancia ya que promover la\nconservación y restauración de los bosques nativos, son acciones críticas para combatir el\ncalentamiento global y aminorar la crisis de extinción que afecta a la biodiversidad mundial. Por\notra parte, en bosques patagónicos, las experiencias de restauración se restringen casi\nexclusivamente al Parque Nacional Torres del Paine, no hay experiencias en restauración de los\n3\nbosques costeros, lo que agrega valor adicional a un plan de restauración en la zona de Cabo\nFroward.\nII. Los bosques costeros templados lluviosos (Pisano, 1997)\nLos bosques costeros templados pluviales, representan una formación restringida\nprincipalmente a ubicaciones costeras occidentales en latitudes superiores a los 30°S, con una\nreducida extensión a nivel global, no superando en superficie unos cuarenta millones de\nhectáreas.\nA diferencia de los bosques templados costeros pluviales del hemisferio norte, caracterizados\npor la predominancia de coníferas (Kirk & Franklin, 1992), los del sur están conformados\npredominantemente por especies latifoliadas, entre las que adquieren una importancia\nprimordial las del género Nothofagus (Fagaceae) o hayas del sur, excepto en los africanos,\ndonde este género está ausente.\nAlaback (1991) sintetiza la importancia de estos bosques de relativamente altas latitudes,\nseñalando que su sensibilidad frente a rápidos cambios climáticos históricos, los hacen buenos\nindicadores para su monitoreo a nivel global y establece que por poseer faunas y paisajes\nmenos alterados que otros ecosistemas, pueden proporcionar respuestas a muchas de las\nincógnitas relacionadas con procesos desarrollados a nivel del paisaje, aunque, sin embargo, la\nadopción de decisiones adecuadas sobre opciones para su conservación y manejo necesita de\nun mejor conocimiento de sus respuestas a intervenciones antrópicas y a las alteraciones\nendógenas derivadas de efectos climáticos.\nLa formación de Bosques Templados Costeros Pluviales del sur occidente de Sudamérica se\npresenta en Chile entre el sector andino de la cuenca del río Maule (35° S), alcanzando por la\ncosta a las inmediaciones del río Bío Bío (36° S), desde donde se extiende por la vertiente andina\noccidental hasta el extremo meridional del país (56° S), territorio que por su aislación e historia\nconstituye una verdadera isla biogeográfica. Su mejor representación se encuentra en la región\nfitogeográfica Valdiviana (40° a 42° S) (Pisano, 1954; Schmidthüsen, 1956; Donoso, 1982, 1993;\nVeblen & Schlegel, 1982; Hueck, 1978; Alaback, 1991; Armesto el al., 1996) donde están\nrepresentados por un complejo de comunidades relacionadas fitosociológicamente,\npresentando una rica biodiversidad con especies, géneros y formas biológicas, un marcado\nendemismo y una relativamente alta complejidad ecológica y estructural.\nDesde esta región, que puede ser considerada como su paleocentro, la formación se degrada\npaulatinamente hacia el norte, por un progresivo incremento de la aridez climática (Almeyda,\n1958) y hacia el sur, respondiendo a una disminución latitudinal de temperaturas, derivada de\nla creciente y múltiplemente manifestada influencia climática antártica (Endlicher & Santana,\n1988), que determina su gradual empobrecimiento en biodiversidad (Godley, 1960) y\nsimplificación de su estructura ecológica, hasta conformar en el sector meridional de su rango\ngeográfico bosques monoespecíficos. En Patagonia austral y Tierra del Fuego éstos están\nformados por sólo cuatro especies de Nothofagus y presentan una estructura ecológica simple,\n4\ncon una marcada reducción en la estratificación y en la diversidad específica de sus\ncomponentes.\nEl territorio de la sección austral de la Patagonia y Tierra del Fuego, abarca en Chile las áreas\ncontinentales y archipelágicas, que se extienden desde el sur de la Región administrativa de\nAysén, en una diagonal entre las latitudes aproximadas desde los 46° S (Chile Chico), a los 47°\nS (Golfo de Penas), y llegan hasta los 56° S (isla Hornos en el archipiélago homónimo) en la\nRegión de Magallanes. Casi la totalidad de la superficie de este territorio fue recurrentemente\nenglaciada durante el Pleistoceno (Caldenius, 1932, Auer, 1958 y numerosos autores\nmencionados por Clapperton, 1994), cuyos hielos labraron su complejo sistema de fiordos y\ncanales (Fuenzalida, 1965) y fueron agentes determinantes de su actual morfología, que en\ngran parte condiciona el establecimiento de las diferentes comunidades vegetales.\nLa existencia de los bosques en Patagonia austral y Tierra del Fuego, está determinada\nprincipalmente por el equilibrio hídrico en el sistema clima/suelo, en el que son importantes\nlas pérdidas causadas por evapotranspiración (que en esta región son notablemente\nincrementadas por los fuertes y constantes vientos durante el período vegetativo); la existencia\nde un rango de temperaturas, que a pesar de ser inferiores a las que caracterizan otros sectores\ndel área de bosques sudamericanos, son suficientes para el desarrollo fenológico y fisiológico\nde los árboles y, aparentemente en forma secundaria, por características edáficas, entre las\nque asume mayor significación la capacidad de retención de agua, los efectos de factores que\nregulan los procesos de humificación de la materia orgánica y los mecanismos de circulación\nde nutrientes.\nLos bosques de Patagonia austral y Tierra del Fuego, se diferencian de sus homólogos de la\nregión valdiviana, por la localización de muchas de sus comunidades en áreas con menores\nprecipitaciones y temperaturas más bajas y principalmente en que en aquéllos las especies de\nNothofagus, por su intolerancia a bajas intensidades de iluminación, conforman las primeras\netapas arbóreas en el proceso sucesional que conlleva al establecimiento de comunidades\nboscosas y son, por lo tanto, las pioneras en sucesiones iniciadas en claros resultantes de\nperturbaciones de diverso origen; pero a medida que avanza el proceso sucesional, son\nreemplazadas por especies tolerantes a condiciones de baja luminosidad que conforman las\ncomunidades climax (Veblen, 1985a, 1985b, 1989; Veblen & Ashton, 1978; Veblen et al., 1978,\n1981, 1996; Glenn et ai, 1991); en el sector austral, en cambio, las especies de Nothofagus son\nsiempre dominantes en cualquier etapa del proceso sucesional y en las comunidades climax\n(Pisano, 1977; Roig etal., 1985; Ilildebiand-Vogel etal., 1990; Gutiérrez et al., 1991; Donoso,\n1993), lo que puede atribuirse a la ausencia de competencia ecológica con especies tolerantes.\nAunque el territorio que soporta los bosques australes posee características ambientales que\nle dan una identidad propia, la diversidad mesoambiental determinada por gradientes en\nlatitud, altitud y geomorfología, en un territorio sobre 1.000 kilómetros de extensión latitudinal\nubicado al oeste del extremo austral del continente americano, con variados regímenes y\nsumas anuales de precipitación, temperaturas templado-frías y sujeto a fuertes y constantes\nvientos (Zamora 8c Santana, 1979; Endlicher & Santana 1988; Tuhkanen, 1984; Burgos, 1985;\n1988; Tuhkanen el al., 1990), determina que con la excepción de su extremo norte, donde se\n5\nencuentra una menor variabilidad transversal, se presenten diversos subsectores ecológicos\nclaramente diferenciados por su paisaje y biota (Pisano. 1977, 1981, 1983, 1991).\nYa en el sector norte de la Patagonia occidental, ubicado entre los golfos de Reloncaví (41° 30\n\\S) y de Penas (47° S), los ecosistemas boscosos comienzan a diferir notoriamente de los del\nvaldiviano, adquiriendo un carácter transicional entre ellos y los monoespecíficos establecidos\nen las latitudes meridionales. Es, sin embargo, en el sector que se extiende desde el sur del\ngolfo de Penas hasta el extremo austral del archipiélago fueguino donde asumen su particular\nidentidad, conformando un complejo de ecosistemas fitosociológicamente relacionados que,\npor sus marcadas diferencias con otros homólogos, se propone denominar como el de los\nBosques de Patagonia Austral y Tierra del Fuego chilenas. Así, en líneas generales, en aquellos\nterritorios más áridos, pero con tipos climáticos favorables para permitir el desarrollo de\necosistemas forestales, se encuentran bosques deciduos, caracterizados por la dominancia de\nNothofagus pumilio (Poepp. et Endl.) Krasser ("lenga"); en cambio, en los subsectores más\nlluviosos, N. betuloides (Mirbel) Oersted ("coihue de Magallanes"), conforma bosques\nsiempreverdes, mientras que en los bordes de los de lenga que contactan con la Estepa\nPatagónica, al igual que en sus niveles altitudinales superiores y en los bordes de las turberas\nesfagnosas, se encuentran rodales y montes de N. antárctica (G. Forster) Oersted ("ñirre"). Más\naún, dependiendo de otros factores como la latitud, tipos de suelo y su drenaje, distancia a las\ncostas, elevación y otros, los dominantes de estos tres tipos de bosques básicos se\nentremezclan entre sí y con otras especies arbóreas, conformando distintos tipos de bosques\nmixtos, que difieren también por la composición florística de sus estratos arbustivos y básales,\ncomo igualmente por la de las comunidades asociadas con ellos (Pisano, 1977).\nFigura N°1: Bosque costero perennifolio dominado por Coihue de Magallanes sometido a\nfuertes vientos (Fotografía de J. Suárez).\n6\nDesde el extremo norte de la Patagonia occidental, a aproximadamente 40° S y llegando hasta\nalgo más al sur de Puerto Edén (49° S), se agrega un cuarto tipo de bosque mixto siempreverde,\nque representa una formación con características ecotonales entre los del sur de la Región\nValdiviana y de los de coihue de Magallanes. Está conformado por Nothofagus nítida (Phil.)\nKrasser ("coihue de Chiloé), que se asocia con Podocatpus nubigena Lindl. ("mañio"), N.\nbetuloides, Laureliopsis philipjñana (Looser) Schodde ("tepa"), y Weinmannia trichosperma Cav.\n("tineo"), siendo relativa mente rico en plantas epífitas, trepadoras, arbustos, heléchos y\nhierbas típicas de los bosques valdivianos (Pisano, 1988, Innes, 1992). Desde su límite norte\nhasta el canal Brecknock (54° 15\' S), en áreas con altas precipitaciones y suelos esfagnosos, en\nel territorio del Complejo de la Tundra Magallánica (Pisano, 1983), se agrega otro tipo, que por\nlo común presenta bajos valores de cobertura y se distribuye en forma de mosaico,\ncaracterizado por la dominancia de Pilgerodendron uviferum (D. Don.) Florin ("ciprés de las\nGuaitecas"), que corrientemente se asocia con N. betuloides y especies herbáceas de turberas.\nEn los territorios donde las precipitaciones superan los 800 mm anuales y en especial hacia el\noeste de la cordillera andina, se extienden los bosques perennifolios dominados por\nNothofagus betuloides, cuya composición varía de acuerdo con la proximidad relativa a las\ncostas y la elevación del terreno. En sus sectores costeros más lluviosos, se encuentran\npequeñas extensiones de bosques pantanosos de Pilgerodendron uviferum, que también son\ncomunes en el área del Complejo de la Tundra Magallánica (Pisano,1977).\nFigura N°2: Bosque pantanoso de Ciprés de Las Guaitecas en el sector de Bahía Cordés, en la\nZona de Cabo Froward (Fotografía de J. Hernández).\n7\nEn el sector norte de este territorio, en cambio, los bosques se confinan a los sectores costeros\ny archipielágicos, mientras que hacia el interior del continente se degradan, conformando\ncomunidades cada vez con más características montañas, que con frecuencia llegan a contactar\ncon el Desierto Andino y los Campos de Hielo Patagónico Sur y Fueguino.\nLos bosques perennifolios australes están conformados básicamente por N. betuloides, pero a\nmedida que aumenta la disponibilidad de humedad, se asocia con Drimys winteri y en sus\nubicaciones costeras se suma Pseudopanax laetevirens (Gay) Franchet ("saúco cimarrón"). La\nmayor disponibilidad de humedad y el carácter más oceánico de su clima favorecen el\ndesarrollo de la trepadora Lebetanthus myrsinites (lam.) Dusén ("chaurilla") y en su estrato\narbustivo Berberis ilicifolia L.f. ("michay") frecuentemente reemplaza a B. buxifolia y se agregan\nPhilesia magellanica J.F. Gmelin ("coicopihue"), Desfontainia spinosa Ruiz et Pavón ("taique"),\nEscallonia serrata Sm. ("sietecamisas blanco"), Gaultheria mucronata (L.f.) Llook. Et Arn.\n("chaura") y la rastrera Luzuriaga marginala (Banks et Sol. Ex Gaert.) Benth. ("flor de la\nalmendra"); el piso del bosque soporta una densa cobertura de "helechos película"\nrepresentados por varias especies de Hymenophyllum y líquenes y briófitas, que también son\nimportantes como epífitas, cubriendo densamente las partes inferiores de los troncos. El\nbosque existente entre el golfo de Penas y las inmediaciones de Puerto Edén exhibe un carácter\ntransicional entre los del sector sur de la zona valdiviana y el siempreverde de Patagonia austral.\nSe caracteriza por la importancia de Nothofagus nítida ("coihue de Chiloé") que se asocia con\nN. betuloides, Podocarpus nubigena, Weinmannia trichosperma, Drimys winteri, y Laureliopsis\nphilippiana. Posee un rico estrato arbustivo, conformado principalmente por especies\nvaldivianas, destacándose Chusquea montana Phil. ("tihuén"), Desfontainia spinosa ("taique"),\nAzara lanceolata Hook. F. ("aromo"), Tepualia stipularis (Hook. et Arn.) Gtiseb. ("tepú"), Fuchsia\nmagellanica Lam. ("chilco"), Ribes magellanicum, Hebe salicifolia (G. Forster) Pennell, Lomatia\nferruginea (Cav.) R. Br. ("fuinque") y Philesia magellanica con grandes plantas de Gunnera\ntinctoria Mol. ("pangue"); las lianas y trepadoras son abundantes, entre las principales se\nencuentran Luzuriaga polyphylla (Hook.) J.F. Macbr. ("quilineja"), Campsidium valdivianum\n(Phil.) Skottsb. ("pilpilvoqui"), Griselinia ruscifolia (Clos.) Taubert ("huinque"), Astheranthera\novata (Cav.) Hanst. ("estrellita"), Mitraria coccínea Cav. ("botellita") e Hydrangea serratifolia\n(Hook. et Arn.) F. Phil. "canelilla"). Abundan los helechos, tanto en el piso del bosque, como los\nepífitos, correspondiendo principalmente a especies valdivianas y en el piso se asocian con\nlíquenes y briófitas, formando un denso tapiz.\na. Historia reciente de los bosques australes\nLas condiciones ambientales físicas, especialmente las climáticas, y la historia biogeográfica de\nPatagonia austral y Tierra del Fuego durante el Tardiglacial y el Holoceno, determinaron que\nsus ecosistemas presenten una biodiversidad comparativamente más reducida que la existente\nen otros territorios que no fueron englaciados o que lo fueron en menores extensiones e\nintensidades. Al considerar la biodiversidad, estructura, dinámica, síndromes de dispersión de\nsus especies y la localización geográfica en relación con el clima de los bosques de Patagonia\naustral y Tierra del Fuego, se llega a la conclusión que ellos constituyen ecosistemas que\npresentan un precario estado de equilibrio dinámico con su ambiente, lo que los hace\nespecialmente lábiles ante alteraciones de carácter antrópico, directo o indirecto, como son las\nderivadas de su explotación irracional y no sustentable y de su uso como recurso pastoril,\n8\ngenerando tipos de sucesión retrogresiva que pueden culminar en invasión de especies\noportunistas y otras mejor adaptadas a las condiciones derivadas que las que los conforman en\nsu estado prístino, degenerándose finalmente en comunidades ruderales o artificializadas\n(Pisano, 1990b).\nLas modificaciones ambientales producidas a lo largo del tiempo geológico, originaron procesos\nde cambios adaptativos por medio de los cuales los biomas ajustaron su estructura y\nbiodiversidad a las nuevas situaciones generadas; por lo tanto, mientras las condiciones\nambientales se mantengan estables en el tiempo, los ecosistemas permanecerán inalterados,\nsufriendo sólo cambios recurrentes de carácter menor, derivados de la periódica variabilidad\nambiental en ciclos cortos de tiempo.\nAl iniciarse el período histórico de asentamiento del hombre europeo en las tierras australes\n(Martinic, 1992), se inició un rápido proceso de deterioro de los biomas que en muchos casos\nadquirió tal intensidad que produjo cambios notables en su composición biótica y aún en el\npaisaje, desencadenando modificaciones en la naturaleza de los suelos y su pérdida por\nerosión; alteraciones en los regímenes de escurrimiento hídrico e incluso modificaciones que\nafectan a las características de los microclimas. Estos daños han alcanzado especial gravedad\nen los territorios del bosque caducifolio. Primero, fueron los bosques de este tipo cercanos a\nlos centros poblados los que sufrieron con mayor fuerza este nuevo impacto, extrayéndose\nárboles para obtener madera para construcciones, su comercio y leña y se cazaron sus grandes\ncarnívoros para la obtención de pieles o por su acción de depredación sobre el ganado\ndoméstico; luego se incendió la mayor parte de ellos para abrir campos para ganadería o para\npermitir la expansión de los asentamientos (Martinic, 1992).\nDespués de la introducción del ganado ovino y su crianza en forma extensiva a gran escala, a\nfines del siglo XIX, esta política destructiva de los bosques alcanzó una especial intensidad. De\neste modo, considerables extensiones forestales fueron incendiadas o eliminadas de otras\nmaneras para favorecer el crecimiento de pastos utilizables en esta nueva actividad.\nComenzaron también las primeras explotaciones comerciales de bosques, empleando métodos\nde corta por "floreo" y "tala rasa", para proveer de madera y combustible a las nuevas\ninstalaciones y para su exportación a mercados cercanos y en casi la totalidad de los casos los\nbosques madereados fueron posteriormente incendiados para proporcionar nuevos terrenos\nde pastoreo.\n9\nFigura N°3: Bosque secundario de Coihue de Magallanes con evidencia de explotación del\nbosque primario y uso posterior del fuego. Bahía San Nicolás (Fotografía de J. Suárez).\nLa búsqueda de nuevos territorios para el desarrollo de esta actividad, llevó a muchos colonos\na establecerse en territorios boscosos, los que fueron inmisericordiosamente incendiados, con\nel objeto de habilitarlos para su nuevo uso. Esta situación perduró hasta 1931, año en que entró\nen vigencia la primera ley forestal y aunque la legislación actualmente vigente referida a la\nutilización de los bosques naturales puede considerarse rudimentaria bajo un enfoque\necológico, debe reconocerse que en algo ha ayudado a su perpetuación. Sin embargo, en una\népoca en que la madera tenía costos de producción superiores a los de la ganadería, un\nmercado limitado y las disposiciones legales vigentes en ese entonces no objetaban la\ndestrucción del bosque, sino todo lo contrario. No puede atribuirse a los pobladores pioneros\nla totalidad de la culpa por este verdadero "crimen ecológico" que ha reducido\nconsiderablemente las superficies que originalmente soportaban bosques en Patagonia austral\ny Tierra del Fuego.\n10\nIII. Objetivo General\nEl objetivo en esta salida exploratoria, fue el de recorrer las propiedades privadas adquiridas\npor la Fundación Rewilding Chile y del Bien Nacional Protegido Cabo Froward con el objeto de\nlograr de primera fuente una visión general respecto del estado de los bosques y su necesidad\nde restauración, caracterizar los ecosistemas, identificar amenazas. Con esta información se\ninicia el trabajo de planificación de restauración de bosque nativo desde el 2024 en adelante\npara la zona de Cabo Froward.\nFigura N°4: Matriz de bosques costeros a explorar y parches de turberas donde aparece el\nCiprés de Las Guaitecas. Sector del Río Yumbel (Fotografía de V. González).\nIV. Objetivos Específicos\n- Realizar una primera descripción in situ de los bosques costeros.\n- Identificar necesidades de restauración y cuantificar las áreas potenciales a restaurar.\n- Identificar áreas de colecta de germoplasma (semillas y/o estaquillas).\n- Elaborar una estrategia de restauración para las diferentes situaciones identificadas.\n- Elaborar mapas que permitan conocer las distintas coberturas del suelo, sus variaciones\nen el tiempo y determinar áreas potenciales para diseñar el plan piloto de restauración\nde bosques nativos en la zona de Cabo Froward.\n11\nV. Metodología de trabajo de terreno\nPara cumplir estos objetivos, en las diferentes zonas de desembarque, se tomaron puntos de\nmuestreo con GPS como referencia para la posterior caracterización del paisaje. Además, se\nrealizaron una serie de vuelos de dron para captura de imágenes y videos y se capturaron fotos\nterrestres ilustrativas de las diferentes formaciones visitadas.\nFigura N°5: Mapas de ubicación de los sitios prospectados y puntos colectados en terreno\n(elaborados por V.González).\nEn cada punto de interés se realizó una caracterización del ecosistema para hacer un primer\nejercicio de descripción de cada sitio. Se registró el código del punto, la coordenada geográfica\nen UTM datum WGS84 Huso 19, nombre del lugar, tipo de cobertura, descripción del\necosistema, tipo forestal, subtipo forestal, especies observadas, altitud, exposición, posición\norográfica, pendiente, cercanía a cursos de agua, ancho del cauce, estratos presentes,\ncobertura de copas, presencia de trepadoras, epífitas, parásitas, helechos, legados biológicos,\ncobertura del suelo, signos de erosión, identificación de amenazas directas, disturbios y\npresencia de especies invasoras. En total, se visitaron cuatro sitios de prospección: bahía del\nIndio, bahía Cordés, bahía Snug y bahía San Nicolás, los cuales se describen a continuación.\n12\nFigura N°6: Trabajo de descripción de un punto de interés (fotografía de J. Hernández).\nFigura N°7: Vuelo de dron en sector de interés para captar fotos y videos (fotografía de J.\nHernández).\n13\nVI. Descripción de sitios\n1.- Bahía del Indio – Río Yumbel (P2)\nLa desembocadura del Río Yumbel tiene una acumulación de troncos arrastrados desde aguas\narriba que permite cruzarlo sin mayores problemas. La costa de la ribera Este muestra\nevidencias de desbordes anteriores. Un poco hacia el interior del bosque se encuentra un\nrefugio, conocido como “La casa del caminante”, muy básico pero que permite pernoctar y\nescapar del mal clima durante la noche. Alrededor del refugio existen claros de bosque y\nsectores planos que tienen potencial para ser usados como futura zona de camping o de\nrestauración forestal. Hacia el interior, por el borde del río, llama la atención la presencia de\nindividuos de lenga y de coihues de gran tamaño. Durante la visita, se constató la presencia de\nun “turista” que parece pasar mucho tiempo en el lugar, de nombre “Stuart”.\nFigura N°8: Desembocadura río Yumbel (Fotografias de J. Hernández)\nEn este sector se trabajó en la descripción de 3 situaciones diferentes: Bosque de Coihue de\nMagallanes con Canelo, Pradera y Bosque de Coihue de Magallanes:\n14\nFigura N°9: Ubicación de los puntos descritos en la desembocadura del río Yumbel\ni. P2-1. Bosque de Coihue de Magallanes con Canelo.\nBosque adulto de Nothofagus betuloides (Coihue de Magallanes). Estrato dominante Coihue de\nMagallanes e intermedio Drimys winteri (Canelo). El bosque presentaba dinámica de claros, en\ndonde los grandes árboles sobremaduros eran derrumbados por el viento generando grandes\nespacios para el establecimiento de la regeneración natural. Además, en el borde del bosque\nse encontraron árboles adultos caídos por la acción del viento, esto debido a que en estos\nsectores de borde las condiciones de viento fuertes son mayores y los árboles están más\nexpuestos.\nEn la superficie comprendida por la base de los árboles recientemente derrumbados, quedó\nsuelo expuesto que permitió el establecimiento de abundante regeneración natural de coihue.\nEn el piso forestal había también abundante regeneración natural de canelo. Se identificó la\npresencia de Fuchsia magellanica (Chilco) en el borde del fragmento.\nEl suelo era altamente pedregoso, con sectores con grandes rocas y con una delgada capa de\nmateria orgánica. Finalmente, en la ribera del río Yumbel, se encontraron algunos ejemplares\nadultos de Nothofagus pumilio (lenga). Estos individuos se encontraban en una franja de\naproximadamente 10 m desde el comienzo del río. Posiblemente, la ocurrencia de esta especie\nen esta área se debe a la dispersión de sus semillas por acción del río aguas arriba.\n15\nFigura N°10: Árboles volteados por viento a orillas del río Yumbel (Fotografía de J. Hernández).\nFigura N°11: Vista aérea de la desembocadura del Río Yumbel (Fotografía de J. Suárez).\n16\nSe observó evidencias de corta de árboles para construcciones rústicas temporales, rastros de\nfogatas, y daños en árboles con hacha. También se identificó fecas de lagomorfos y algunos\ntroncos roídos por Castores en el sector aledaño al río.\nii. P2-2. Pradera.\nEste punto corresponde a praderas con gramíneas exóticas y arbustos: Fuchsia magellanica\n(Chilco) y Chiliotrichum diffusum (Romerillo). En el límite de la pradera había algunos tocones\nde Coihue antiguos. En esta área se encontraba un refugio antiguo. Probablemente donde\npernocta Stuart. En este punto se podría evaluar destinar parte del área a restauración del\nbosque costero, pero también habría que destinar las áreas más protegidas para la instalación\nde un área de camping.\nFigura N°12: Sector de pradera en la ribera sur del río Yumbel (Fotografia de J. Suárez).\niii. P2-3. Bosque de Coihue de Magallanes.\nSector aledaño al refugio, corresponde a un bosque adulto de Nothofagus betuloides (Coihue\nde Magallanes), con un estrato dominante de Coihue de Magallanes e intermedio de Drimys\nwinteri (Canelo). El bosque presentaba dinámica de claros, en donde los grandes árboles\nsobremaduros eran derrumbados por el viento. El bosque presentaba tocones de coihue de\ncortas antiguas con una cobertura de copas media, y material leñoso en el suelo. Se encontró\nevidencia de varias fogatas. En este sector se podría evaluar la realización de una plantación de\nenriquecimiento para mejorar la composición del bosque, además de eliminar construcciones\nviejas y construir un sector de acampada y baños.\n17\nFigura N°13: Refugio en el sector del Río Yumbel (Fotografias de J. Hernández).\n2.- Bahía Cordés (P3)\nLa zona contiene una extensa turbera que contiene una variación interna asociada a la\npresencia de individuos arbóreos, principalmente de Coihue de Magallanes y en menor medida\nde Canelo y Ciprés de las Guaitecas (ver figuras N°14 y N°15).\nFigura N°14: Turbera con presencia de Coihue de Magallanes en sector de lagunas en Bahía\nCordés (Fotografía de J. Hernández).\n18\nEn las zonas más cercanas a la costa se observan parches de bosque con mayores densidades\npero de tamaño moderado. La turbera está dominada por Sphagnum magellanicum aunque se\npueden observar algunas áreas pequeñas de turberas pulvinadas, con Astelia pumila y Donatia\nfascicularis como las especies dominantes. También son abundantes las juncáceas y otras\nespecies herbáceas, probablemente del género carex de la familia de las ciperáceas.\nLos lomajes que se extienden más allá de las lagunas del sector tienen potencial de ser hábitat\ndel huemul. Sería importante poder instalar estaciones de muestreo con trampas-cámaras para\nconfirmar esta hipótesis.\nFigura N°15: Turbera arbórea con Ciprés de las Guaitecas y Coihue de Magallanes en diferentes\nfases de desarrollo (Fotografía de J. Hernández).\nEn este sector se describieron 3 situaciones de turberas con diferentes características\nfundamentalmente respecto de las especies forestales presentes: turbera con arbustivas,\nturbera con Coihue de Magallanes y Ciprés de las Guaitecas y turbera con Ciprés de las\nGuaitecas. Se nos indicó que en esta área se instaló un aserradero, información que hay que\n19\nconfirmar o descartar en próximas exploraciones hacia el noreste de la Bahía, ya que no se\nobservó en el área recorrida indicios de tal aserradero.\nFigura N°16: Especies observadas en la turbera, de izquierda a derecha Donatia fascicularis,\nAstelia pumila y Sphagnum magellanicum (Fotografías de J. Hernández).\nFigura N°17: Mapa de ubicación de los puntos descritos en Bahía Cordés\n20\niv. P3-0. Turbera.\nTurbera dominada por Sphagnum magellanicum y Empetrum rubrum (Murtilla de Magallanes)\ncon gran diversidad de especies arbustivas y algunas arbóreas. Dentro de las principales\nespecies arbustivas se registraron romerillo (Chiliotrichum diffusum) y chaura (Gaultheria\nantarctica).\nFigura N°18: Vista general de la turbera en este sector (Fotografía de J. Suárez).\nEn cuanto a las especies arbóreas dominantes, se registraron Ciprés de las Guaitecas, Coihue\nde Magallanes y Canelo. También se encontraron áreas con presencia de Ciprés enano de\nturbera (Lepidothamnus fonkii). La turbera presentaba al menos 1 m de profundidad respecto\nal perfil de suelo observado en la playa, sin embargo, esta podría tener una profundidad mucho\nmayor. En algunos sectores se observan pequeños fragmentos de bosque de Ciprés de las\nGuaitecas establecidos sobre la turbera.\nv. P3-1. Turbera con Coihue de Magallanes y Ciprés de las Guaitecas.\nSe trata de una turbera de tipo arbórea con ejemplares de Ciprés de Las Guaitecas y Coihue de\nMagallanes afectados por un incendio forestal ocurrido en el siglo pasado aproximadamente\n21\nen 1975. Los cipreses más altos se encontraban muertos en pie y los Coihues con daño en la\ncorteza hasta una altura aproximada de 3 m. El sotobosque estaba conformado por especies\narbustivas como romerillo (Chiliotrichum diffusum), michay (Berberis darwinii) y chaura\n(Gaultheria antarctica). La matriz de la turbera estaba dominada por Sphagnum magellanicum\ncon presencia de junco de Magallanes (Marsippospermum grandiflorum).\nFigura N°19: Turbera con Coihue de Magallanes y Ciprés de las Guaitecas (Fotografía de J.\nSuárez).\nvi. P3-2. Turbera con Ciprés de las Guaitecas.\nCorresponde a una turbera arbórea, con ejemplares adultos de Ciprés de las Guaitecas y\nabundante regeneración natural. Algunas plantas de ciprés podrían haber sido ramoneadas por\nvacuno bagual, ya que presentaban un hábito achaparrado, de acuerdo a lo indicado por\nintegrante de la tripulación, en el área hubo ganado vacuno. Dada la cantidad de ejemplares\ny la abundante regeneración este sitio, puede ser considerado como un punto interesante para\nla colecta de estaquillas o semillas de Ciprés de las Guaitecas.\n22\nFigura N°20: Turbera con bosquetes de Ciprés de las Guaitecas (Fotografía de J. Suárez).\nFigura N°21: Bosquetes de Ciprés de las Guaitecas con potencial para colecta de semillas y/o\nestaquillas (Fotografía de J. Suárez).\n23\nb. 3.- Bahía Snug- Río del Oro (P4)\nDebido a las difíciles condiciones climáticas, la visita a este sector fue muy rápida y dirigida\nfundamentalmente a revisar las dos trampas cámaras que ya estaban instaladas para\nreemplazar las tarjetas de memoria.\nFigura N°22: Localización de las trampas cámaras (Fotografías de J. Hernández).\nFigura N°23: Puntos tomados en el sector del Río Del Oro.\n24\nEl sector tiene un borde boscoso con individuos de Coihue de Magallanes y Canelo de segundo\ncrecimiento. Hacia el interior se encuentra una zona de turbera de características similares a\nBahía Cordés. Durante el trayecto se constató la existencia de un refugio, en relativa buenas\ncondiciones, que probablemente es usado por pescadores de Punta Arenas.\ni. P4-1 Bosque de Coihue de Magallanes.\nRetiro de cámara trampa. Bosque con dominancia de Coihue de Magallanes y presencia de\ncanelo. Se observó un parche de Bosque muerto posiblemente afectado por el agua de mar por\nmarejadas.\nii. P4-2 Turbera.\nSe trata de una turbera con Coihue de Magallanes (Nothofagus betuloides), juncos\n(Marsippospermum grandiflorum) y abundante chaura (Gaultheria mucronata).\niii. P4-3 Refugio.\nPunto que constata la existencia de una construcción de lata tipo refugio con estufa a leña en\nbuen estado.\n4.- Bahía San Nicolás (P5)\nEn el borde costero se constató la existencia de restos de aserraderos antiguos (50 años atrás\no más). Debido a lo anterior, es posible encontrar tocones antiguos, principalmente de coihues,\nde individuos de gran tamaño (DAP 1-2 m) en medio de renovales muy altos de coihue y canelo.\nAlgunas áreas se encuentran afectadas por caídas en masa de individuos altos y delgados\ncreciendo en suelos con pendiente de poca profundidad. Estas zonas, podrían ser usadas en el\nprograma de restauración, después de una evaluación más detallada.\nFigura N°24: Restos de la maquinaria, calderas y “locomóvil” usados en el pasado en el sector\n(Fotografías de J. Hernández).\n25\nHacia el interior, se encuentra una extensa turbera, en composición similar a la de bahía Cordes\npero con heterogeneidad composicional que se expresa en manchones más grandes.\nAproximadamente a 1,3 km de la costa, sobre un subsidiario del río, se constató la presencia\nde una castorera, aparentemente activa aunque no se observó ningún castor.\nFigura N°25: Bosque de coihue de Magallanes muerto por inundación por presencia de\nCastores, En recuadro vista de la misma castorera en Google Earth (Fotografia de J.\nHernández).\nFigura N°26: Imagen de la castorera captada por el equipo desde un Dron (Fotografia de S.\nVelasquez).\n26\nSe identificó una castorera activa a un costado de la turbera en un sector arbolado cruzado por\nuna corriente de agua secundaria, de bajo caudal. A través de fotointerpretación, ese mismo\npatrón fue encontrado en otras áreas similares hacia el interior del valle. Es altamente probable\nque existan más castoreras hacia el interior siguiendo el mismo patrón de uso de brazos más\npequeños y menos caudalosos para la construcción de los tranques en zonas arboladas\naledañas o al interior de las turberas.\nEn este sector se realizó la descripción de 5 situaciones diferentes: tres puntos de Renovales\nde Coihue de Magallanes, turbera y la quinta situación de turbera con Coihue de Magallanes\ny Ciprés de las Guaitecas.\nFigura N°27: Mapa de los puntos descritos en el sector de Bahía San Nicolás.\niv. P5-1. Renoval de Coihue de Magallanes.\nRenoval de Coihue de Magallanes con abundante material leñoso en el piso forestal. En este\necosistema se encontraron grandes tocones de Coihue, los cuales quedaron después un\nintenso floreo de este bosque. Los tocones medían aproximadamente 1 m de diámetro y entre\n1 y 2 m de altura en el corte. El bosque presentaba un estrato dominante de Coihue de\nMagallanes e intermedio de Canelo. En el suelo se encontró abundante regeneración natural\nde canelo y algunos individuos de leña dura (Maytenus magellanica) en estado de brinzal. El\nsotobosque estaba conformado principalmente por especies arbustivas como zarzaparrilla\n27\n(Ribes magellanicum), chilco (Fuchsia magellanica), calafate (Berberis microphylla) y chaura\n(Gaultheria antarctica). Sobre los grandes troncos y ramas en el suelo se encontraban\ncreciendo diversas especies de briófitas y hongos, pudiendo ser estos últimos\ndescomponedores de madera. Este bosque fue explotado en el pasado utilizando aserradero\ncon locomóvil para dimensionar los árboles cortados, del cual se pudieron encontrar algunas\npartes oxidadas de esta maquinaria cubiertas por tierra dentro del bosque. Finalmente, el\nbosque presentaba árboles caídos por efecto del viento.\nFigura N°28: Renoval de Coihue de Magallanes con presencia de grandes tocones y material\nleñoso en el suelo. A la derecha: Vista de las copas del renoval (Fotografias de J. Suárez)\nv. P5-2. Renoval de Coihue de Magallanes.\nRenoval de Coihue de Magallanes y Canelo en estado de latizal bajo. El piso forestal presentaba\nabundante regeneración natural de canelo. En esta área el bosque primario también fue\nintervenido, sin embargo, por los tocones encontrados se infiere que los árboles cortados\npresentaban menor diámetro (80 cm aprox.) que el punto anterior. Se encontraron árboles\ncaídos producto de los vientos fuertes del sector. Los suelos del área eran muy delgados de\nacuerdo a perfil observado en la playa. En el sotobosque se observaron las siguientes especies\nRibes magellanicum (zarzaparrilla), Fuchsia magellanica (Chilco), Berberis microphylla\n(Calafate) y Gaultheria mucronata (Chaura común). Se observó evidencia de corta de grandes\nárboles, también se encontraron algunas fogatas dentro del bosque, donde había acumulación\nde material leñoso en el piso forestal, en el mismo sector se encontró basura de turistas\nsenderistas.\n28\nFigura N°29: Renoval de Coihue de Magallanes con presencia de tocones y fogatas\n(Fotografías de J. Suárez).\nFigura N°30: Vista de la cobertura de las copas del renoval de Coihue de Magallanes\n(Fotografía de J. Suárez).\n29\nvi. P5-3. Renoval de Coihue de Magallanes.\nRenoval de Coihue de Magallanes con la totalidad de árboles muertos en pie. Posible causa de\nmuerte, inundación del sector con agua de mar. En los claros generados por la muerte de estos\nárboles se encontró abundante regeneración natural de zarzaparrilla. En el área se encontraron\npartes de maquinaria locomóvil utilizada para aserrar los árboles cortados. Según los\nantecedentes disponibles, el locomóvil y construcciones auxiliares del aserradero\npertenecieron a Don Diego Cárdenas (ver Figura N° 24).\nvii. P5-4. Turbera.\nTurbera de tipo arbórea con árboles aislados de Ciprés de las Guaitecas, Canelo y Coihue de\nMagallanes. En algunos sectores los árboles se encontraban creciendo en núcleos. Los Coihues\npresentaban un crecimiento achaparrado. Además, se encontraron ejemplares de Nothofagus\nantarctica (ñirre).\nFigura N°31: El equipo tomando puntos y haciendo la descripción del ecosistema en este caso\nla turbera con bosquetes de Cipres de Las Guaitecas (Fotografía de J. Suárez).\nLa matriz de la turbera estaba constituida por Sphagnum magellanicum. Las especies\narbustivas observadas correspondieron a Gaultheria antarctica (chaura), Berberis microphylla\n(Calafate), Chiliotrichum diffusum (romerillo) y Empetrum rubrum (Murtilla de Magallanes). Se\nobservó también presencia de Marsippospermum grandiflorum (Junco de Magallanes). La\n30\npresencia de Castor Canadensis en área adyacente podría modificar el régimen hídrico de esta\nturbera.\nviii. P5-5. Bosque de Coihue de Magallanes.\nBosque de Coihue de Magallanes con muchos árboles muertos. Los árboles murieron debido a\nla inundación provocada por el castor para la construcción de su represa. Dentro de la castorera\nse identificó el dique y la madriguera. En el borde de ésta se pudo observar árboles muertos, y\ntocones roídos por castores. En sectores adyacentes se encontraron algunos individuos de\nCiprés de las Guaitecas. Este punto se presenta como un punto relevante para planificar\nacciones de restauración y eliminación de amenazas.\nFigura N°32: Imagen de la castorera y el bosque de coihue de Magallanes inundado\n(Fotografía de J. Suárez).\n31\nVII. Resultados preliminares y conclusiones\nAun cuando se trata de la primera exploración de un terreno de gran superficie, esta primera\nprospección nos permitió configurar una visión general del territorio, así como también dar\ncuenta de los desafíos en lo logístico y para la restauración del bosque nativo costero en\nPenínsula Brunswick, en el sector de Cabo Froward.\nLuego de realizar el análisis de la información recopilada y la caracterización puntual de las\nzonas recorridas es posible concluir lo siguiente:\n1.- En el sector del río Yumbel podría considerarse en su desembocadura como un sector a\nconsiderar en el futuro plan de restauración. Se podría considerar además la posibilidad de\nrealizar enriquecimiento en algunos sectores y la instalación de un área de camping en el sector\ndel refugio existente en el lugar, para reducir el daño al bosque y regular el uso y\ncomportamiento de los senderistas en la zona.\n2.- En el sector de Bahía Cordés aunque se requiere una exploración mayor del sector de la\nBahía dado que hay antecedentes del funcionamiento de un antiguo aserradero en la zona,\nademás de la existencia de vacunos, esta área se puede definir como área fuente de semillas y\nestaquillas de Ciprés de las Guaitecas ya que presenta bosquetes con buen potencial para su\npropagación.\n3.- En el sector del Río del Oro es posible planificar la restauración de bosques de Coihue de\nMagallanes con ciprés de las Guaitecas, en una superficie a definir en próximas visitas, requiere\nmás recorrido y con mejores condiciones meteorológicas para poder profundizar en la\nrecopilación de antecedentes.\n4.- En el sector de Bahía San Nicolás, es posible definir un área para restauración de bosques\nde Coihue de Magallanes y mejoramiento de áreas de camping (para restringir el uso del\nbosque) en el sector costero por donde está el tránsito de los senderistas hacia Cabo Froward.\nY por el Río San Nicolás hacia arriba se podría considerar el área de la castorera identificada,\neliminando paralelamente la amenaza de castores. Será necesario, sin embargo, recorrer río\narriba para determinar si existen otras áreas similares para trabajar en restauración y\neliminación de esta amenaza para los ecosistemas de la zona. Dado que los castores se\nmovilizan desde isla Dawson hacia Cabo Froward con rumbo noreste, parece sensato mantener\nel monitoreo de los ríos con el fin de hacer un control permanente sobre la presencia de\ncastores\n5.- En términos generales esta primera expedición ha sido muy útil para establecer una visión\nde los ecosistemas de la zona y su estado actual, aun cuando será necesario seguir sumando\nexploración y conocimiento del área para tener más certidumbre respecto de los resultados de\nlas diferentes estrategias que se planteen para restaurar estos bosques.\n6.- Aun cuando las condiciones para la vida humana son muy difíciles en la zona y ha sido\nescasamente explorada, se pueden evidenciar en el bosque actual los efectos negativos de la\n32\nactividad humana en el pasado (explotación maderera del bosque primario en el siglo pasado)\ny senderismo y extracción de leña en la actualidad.\n7.- Lo visto hasta ahora en la zona de Cabo Froward nos impone el lindo desafío de conocer el\nterritorio, sus suelos, sus ríos, y su clima para poder diseñar un plan exitoso que nos permita\ncaptar la variabilidad, y los conocer los procesos que determinan este paisaje, sus amenazas y\ndisturbios que afectan a estos bosques.\nVIII. Aprendizajes para una próxima expedición\nSe sugiere preparar prensa de herbario para colecta de muestras de especies vegetales\npresentes y poder identificar con ayuda de especialistas.\nSe recomienda la adquisición de wader y bote inflable tipo Packraft para subir por los ríos y\nprospectar ríos por posible presencia de castores y mejorar la cobertura de la exploración.\nSe debe considerar volver al río del Oro (Bahía Snug) para realizar una exploración más extensa\ndel sector. También se debiera considerar desembarco en el sector del Río Nodales y en el\nsector puntual del Cabo Froward donde comienza el sendero de ascenso a la Cruz de los Mares.\nIX. Agradecimientos\nSe agradece en primer lugar la disposición de las instituciones participantes y el compromiso\nde los profesionales que formaron parte de la expedición. Se agradece también a Lorena\nValenzuela por la preparación del material cartográfico de apoyo a la expedición. Finalmente,\nse agradece a toda la tripulación de la lancha Huracán por el esfuerzo y disposición para lograr\nque el equipo desarrollara su trabajo en condiciones climáticas adversas.\n33\nX. Referencias Bibliográficas\nBannister et al, 2013. Revista Bosque Nativo N°52: 35 - 43, 2013. Experiencias de restauración\nen los bosques nativos del sur de Chile: Una mirada desde la Isla Grande de Chiloé\nJan R. Bannister, Mauro E. González, Christian Little, Alvaro G. Gutiérrez, Pablo J. Donoso,\nRodrigo Mujica, Sabine Müller-Using, Antonio Lara, Marcela A. Bustamante-Sánchez, Alan\nBannister, Andrés Caracciolo, Jorge Echeverría, José A. Suárez, Carlos Zambrano.\nMarquet et al, 2019. Marquet, P. A., M. Fernández, P. Pliscoff, C. Smith-Ramírez, E. Arellano, J.\nArmesto, R. Bustamante, P. Camus, A. P. Durán, C. Echeverría, T. Fuentes-Castillo, A. Gaxiola, C.\nGaymer, S. Gelcich, R. Hucke-Gaete, D. Manuschevich, M. J. Martínez-Harms, J. Naretto, V.\nQuirici, P. Ramírez de Arellano, H. Samaniego y M. Tironi (2019). Áreas protegidas y\nrestauración en el contexto del cambio climático en Chile. Informe de la mesa Biodiversidad.\nSantiago: Comité Científico COP25; Ministerio de Ciencia, Tecnología, Conocimiento e\nInnovación.\nPisano, 1997. Edmundo Pisano. Anales Inst. Patagonia, Ser. Cs. Nat. (Chile), 1997. Vol 25:9:19.\nLos Bosques de Patagonia Austral y Tierra del Fuego Chilenas.\nSER, 2004. Society for Ecological Restoration (SER) International, Grupo de trabajo sobre ciencia\ny políticas. 2004. Principios de SER International sobre la restauración ecológica. www.ser.org\ny Tucson: Society for Ecological Restoration International.\n34\nXI. ANEXO 1. Itinerario\nDía 1. Viernes 06 de octubre. Parcialmente nublado, vientos suaves.\n11:30. Zarpe desde bahía Mansa hacia bahía el Indio.\n13:38. Fondeo en la bahía del Indio. Coordinación con Capitán Hugo y José para prospectar el\nrío y los bosques aledaños.\n15:00. Salida exploratoria en bahía del Indio por todo el equipo.\n18:50. De vuelta a la embarcación. Zarpe hacia bahía Escondida.\n19:30. Fondeo en la bahía Escondida.\nDía 2. Sábado 07 de octubre. Nieve y viento, cielo cubierto.\n7:45. Zarpe desde la bahía Escondida.\n14:00. Fondeo en la bahía Cordes.\n15:00. Bajada en bahía Cordes o caleta San Miguel de todo el equipo. Caminata por borde\ncostero y turberas.\n18:00. De vuelta a la embarcación. Se pernocta en la bahía Cordes.\nDía 3. Domingo 08. Cielo cubierto, nieve y chubascos, vientos fuertes.\nFondeo en la bahía Cordes.\nDía 4. Lunes 09. Cielo parcialmente cubierto, chubascos repentinos y vientos fuertes.\n9:20. Zarpe desde bahía Cordes hacia bahía Snug.\n10:00. Bajada a río del Oro a revisar las cámaras trampa. Solo bajan Jaime, José, Sebastián y\nBenjamín por condiciones adversas de clima. Se hace recambio de tarjetas de memoria de las\ndos cámaras trampa instaladas en el mes de agosto.\n10:45. De vuelta en la embarcación. Se zarpa hacia la bahía San Nicolás.\n12:40. Fondeo en San Nicolás. Se observan delfines chilenos y delfines australes.\n14:00. Desembarco de todo el equipo. Caminata por el borde costero, bosques y turberas.\n18:45. De vuelta a la embarcación y zarpe de inmediato a bahía Escondida.\n19:00. Fondeo en bahía Escondida.\nDía 5. Martes 10.\nZarpe desde bahía Escondida hacia bahía Mansa.\n35\nXII. ANEXO 2. Tabla de identificación de puntos descritos\n36', 'description': None, 'parent_drive_file_id': '18LMtotWADBv25YNwJV9cvs13tSkdx3IQ', 'children': []}, {'id': 'a4169715-bb87-4ea8-86c9-b8a2a22e5a5c', 'drive_file_id': '1rmThkJNVRzwwAABtekZHbQIOxI5swb9j', 'name': 'INFORME EXPEDICIONES Rest. I y II Final (04-06 2025).pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1rmThkJNVRzwwAABtekZHbQIOxI5swb9j/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 16, tzinfo=datetime.timezone.utc), 'text_content': 'INFORME EXPEDICIONES I Y II - 2025\nPROGRAMA RESTAURACION DE BOSQUES NATIVOS\nCabo Froward, Península Brunswick,\nRegión de Magallanes y la Antártica Chilena.\nJosé Suárez\nJulio, 2025\nÍNDICE\nI. INTRODUCCIÓN 3\nII. OBJETIVOS EXPEDICIONES 4\nIII. METODOLOGÍA 5\n3.1. Expedición III – Colecta de estaquillas 5\n3.2. Expedición IV – Almacenamiento de C en los ecosistemas boscosos y de\n10\nturberas\nRevisión sensores de humedad y temperatura 16\nIV. AVISTAMIENTO Y REGISTRO DE AVES Y MAMÍFEROS MARINOS 16\nV. RESULTADOS PRELIMINARES Y CONCLUSIONES. 17\n2\nI. INTRODUCCIÓN\nCabo Froward, corresponde al punto continental más austral de América y destaca por ser un punto\nde encuentro de las aguas de Pacífico, Atlántico y Antártico lo que genera una enorme diversidad de\ncondiciones ambientales tanto terrestres como marinas.\nLas tierras, se encuentran en su mayor parte, cubiertas por bosques y túrbales. La especie dominante\nde estos bosques son coihue de Magallanes (Nothofagus betuloides) y canelo (Drimys winteri). Sobre\nel límite arbóreo se desarrolla un bosque achaparrado de lenga y ñirre y una estepa húmeda. Es\nimportante destacar la presencia de la especie arbórea Ciprés de las Guaitecas especialmente en las\nturberas, considerada la conífera más austral del mundo, catalogada por la IUCN como Vulnerable,\ne incluida en el Apéndice 1 de CITES.\nComo parte del trabajo de terreno para el Programa de Restauración, se ha determinado como\nnecesario realizar diversas campañas de terreno (expediciones) durante el año. Es por esto que\ndurante este primer semestre se han realizado dos expediciones, la primera en el mes de abril y la\nsegunda en el mes de junio.\nLas expediciones se realizaron en la costa de la Península de Brunswick a bordo de la Motonave\nHuracán, en terrenos privados adquiridos por la Fundación Rewilding Chile.\nEl objetivo de la primera expedición fue realizar una nueva colecta de estaquillas de Ciprés de Las\nGuaitecas con el fin de propagación. Este equipo estuvo conformado por profesionales de la\nFundación Rewilding Chile, un equipo de jornales locales y un funcionario del Banco de\nGermoplasma del Servicio Agrícola y Ganadero. En la segunda expedición del año, realizada en el\nmes de junio, se formó una cuadrilla de plantación con personal con experiencia en plantaciones\nforestales.\n3\nII. OBJETIVOS EXPEDICIONES\nPara la expedición I-2025 realizada en abril los objetivos planteados fueron:\n- Recolección de germoplasma de Ciprés de la Guaitecas para la futura producción de plantas\npara el Programa de Restauración a realizarse en Cabo Froward (ver Figura 1).\n- Toma de muestras de agua y suelo para la estimación de biodiversidad en Cabo Froward,\nmediante el análisis de ADN ambiental (ver Figura 2).\nPor otra parte, para la expedición II-2025 realizada el mes de junio sus objetivos fueron:\n- Realizar la primera plantación de Ciprés de Las Guaitecas, para probar la logística, la calidad\nde la planta, fecha de plantación y la técnica general en Cabo Froward (ver Figura 3).\nFigura 1. Imagen del equipo desplegado para colectar estaquillas de ciprés de Las Guaitecas.\n4\nFigura 2. Imagen de los equipos en funcionamiento para la toma de muestras de ADN Ambiental.\nFigura 3. Plantación de Ciprés de Las Guaitecas en Bahía Cordés.\n5\nIII. METODOLOGÍA\n3.1 Expedición I- 2025 – Colecta de estaquillas\n3.1.1 Área de trabajo\nPara la colecta de estaquillas de ciprés de Las Guaitecas nos desembarcamos en las áreas de bahía\nFortescue y bahía Cordés. Y se tomó muestras de agua para ADN ambiental en 4 ríos en Bahía Cordés\n(2), Bahia Fortescue (1) y Cruz de los Mares (1). Donde hubo condiciones meteorológicas favorables\nse realizaron vuelos de dron para captura de imágenes y videos y se tomaron fotos y videos del\ntrabajo realizado en terreno.\nFigura 4. Puntos de colecta de estaquillas de Ciprés de Las Guaitecas en la expedición I- 2025.\n3.1.2 Metodología de trabajo y resultados\nEn primer lugar, se realizó una inducción a los participantes en relación al objetivo y forma de la\ncolecta. Se obtuvieron estaquillas semi-leñosas de unos 15 cm, con un grosor desde 0,4 mm hasta\n0,8 mm aproximadamente. Las estaquillas fueron empaquetadas con elásticos y puestas en\ncontenedores con agua para mantenerlas.\n6\nFigura 5. Imagen de la extracción de estaquillas en terreno.\nEn total se recolectaron aproximadamente 2.600 estaquillas de ciprés de las Guaitecas de las cuales\n600 se llevaron a las instalaciones del SAG de Punta Arenas y el las restantes en las instalaciones del\nVivero Monte Nativo en El Amarillo, Región de Los Lagos, para ser viverizadas y promover su\nenraizamiento mediante aplicación de hormonas enraizante de tipo comercial (Keriroot). Para ser\nestablecidas posteriormente en restauración de diferentes áreas del futuro parque nacional Cabo\nFroward.\nTambién se realizó la prospección en detalle de los sitios para plantación en Bahía Cordés y en el\nsector de la Cruz de Los Mares.\n7\nFigura 6. Trabajo en colecta y preparación de estaquillas de Ciprés de las Guaitecas.\nFiguras 7 y 8. Coleta de estaquillas de ciprés de la Guaitecas en Cabo Froward.\n8\nLos sectores donde se hizo colecta de germoplasma, corresponden en general a matrices de turbera\narbórea, con ejemplares adultos de Ciprés de las Guaitecas y abundante regeneración natural. Otros\nsectores trabajados corresponden a turberas de tipo arbórea con ejemplares de Ciprés de Las\nGuaitecas y Coihue de Magallanes. Algunas áreas presentan signos de incendios pasados, lo que\ndemuestra que estas áreas fueron explotadas anteriormente.\n- Equipo participante de la expedición de Colecta\nEl equipo participante en esta expedición estivo compuesto por José Suárez asesor del Programa de\nRestauración de la Fundación (encargado Expedición y trabajo técnico) y Lorena Valenzuela\n(encargado Expedición y trabajo técnico-operaciones), Roberto Niculcar del Banco de germoplasma\ndel SAG, Juan Pablo Chandía y Jean Marcel como ayudantes especializados para la colecta de\nestaquillas de Ciprés de las Guaitecas.\nRespecto de la tripulación de la embarcación Huracán nos acompañaron Hugo Cárdenas, capitán, y\nsu tripulación, Oscar Cárdenas, Patricio Cárdenas, Víctor Ojeda y Heladio Melipillan.\nFigura 9. Equipo expedición de Restauración I 2025 – colecta de estaquillas.\n9\n3.2 Expedición II-2025 – Plantación en Bahía Cordés.\n3.2.1 Área de trabajo\nLa costa suroeste de la Península de Brunswick específicamente en el sector de Bahia Cordés.\nFigura 10. Áreas plantadas en el sector de Bahía Cordés\n10\n3.2.2 Metodología y resultados\nSe descargaron las plantas previamente colocadas en sacos con gel hidratante para transporte, estos\nsacos se colocaron en cajas plásticas para proteger las plantas especialmente la zona radicular.\nFiguras 11 y 12. Plantas preparadas para bajarlas a la costa.\nDispuestas en las cajas se descargaron al bote para llegar a tierra y en la costa de movilizaron en las\nmochilas con tambores, mochila Patrick adaptada con caja y una tercera mochila con bolsas laterales\nde Foresty Suppliers. De las tres formas de trasladar las plantas en terreno parece ser que la mochila\ncon tambores es la que mejor permite el traslado seguro y eficiente de las plantas.\nFiguras 13, 14 y 15: diferentes formas de trasladar plantas en terreno.\n11\nEn vista de las condiciones climáticas adversas con precipitaciones de nieve en forma intensa\ndurante los dos días previos, y ante la posibilidad que estas fueran más extremas en el sector de la\nCruz de los Mares, se decidió realizar la totalidad de la plantación en el sector de Bahía Cordés, razón\npor la cual se realizaron 2 polígonos de plantación en el mismo sector. La metodología para\ndisponerlas en el terreno fue haciendo mini núcleos, dado que había que hacer un trabajo de\ndespeje de nieve previo.\nFiguras 16 y 17. Plantación de Ciprés de Las Guaitecas.\nFigura 18. Mini núcleo de plantación.\n12\nFiguras 19. Trabajo de deje de nieve previo a la plantación.\nFigura 20. Plantación de Ciprés de Las Guaitecas.\n13\nFigura 21. Plantación de Ciprés de Las Guaitecas.\nFigura 22. Plantación de Ciprés de Las Guaitecas.\n14\nFigura 23. Plantación de Ciprés de Las Guaitecas.\n- Equipo participante de la expedición de plantación\nJosé Suárez (encargado Expedición y trabajo técnico), la cuadrilla de plantadores estuvo conformada\npor Juan Pablo Chandía, Marco Garrido, Jean Marcel y Hugo Gallardo.\nRespecto de la tripulación de la embarcación Huracán nos acompañaron Hugo Cárdenas, capitán, y\nsu tripulación, Oscar Cárdenas, Patricio Cárdenas, Víctor Ojeda y Heladio Melipillan.\nFigura 24. Equipo participante de la Expedición II de plantación y tripulación de la embarcación Huracán.\n15\n- Revisión sensores de humedad y temperatura\nEn la expedición de plantación pudimos bajar la información de uno de los sensores instalados en\nBahía Cordés. El resto de los sensores de humedad y temperatura, serán revisados en la próxima\nexpedición. Ya que se instalaron en diferentes situaciones: en zonas abiertas (turberas), semicerrado\n(transición turbera-bosques) y bosques (cerrado). El objetivo es monitorear y registrar condiciones\nen distintos tipos de ambientes. Estos dispositivos cuentan con registrador (data logger) que está\nconectado a una sonda que es la que mide temperatura y humedad cada 1 hora. Con estos datos se\npodrá posteriormente hacer un análisis de las condiciones climáticas del sector y su variación en el\ntiempo.\nFigura 25. Instalación de sensores para medición de temperatura y humedad dentro del futuro PN Cabo\nFroward\nIV. AVISTAMIENTO Y REGISTRO DE FUNA SILVESTRE.\nSe pudo verificar las huellas de ejemplar de zorro desplazándose en el sector de Bahía Cordés en el\nsector de plantación luego del primer día de trabajo.\n16\nFigura 26. Huella de probable zorro en el sector de plantación, en Bahia Cordés.\nV. RESULTADOS Y CONCLUSIONES.\nLos principales resultados obtenidos en estas dos expediciones tienen relación con la obtención de\nmaterial vegetativo para propagación de Ciprés de las Guaitecas por un total aproximado de 2.600\nestaquillas y la plantación de las primeras 1.000 plantas de Ciprés de las Guaitecas por parte del\nPrograma de Restauración.\nLas estaquillas se encuentran actualmente en proceso de enraizamiento (en instalaciones del SAG\nMagallanes y Monte Nativo – El Amarillo) en invernadero y esperamos estén en condiciones de ser\nplantadas en un par de temporadas por el programa de Restauración de FRC.\nPor otra parte, se plantó en Bahía Cordés un total de 1.000 plantas de Ciprés de Las Guaitecas en dos\npolígonos cercanos en el sector de Bahía Cordés, cada uno de 0,3 ha (0,60 ha en total). Se puso a\nprueba la logística de traslado y acarreo de plantas en el terreno y su conservación y mantención en\nel proceso. Por otra parte, estamos poniendo a prueba la planta, se está probando también la época\nde plantación y la técnica empleada.\n17', 'description': None, 'parent_drive_file_id': '18LMtotWADBv25YNwJV9cvs13tSkdx3IQ', 'children': []}, {'id': '0b4b14ba-147d-440c-8e73-5bb5101eba5c', 'drive_file_id': '17VfXPU0x6Eh0hDXO3yWs2CToRG1s8Kdo', 'name': 'Notas Expedición IV Restauración Cabo Froward 240524.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/17VfXPU0x6Eh0hDXO3yWs2CToRG1s8Kdo/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 16, tzinfo=datetime.timezone.utc), 'text_content': 'EXPEDICIÓN RESTAURACIÓN IV\nCabo Froward, comuna de Punta Arenas, provincia Magallanes\nregión de Magallanes y Antártica Chilena\n24 de mayo del 2024\nI. CONTEXTO\n▪ Fecha de la expedición y duración total\nDel 6 de mayo al 11 de mayo: 6 días embarcados.\n▪ Equipo a bordo\nJosé Suárez (encargado Expedición y trabajo técnico), Lorena Valenzuela (encargado Expedición\ny trabajo técnico-operaciones), y los académicos del Dpto. de Silvicultura y Conservación de la\nNaturaleza: Eduardo Martínez (Profesor asistente, especialidad Suelo, Agua, Planta), Carlos\nMagni (Profesor asociado, especialidad Genética Forestal), y del Dpto. de Gestión Forestal y\nMedio Ambiente: Cristian Estades (Profesor titular, especialidad Fauna Silvestre), Jaime\nHernández (Profesor titular, especialidad Geomática y Ecología del Paisaje), Valentina González\nCastro (Asistente de investigación del Laboratorio de Geomática y Ecología del Paisaje) y Javier\nHernández (Memorante tesis de pregrado).\nTripulación embarcación Huracán: Hugo Cárdenas, Oscar Cárdenas, Víctor Ojeda y Heladio\nMelipillan.\n▪ Lugares explorados\nCosta suroeste de la Península de Brunswick, específicamente Bahía San Nicolás, Bahía El Águila,\ny Bahía Córdes.\nII. EXPEDICIÓN\n▪ Objetivos principales\n- Realizar ensayos de metodologías para toma muestras para el almacenamiento de C en los\necosistemas boscosos y de turberas.\n- Determinar profundidades de distintos tipos de turberas y en distintas condiciones\ngeográficas.\n- Identificar y describir las distintas turberas presentes en el futuro parque nacional.\n- Identificar futuras áreas para la toma muestras para el almacenamiento de C en la próxima\nexpedición.\n- Prospección y avistamiento de fauna asociada los ecosistemas del futuro parque nacional.\n- Revisión de trampas de colecta de semillas y monitoreo de estados fenológicos.\n▪ ¿En base a que se seleccionaron las zonas escogidas?\nPara la identificación de zonas se revisó la cartografía disponible, levantamiento de información de\nlas expediciones anteriores y salida a terreno del levantamiento de información para el sendero de\nCabo Froward.\n▪ ¿Qué condiciones climáticas enfrentaron?\nEn general, las condiciones climáticas fueron favorables, pero siempre acompañados de bajas\ntemperaturas.\n▪ Descripción del ecosistema en los lugares explorados\nCabo Froward, corresponde al punto continental más austral de América y destaca por ser un punto\nde encuentro de las aguas de Pacífico, Atlántico y Antártico lo que genera una enorme diversidad de\ncondiciones ambientales tanto terrestres como marinas.\nLas tierras, se encuentran en su mayor parte, cubiertas por bosques y túrbales. La especie dominante\nde estos bosques son coihue de magallanes (Nothofagus betuloides) y canelo (Drimys winteri). Sobre\nel límite arbóreo se desarrolla un bosque achaparrado de lenga y ñirre y una estepa húmeda. Es\nimportante destacar la presencia de la especie arbórea Ciprés de las Guaitecas especialmente en las\nturberas, considerada la conífera más austral del mundo, catalogada por la IUCN como Vulnerable, e\nincluida en el Apéndice 1 de CITES.\nEn las cercanías de los cursos de agua se observan formaciones de bosque nativo renoval y adulto\nprincipalmente de Nothofagus, cuyas principales funciones ecológicas son: protección de riberas,\naporte de materia orgánica a los ecosistemas acuáticos, hábitat para numerosas especies de flora y\nfauna y almacenamiento de carbono. Existe una gran proporción de túrbales de Sphagnum, en los\nsectores de menor drenaje, mesetas y fondo de valles.\n▪ ¿Qué encontraron y que no pensaban observar? ¿Qué no encontraron y que sí esperaban ver?\nEl avistamiento y registro de un huemul en Bahía Córdes, fue algo totalmente inesperado. Fue\navistado en primera instancia por el académico Cristian Estades, luego todo el equipo pudo avistarlo.\nLuego, Benjamín y Diego realizaron un acercamiento (siempre manteniendo la distancia\ncorrespondiente) para obtener mejores registros. Al otro día, también posible avistarlo, ya que estaba\ncerca de lancha donde se encontraba realizando faena para toma de agua. El huemul se acercó a la\nlancha por lo que se pudo hacer otros buenos registros (revisar carpeta de fotos de Lorena\nValenzuela).\nTambién destaca la gran cantidad de avifauna observada, como las aves marinas costeras: pato\nquetru no volador (Tachyeres pteneres), caranca (Chloëphaga hybrida), martín pescador (Megaceryle\ntorquata), cormorán imperial (Phalacrocorax atriceps), pato juarjual (Lophonetta specularioides);\naves pelágicas como el petrel gigante antártico (Macronectes giganteus), albatros de ceja negra\n(Thalassarche melanophris), petrel plateado (Fulmarus glacialoides); aves del bosque siempreverde\ncomo el rayadito común (Aphrastura spinicauda), tordo (Curaeus curaeus), picaflor (Sephanoides\nsephaniodes), churrin (Scytalopus magellanicus), cachaña (Enicognathus ferrugineus), jilguero (Spinus\nbarbata), diucón (Xolmis pyrope), comesebo (Pygarrhichas albogularis), cometocino (Phrygilus\npatagonicus), churrete patagonico (Cinclodes patagonicus), colilarga (Sylviorthorynchus desmursii),\nentre otros.\n▪ ¿Cuáles son las principales amenazas observadas? Por ejemplo, ¿se observa evidencia de acción\nantrópicas como aserradores, vestigios de incendios en el pasado, o la presencia de ganado bagual\no especies exóticas o presencia de senderistas no regulados o turismos no regulados?\nLa amenaza principal está asociada con la presencia de castores, sobre todo en el sector de Bahía\nCórdes. Éstos, cortan árboles para construir represas y castoreras, desvían los cursos de agua e\ninundan los bosques y turberas modificando los ecosistemas presentes.\nPresencia de basura en las zonas donde hacen rancho los pescadores y también zonas que están\nasociadas al sendero de Faro San Isidro a Cruz de los Mares debido a la visita cada vez más frecuente\nde turistas.\n▪ Otros datos recopilados\nSe instalaron sensores de medición de humedad y temperatura en diferentes ambientes (zonas\nabiertas (turberas), semicerrado (transición turbera-bosques) y bosques (cerrado). Cuyo objetivo es\nmonitorear y registrar condiciones ambientales en distintos tipos de ambientes.\n▪ Mapa de ubicación en el sector', 'description': None, 'parent_drive_file_id': '18LMtotWADBv25YNwJV9cvs13tSkdx3IQ', 'children': []}, {'id': '436b9419-7afc-4ed2-b267-89123243f69d', 'drive_file_id': '1gjNb-zv6VbhR7gZJY5kYNxGjHBHFDLJO', 'name': 'Notas Expedición III Restauración Cabo Froward  090424.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1gjNb-zv6VbhR7gZJY5kYNxGjHBHFDLJO/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 16, tzinfo=datetime.timezone.utc), 'text_content': 'EXPEDICIÓN RESTAURACIÓN III\nCabo Froward, comuna de Punta Arenas, provincia Magallanes y región de Magallanes y\nAntártica Chilena\n09 de abril del 2024\nI. CONTEXTO\n▪ Fecha de la expedición y duración total\nDel 14 de marzo al 20 de marzo: 7 días embarcados.\n▪ Equipo a bordo\nJosé Suárez (encargado Expedición y trabajo técnico) y Lorena Valenzuela (encargados\nExpedición y trabajo técnico-operaciones), Martin Cornejo, Martin Vega, Montserrat Aldea y\nAlonso Rosales como ayudantes especializados para la colecta de estaquillas de Ciprés de las\nGuaitecas.\nTripulación embarcación Huracán: Hugo Cárdenas, Oscar Cárdenas, Patricio Cárdenas, Víctor\nOjeda y Heladio Melipillan.\n▪ Lugares explorados\nCosta suroeste de la Península de Brunswick, específicamente en el BNP Cabo Froward: Bahía\nSan Nicolás, Bahía El Águila, Río Yumbel y en la propiedad de la Fundación Rewilding Chile: Cruz\nde los Mares y Bahía Córdes. En este último punto también se explora la propiedad de interés\nde Poduje.\nII. EXPEDICIÓN\n▪ Objetivos principales\n- Recolección de germoplasma de Ciprés de la Guaitecas para la futura producción de plantas\npara el Programa de Restauración a realizarse en Cabo Froward.\n- Toma de muestras provenientes de matrices ambientales de agua y suelo para la estimación\nde biodiversidad en Cabo Froward, mediante el análisis de ADN ambiental.\n- Revisión de estado fenológico (estado del proceso de maduración de frutos) de Ciprés de\nlas Guaitecas para recolección de semillas.\n- Identificación de futuras áreas para Restauración a través de forestación y otras actividades.\n▪ ¿En base a que se seleccionaron las zonas escogidas?\nPara la identificación de zonas se revisó la cartografía disponible, levantamiento de información de\nlas expediciones anteriores y salida a terreno del levantamiento de información para el sendero de\ncabo Froward.\n▪ ¿Qué condiciones climáticas enfrentaron?\nEn general, las condiciones climáticas fueron favorables, pero siempre acompañados de bajas\ntemperaturas. El día de subida a la Cruz de las Mares, hubo mucha ventisca con agua nieve lo que\ndificultó el traslado e hizo más difícil los movimientos.\n▪ Descripción del ecosistema en los lugares explorados\nCabo Froward, corresponde al punto continental más austral de América y destaca por ser un punto\nde encuentro de las aguas de Pacífico, Atlántico y Antártico lo que genera una enorme diversidad de\ncondiciones ambientales tanto terrestres como marinas.\nLas tierras, se encuentran en su mayor parte, cubiertas por bosques y túrbales. La especie dominante\nde estos bosques son coihue de magallanes (Nothofagus betuloides) y canelo (Drimys winteri). Sobre\nel límite arbóreo se desarrolla un bosque achaparrado de lenga y ñirre y una estepa húmeda. Es\nimportante destacar la presencia de la especie arbórea Ciprés de las Guaitecas especialmente en las\nturberas, considerada la conífera más austral del mundo, catalogada por la IUCN como Vulnerable, e\nincluida en el Apéndice 1 de CITES.\nEn las cercanías de los cursos de agua se observan formaciones de bosque nativo renoval y adulto\nprincipalmente de Nothofagus, cuyas principales funciones ecológicas son: protección de riberas,\naporte de materia orgánica a los ecosistemas acuáticos, hábitat para numerosas especies de flora y\nfauna y almacenamiento de carbono. Existe una gran proporción de túrbales de Sphagnum, en los\nsectores de menor drenaje, mesetas y fondo de valles.\nLos arbustos más frecuentes que crecen estos bosques costeros son michay (Berberis ilicifolia),\nzarzaparrilla (Ribes magellanicum) y chilco (Fuchsia megellanica).\n▪ ¿Qué encontraron y que no pensaban observar? ¿Qué no encontraron y que sí esperaban ver?\nA pesar de ser zonas ya exploradas, siempre sorprende la majestuosidad del paisaje y de la adaptación\nde las especies terrestres y marinas que habitan ese territorio.\nDestaca el registro de un pequeño roedor que estaba muerto, al parecer por condiciones de\ntemperatura. También el avistamiento de un halcón peregrino que no había sido registrado en las\nexpediciones anteriores.\nEn relación a la vegetación, las matrices de turberas con la presencia de bosques de Ciprés de las\nGuaitecas sin duda son los principales protagonistas de esta expedición.\n▪ ¿Cuáles son las principales amenazas observadas? Por ejemplo, ¿se observa evidencia de acción\nantrópicas como aserradores, vestigios de incendios en el pasado, o la presencia de ganado bagual\no especies exóticas o presencia de senderistas no regulados o turismos no regulados?\nLa amenaza principal está asociada con la presencia de castores, sobre todo en el sector de Bahía\nCórdes. Estos cortan árboles para construir represas y castoreras, desvían los cursos de agua e\ninundan los bosques y turberas modificando los ecosistemas presentes.\nPresencia de basura en las zonas donde hacen rancho los pescadores y también zonas que están\nasociadas al sendero de Faro San Isidro a Cruz de los Mares debido a la visita cada vez más frecuente\nde turistas.\n▪ Dato anecdótico\nSin anécdotas que informar.\n▪ Mapa de ubicación en el sector\nEn elaboración LORENA', 'description': None, 'parent_drive_file_id': '18LMtotWADBv25YNwJV9cvs13tSkdx3IQ', 'children': []}]}, {'id': '9dcb83fc-2def-460f-bd06-2cd6530955ab', 'drive_file_id': '1WVTOwxuGpdfTYjztjxDUk_6Qnmbbkx5-', 'name': 'Estimación Carbono UChile', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1WVTOwxuGpdfTYjztjxDUk_6Qnmbbkx5-', 'modified_time': datetime.datetime(2026, 6, 30, 16, 18, 59, 187000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1IN8ZJZYtTbtMIuqRQ4oBgkhS6lihkNFN', 'children': [{'id': 'f8b4d0e2-d1f9-400f-afa0-5104b52e62e9', 'drive_file_id': '1SGlfCCS0Cjm3cXCsdTh8rEprHTapcDZQ', 'name': 'Presentacion JaimeH CarbonPNCF 010825 .pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1SGlfCCS0Cjm3cXCsdTh8rEprHTapcDZQ/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 17, tzinfo=datetime.timezone.utc), 'text_content': 'Carbon Estimation in Ecosystems of the Future\nCape Froward National Park\nAuthors\nJaime Hernández P.\nJavier Hernández G.\nEduardo Martínez H\nField measurement and samples collection\nCarbol Stock Estimation\nC = A * D * ρ * %C\nstock\nA = Total Area (from land cover map)\nD = Depth (from field sampling)\nρ = Soil bulk density\n%C = Soil carbon stock (%)\nLand cover mapping (satellite analysis)\nDepth of Peatlands\nAverage ~ 200 cm\nDepth (cm)\nTotal Carbon by Peatland Depth\nAverage ~ 44,6 %\nDepth (cm)\nPeatland Bulk Density\nAverage ~ 0,17 g/cm3\nProm= 1647,5 t/ha Total= 536,2 t/ha\nSup = 55.993 ha Sup = 58.200 ha\nTotal = 92.248.467,5 tones Total = 31.206.840 tones\nMedia global = 871,13 t/ha', 'description': None, 'parent_drive_file_id': '1WVTOwxuGpdfTYjztjxDUk_6Qnmbbkx5-', 'children': []}, {'id': '59c3c4d7-7bba-4f47-95da-35c0a89117a3', 'drive_file_id': '1Wm2hbL5jzukAMRUzSkbeBngaew2xkH6c', 'name': 'Informe Final - Estimación Carbono PN Cabo Froward.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1Wm2hbL5jzukAMRUzSkbeBngaew2xkH6c/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 30, 15, 59, 17, tzinfo=datetime.timezone.utc), 'text_content': "Informe Final\nEstimación de Carbono en Ecosistemas del futuro\nParque Nacional Cabo Froward\nAutores\nJaime Hernández P.\nJavier Hernández G.\nEduardo Martínez H.\nAgosto, 2025\nEquipo de Terreno\nLas siguientes personas participaron en las campañas de terreno de mayo y/o noviembre de 2024. A\ntodas ellas, nuestros sinceros agradecimientos.\nUniversidad de Chile\nJaime Hernández\nValentina González*\nCarlos Magni\nEduardo Martínez\nJavier Hernández\nBetsabé Abarca\nSebastián Casali\nBruno Gonzalez\nLissette Cortés\nRewilding Chile\nBenjamín Morales\nJosé Suárez\nLorena Valenzuela\nDiego Nahuel\n*Asesora en clasificación digital con plataforma Google Earth Engine.\n2\nÍndice\n1. Introducción ................................................................................................................................ 4\n2. Objetivos ..................................................................................................................................... 8\n3. Materiales y Métodos .................................................................................................................. 9\n3.1. Estimación de superficies ......................................................................................................... 9\n3.2. Estimación de carbono en bosques ......................................................................................... 11\n3.2.1. Biomasa aérea de bosques ............................................................................................... 11\n3.2.2. Estimación de volúmenes y carbono: bosque y matorrales ............................................. 13\n3.3. Estimación de almacenamiento de C en suelos minerales y turberas .................................... 15\n3.3.1. Caracterización de tipos de turberas ................................................................................ 15\n3.3.2 Preparación de las muestras ............................................................................................. 17\n3.3.3. Densidad aparente del suelo ............................................................................................ 18\n3.3.4. Análisis de carbono almacenado por tipo de turbera y su variación en profundidad ...... 18\n4. Resultados ................................................................................................................................. 20\n4.1. Superficies por tipos de vegetación y cobertura de suelo....................................................... 20\n4.2. Carbono Almacenado ............................................................................................................. 22\n4.2.1. Almacenamiento de Carbono en Bosques ....................................................................... 22\n4.2.2 Almacenamiento de carbono en turberas y suelos minerales ........................................... 22\n4.2.3. Efecto de la profundidad sobre el carbono total (%C) y nitrógeno total (%N) ............... 23\n4.2.4. Estimación de profundidades máximas medias ............................................................... 25\n4.2.5. Comparación de carbono entre componentes .................................................................. 28\n5. Conclusiones ............................................................................................................................. 30\n6. Agradecimientos........................................................................................................................ 31\n7. Referencias ................................................................................................................................ 32\n8. Apéndices .................................................................................................................................. 33\nApéndice I. .................................................................................................................................... 33\nApéndice II. ................................................................................................................................... 35\nApéndice III. ................................................................................................................................. 37\n3\n1. Introducción\nEl aumento constante de las concentraciones de dióxido de carbono (CO2) en la atmósfera terrestre,\nimpulsado principalmente por actividades antropogénicas como la quema de combustibles fósiles el\ncambio de uso del suelo y la deforestación, ha generado una preocupación global debido a sus\nimplicaciones en el cambio climático (IPCC, 2021). En este contexto, la capacidad de los ecosistemas\nterrestres para secuestrar y almacenar carbono (C) emerge como una estrategia fundamental para\nmitigar los efectos del calentamiento global. Estos ecosistemas actúan como sumideros naturales de\nC, capturando el CO2 atmosférico a través de la fotosíntesis y reteniéndolo en diversas formas, tanto\nen la biomasa vegetal como en el suelo.\nEntre los principales componentes de los ecosistemas terrestres con un rol en el ciclo del carbono,\ndestacan los bosques, los suelos minerales y las turberas. Los bosques, con su biomasa arbórea,\nrepresentan uno de los mayores reservorios de carbono terrestre. Se estima que, a nivel mundial, se\nalmacenan aproximadamente 861 gigatoneladas de carbono (GtC), de las cuales 327 GtC se\nencuentran en la biomasa viva y 383 GtC en el suelo (Pan et al., 2011). Además de los árboles, el\nsuelo es un reservorio de carbono aún más grande. Se calcula que los suelos del mundo contienen\nentre 1500 y 2400 GtC en sus primeros metros de profundidad, superando con creces la cantidad de\ncarbono en la atmósfera y el almacenado por la biomasa vegetal (Jobbágy & Jackson, 2000). En\nparticular, las turberas son un subtipo de suelo que, debido a sus condiciones hidromórficas, acumulan\nuna gran cantidad materia orgánica en superficies terrestre relativamente pequeñas, comparadas con\notros reservorios (aproximadamente el 3% de la superficie terrestre), son los ecosistemas con la mayor\ndensidad de carbono por unidad de área, almacenando un estimado de 550 a 600 GtC a nivel global,\nlo que representa aproximadamente un tercio del carbono del suelo mundial (Yu et al., 2010). La\ncomprensión de los mecanismos de secuestro de carbono en estos ecosistemas, así como la\ncuantificación precisa de las cantidades de C almacenado y su dinámica bajo diferentes escenarios de\ncambio climático y manejo antrópico, son esenciales para desarrollar estrategias efectivas de\nmitigación.\nEl presente informe presenta los resultados de un estudio pionero cuyo objetivo principal fue la\nestimación del carbono total almacenado en los ecosistemas terrestres del futuro Parque Nacional\nCabo Froward (PNCF), ubicado en la Península de Brunswick Chile, correspondiente al extremo más\naustral, de manera terrestre continua, del continente americano (Figura 1).\n4\nFigura 1. Área de estudio.\nTurberas en la Península de Brunswick\nLas turberas son reservorios vitales de carbono que desempeñan un papel fundamental en la\nmitigación del cambio climático, la conservación de la biodiversidad y la provisión de servicios\necosistémicos (Lázaro-Lobo et al., 2023). Su protección y gestión adecuadas son cruciales para\ngarantizar su conservación a largo plazo y maximizar los beneficios que proporcionan tanto a nivel\nlocal como global. Son ecosistemas terrestres únicos que desempeñan un papel crucial en el ciclo\nglobal del carbono, aunque ocupan sólo alrededor del 3% de la superficie terrestre mundial,\nalmacenan casi un tercio del carbono total mundial, lo que las convierte en uno de los mayores\nreservorios de carbono del planeta (Masterson, 2021).\nEn Sudamérica, las turberas se encuentran principalmente en el cono sur, siendo Chile y Argentina\nlos principales países con superficies de este tipo. Históricamente han sido menos estudiadas que las\nencontradas en el hemisferio norte, debido posiblemente a superficies limitadas de extensión o su\ninaccesibilidad (Domínguez y Vega, 2015). En la Región de Magallanes, una de las amenazas\nexistentes es la extracción de este recurso, afectando 444 hectáreas (0,16%) de la superficie total de\nla región. Lo anterior equivale a más de 6.200 toneladas de turba en el año 2018 (SERNAGEOMIN,\n2019; Domínguez, 2021).\nPara este tipo de ecosistemas existen clasificaciones según varios criterios dependiendo del tipo de\nestudio y enfoque que se tenga, por ejemplo, la topografía, hidrología, composición química del agua,\nentre otros. Pisano (1977), clasifica las turberas utilizando un criterio fitogeográfico que se relaciona\ncon el clima y la composición de especies, obteniendo tres tipos de turberas: turberas de Sphagnum\nmagellanicum o esfagnosas, turberas graminoides y las turberas pulvinadas. Las turberas esfagnosas\n5\nestán dominadas por cojines laxos del musgo Sphagnum magellanicum (Domínguez y Vega, 2015).\nAdemás, Sphagnum Magellanicum o “pompón”, también es usado comercialmente como sustrato en\nviveros para orquídeas, poniendo en peligro este recurso (Alarcón, 2023).\nLas turberas graminoides están dominadas por especies similares a gramíneas, estos ecosistemas\npresentan una apariencia similar a la de una pradera. La vegetación dominante también puede incluir\nbriófitas, líquenes y algunos árboles dispersos (Domínguez y Vega, 2015). Por último, las turberas\npulvinadas están dominadas por plantas que crecen en forma de cojines compactos y duros, formadas\npor las especies Donatia fascicularis y Astelia pumila principalmente (Domínguez y Vega, 2015). A\nveces, forman parches dentro de las turberas de Sphagnum y las turberas graminoides en la Región\nde Magallanes y al norte de esta región, se encuentran como islas en las cimas más altas, expuestas y\nlluviosas de la Cordillera de la Costa entre Temuco y Chiloé (Domínguez y Vega, 2015).\nEn particular, en la zona de Cabo Froward se estima de manera preliminar una superficie de alrededor\nde 9.729 ha de turberas y humedales, pero no se cuenta con información de su tipología o validaciones\ncon datos de campo locales para la estimación de secuestro y almacenamiento de carbono (Fundación\nRewilding Chile, 2025).\nSi bien la Corporación Nacional Forestal (CONAF) ha desarrollado un sistema detallado de\nclasificación del uso de la tierra en Chile, que incluye la región de Magallanes y la Península de\nBrunswick, las turberas suelen ser clasificadas de manera poco precisa. Frecuentemente, son\nclasificadas como algún tipo de matorral, pradera y/o renovales de bosque nativo.\nLos bosques y matorrales de Cabo Froward\nLa Península de Brunswick, ubicada en la región de Magallanes, alberga una diversidad de bosques\nsubantárticos que se caracterizan por su vegetación densa y resiliente. Entre las especies arbóreas\ndominantes se encuentran el coigüe de Magallanes (Nothofagus betuloides), la lenga (Nothofagus\npumilio), el canelo (Dimitris winteri) y el ciprés de las guaitecas (Pilgerodendron uviferum), que\nforman extensos bosques de hoja perenne y caduca. Con una menor participación, y generalmente en\nuna posición de dosel intermedio o bajo, se encuentra la leña dura (Maytenus magellanica). Pueden\ncorresponder a bosque nativo adulto denso, bosque nativo adulto-renoval denso o bosque nativo\nadulto-renoval semidenso. Estos bosques no solo son vitales para la biodiversidad local, sino que\ntambién desempeñan un papel crucial en la captura de carbono y la regulación del clima. La estructura\nde estos bosques varía desde densos matorrales en las zonas más expuestas a los vientos, hasta\nformaciones arbóreas más altas y cerradas en áreas protegidas, creando un mosaico de hábitats que\nsustentan una rica fauna y flora endémica. Las formaciones arbustivas se presentan en distintos tipos\ncomo matorral arborescente abierto y matorral-pradera denso. Estas tipologías de bosque son\ncomunes en áreas donde se ha producido una regeneración natural causada por perturbaciones como\nincendios o tala selectiva de árboles (CONAF, 2019).\nPara la Región de Magallanes, el Programa Austral Patagonia (2019) indica que los bosques nativos\npresentan un importante contenido de carbono en la biomasa, tanto muerta como viva. Los promedios\nde biomasa muerta varían entre 92,2 y 100,7 Mg C/ha, mientras que la biomasa viva se encuentra en\nun rango de 43,3 a 47,4 Mg C/ha, dependiendo del tipo de bosque (Achaparrado, Adulto, Renoval y\nAdulto-Renoval). Estos valores reflejan la relevancia de los bosques de Magallanes como importantes\nreservorios de carbono en la región (Tabla 1).\nEn el mismo informe (Programa Austral Patagonia, 2019), se indica que los matorrales muestran una\nmenor acumulación en biomasa muerta (10,1 Mg C/ha) y viva (8,1 Mg C/ha), mientras que las\n6\npraderas (herbazales) presentan valores aún más bajos en biomasa muerta (0,8 Mg C/ha) y viva (2,0\nMg C/ha). Por su parte, reportan que las turberas, en promedio, exhiben un contenido de 30 Mg C/ha.\nTabla 1. Valores de referencia entre biomasa muerta y viva en Programa Austral Patagonia, 2019.\nBiomasa muerta (Mg C ha-1) Biomasa viva (Mg C ha-1)\nUso de suelo forestal\nPromedio D.E. Promedio D.E.\nBosque Nativo Renoval 100,7 41,1 47,4 19,3\nBosque Nativo Adulto 98,6 38,2 46,3 17,9\nBosques Nativo Adulto- Renoval 99,1 36,7 46,6 17,2\nBosque Nativo Achaparrado 92,2 35,8 43,3 16,8\nPromedio 97,7 37,9 45,9 17,8\n7\n2. Objetivos\nEste objetivo de este estudio se centra en la delimitación y cuantificación de las superficies ocupadas\npor bosques nativos y turberas dentro de los límites geográficos del futuro Parque Nacional Cabo\nFroward y la estimación del almacenamiento de Carbono en cada uno de ellos.\nPara lo anterior, se propone la utilización de una metodología combinada que integre:\n● Análisis de imágenes satelitales de media resolución para la identificación y clasificación de\nlas coberturas vegetales presentes, con especial énfasis en la diferenciación entre bosques\nnativos y turberas.\n● Muestreo de campo para la medición de biomasa aérea y la toma de muestras de suelo y\nturberas a distintas profundidades.\n● Análisis de laboratorio de las muestras de suelo para determinar el contenido de carbono\norgánico.\n8\n3. Materiales y Métodos\nEn la Figura 2 se resume el enfoque general utilizado para estimar el almacenamiento de carbono.\nComienza con la estimación de superficies mediante clasificación de imágenes satelitales para\nidentificar la cobertura del suelo. Luego, se toman datos en el campo, como la profundidad y muestras\nde laboratorio en turberas, y la composición y estructura en bosques. Los datos recolectados se\nprocesan, incluyendo análisis específicos tanto cuantitativos de bosques como de profundidad. Las\nmuestras se analizan en laboratorio y se estima el almacenamiento promedio de carbono en toneladas\npor hectárea. Finalmente, se calcula el almacenamiento total por componente, integrando toda la\ninformación recopilada. Se realizaron dos campañas de terreno, en mayo y diciembre de 2024, de seis\ny siete días, respectivamente. En la primera se discutieron y se probaron los métodos de colecta de\ndatos tanto para turberas, profundidades y muestras para laboratorio, como bosques (estructura y\ncomposición). En la segunda se completó la muestra abarcando más sectores.\nFigura 2. Esquema metodológico general.\n3.1. Estimación de superficies\nPara estimar las superficies por tipo de formación vegetal se adoptó un enfoque de clasificación digital\nsupervisada con imágenes satelitales del programa Landsat. En primer lugar, se construyó un conjunto\nde áreas de entrenamiento para las clases consideradas, 13 en total, que se fotointerpretaron sobre\nimágenes de mayor resolución espacial sobre imágenes Planet y Google Earth (Ver figura 3).\nLas clases incluidas fueron (en paréntesis se presenta el identificar de la clase en el ráster clasificado):\na. Turberas:\na.1. Pulvinada (1)\na.2. Sphagnum (2)\na.3. Sphagnum leñoso (3)\n9\na.4. Graminoide (5)\na.5. Mosaico (6)\nb. Bosques:\nb.1. Bosque primario (8)\nb.2. Renoval (9)\nb.3. Achaparrado (10)\nc. Herbáceas (11)\nd. Agua (7)\ne. Suelo desnudo (12)\nf. Nieve (13)\nFigura 3. Áreas de entrenamiento para las clases consideradas para clasificación.\nEn segundo lugar, se creó un mosaico anual con todas las imágenes Landsat disponibles para el año\n2024. Posteriormente, se obtuvieron bandas adicionales para generar un mosaico ampliado, de 184\nbandas en total, que se usó para entrenar un clasificador random forest (Breiman, 2001). El mosaico\nfinal incluyó estadísticas anuales resumidas de las bandas originales de landsat, índices y fracciones\nderivados. Las estadísticas incluyeron la mediana, desviación estándar, mínimo, máximo y dos\nvariables adicionales asociadas al NDVI: valor cuando el NDVI era el más alto anual (percentil 75%)\ny cuando era el valor más bajo (percentil 25%). Finalmente, la clasificación digital se realizó\nutilizando el algoritmo Random Forest (Breiman, 2001), disponible en Google Earth Engine, con 100\niteraciones, y se obtuvieron las estadísticas de exactitud asociadas a la calidad del producto final\n10\n(matriz de confusión y métricas asociadas). Las superficies, en hectáreas por clase, fueron obtenidas\nde la clasificación final.\n3.2. Estimación de carbono en bosques\nDurante las campañas de terreno se levantaron un total de 48 estaciones muestrales, 19 en bosques\nprimarios, 11 en renovales y 18 para estratos leñosos sobre turberas. Las estaciones muestrales\ncomprenden un punto de muestreo puntual horizontal para árboles, una subparcela de 25 m2 para\nsotobosque, dos submuestras de biomasa del sotobosque (cubos) y dos subparcelas para necromasa\n(0.5, 1.0 o 2.0 m2).\n3.2.1. Biomasa aérea de bosques\nEn cada unidad muestral (Figuras 6 y 7) se realizó una parcela de muestreo puntual horizontal con\nFAB 2 o 4 m2 ha-1, con partida al azar (Yang et al., 2017). En total se realizaron 35 parcelas\nseleccionadas por accesibilidad y en cantidad restringida por el tiempo disponible en terreno\n(Apéndice I). El método consiste en una proyección horizontal del diámetro normal (DAP) de los\nárboles que califican para mediante un ángulo de selección, utilizando el dendrómetro Kramer (Figura\n4). A todos los árboles seleccionados se les midió el DAP y una submuestra de alturas totales (Ht)\nrepresentativas del rango diamétrico con pistola Haga. Ello permitió ajustar modelos DAP vs Ht por\nespecie para estimar la altura de los árboles sin este valor. La información recolectada, sirvió para la\ncaracterización de los rodales con los siguientes atributos: i) densidad de árboles (N/ha) y ii) biomasa\naérea total (t/ha) en base a funciones alométricas.\nFigura 4: Utilización del muestreo puntual horizontal con dendrómetro Kramer.\nPara obtener la altura total (Ht) de los individuos arbóreos a partir del diámetro a la altura del pecho\n(DAP), usando la submuestra de datos de terreno, se ajustaron y evaluaron distintas formas\nfuncionales comúnmente utilizadas en estudios alométricos y se seleccionó con el coeficiente de\ndeterminación ajustado más alto (R² ajustado). Además, se evaluaron los gráficos de dispersión de\nlos residuos. Esta metodología permitió identificar cuál relación funcional describe de mejor forma\nel patrón de crecimiento observado en cada especie en particular con los datos obtenidos en terreno\n(Tabla 2).\n11\nTabla 2: Modelos usados para la estimación de alturas.\nEspecie Tipo de modelo Fórmula del modelo Comentarios\nMejora el ajuste respecto al\nCanelo Log-log Ht = a + DAPb modelo lineal, captando\nmejor la variación curvilínea.\nRefleja adecuadamente la\nHt = a + b x log (DAP) desaceleración del\nCiprés de las Guaitecas Logarítmico\ncrecimiento en altura con\ndiámetros mayores.\nPresentó el mejor ajuste\nCoigüe de Magallanes Lineal Ht = a + b × DAP lineal entre DAP y altura en\nlos datos observados.\nMejor desempeño en especies\nLeña dura Log-log Ht = a + DAPb leñosas de porte bajo, con\ncrecimiento no proporcional.\nEstos modelos no fueron tomados estrictamente de literatura externa, sino ajustados directamente a\nlos datos recolectados en terreno, lo cual garantiza que reflejan de mejor manera las condiciones\necológicas y estructurales de los bosques presentes en Cabo Froward. Para la estimación de la biomasa\nde las distintas especies se ocuparon distintas funciones alométricas extraídas de diferentes fuentes\npara la Región de Magallanes (Tabla 3).\nTabla 3: Funciones alométricas.\nNombre común Función/es alométrica/s\nLn PTA = -1,68 + 2,15 Ln DAP\nCoigüe de magallanes\nLn PSA = -5,73651 + EXP (3,25257 + 0,07943 DAP)\nCanelo Ln PSRaíz = (-1,48839 + 0,35960 DAP)2\nFunción de biomasa aérea: VC * D * FEB\nCiprés de las guaitecas\nLeña dura Función de biomasa aérea: VC * D * FEB\nNotas: PTA = Peso seco total del árbol; DAP = Diámetro a la altura del pecho; PSRaíz = Peso seco raíces; VC = Volumen bruto fustal\n(m3/ha) árboles con DAP >= 4cm; D = Densidad básica de la madera = 405,0 kg/m3 para Ciprés de las Guaitecas y 799,1 kg/m3 para\nLeña Dura; FEB= Factor de expansión de biomasa (biomasa aérea seca/biomasa aérea comercial) = 1,75\n12\n3.2.2. Estimación de volúmenes y carbono: bosque y matorrales\nPara la estimación del carbono almacenado en bosques, y con las alturas ya estimadas de los árboles\ngracias a los modelos usados, se recopilaron funciones alométricas conocidas para cada especie\nmuestreada. Para el canelo se obtuvieron funciones para la biomasa aérea y raíces de forma separada,\npero para el ciprés de las Guaitecas, coigüe de Magallanes y leñadura se ocuparon funciones para\ncalcular la biomasa total directamente. Luego se calculó el volumen usando el DAP, la altura estimada\ny el factor de forma para cada especie. Volumen que se divide por el área basal del árbol, obteniendo\nla altura comercial media del árbol que luego es sumado para cada parcela por especie.\nAdicionalmente, se registraron los siguientes datos en cada estación de muestreo:\n■ Coordenadas del punto central con GPS usando WGS84 UTM 18s.\n■ Cobertura y altura promedio de sotobosque (arbustos y herbáceas), de manera agregada, en\nparcelas de 5x5 m2. Con estos datos se obtuvo el volumen estéreo total por parcela (m3).\n■ Extracción de dos muestras de biomasa arbustos y herbáceas, de manera agregada, usando\ncubos de 25 cm o 50 cm de lado, según densidad del volumen vegetal. Las muestras fueron\nllevadas a laboratorio y secadas hasta peso constante. Con el valor resultante (kg/m3) se\nconvirtió el volumen estéreo del sotobosque a peso seco y se expandió a valores de ton/ha.\nSe usó un valor medio de 0,4964 (Infor, 2021) en la conversión de biomasa a carbono\nequivalente (Figura 5).\n■ Medición de necromasa en subparcelas de 0,5 x 0,5 m2, 1 x 1 m2 o 5 x 5 m2, según la densidad\ndel sotobosque (más pequeña en lugares con mayor densidad). Se midió el largo y diámetro\npromedio de todas las ramillas, ramas y troncos muertos dentro de cada subparcela. Se usó la\nfórmula de Smalian para calcular los volúmenes de cada troza o rama y una densidad\nponderada de las especies dominantes presentes de 0,484 (Coigüe = 66,3%; canelo=12,9%,\nciprés=19,4%; leña dura =1,1%) para calcular el peso seco. Además, se asumió un nivel de\ndegradación media ponderando por un factor de 0,65 (Infor, 2021). Finalmente, se usó un\nvalor medio de 0,4964 (Infor, 2021) en la conversión de biomasa a carbono equivalente.\nFigura 5: Parcelas de necromasa (izquierda) y cubos de biomasa en sotobosque (derecha).\n13\n■ Para evaluar los individuos leñosos que crecen sobre las turberas, se realizaron 16 parcelas\nde 400, 225 o 100 m2 en algunas zonas de turberas. En ellas se registró la especie, DAP y\nAltura total de los individuos leñosos. En segundo lugar, se registró el volumen de arbustos\ny se tomaron muestras usando el mismo sistema de cubos descrito anteriormente. Además,\nse evaluó la regeneración en 4 subparcelas de 4m2.\nLa figura 6 muestra las localizaciones de las estaciones de muestreo en diferentes zonas del área de\nestudio.\nFigura 6. Puntos de muestreo de bosques en Bahía Cordes y Fortescue (arriba) y zona costera en el BNP\nCabo Froward (abajo).\n14\n3.3. Estimación de almacenamiento de C en suelos minerales y turberas\n3.3.1. Caracterización de tipos de turberas\nSe caracterizaron tres tipologías de turbera en el cabo Froward (esfagnosas, graminoides y\npulvinadas), Debido a la ausencia de redes de caminos y acceso por tierra, se accedió a las turberas\nmediante embarcación en lugares cercanos a la costa. Junto a lo anterior se ocupó la herramienta de\nfotointerpretación en los posibles puntos donde existan turberas predominantes de alguno de los tres\ntipos ya clasificados previamente esfagnosas, pulvinadas y graminoides (Figura 7).\nFigura 7. Enfoque metodológico para la caracterización de las turberas.\nDurante el mes de mayo de 2024, se realizó el primer terreno de prospección con el propósito de\nidentificar y corroborar estas formaciones asignadas mediante la fotointerpretación en gabinete.\nPosteriormente, en una segunda visita (diciembre de 2024) se realizó un levantamiento de la\ncomposición florística y dominancia de cada tipo de turbera.\nUna vez en terreno, se generó una matriz de puntos de muestreo a lo largo de la turbera en que se\nmidió la profundidad y se colectaron muestras de turba para medir el carbono. En cada punto de\nmuestreo se registraron variables topográficas, topológicas y vegetacionales. En la figura 8 se\nobservan los puntos de muestreo de profundidad y extracción de muestras para análisis.\n15\nFigura 8. Puntos de muestreo de profundidad zona costera Cabo Froward (arriba zona Oeste y abajo zona\nEste).\n16\nEntre las variables topográficas se consideró la pendiente, distancia al mar y a bosques, mientras que\nla composición cobertura y estructura se utilizaron como variables de tipo categóricas, para clasificar\nlos tipos de turberas prospectadas.\nPara la extracción de muestras de turba y su posterior procesamiento en laboratorio, se tomaron\nmuestras de los puntos con mayor profundidad en los tres tipos de turbera y lugares de interés como\necotonos transicionales de turbera a bosque. El método utilizado, consistió en la extracción de\nmuestras en un volumen conocido mediante el uso de una barrena rusa descrita por Jowsey (1966),\nextrayendo una muestra de aproximadamente 1061 centímetros cúbicos cada 50 centímetros (Figura\n9). Se probaron dos tamaños de muestra (5 cm para la primera prospección y 50 cm de largo en el\nmuestreo intensivo de diciembre de 2024). En total se colectaron y analizaron 64 muestras o núcleos\nde suelo/turbera. Adicionalmente, se usó la barrena desprovista del tubo muestreador, con el propósito\nde pinchar las turberas y acceder una extensa red de puntos de profundidades (n = 280).\nFigura 9. Colecta de núcleos de turba mediante barrena rusa. La imagen de la izquierda muestra el proceso\nde inserción del aparato mediante el acople de barras metálicas de 1m de largo. En la imagen de la derecha\nse muestra el tubo colector de muestras de la barrena el cual permite la extracción de semicilindros de 50 cm\nde profundidad y 2,5 cm de radio.\n3.3.2 Preparación de las muestras\nEn los puntos de colecta de turbera, las muestras se depositaron en bolsas selladas herméticamente\ncon alrededor de 600 g de turba húmeda por tramo de profundidad. Las muestras fueron etiquetadas,\nmantenidas en frío (5°C) y enviadas a laboratorio para secado y determinación de la densidad\naparente. En laboratorio, las muestras fueron pesadas y depositadas en envases de aluminio marcados\npara el secado en estufa de aire forzado a 65°C hasta alcanzar peso constante. Finalmente, con el peso\nseco de las muestras y el volumen conocido del tubo muestreador de la barrena rusa se determinó la\n17\ndensidad aparente de cada muestra (ρ). En el caso de las muestras de suelo mineral, de cada horizonte\nidentificado se extrajo suelo en cilindros metálicos de volumen conocido (98,17 cm3). El\nprocedimiento de secado, pesaje y determinación de la densidad aparente fue el mismo que el\nutilizado para las muestras de turba, para lo cual se utilizó la siguiente fórmula:\n3.3.3. Densidad aparente del suelo\nLa densidad aparente del suelo (ρ) se calcula de acuerdo con la siguiente expresión:\nρ (g/cm3) = masa del suelo seco (g) / volumen de la muestra (cm3)\nCada muestra fue secada y pesada, posteriormente en mortero cerámico las muestras se trituraron y\ntamizaron para obtener un tamaño de agregados de 2 mm. Estas muestras fueron nuevamente\netiquetadas y enviadas a laboratorio para determinar el carbono y nitrógeno total de cada muestra.\n3.3.4. Análisis de carbono almacenado por tipo de turbera y su variación en profundidad\nLas muestras diferenciadas entre cada tipo de turbera, suelo y profundidad se procesaron en el\nlaboratorio de suelos Ventura Matte de la Universidad de Chile. En el laboratorio se utilizó el método\nestándar de análisis de carbono total (C) y método de análisis de nitrógeno total (N), (Wright y Bailey,\n2001). Las muestras se sometieron a un horno de cerámica con diseño horizontal y alta resistencia a\naltas temperaturas produciendo una combustión a los 1350°C. Este tipo de combustión genera gases\ncomo el dióxido de carbono y óxido de nitrógeno, los cuales son recolectados y analizados mediante\nuna celda de detección infrarroja y una celda de conductividad respectivamente (Nelson y Sommers,\n1996). Los resultados de este análisis se expresan en porcentaje de C o N en base a la masa de cada\nmuestra.\nCon los resultados de concentraciones totales de C y N se calculó el promedio por tipo de turbera y\nprofundidad, y se realizó un análisis de varianza (ANDEVA) (Ver figura 10 para la metodología). El\nanálisis de varianza indica si existe una relación significativa entre las profundidades y los tipos de\nturbera sobre los porcentajes de C y N acumulados. Los resultados se expresaron mediante gráficos\nboxplot (Figura 12). Debido a la diferencia del número de repeticiones por cada factor se realizaron\nANOVAs de una vía (one way análisis).\n18\nFigura 10. Pasos metodológicos para Análisis de carbono almacenado por tipo de turbera y su variación en\nprofundidad.\nUna vez procesados los datos, se calculó la cantidad o stock de carbono almacenado en profundidad\nen una hectárea para cada turbera, para lo cual se utilizó la siguiente fórmula de cálculo:\nCstock = A * D * ρ * %C\nDonde C , corresponde al carbono almacenado por unidad de superficie A (1 hectárea), D es la\nstock\nprofundidad del suelo o turbera, ρ, es la densidad aparente del suelo y %C corresponde al porcentaje\nde C determinado en laboratorio. Con esta información se calculó la profundidad media de todas las\nturberas analizadas y se multiplicó por la superficie de turberas reconocidas en la etapa de mapeo\nland cover.\n19\n4. Resultados\n4.1. Superficies por tipos de vegetación y cobertura de suelo\nLos resultados de la clasificación digital muestran que la cobertura de turberas ocupa un total de\n55.993 hectáreas (Tabla 4, figura 11). Dentro de esta categoría, las formaciones de Sphagnum con\npresencia de individuos leñosos, con 22.890 hectáreas, y pulvinada, con 19.162 hectáreas, son las\npredominantes. Los bosques también representan una cobertura significativa, sumando 58.200\nhectáreas, siendo el bosque primario la clase más extensa dentro de esta categoría, con 38.466\nhectáreas.\nTabla 4: Superficies por tipos de vegetación y cobertura de suelo\nClases de Cobertura de Subclases de cobertura de Hectáreas por Hectáreas\nSuelo suelo subclase totales\nPulvinada 19.162\nSphagnum 9.033\nTurberas Sphagnum leñoso 22.890 55.993\nGraminoide 4.823\nMosaico 85\nBosque primario 38.466\nBosques Renoval 5.470 58.200\nAchaparrado 14.264\nAgua 3.984\nHerbáceas 4.994\nOtros 21.410\nZonas descubiertas 11.796\nOtros (hielo, rocas, etc) 635\nTOTAL 141.718\nEs importante señalar que existe un cierto grado de confusión en la clasificación, especialmente entre\nlas diferentes clases de turberas (Apéndice III), donde algunas formaciones pueden presentarse con\nsimilitudes que dificultan una separación clara. Asimismo, se observan posibles confusiones entre los\ntipos de bosques primarios y renovales, lo que puede afectar la precisión de la clasificación en esas\ncategorías. Estas limitaciones están relacionadas con la similitud en las características espectrales y\nla resolución de las imágenes utilizadas en el proceso de clasificación (Figura 3).\nPara el cálculo de la exactitud global las clases se agruparon en otra matriz de confusión juntando las\ntipologías; Turberas, Bosques y Otros, obteniendo para la exactitud global un valor de 95.6% (Tabla\n5).\n20\nTabla 5: Matriz de confusión por grupos de coberturas. La matriz con las subclases se puede revisar en los\napéndices (apéndice III).\nTurberas Bosques Otros\nTurberas 2174 58 23\nBosques 24 1000 15\nOtros 53 16 987\nFigura 11: Resultado de la clasificación digital de tipos de coberturas de suelo.\n21\n4.2. Carbono Almacenado\n4.2.1. Almacenamiento de Carbono en Bosques\nAl aplicar las funciones alométricas, se pudo estimar la altura total de todos los individuos con DAP\nmedido y, a partir de ello, la biomasa aérea y subterránea. Los modelos ajustados DAP-Ht presentaron\nun coeficiente de determinación (R2 ajustado) superiores al 0,80 para todas las especies, lo que indica\nun buen nivel de ajuste tomando en cuenta las condiciones locales. En promedio, el coigüe de\nMagallanes presenta la mayor altura proyectada respecto a su DAP, seguido por el ciprés de las\nguaitecas y el canelo. Por otro lado, la leña dura presenta un porte más pequeño con mayor\ncrecimiento con DAPs menores y uno menor con mayores.\nPara la estimación de biomasa se usaron los modelos alométricos descritos en la Tabla 3.\nPosteriormente, se aplicó el factor de conversión a carbono equivalente (0,4964) para obtener los\nvalores de carbono almacenado tanto para la biomasa aérea como para la biomasa subterránea. Los\nresultados promedios por tipo de formación arbórea se presentan en la Tabla 6. Los datos por parcela\nse presentan en el apéndice II.\nTabla 6. Resumen por tipo de formación vegetal.\nTipo de formación Biomasa total promedio (ton/ha) Carbono total promedio (Cton/ha)\nBosque 426,61 211,77\nRenoval 316,23 156,97\nTurbera 3,46 1,72\nTurbera arborescente 78,15 38,79\nTurbera boscosa 194,07 96,34\nTurbera matorral 4,85 2,41\nEn términos generales, los bosques adultos (primarios) muestran un mayor contenido de carbono por\nhectárea, debido a los mayores DAP y alturas de sus individuos. Mientras que los renovales muestran\nvalores intermedios que son coherentes al menor desarrollo estructural respecto a los bosques\nadultos.\nLa “turbera boscosa” muestra valores considerablemente más altos que los otros tipos de turberas\nmuestreadas, y las turberas arborescentes le sigue, lo que sugiere que la presencia de individuos\nleñosos más grandes aumenta de manera significativa el valor de biomasa aérea y carbono\nalmacenado. Los demás tipos de turbera muestreadas presentan valores bastante menores en\ncomparación debido a la falta de árboles de mayor tamaño.\n4.2.2 Almacenamiento de carbono en turberas y suelos minerales\nLa primera actividad consistió en una caracterización de las turberas de acuerdo con su composición\ny estructura. En la tabla 7, se observa que la tipología que fue más comúnmente muestreada\ncorresponde a la clase graminoide, seguida por las esfagnosas y finalmente las pulvinadas.\n22\nTabla 7. Caracterización de las turberas analizadas en Cabo Froward.\nNombre Tipología de turbera Muestreo\nSan Nicolás Pozas Pulvinada N+P\nFrente Isla Nassau pulvinado Pulvinada N+P\nSan Nicolás Sphagnum N+P\nBahía Cordes Laguna Graminoide con sectores de sphagnum N+P\nBahía Fortescue Sphagnum P\nFrente Isla Nassau esfagnoso Sphagnum N+P\nSector barreno perdido Graminoide P\nTurbera Lengüeta Sphagnum con sectores graminoides N+P\nSendero del caminante Sphagnum N+P\nBahía Cordes (norte, sur y bosquete) Pulvinada con sectores graminoides y N+P\nsphagnum\nRío del oro Graminoide P\nNota. N: Extracción de núcleo, P: Medición de profundidad.\n4.2.3. Efecto de la profundidad sobre el carbono total (%C) y nitrógeno total (%N)\nEn el análisis de varianza para el carbono total (%C) no se encontraron diferencias significativas en\nlas concentraciones de carbono en función de la profundidad del suelo (Tabla 8). En otras palabras,\nlas variaciones observadas en las concentraciones de carbono no pueden atribuirse a la profundidad\ndel suelo, sino que probablemente se deben a otras fuentes de variación o al azar.\nPara el caso del nitrógeno total (%N) se encontraron diferencias significativas (p<0,05) entre las\nconcentraciones de nitrógeno y la profundidad de la muestra (Tabla 9). Esto significa que la\nprofundidad tiene un efecto sobre las concentraciones de nitrógeno total, indicando que los resultados\nno son producto del azar y si están influenciadas por la profundidad del suelo. Los resultados de\ncarbono y nitrógeno total se observan en las figuras 13 y 14.\nTabla 8. Resultados del ANDEVA para concentraciones de carbono.\nDf Sum Sq Mean Sq F value Pr (>F)\nProfundidad (cm) 1 80 79,71 0,484 0,49\nResiduals 44 7.244 164.63\n23\nTabla 9. Resultados del ANDEVA para concentraciones de nitrógeno\nDf Sum Sq Mean Sq F value Pr (>F)\nProfundidad (cm) 1 20,65 20,65 4,308 0,0438*\nResiduals 44 210,91 4,793\nCarbono total\nEl análisis visual de la gráfica boxplot (Figura 12) confirma lo encontrado en el ANDEVA, es decir,\nno hay diferencias significativas en profundidad, con valores cercanos al 50% en base a masa. Llama\nla atención la amplia variabilidad de los datos en la profundidad cercana a 150 cm, probablemente\nesta condición esté asociada a la presencia de capas de sustrato con bajo porcentaje de carbono\norgánico que estarían provocando un efecto de dilución del %C. Lo anterior concuerda con al menos\ndos capas de tefra volcánica félsica encontrada en profundidades que en el área de estudio varían de\n100 a 200 cm de profundidad y otra anomalía a los 230 cm. De acuerdo con Loisel & Bunsen (2020),\nen el extremo sudamericano, existe evidencia de capas de tefra provenientes de erupciones de los\nvolcanes Burney, Hudson y Reclus. Excluyendo los rangos con presencia de tefra, no se encontraron\nmuchos valores atípicos, sugiriendo en su mayoría que los datos están en el rango esperado, sin\nvariación significativa en la profundidad.\nNitrógeno total\nEl Nitrógeno total mostró una mayor variabilidad en función de la profundidad, con valores más altos\nen algunas capas del suelo i.e. 150 -200 y 250-300 (Figura 12). Lo anterior podría relacionarse con\ncambios en la composición florística en el pasado y al aporte de N que ocurre durante los ciclos\neruptivos volcánicos.\nAdemás, se identificaron valores atípicos, lo que indica la presencia de posibles anomalías o la\ninfluencia de procesos biogeoquímicos diferenciados en ciertas profundidades específicas.\n24\nFigura 12. Distribución del porcentaje de carbono (arriba) y Nitrógeno (abajo) en turberas en profundidad.\n4.2.4. Estimación de profundidades máximas medias\nSe analizaron las profundidades medias máximas de todas las turberas muestreadas en las campañas\nde medición de terreno. Las turberas muestran un comportamiento interno heterogéneo en cuanto a\nsus profundidades. Este comportamiento fue modelado a través de interpolación geoestadística (i.e.\nkriging) para algunas zonas seleccionadas (Figura 14). Sin embargo, al comparar las profundidades\nmedias máximas entre turberas donde se colectaron núcleos para análisis de C, N y ρ, se observa que\nson estadísticamente iguales, no encontrándose una tendencia por tipología de turberas (Figura 13 y\nTabla 9). Debido a esto, se utilizó el valor promedio de todas las profundidades de las turberas\nanalizadas (199 cm), como un criterio conservador para la extrapolación al resto de las turberas del\nárea de estudio que no fueron visitadas en terreno. Al comparar todos los sectores de turbera\n25\nprospectados (con y sin extracción de núcleos), si hay diferencias en cuanto a las profundidades\nmedidas, lo cual resulta propio de la condición natural de la geografía del lugar (Figura 15).\nFigura 13. Valores de profundidad promedio máxima en Núcleos de Turberas de Cabo Froward.\nFigura 14. Interpolación de profundidad (cm) de turberas vía kriging. A: subzona Bahía Fortescue. B:\nsubzona Bahía Cordés.\n26\nFigura 15. Valores de profundidad promedio máxima en turberas de Cabo Froward (con muestreo de\nnúcleos y puntos de pinchar).\nLa estimación del carbono total almacenado se realizó mediante el promedio de núcleos colectados\npara cada turbera, considerando la suma de todas las profundidades muestreadas (Figura 16). Se pudo\nobservar que el stock de carbono almacenado varía entre 2441 Mg/ha (toneladas métricas por\nhectárea) y 1282 Mg/ha. Sin embargo, estos valores dependen en gran medida de la profundidad de\nla turbera. Los valores de este estudio se encuentran en los rangos informados por Loisel & Bunsen\nen el extremo sur de Sudamérica (2020) de 560 - 1410 Mg/ha. Holden & Connolly (2011) informan\nvalores de C almacenado para Irlanda entre 530 y 3303 Mg/ha, en profundidades de turberas de 100\n- 650 cm. Otros autores informan turberas con valores menores a los encontrados en nuestro estudio,\nasí en Michigany Minnesota (USA), Chimner et al. (2014) el valor promedio alcanzado es de 544,7\nMg/ha.\n27\nFigura 16. Carbono total almacenado (C ) en las turberas analizadas.\nstock\nLas turberas, al ser cuerpos orgánicos bastante profundos y con bajo grado de descomposición,\npresentan una mayor capacidad de almacenamiento de carbono en relación con el suelo mineral no\norgánico. En las turberas de Cabo Froward se encontraron valores de densidad aparente (Da)\npromedio de 0,169 g/cm3, una masa del sustrato total de 3.379,90 Mg/ha y el contenido promedio de\ncarbono alcanzó a los 1508,07 Mg C/ha, para una profundidad media de 199 cm, destacando su rol\ncomo sumidero de carbono a largo plazo (Tabla 10).\nTabla 10: Resumen de propiedades físicas de turberas.\nPromedio C Promedio Da Promedio vol/ha Promedio Mg/ha Promedio Mg C/ha\n44,61% 0,1698 19900 3.379,90 1.508,07\n4.2.5. Comparación de carbono entre componentes\nAdemás de un análisis específico para las turberas, también se estimó el carbono almacenado en otras\ncomponentes superficiales y subterráneas de Cabo Froward: hojarasca (Oi), suelo mineral (Tabla 11).\nHojarasca (Oi): Corresponde a la fracción más superficial del horizonte orgánico (fijado en una\nprofundidad <= 5cm). Con una densidad aparente promedio de 0,29 g/cm3, con una biomasa de\n145,88 Mg/ha y el carbono promedio estimado fue de 53,22 Mg C/ha, indica que es un componente\nimportante pero menor y superficial del almacenamiento de C en suelos.\nSuelo mineral: Fueron definidas como suelo bajo la capa de hojarasca o capas orgánicas, contienen\ncontenidos de carbono rondando el 40% y con una densidad aparente promedio de 0,159 g/cm3. Con\nuna biomasa de 478,11 Mg/ha y un promedio de carbono de 189,61 Mg C/ha. Para el caso del suelo\nmineral, la estimación del C , consideró una profundidad de 30 cm.\nstock\n28\nTabla 11: Almacenamiento total promedio por tipo de componente y subcomponente. Los subcomponentes de\nBosques Árboles y Sotobosque incluyen biomasa aérea y subterránea.\nComponente ton/ha Subcomponente Ton/ha\nÁrboles 191,68\nSotobosque 0,96\nBosques 536,2 Necromasa 100,73\nHojarasca 53,22\nSuelo mineral 189,61\nÁrboles 9,32\nSotobosque 2,46\nTurberas 1647,5\nNecromasa 19,19\nTurba 1.508,07\nLa figura 17 muestra una comparación final entre los almacenamientos de carbono promedio entre\nbosques y turberas y sus subcompartimentos.\nFigura 17. Comparación del carbono promedio almacenado entre bosques y turberas por compartimento.\n29\n5. Conclusiones\nEste estudio pionero en el Parque Nacional Cabo Froward revela la significativa capacidad de\nalmacenamiento de carbono en sus ecosistemas terrestres, con especial énfasis en bosques y turberas.\nLos hallazgos clave son:\n▪ Superficies de turberas: Las turberas cubren una superficie de 55.993 hectáreas.\n▪ Bosques como sumideros clave: destacan como importantes reservorios de carbono,\nalmacenando un total de 31.206.840 Mg C en un área de 58.200 hectáreas, equivalente a\n536.2 Mg C/ha.\n▪ Considerable almacenamiento de carbono en turberas: Las turberas almacenan un total de\n92.248.467,5 toneladas de carbono. El almacenamiento promedio es de 1647,5 Mg C/ha en\nel área de estudio.\n▪ Almacenamiento total y promedio: Los bosques y turberas del área de estudio almacenan un\ntotal de 123.455.307,5 Mg C con un almacenamiento promedio ponderado de 871,13 Mg\nC/ha.\nLas campañas de terreno permitieron caracterizar y colectar muestras para los análisis de densidad y\ncarbono. No obstante, la accesibilidad a los sitios de muestreo puede sesgar los datos debidos a la\ncercanía al mar y exclusión de terrenos de pendientes abruptas y mayor rango altitudinal.\nEl Parque Nacional Cabo Froward alberga ecosistemas valiosos para la mitigación del cambio\nclimático, con un considerable potencial de almacenamiento de carbono, especialmente en turberas.\nSe recomienda implementar estrategias de conservación y manejo sostenible para proteger estos\necosistemas y maximizar su función como sumideros de carbono.\n30\n6. Agradecimientos\nLos autores agradecen el apoyo financiero, así como los medios logísticos provistos por el personal\nde la Fundación Rewilding Chile, así como al Dr. Fabrice Lambert de la Pontificia Universidad\nCatólica de Chile por facilitar el uso del equipo que permitió la colecta de muestras de turba en\nprofundidad. Además, se agradece el apoyo en identificación de medioambientes y flora al Dr.\nCristian Estades y al equipo CESAF de la Universidad de Chile.\n31\n7. Referencias\n➢ Alarcón, M. (2023, octubre 11). Peatlands: A Chilean Treasure Hidden in Patagonia.\nRecuperado 23 de octubre de 2024, de Pulitzer Center website:\nhttps://pulitzercenter.org/projects/peatlands-chilean-treasure-hidden-patagonia\n➢ Breiman, L. (2001). Random forests. Machine learning, v. 45, n. 1, p. 5-32\n➢ Chimner, R. A., Ott, C. A., Perry, C. H., & Kolka, R. K. (2014). Developing and evaluating\nrapid field methods to estimate peat carbon. Wetlands, 34(6), 1241-1246.\n➢ Corporación Nacional Forestal (CONAF). (2019). Sistema de Información Territorial - 12.\nRegión de Magallanes Actualización 2017-2019 Zona 3. Recuperado de https://sit.conaf.cl/\n➢ Domínguez, E., & Vega, D. (2015). Funciones y servicios ecosistémicos de las turberas en\nMagallanes. Recuperado de https://hdl.handle.net/20.500.14001/3576\n➢ Fundación Rewilding Chile. (2025). Proyecto parque nacional en Cabo Froward. Recuperado\nde https://www.rewildingchile.org/proyectos/p