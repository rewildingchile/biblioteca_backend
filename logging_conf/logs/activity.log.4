6c-82b6-d5b8e89b43e0', 'drive_file_id': '1MLyOGhqYtHyInHTJ7_w4UYWpyozatmXt', 'name': 'Visión 2035 - Rewilding Chile.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1MLyOGhqYtHyInHTJ7_w4UYWpyozatmXt/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 26, 40, 507000, tzinfo=datetime.timezone.utc), 'text_content': 'Desde la Ruta de los Parques de la Patagonia al\nCorredor Andino: una Visión 2035 de Rewilding\nChile\nContenido\nContinuando el legado ....................................................................................................................................................................... 2\nEl rewilding: una estrategia proporcional a la escala de la crisis ........................................................................................................ 2\nNuestra brújula para el 2035 .............................................................................................................................................................. 2\nPropuesta de impacto ................................................................................................................................................................ 2\nVisión .......................................................................................................................................................................................... 3\nMisión ......................................................................................................................................................................................... 3\nEnfoque ...................................................................................................................................................................................... 3\nNuestro Plan de Expansión ................................................................................................................................................................. 3\nObjetivos de largo alcance ................................................................................................................................................................. 4\nObjetivo de largo alcance 1. Consolidar la Ruta de los Parques de la Patagonia como un referente de conservación a nivel\ncontinental. ................................................................................................................................................................................ 4\nObjetivo de largo alcance 2. Expandir el rewilding a lo largo de todo el Corredor Andino. ....................................................... 6\nEstrategia de impacto 2035 ................................................................................................................................................................ 8\nObjetivos 2026-2028 .................................................................................................................................................................. 8\nProgramas de Vida Silvestre ............................................................................................................................................... 8\nConservación terrestre ....................................................................................................................................................... 9\nConservación marina .......................................................................................................................................................... 9\nVinculación comunitaria ................................................................................................................................................... 10\nObjetivos 2029-2031 ................................................................................................................................................................ 10\nProgramas de Vida Silvestre ............................................................................................................................................. 10\nConservación terrestre ..................................................................................................................................................... 10\nConservación marina ........................................................................................................................................................ 10\nVinculación comunitaria ................................................................................................................................................... 11\nObjetivos 2032-2035 ................................................................................................................................................................ 11\nProgramas de Vida Silvestre ............................................................................................................................................. 11\nConservación terrestre ..................................................................................................................................................... 11\nConservación marina ........................................................................................................................................................ 12\nVinculación comunitaria ................................................................................................................................................... 12\nMonitoreo, evaluación y aprendizaje ....................................................................................................................................... 12\nNuestro aporte a las metas globales de conservación ..................................................................................................................... 13\n1\nContinuando el legado\nEn Rewilding Chile, somos una fundación sin fines de lucro que forma parte del legado de Douglas y\nKristine Tompkins, quienes a inicios de los años noventa dedicaron su vida a proteger la belleza y la\nbiodiversidad de la Patagonia chilena frente a la crisis de extinción de especies y el cambio climático.\nTres décadas después, seguimos comprometidos con esa misión, protegiendo y restaurando ecosistemas\ncompletos y funcionales.\nNuestro trabajo se ha concentrado en la Ruta de los Parques de la Patagonia Chilena, un extenso\nterritorio de más de 2.800 kilómetros y 17 parques nacionales entre Puerto Montt (41° S) y Cabo de\nHornos (56° S). Junto a Tompkins Conservation, nos enorgullece haber contribuido a la fecha con la\nprotección definitiva de más de 4.000.000 de hectáreas, y la restauración de ecosistemas clave para esta\nregión del continente.\nNuestra Visión 2035 traza el rumbo de Rewilding Chile para la próxima década, guiada por un principio\ncentral: la restauración de poblaciones de vida silvestre como motor de recuperación ecológica a gran\nescala. Desde la Patagonia —el ancla austral de la cordillera de los Andes y nuestro territorio de\naprendizaje— aspiramos a expandir el rewilding hacia el norte a lo largo de la cordillera, fortaleciendo la\nconexión entre ecosistemas, especies y comunidades.\nEl rewilding: una estrategia proporcional a la escala de la crisis\nNos encontramos en un momento decisivo para la vida en el planeta. La comunidad científica ha\nalertado sobre una disminución acelerada de la biodiversidad, al punto de describirla como la sexta\nextinción masiva y la primera causada por una sola especie: el ser humano. La evidencia registrada desde\n1970 es contundente, ya que las poblaciones de vertebrados han disminuido en promedio un 73%,\nmientras que en América Latina la caída alcanza un alarmante 95%.\nLa crisis actual exige proteger hábitats y prevenir pérdidas, pero además demanda acciones concretas\nque ayuden a la naturaleza a sanar. Ese es el objetivo del rewilding, una estrategia de conservación que\nbusca restaurar la integridad ecológica.\nConcebido desde sus orígenes como una respuesta proporcional a la crisis de extinción, el rewilding fue\ndefinido por Michael Soulé y Reed Noss (1998) como una estrategia de conservación a gran escala,\nsustentada en la protección de grandes núcleos de hábitat, la habilitación de corredores de conectividad\ny la recuperación de especies clave. Desde entonces, ha mantenido una vocación continental,\nentendiendo que la restauración ecológica sólo puede alcanzarse si trasciende los límites de áreas\naisladas, para abarcar paisajes y sistemas biogeográficos completos donde la vida silvestre y los procesos\nnaturales puedan desarrollarse libremente.\nNuestra brújula para el 2035\nPropuesta de impacto\nRestauración de ecosistemas y poblaciones de vida silvestre en la Patagonia y el Corredor Andino,\nmediante el rewilding como fuerza catalizadora de conservación y bienestar humano.\n2\nVisión\nUn planeta saludable con ecosistemas completos donde todas las formas de vida prosperan y las\ncomunidades se desarrollan en armonía con la naturaleza.\nMisión\nImpulsamos el rewilding como estrategia de conservación integral desde la Ruta de los Parques de la\nPatagonia, restaurando ecosistemas terrestres y marinos, recuperando especies clave y fortaleciendo el\nvínculo entre comunidades y naturaleza. A través de la creación de parques nacionales, el\nfortalecimiento de la institucionalidad de conservación y la construcción de alianzas, buscamos expandir\neste modelo a través del Corredor Andino, contribuyendo a la recuperación de ecosistemas completos y\na un futuro donde las comunidades convivan en armonía con la naturaleza.\nEnfoque\nTrabajamos en un marco de colaboración público-privada con el Estado de Chile y sus instituciones a\nnivel nacional, regional y local para desarrollar acciones conjuntas de conservación. Esta cooperación\nbusca consolidar alianzas permanentes que aseguren los resultados en el tiempo, promoviendo que la\nconservación se integre de forma estructural en las políticas públicas y contribuya al cumplimiento de los\ncompromisos internacionales del país. Asimismo, fomentamos la colaboración con la academia,\norganizaciones de la sociedad civil y comunidades locales, convencidos de que sólo a través de alianzas\nduraderas podremos garantizar la conservación a largo plazo de los ecosistemas y la vida silvestre a\nescala andina.\nNuestro Plan de Expansión\nLa Patagonia chilena ha sido históricamente nuestro ámbito de acción. Sin embargo, al enfrentarnos a\ncrecientes tasas de defaunación y pérdida de hábitats en todo el continente, nos hemos propuesto\nampliar nuestro impacto hacia nuevos territorios.\nNuestra proyección se orienta naturalmente hacia el resto del Corredor Andino. Reconocemos a la\nPatagonia como la expresión más austral de esta vasta región ecológica, que se extiende desde Colombia\ny Venezuela hasta el Cabo de Hornos. Este extenso macizo que abarca alrededor de 9.000 kilómetros de\nlongitud alberga un gran abanico de especies y ecosistemas amenazados, interconectados de forma\nnatural por las montañas y otras formaciones geológicas como cuencas hidrográficas, bosques y\nhumedales.\nEn una primera etapa, concentraremos nuestros esfuerzos en las cinco especies emblemáticas de la\nPatagonia que nos conectan con el continente en su conjunto, ya que también habitan distintos rangos a\nlo largo del Corredor Andino: el cóndor, el huemul, el guanaco, el ñandú y el puma. A partir de ellas, y\nmediante alianzas estratégicas, buscaremos expandir la recuperación de otras especies amenazadas para\nintegrar el rewilding como una estrategia de conservación a escala andina.\nEste trabajo se sumará a nuestros proyectos de conservación de la Patagonia, territorio que se está\nconsolidado como un referente global de rewilding al concentrar más del 91% de la superficie de\n3\nparques nacionales de Chile. Seguiremos trabajando para fortalecer la Ruta de los Parques de la\nPatagonia e impulsarla como política pública nacional, ofreciendo una alternativa de desarrollo para el\npaís. Nuestro trabajo de restauración de especies y ecosistemas seguirá creciendo, incorporando a\nnuevas especies claves o en distintos grados de amenaza. Asimismo, nuestro foco marino se mantendrá\nen los fiordos y canales del mar patagónico, avanzando hacia una red de parques marinos estratégicos y\nestrictamente protegidos.\nContinuaremos fortaleciendo nuestro trabajo con las comunidades locales como aliadas de largo plazo\nde los parques nacionales, promoviendo el turismo responsable, la educación ambiental y el desarrollo\nen armonía con la naturaleza. Solo mediante este vínculo será posible asegurar que el mundo humano y\nno humano prosperen juntos en el tiempo.\nObjetivos de largo alcance\nEn el marco de nuestra visión 2035 hemos definido dos objetivos de largo alcance que orientan nuestro\ntrabajo.\nObjetivo de largo alcance 1. Consolidar la Ruta de los Parques de la Patagonia como un\nreferente de conservación a nivel continental.\nEn los próximos diez años consolidaremos el trabajo de conservación en la Ruta de los Parques de la\nPatagonia como un referente a nivel continental. El siguiente mapa refleja nuestra hoja de ruta en la que\nproyectamos crear y ampliar nuevos parques nacionales terrestres y marinos, fortalecer la gestión de\nparques existentes, restaurar hábitats críticos y sus poblaciones clave de vida silvestre, manteniendo\ncomo un eje de trabajo el ya establecido Corredor Nacional del Huemul. Asimismo, seguiremos\nfortaleciendo la colaboración con comunidades locales como la primera línea de defensa de estos\nterritorios y restaurando también el vínculo entre conservación y desarrollo económico local.\n4\n5\nObjetivo de largo alcance 2. Expandir el rewilding a lo largo de todo el Corredor Andino.\nLa expansión hacia el Corredor Andino busca restaurar y conectar ecosistemas a través de la protección\nde territorios clave y el fortalecimiento de la vida silvestre como promotores de ecosistemas completos y\nfuncionales. El siguiente mapa define nuestras metas para los próximos 10 años, reflejando las especies\nque guiarán nuestro trabajo en colaboración con organizaciones aliadas.\n6\n7\nEstrategia de impacto 2035\nEl presente plan traduce nuestra Visión 2035 en una hoja de ruta progresiva que orienta las acciones de\nRewilding Chile durante la próxima década.\nEsta propuesta de impacto se sustenta en tres pilares estratégicos que han guiado nuestro trabajo a lo\nlargo de los años: la creación de parques nacionales, la restauración de ecosistemas completos y\nfuncionales, y la vinculación comunitaria. En esta nueva era para nuestra organización ponemos al centro\nla restauración de ecosistemas y su vida silvestre como eje articulador para consolidar nuestro trabajo en\nla Patagonia y expandirnos hacia el norte a lo largo del Corredor Andino.\nPara conseguir nuestros resultados de largo alcance, nuestros pilares estratégicos se materializan a\ntravés de cuatro áreas programáticas —Vida Silvestre, Conservación Terrestre, Conservación Marina, y\nVinculación Comunitaria. En las siguientes páginas, desarrollaremos más en detalle los resultados\nintermedios de cada área, ordenado en periodos de tres años, junto a una plataforma de monitoreo,\nevaluación y aprendizaje.\nObjetivos 2026-2028\nProgramas de Vida Silvestre\nRuta de los Parques de la Patagonia\n● Trabajo de rewilding y monitoreo con 11 especies de la Patagonia: Huemul, puma, guanaco,\nñandú, cóndor, canquén colorado, ranita de Darwin, pudú, pequeños felinos de la patagonia\n(pajonal, güiña, montés).\n● Consolidación del trabajo de las subpoblaciones actuales del CNH: Pumalín, Futaleufú, Cerro\nCastillo, Patagonia, Cabo Froward.\n8\nCorredor Andino\n● Puesta en marcha de programa piloto de restauración de sub-poblaciones de guanaco en la\nRegión Metropolitana de Santiago de Chile.\n● Puesta en marcha de programa piloto de conservación del cóndor andino en el norte de su\ndistribución (Colombia).\n● Inicio de trabajo colaborativo del Suri-Ñandú entre Chile-Perú.\n● Expansión del Corredor Nacional del Huemul a lo largo de su rango de distribución original.\n● Exploración de la matriz de trabajo con especies amenazadas en el norte de Chile como Picaflor\nde Arica, Taruca, flamencos y aves nidificantes del desierto.\nConservación terrestre\nRuta de los Parques de la Patagonia\n● Creación del Parque Nacional en Cabo Froward.\n● Establecimiento de un proyecto de conservación en la Estancia Baño Nuevo.\n● Fortalecimiento de la gestión de los Parques Nacionales Patagonia, Pumalín y Cerro Castillo.\n● Gestión para la ampliación de Parques Nacionales Patagonia y Cerro Castillo.\n● Restauración de 25 ha de bosque nativo estratégico. Comentado [1]: aca sólo estamos considerando\nPNCC? Qué pasa con las 80 há de Cabo Froward?\nCorredor Andino\n● Fortalecimiento de áreas protegidas estratégicas en Chile Central.\n● Posicionamiento del rewilding como estrategia de conservación a nivel nacional.\nConservación marina Comentado [2]: qué pasó con los 1,300 km2 de PM\nque considerábamos como prioritarios: Cabo Froward,\nRuta de los Parques de la Patagonia\nBahía Inutil, Comau Punta Dungeness?\n● Levantamiento de información de biodiversidad para la conservación de hábitats estratégicos en\nComentado [3]: no mencionamos nada de activismo ni\nla Patagonia. campaña salmones\n● Mega-transecto de biodiversidad asociado a bosques de macroalgas.\n● Consolidación de propuesta de red de parques marinos.\n● Creación de un Parque Nacional Marino en Bahía Inútil en alianza con la Universidad de\nMagallanes.\n● Recategorización del Área de Conservación de Múltiples Usos Fiordo Comau en Parque Nacional\nMarino en alianza con Fundación Huinay.\n● Rewilding marino: Inicio de piloto de repoblamiento y monitoreo de bancos naturales de\nmitílidos en Fiordo Comau y exploración de un piloto de restauración de pastos marinos en Seno Comentado [4]: se podría usar un término menos\nSkyring. técnico? Esto se referiría a las cholgas y además a los\narrecifes artificiales?\n● Medición de los impactos de la salmonicultura sobre la biodiversidad.\nVinculación comunitaria\nRuta de los Parques de la Patagonia\n● Consolidar trabajo en 10 comunidades (Valle del Río Chamiza, Chaitén, Amarrillo, Villa Cerro\nCastillo, Puerto Ingeniero Ibáñez, Chile Chico, Cochrane, Agua Fresca y Rinconada de Bulnes,\nHornopirén) y en 5 Parques Nacionales Terrestres (PNAA, PNPDT, PNCC, PNP, PNCF).\n9\n● Fortalecimiento de la visión territorial Ruta de los Parques.\nObjetivos 2029-2031\nProgramas de Vida Silvestre\nRuta de los Parques de la Patagonia\n● Trabajo de rewilding y monitoreo con 14 especies de la Patagonia: Huemul, puma, cóndor,\nñandú, cóndor, canquén colorado, ranita de Darwin, pudú, gatos chicos (pajonal, güiña, montés),\nvizcacha, huillín, chungungo.\n● Identificación y trabajo con 2 subpoblaciones nuevas de huemules del Corredor Nacional del\nHuemul.\nCorredor Andino\n● Consolidación del programa de restauración a escala de paisaje del guanaco en la Región\nMetropolitana de Santiago de Chile.\n● Traslado de 4-6 cóndores a Colombia y otros países andinos\n● Consolidación de núcleos poblacionales de huemul en el norte de su distribución.\n● Consolidación del trabajo colaborativo de Suri y ñandú con Perú y Bolivia.\n● Expansión del trabajo de coexistencia con el Puma.\n● Programas colaborativos de rescate del picaflor de Arica; tarucas; chinchillas; nutrias; flamencos;\ncomunidades de aves nidificantes del desierto (golondrinas de mar, garuma); gaviotín chico.\nConservación terrestre\nRuta de los Parques de la Patagonia\n● Creación de un nuevo parque nacional en la Patagonia.\n● Gestión institucional para la ampliación de dos parques nacionales existentes.\n● Restauración de 50 ha de bosque nativo estratégico. Comentado [5]: donde? en nuevas areas a explorar?\n● Establecimiento de alianzas regionales y binacionales para la protección de corredores biológicos\ntransfronterizos.\nCorredor Andino\n● Consolidación de un marco institucional de colaboración público-privada, articulando alianzas\ncon CONAF, MMA, SAG y gobiernos regionales.\n● Posicionamiento del rewilding como estrategia de conservación a nivel sudamericano.\nConservación marina\nRuta de los Parques de la Patagonia\n● Creación de los Parques Nacionales Marinos Cabo Froward (~ 6.000 ha) y Bahía Yendegaia (~\n3.600 ha).\n● Declaración de los bosques del alga Macrocystis pyrifera como Monumento Natural para las\nregiones de Aysén y Magallanes, como resultado del proyecto mega-transecto.\n● Recategorización a Parque Nacional Marino de la Reserva Kawésqar, en áreas que presentan\necosistemas marinos vulnerables (arrecifes someros del coral rojo, Errina antarctica).\n● Consolidación del Plan de Gestión de los Parques Nacionales Marinos de Bahía Inútil y Fiordo\nComau.\n10\nVinculación comunitaria\nRuta de los Parques de la Patagonia\n● Expansión del trabajo con 10 comunidades adicionales (Porvenir, Puerto Guadal, Mallín Grande,\nLoyola, Casa Pesca, Chumelden, Isla Llahuén, Bahía Pumalín, El Blanco, y Balmaceda).\n● Ampliación del programa de vinculación comunitaria al ambiente marino (Porvenir - Bahía Inútil).\n● Fortalecimiento del modelo Ruta de los Parques.\nObjetivos 2032-2035\nProgramas de Vida Silvestre\nRuta de los Parques de la Patagonia\n● Trabajo de rewilding y monitoreo con 17 especies de la Patagonia: Huemul, puma, cóndor,\nñandú, cóndor, canquén colorado, ranita de Darwin, pudú, gatos chicos (pajonal, güiña, montés),\nvizcacha, huillín, chungungo, martineta, pidén austral, chorlo de Magallanes.\n● Identificación y trabajo con 2 subpoblaciones nuevas del Corredor Nacional del Huemul.\nCorredor Andino\n● Aumento poblacional y reintroducción efectiva de subpoblaciones de guanaco en la Región\nMetropolitana de Santiago de Chile y restablecimiento de conectividad poblacional.\n● Desarrollo y consolidación de iniciativas de rewilding con países andinos y especies en categorías\nde amenaza.\nConservación terrestre\nRuta de los Parques de la Patagonia\n● Creación de un nuevo Parque Nacional en la Patagonia.\n● Restauración de 100 ha de bosque nativo estratégico.\n● Fortalecimiento de una red de parques nacionales y marinos con gestión efectiva,\nfinanciamiento sostenible y monitoreo continuo de biodiversidad.\nCorredor Andino\n● El rewilding institucionalizado en políticas públicas nacionales e internacionales, y reconocido\ncomo una herramienta clave para cumplir los compromisos globales de conservación de la\nbiodiversidad.\nConservación marina\nRuta de los Parques de la Patagonia\n● Creación de la Red de Parques Nacionales Marinos de Pequeña Escala del Estrecho de\nMagallanes, compuesta por Dungeness; Buque Quemado; Segunda Angostura; Isla\nContramaestre; Isla Isabel-Marta; y Punta Zenteno, protegiendo más de 17.000 ha.\n● Creación del Parque Nacional Marino Isla Guamblin (~ 85.000 ha) en la región de Aysén.\n● Se consolida el Programa de Restauración Marina que comprende: (1) restauración de bancos\nnaturales de mitílidos y pastos marinos; (2) biorremediación mediante arrecifes artificiales en\náreas afectadas por la actividad salmonera.\n11\nVinculación comunitaria\nRuta de los Parques de la Patagonia\n● Expansión del trabajo con 5 comunidades adicionales (Palena, Puyuhuapi, Villa Santa Lucía, Seno\nObstrucción, Cameron); y en 2 Parques Nacionales Terrestres adicionales (PN Corcovado y PN\nYendegaia) y a 2 localidades marinas adicionales (Puyuhuapi, Seno Obstrucción).\nMonitoreo, evaluación y aprendizaje\nEl monitoreo, la evaluación y el aprendizaje (MEL) son pilares esenciales para asegurar la efectividad,\ntransparencia y mejora continua de nuestro trabajo. Este sistema busca no solo medir el avance hacia\nnuestras metas, sino también fortalecer la toma de decisiones, la rendición de cuentas y la generación de\nconocimiento que permita ampliar nuestro impacto.\nA través de esta herramienta, evaluaremos de manera continua los resultados de nuestras acciones en\ntierra, mar y comunidades, conectando las actividades de cada programa con los objetivos de mediano y\nlargo plazo establecidos en nuestra Visión 2035. El objetivo es comprender cómo nuestras\nintervenciones contribuyen a restaurar ecosistemas completos y funcionales, recuperar poblaciones de\nfauna silvestre, mejorar la gestión de áreas protegidas y fortalecer el vínculo entre las comunidades y la\nnaturaleza.\nAsimismo, este marco MEL promueve el aprendizaje organizacional, permitiendo ajustar estrategias,\npriorizar recursos y comunicar con claridad los avances alcanzados. Los indicadores aquí descritos\nofrecen una base común para medir el progreso y facilitar la colaboración entre equipos, socios\nestratégicos y aliados institucionales, consolidando a Rewilding Chile como un actor clave dentro del\nmovimiento global de rewilding.\nLos indicadores, y cómo se desglosan, son los siguientes:\n1. Hectáreas protegidas\no Hectáreas adquiridas\no Hectáreas donadas\no Hectáreas públicas apalancadas (leveraged)\no Hectáreas bajo protección formal\no Número de nuevas áreas protegidas\n2. Fortalecimiento del manejo de áreas protegidas (hectáreas y otros)\no Hectáreas bajo sistemas de monitoreo de biodiversidad activos\no Gestión y manejo de las áreas protegidas mejorada, a través de capacidades fortalecidas,\ninfraestructura mejorada, u otros.\n3. Restauración de especies y ecosistemas\no Hectáreas en proceso de restauración\no Reintroducciones/translocaciones\n12\no Centros de reproducción, rescate y otra infraestructura de manejo para el\nrepoblamiento en los cuales estamos involucrados\no Especies con la que se trabaja, comunidades animales y ecosistemas abordados\no Tendencias poblacionales de especies (abundancia/densidad, ocupación, distribución,\ndesplazamiento, sobrevivencia, uso de corredores, amenazas retiradas, nuevas especies\no subpoblaciones identificadas)\n4. Impacto de la vinculación comunitaria\no Personas de las comunidades locales involucradas en nuestros programas\no Personas certificadas o con capacidades mejoradas\no Organizaciones de las comunidades involucradas\no Territorios/comunidades abarcados\no Otros\n5. Productos de conocimiento\no Estudios científicos, informes técnicos o literatura gris, tesis académicas, herramientas\ndesarrolladas para el intercambio de conocimientos y/o datos (mapas de historias, etc.)\n6. Alianzas e incidencia\no Número de alianzas estratégicas concretadas\no Alcance público y mediático\n7. Desarrollo organizacional\no Nuevos cargos incorporados, programas, miembros del equipo, gobernanza (board),\nmejora de procesos\nNuestro aporte a las metas globales de conservación\nHoy, el movimiento global por el rewilding crece con fuerza en todos los continentes. Con esta Visión\n2035, Rewilding Chile da un paso decisivo para llevar ese impulso a una escala andina, conectando,\nespecies, ecosistemas y comunidades a lo largo de la columna vertebral ecológica de Sudamérica. Con\neste plan buscamos restaurar la vida silvestre, fortalecer ecosistemas completos y construir un futuro\ndonde las comunidades prosperen en armonía con la naturaleza.\nAl hacerlo, contribuimos a las metas globales de conservación, como el compromiso 30x30 del Marco\nMundial de la Biodiversidad, la década para la restauración de la biodiversidad, y el marco de los\nobjetivos de desarrollo sustentable. Pero con nuestra ambición y escalabilidad, nos adelantamos a la\nsiguiente década, entendiendo que la magnitud de la crisis requiere acciones concretas y ambiciosas.\nInvitamos a todos quienes creen en un futuro más silvestre a sumarse a este esfuerzo colectivo. En\ncolaboración, podemos hacer de Chile y de la Cordillera de los Andes un territorio más salvaje.\n13', 'description': None, 'parent_drive_file_id': '1knhqSkFI1O1Fewp0PvJeJJ6pJiR-XM7T', 'children': []}, {'id': '000c96a7-d603-4579-8d6f-8c521c85a1e3', 'drive_file_id': '1K1QkIjMD6G4GZcP5GXPtPfc1EXPHUPD4', 'name': 'Visión 2035 - Rewilding Chile - English.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1K1QkIjMD6G4GZcP5GXPtPfc1EXPHUPD4/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 26, 36, 480000, tzinfo=datetime.timezone.utc), 'text_content': "From the Route of Parks of Patagonia\nto the Andean Corridor: A 2035 Vision\nfrom Rewilding Chile\nContinuing the Legacy\nAt Rewilding Chile, we are a non-profit organization that is part of the legacy of Douglas and Kristine\nTompkins, who in the early 1990s dedicated their lives to protecting the beauty and biodiversity of\nChilean Patagonia in the face of the species extinction crisis and climate change. Three decades later,\nwe remain committed to that mission, protecting and restoring complete and functional ecosystems.\nOur work has focused on the Route of Parks of Chilean Patagonia, an extensive territory of over 2,800\nkilometers and 17 national parks stretching between Puerto Montt (41° S) and Cape Horn (56° S).\nTogether with Tompkins Conservation, we are proud to have contributed to the permanent\nprotection of over 4,000,000 hectares and to the restoration of key ecosystems in this region of the\nSouthamerican continent.\nOur Vision 2035 charts Rewilding Chile’s course for the coming decade, guided by a central principle:\nthe restoration of wildlife populations as a driver of large-scale ecological recovery. From\nPatagonia—our starting point and learning ground—we aim to expand rewilding along the Andes,\nthe ecological backbone of South America, strengthening the connection between ecosystems,\nspecies, and communities.\nRewilding: A Strategy Proportional to the Scale of the\nCrisis\nWe find ourselves at a decisive moment for life on Earth. The scientific community has warned us of\nan accelerating loss of biodiversity, to the point of describing it as the sixth mass extinction—and the\nfirst caused by a single species: homos sapiens. The evidence recorded since 1970 is overwhelming:\nvertebrate populations have declined by an average of 73%, while in Latin America this drop reaches\nan alarming 95%.\nThe current crisis demands that we protect habitats and prevent further losses, but it also calls for\nconcrete actions to help nature heal. That is the purpose of rewilding—a conservation strategy aimed\nat restoring ecological integrity at scale.\nConceived from its origins as a proportional response to the extinction crisis, rewilding was defined\nby Michael Soulé and Reed Noss (1998) as a large-scale conservation strategy grounded in the\nprotection of core habitat areas, the establishment of connectivity corridors, and the recovery of key\nspecies. Since then, it has maintained a continental vocation, recognizing that ecological restoration\ncan only be achieved when it transcends the boundaries of isolated patches, encompassing entire\nlandscapes and biogeographic systems where wildlife and natural processes can thrive freely.\nOur Compass for 2035\nIntended Impact: Restoration of ecosystems and wildlife populations in Patagonia and the Andean\nCorridor, using rewilding as a catalytic force for conservation and development.\nVision: A healthy planet with fully functioning ecosystems where all life forms thrive and\ncommunities develop in harmony with nature.\nMission: We advance rewilding as a comprehensive conservation strategy from the Route of Parks of\nPatagonia, restoring terrestrial and marine ecosystems, recovering keystone species, and\nstrengthening the bond between communities and nature. Through the creation of national parks,\nthe strengthening of conservation institutions, and the building of strategic alliances, we seek to\nexpand this model toward the Andean Corridor, contributing to the recovery of fully functioning\necosystems and a future where communities live in harmony with nature.\nApproach: We work under a public–private collaboration framework with the State of Chile and its\ninstitutions at national, regional, and local levels to develop joint conservation actions. This\ncooperation aims to consolidate lasting partnerships that secure conservation outcomes over time,\npromoting the structural integration of rewilding into public policy and supporting Chile’s\ninternational commitments. Likewise, we foster collaboration with academia, civil society\norganizations, and local communities, as we are convinced that only through enduring alliances can\nwe guarantee the long-term conservation of ecosystems and wildlife across the Andes.\nOur Expansion Plan\nFor decades, Chilean Patagonia has been at the heart of our work. However, as defaunation and\nhabitat loss accelerate across the continent, we have set out to broaden our impact and bring\nrewilding to new territories.\nOur expansion naturally looks toward the Andean Corridor—the vast ecological region influenced by\nthe Andes Mountains, stretching from Colombia and Venezuela to Cape Horn in Patagonia. This\n9,000-kilometer mountain system harbors an extraordinary diversity of species and ecosystems\nunder threat, all interconnected through mountain ranges, river basins, forests, and wetlands.\nIn its first phase, our work will focus on the five emblematic species of Patagonia that also inhabit\ndifferent ranges along the Andean Corridor: the Andean condor, the huemul deer, the guanaco, the\nDarwin’s rhea, and the puma. Through these species—and in collaboration with strategic\npartners—we aim to expand the recovery of other threatened species and embed rewilding as a\nconservation strategy at an Andean scale.\nThis new line of work will complement our ongoing conservation efforts in Patagonia, a region\nincreasingly recognized as a global benchmark for rewilding, containing over 91% of Chile’s national\npark area. We will continue to strengthen the Route of Parks of Patagonia and promote it as a\nnational public policy, offering a model of sustainable development for the country.\nOur ecosystem restoration work will continue to grow, incorporating new key and threatened\nspecies. Likewise, our marine conservation efforts will remain focused on the fjords and channels of\nthe Patagonian Sea, advancing toward a network of strategically located and strictly protected\nmarine parks.\nWe will also deepen our collaboration with local communities, recognizing them as long-term allies\nof national parks. Together, we will promote responsible tourism, environmental education, and\ndevelopment in harmony with nature. Only through this enduring relationship can we ensure that\nthe human and non-human worlds thrive together over time.\nLong-range Goals\nWithin the framework of our 2035 Vision, we have defined two long-term objectives that guide our\nwork and strategic direction.\nLong-Range Goal 1: Consolidate the Route of Parks of\nPatagonia as a Continental Benchmark for Conservation.\nOver the next decade, we will strengthen conservation efforts along the Route of Parks of Patagonia,\npositioning it as a continental reference point for large-scale ecological restoration and protected\narea management.\nThe map below outlines our roadmap for the coming years, which envisions the creation and\nexpansion of new terrestrial and marine national parks, the strengthening of management in existing\nparks, and the restoration of critical habitats and key wildlife populations, with a special focus on the\nalready established National Huemul Corridor as a central axis of our work.\nAt the same time, we will continue to deepen collaboration with local communities, recognizing\nthem as the first line of defense for these territories, and restoring the connection between\nconservation and local economic development to ensure that nature protection and human\nwell-being advance together.\nLong-Term Goal 2: Expand Rewilding Across the Andean\nCorridor\nThe expansion toward the Andean Corridor aims to restore and reconnect ecosystems through the\nprotection of key territories and the strengthening of wildlife populations as drivers of complete and\nfunctional ecosystems.\nThe map below outlines our targets for the next ten years, highlighting the species that will guide our\nefforts in collaboration with partner organizations.\n2035 Strategy for Impact\nThis plan translates our 2035 Vision into a progressive roadmap that will guide Rewilding Chile’s\nactions over the next decade.\nOur strategic impact plan is built upon three strategic pillars that have guided our work throughout\nthe years: the creation of national parks, the restoration of complete and functional ecosystems, and\ncommunity engagement. In this new chapter for our organization, we place ecosystem and wildlife\nrestoration at the core of our strategy, serving as the unifying axis to consolidate our work in\nPatagonia and expand toward the Andean Corridor.\nTo achieve our long-term goals, these strategic pillars take shape through four programmatic areas —\nWildlife, Terrestrial Conservation, Marine Conservation, and Community Engagement. The following\npages detail the intermediate outcomes for each area, organized into three-year periods, along with\na framework for monitoring, evaluation, and learning.\n2026-2028 Objectives\nWildlife Programs\nRoute of Parks of Patagonia\n● Rewilding and monitoring of 11 Patagonian species: huemul, puma, Andean condor,\nguanaco, Darwin’s rhea, Ruddy-headed goose, Darwin’s frog, pudu, and the suite of\nPatagonian small cats (pampas cat, güiña, Geoffroy’s cat).\n● Strengthening conservation work across the current subpopulations within the National\nHuemul Corridor (CNH): Pumalín, Futaleufú, Cerro Castillo, Patagonia, and Cabo Froward.\nAndean Corridor\n● Launch of a pilot restoration program for guanaco subpopulations in the Metropolitan\nRegion of Santiago, Chile.\n● Launch of a pilot conservation program for the Andean condor in the northernmost part of\nits range (Colombia).\n● Initiation of binational collaboration between Chile and Peru for the conservation of the suri\n(Darwin’s rhea).\n● Expansion of the National Huemul Corridor along the species’ original distribution range\n(reaching up to Nevados de Chillán).\n● Exploration of a conservation portfolio for threatened species in northern Chile, including the\npicaflor de Arica (Chilean Woodstar), taruca (north Andean deer), flamingos, and\ndesert-nesting bird species.\nTerrestrial Conservation\nRoute of Parks of Patagonia\n● Creation of a new National Park in Cabo Froward.\n● Establishment of a conservation project at Estancia Baño Nuevo.\n● Strengthening management capacities in the Patagonia, Pumalín, and Cerro Castillo National\nParks.\n● Advocacy and technical work to support the expansion of Patagonia and Cerro Castillo\nNational Parks.\n● Restoration of 25 hectares of strategic native forest.\nAndean Corridor\n● Strengthening strategic protected areas for rewilding in Central Chile.\n● Positioning rewilding as a national conservation strategy within public policy and institutional\nagendas.\nMarine Conservation\nRoute of Parks of Patagonia\n● Biodiversity assessments to inform the conservation of strategic marine habitats in\nPatagonia.\n● Implementation of a biodiversity mega-transect focused on kelp forest ecosystems.\n● Consolidation of a proposal for a network of marine parks across the Patagonian region.\n● Creation of a Marine National Park in Bahía Inútil, in partnership with the University of\nMagallanes.\n● Reclassification of the Fiordo Comau Multiple-Use Conservation Area into a Marine National\nPark, in partnership with Fundación Huinay.\n● Marine rewilding initiatives, including:\n○ Launch of a pilot program to restore and monitor natural mussel beds (mitílidos) in\nFiordo Comau.\n○ Exploration of a pilot seagrass restoration program in Seno Skyring.\n● Assessment of the impacts of salmon farming on biodiversity.\nCommunity Engagement\nRoute of Parks of Patagonia\n● Consolidation of engagement efforts in 10 communities and in 5 National Parks.\n○ Communities: Valle del Río Chamiza, Chaitén, El Amarillo, Villa Cerro Castillo, Puerto\nIngeniero Ibáñez, Chile Chico, Cochrane, Agua Fresca, Rinconada de Bulnes, and\nHornopirén.\n○ National Parks: Alerce Andino, Pumalín Douglas Tompkins, Cerro Castillo, Patagonia\nand Cabo Froward.\n● Strengthening the territorial vision of the Route of Parks of Patagonia.\n2029-2031 Objectives\nWildlife Programs\nRoute of Parks of Patagonia\n● Rewilding and monitoring focused on 14 Patagonian species: huemul, puma, condor,\nguanaco, Darwin’s rhea, the Ruddy-headed goose, Darwin’s frog, pudú, small wild cats\n(pampas cat, güiña, Geoffroy's cat), vizcacha, river otter (huillín), and marine otter\n(chungungo).\n● Identification and initial work with two additional huemul subpopulations within the\nNational Huemul Corridor.\nAndean Corridor\n● Consolidation of the landscape-scale guanaco restoration program in the Metropolitan\nRegion of Santiago.\n● Translocation of 4–6 condors to Colombia and other Andean countries.\n● Strengthening of huemul population nuclei in the northern limit of their distribution.\n● Expansion of collaborative conservation efforts for suri and rhea with Peru and Bolivia.\n● Scaling up of coexistence initiatives with the puma.\n● Collaborative rescue and recovery programs for highly threatened species, including the\nChilean woodstar, taruca deer, chinchillas, native otters, flamingos, desert-nesting seabird\ncommunities (like sea swallows and the Chilean tern)\nTerrestrial Conservation\nRoute of Parks of Patagonia\n● Creation of a new rewilding project in Patagonia.\n● Institutional work to expand two existing national park\n● Restoration of 50 hectares of strategically important native forest.\n● Development of regional and binational partnerships to protect transboundary wildlife\ncorridors.\nAndean Corridor\n● Establishment of a robust public–private institutional framework, bringing together CONAF,\nthe Ministry of the Environment, SAG, and regional governments.\n● Positioning rewilding as a leading conservation strategy at the South American level.\nMarine Conservation\nRoute of Parks of Patagonia\n● Creation of the Cabo Froward (~6,000 ha) and Bahía Yendegaia (~3,600 ha) Marine National\nParks.\n● Designation of Macrocystis pyrifera kelp forests as a Natural Monument in the Aysén and\nMagallanes regions, stemming from the mega-transect project.\n● Upgrading portions of the Kawésqar Reserve to Marine National Park status in areas with\nvulnerable marine ecosystems (such as shallow reefs of the red coral Errina antarctica).\n● Strengthening of the management plans for the Bahía Inútil and Fiordo Comau Marine\nNational Parks.\nCommunity Engagement\nRoute of Parks of Patagonia\n● Expansion of community engagement work to 10 additional communities: Porvenir, Puerto\nGuadal, Mallín Grande, Loyola, Casa Pesca, Chumelden, Isla Llahuén, Bahía Pumalín, El\nBlanco, and Balmaceda.\n● Extension of the community engagement program to the marine environment\n(Porvenir–Bahía Inútil).\n● Strengthening and scaling of the Route of Parks model.\n2032-2035 Objectives\nWildlife Programs\nRoute of Parks of Patagonia\n● Rewilding and monitoring of 17 Patagonian species: huemul, puma, condor, guanaco,\nDarwin’s rhea, the Ruddy-headed goose, Darwin’s frog, pudú, small wild cats (pampas cat,\ngüiña, Geoffroy's cat), vizcacha, river otter (huillín), and marine otter (chungungo), martineta\ntinamou, austral rail, Magellanic plover.\n● Identification of two additional subpopulations of huemul within the National Huemul\nCorridor, along with the launch of conservation actions.\nAndean Corridor\n● Population increase and effective reintroduction of guanaco subpopulations in the\nMetropolitan Region of Santiago, ensuring restored population connectivity.\n● Development and consolidation of rewilding initiatives with Andean countries, focused on\nspecies listed under threatened categories.\n○ Andean Condor: Establish a coordinated Andean-wide reinforcement program to\nrecover declining populations and secure genetic flow across borders.\n○ Darwin’s Rhea (Suri/Ñandú): Restore priority breeding sites and ensure cross-border\npopulation connectivity with Peru and Bolivia.\n○ Puma: Implement coexistence frameworks with local communities to reduce conflict\nand support puma recovery at a continental scale.\n○ Huemul: Strengthen north-range conservation nuclei and promote habitat corridors\nlinking isolated subpopulations.\n○ Other Threatened Species: Develop collaborative monitoring, protection, and\nrestoration actions for priority species of shared concern—such as taruca, chinchilla,\nChilean woodstar, and desert-nesting seabirds.\nTerrestrial Conservation\nRoute of Parks of Patagonia\n● Strengthening of a new rewilding project in Patagonia.\n● Restoration of 100 hectares of strategic native forest.\n● Strengthening of an integrated network of national parks with effective management,\nsustainable financing, and continuous biodiversity monitoring.\nAndean Corridor\n● Rewilding becomes institutionalized within national and international public policies, and\nrecognized as a key tool for meeting biodiversity conservation commitments at an Andean\nscale.\nMarine Conservation\nRoute of Parks of Patagonia\n● Establishment of a small-scale Marine National Parks Network of the Strait of Magellan,\ncomposed of Dungeness, Buque Quemado, Segunda Angostura, Isla Contramaestre, Isla\nIsabel-Marta, and Punta Zenteno, protecting more than 17,000 hectares.\n● Creation of the Isla Guamblin Marine National Park (~85,000 ha) in the Aysén region.\n● Consolidation of the Marine Restoration Program, which includes:\n○ Restoration of natural beds of mussels and seagrass meadows\n○ Bioremediation through artificial reefs in areas impacted by salmon farming.\nCommunity Engagement\nRoute of Parks of Patagonia\n● Expansion of work to 5 additional communities, 2 terrestrial National Parks and 2 marine\nlocalities:\n○ Communities: Palena, Puyuhuapi, Villa Santa Lucía, Seno Obstrucción, Cameron)\n○ Terrestrial National Parks: Corcovado NP and Yendegaia NP.\n○ Marine localities: Puyuhuapi and Seno Obstrucción.\nMonitoring, Evaluation, and Learning\nMonitoring, evaluation, and learning (MEL) is an essential pillar for ensuring the effectiveness,\ntransparency, and continuous improvement of our work. This system seeks not only to measure\nprogress toward our goals, but also to strengthen decision-making, accountability, and the\ngeneration of knowledge that expands our impact.\nThrough this framework, we will continuously assess the results of our actions on land, at sea, and\nwith communities, linking the activities of each program to the intermediate outcomes and\nlong-term impacts defined in our 2035 Vision. The objective is to understand how our interventions\ncontribute to restoring complete and functional ecosystems, recovering wildlife populations,\nimproving protected area management, and strengthening the bond between communities and\nnature.\nThis MEL framework also promotes organizational learning, enabling us to adjust strategies, prioritize\nresources, and clearly communicate the progress achieved. The indicators described below provide a\nshared foundation for measuring progress and facilitating collaboration among teams, strategic\npartners, and institutional allies, positioning Rewilding Chile as a key actor within the global rewilding\nmovement.\nIndicators and their Components:\nThe official matrix is in this table.\n1. Protected Hectares\n● Hectares acquired\n● Hectares donated\n● Public hectares leveraged\n● Hectares under formal protection\n● Number of new protected areas\n2. Strengthened Management of Protected Areas\n● Hectares under active biodiversity monitoring systems\n● Improved management of protected areas through strengthened capacities, enhanced\ninfrastructure, or other means\n3. Restoration of Species and Ecosystems\n● Hectares under ecological restoration\n● Species reintroductions/translocations\n● Breeding, rescue, or other management facilities for population recovery in which we are\ninvolved\n● Species, animal communities, and ecosystems addressed\n● Population trends of focal species (abundance/density, occupancy, distribution, movement,\nsurvival, corridor use, threats removed, new species or subpopulations identified)\n4. Knowledge Products\n● Scientific studies, technical reports or grey literature, academic theses, or tools for data and\nknowledge exchange (story maps, etc.)\n5. Community Engagement Impact\n● People from local communities engaged in our programs\n● People trained or certified, with improved capacities\n● Community-based organizations engaged\n● Territories/communities reached\n● Other community-related outcomes\n6. Strategic Partnerships\n● Number of strategic alliances formalized\n7. Organizational Development\n● New positions, programs, team members, governance improvements, or enhanced\norganizational processes\nOur Contribution to Global Conservation Goals\nToday, the global rewilding movement is gaining momentum across all continents. With this 2035\nVision, Rewilding Chile takes a decisive step toward bringing that momentum to an Andean\nscale—connecting species, ecosystems, and communities along the ecological backbone of South\nAmerica. Through this plan, we aim to recover wildlife, restore complete ecosystems, and build a\nfuture where communities thrive in harmony with nature.\nIn doing so, we contribute to global conservation goals such as the 30x30 commitment of the Global\nBiodiversity Framework, the UN Decade on Ecosystem Restoration, and the Sustainable Development\nGoals. Yet through our ambition and scalability, we look beyond to the next decade, understanding\nthat the magnitude of the ecological crisis demands concrete and transformative action.\nWe invite all those who believe in a wilder future to join this collective effort. Together, we can make\nChile and the Andes a more thriving, more resilient, and more genuinely wild landscape.", 'description': None, 'parent_drive_file_id': '1knhqSkFI1O1Fewp0PvJeJJ6pJiR-XM7T', 'children': []}]}]}, {'id': '8e077db7-fba0-489d-bcf5-1c3381650961', 'drive_file_id': '14OA5WleFnmP0lJsXTWEO7Ys3y_DTu3Oj', 'name': '09. Mapas', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/14OA5WleFnmP0lJsXTWEO7Ys3y_DTu3Oj', 'modified_time': datetime.datetime(2026, 6, 30, 16, 53, 17, 275000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '16j0klxJnQspJ1mvafpnMaRx7Xd1SRIDO', 'children': [{'id': '60826890-3de3-4ad7-a568-60a937341d71', 'drive_file_id': '1oJjFZSn7nmRJgdpWeYj1h9aEQ4GqY8EO', 'name': 'Mapas del Corredor Andino', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1oJjFZSn7nmRJgdpWeYj1h9aEQ4GqY8EO', 'modified_time': datetime.datetime(2026, 6, 30, 16, 33, 39, 929000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '14OA5WleFnmP0lJsXTWEO7Ys3y_DTu3Oj', 'children': []}, {'id': '01116aa3-15ec-41dc-84ad-5eba6a9e197c', 'drive_file_id': '1vH_z9jxXzREvHfGcAd3596JPU7Qwx5fe', 'name': 'Mapas Proyectos Terrestres', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1vH_z9jxXzREvHfGcAd3596JPU7Qwx5fe', 'modified_time': datetime.datetime(2026, 6, 30, 16, 33, 39, 938000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '14OA5WleFnmP0lJsXTWEO7Ys3y_DTu3Oj', 'children': []}, {'id': '0eb34854-1d7d-4a4a-95e1-91a2f320b507', 'drive_file_id': '1H-WODTsMha6ZkXS69WzpYPZo6lLopdu2', 'name': 'Mapas Decretos PN (Ruta de los Parques)', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.goog