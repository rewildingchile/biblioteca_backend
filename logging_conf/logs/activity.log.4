-c3b1-47f9-a9e0-3b9d3d132905', 'drive_file_id': '1yWHKffqBMTSmJHyy2oCLpIHHr-XQ2TKF', 'name': 'Email Esri Sunny Ingles_09.06.26.docx', 'mime_type': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/1yWHKffqBMTSmJHyy2oCLpIHHr-XQ2TKF/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 50, 909000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1ayP1e8nDHlb6SHJUjls9eHH7tjaQZnWe', 'children': []}, {'id': 'eb938c6b-652b-40dc-be51-617c85cac993', 'drive_file_id': '1vVUeX44SBQBP-B-y1Eb2Cvhuu-Hp8uls', 'name': 'email a Sunny_ESRI_08.06.26(1).docx', 'mime_type': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/1vVUeX44SBQBP-B-y1Eb2Cvhuu-Hp8uls/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 22, 18, 39, 2, 393000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1ayP1e8nDHlb6SHJUjls9eHH7tjaQZnWe', 'children': []}]}, {'id': '6bfbd9b5-1f24-49f8-b46c-e16e2a28c5b9', 'drive_file_id': '1cqihjMa3KqZFLAG1bPrcQdBKcEYXUJET', 'name': 'Doc. Shaw Island Corredor Andino', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1cqihjMa3KqZFLAG1bPrcQdBKcEYXUJET', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 38, 688000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': [{'id': '6f40e8d5-3eac-4c8a-8cce-e0275c4fa2be', 'drive_file_id': '1OzRCJS6EWkJ8l0MqjO1w-Vw1moEeFHma', 'name': 'readme.txt', 'mime_type': 'text/plain', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1OzRCJS6EWkJ8l0MqjO1w-Vw1moEeFHma/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 39, 49, 837000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1cqihjMa3KqZFLAG1bPrcQdBKcEYXUJET', 'children': []}]}, {'id': 'd5cc64b0-3756-4447-8fe6-03f32211c3ee', 'drive_file_id': '1ERz-6WD0wNjkEDnv9JhqPieWo70Lwg01', 'name': 'Picaflor de Arica', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1ERz-6WD0wNjkEDnv9JhqPieWo70Lwg01', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 14, 119000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': [{'id': 'e372ba72-25ba-4055-8aae-e146553b382e', 'drive_file_id': '1n9HxuLgnupLnDQIshm_AjwP7OSEWZhMy', 'name': 'Informe Arica_FINAL 11.25.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1n9HxuLgnupLnDQIshm_AjwP7OSEWZhMy/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 44, 255000, tzinfo=datetime.timezone.utc), 'text_content': 'INFORME Y OBSERVACIONES GIRA TÉCNICA A ARICA\nFundación Rewilding Chile y Red de Observadores de Aves y Vida Silvestre de Chile (ROC)\nPicaflor de Arica y Aves nidificantes del desierto y otras\nCristián Saucedo e Ingrid Espinoza\nTABLA DE CONTENIDOS\n1. PICAFLOR DE ARICALA ESPECIE\n2. TERRENO (17-18 NOV)\n3. CONSIDERACIONES GENERALES\n4. TEMAS PRIORITARIOS Y PROYECCIONES PARA UN ABORDAJE DEL PICAFLOR DE ARICA\n4.1. Tierras\n4.2. Sitio de Hacienda Vitor (Micro reserva ROC)\n4.3. Normativa o fiscalización\n4.4. Trabajo colaborativo\n4.5. Enfoque multi especies y exploración de otras alianzas potenciales en la región\n4.6. Exploración otras especies – Taruca o Huemul del Norte\n5. OTRAS ESPECIES EN ESTA VISITA\n5.1. Golondrinas de Mar – Golondrinas del Desierto\n5.2. Golondrina de mar negra (Hydrobates markhami)\n5.3. Tres especies que caen en los Fiordos del Patagónicos\n5.4. Gaviotín chico (Sternula lorata)\n5.5. Taruca o Huemul del Norte (Hippocamelus antisensis)\n6. OTRAS NOTAS DE LA ZONA\n6.1. Experiencia RENAMU Desembocadura del río Lluta\n6.2. Experiencia con radiotransmisores en Chorlo cabezón\n6.3. Pingüinos\n12 febrero 2026\n1. PICAFLOR DE ARICA\nPicaflor de Arica (Eulidia yarrellii) – Clasificación IUCN: En Peligro Crítico (CR), Clasificación RCE: En\nPeligro Crítico (CR)\nEl ave más pequeña y amenazada del país, cuya distribución históricamente se extendía desde el sur\nde Perú hasta el norte de Chile. Actualmente es un ave endémica de Chile y se restringe únicamente\na la Región de Arica y Parinacota, habitando sectores de matorral ripario y bordes arbustivos en\nzonas agrícolas en los valles de Chaca (Vítor) y Camarones. Destaca por su cabeza y dorso verde oliva,\nvientre blanquecino y garganta de color violeta iridiscente en el macho. En época reproductiva los\nmachos se agrupan en áreas denominadas “leks” donde realizan llamativos despliegues para atraer\na las hembras, quienes se encargan de la construcción del nido. Se alimenta del néctar obtenido de\nlas flores, tanto nativas como cultivadas. Su población ha disminuido drásticamente debido a la\nfuerte presión de la industria agrícola y el uso indiscriminado de pesticidas.\nRegistros de Picaflor de Arica en plataforma e-bird\nRegistros de Picaflor de Arica en plataforma INaturalist\nDistribución Histórica Picaflor de Arica – Plan Recuperación y Gestión Especies Amenazadas.\nMapa de referencia de valles ocupadas por el Picaflor de Arica.\n2. TERRENO (17-18 NOV)\nEl día 17 de noviembre conocimos el acceso al Valle de Azapa con el objetivo de recorrer y observar\nel paisaje y el uso de la tierra en un valle donde antes habitó el Picaflor de Arica y hoy se encuentra\nbastante modificado, intervenido y con extensas superficies cubiertas con carpas plasticas de cultivo\nagrícola para tomates, frutillas y otros cultivos intensivos.\nEl Picaflor de Arica habitaba los Valles de Lluta, Azapa, Vitor (Chaca) y Camarones. Hoy solo quedan\nPicaflores de Arica en el Valle Camarones y Chaca (Vitor).\nEn esta región se observan picaflor de Cora, de Arica y del Norte, todos están en disminución de sus\npoblaciones. En el Valle Azapa observamos picaflor del norte con cierta facilidad. Entre las amenazas\ndel Picaflor de Arica se encuentran la pérdida de hábitat, actividad agrícola, pesticidas, además del\naparente desplazamiento por Picaflor de Cora. En los años 70 para la eliminación de la mosca de la\nfruta se utilizaron pesticidas en gran parte de la región con avionetas y eso aparentemente fue una\nde las causas principales de su rápida disminución.\nEl día 18 de noviembre 2025 nos dirigimos al Valle de Camarones. Aplurus pruvianus, es una especie\nnativa de acá. El pimiento boliviano también. El Valle de Camarones es más bien ganadero de\npequeña escala y es para cultivos más salobres, hoy esa ganadería es menor y hoy en día se está\ncultivando. Gradualmente, los alfalfales y árboles se están eliminando para la entrada y avance de la\nagricultura. El uso y ocupación de terrenos en el Valle de Camarones es mucho más reciente, lo que\nhace pensar en una oportunidad para poder trabajar un proyecto de conservación de hábitat para\nel Picaflor de Arica.\nValle del Chaca (Vitor) Llares o chañares, un bosque en muy buen a condición al lado del río la\nQuebrada de Vitor (Valle Chaca). Chaca pertenece a la comuna de Arica. Quebrada de Vitor, es\npotencialmente fiscal y es hábitat de picaflor de Arica. Muy importante ya que falta evaluación\ncatastral de propiedades.\nEn la zona de Cuya (Camarones) Avícola Ariztía tiene una propiedad grande en la zona llamada\nHacienda Camarones, la cual tiene varios sectores muy importantes para la reproducción y\nalimentación del Picaflor de Arica. También hay más campos interesantes en valles, que aún no han\nsido ocupados para agricultura que posiblemente sean fiscales o privados. Corresponde a la I.M. de\nCamarones y en Cuya está la municipalidad.\nEl chañar y el tamarugo son el alimento principal del Picaflor de Arica, se adapta al tamarugo y hace\nsus nidos ahí y como es nudoso con las espinosas quedan clavados los nidos y como persisten tanto\nson ocupados varias veces. El molle también, pero tiene ramas más débiles por lo que a veces se\ncaen.\nPor lo general se privilegia el tamarugo cuando se realizan plantaciones, ya que el chañar crece solo.\nEl fruto del chañar se ocupa para repostería. La mayor parte de las acciones de restauración se hacen\ncon tamarugo. El tamarugo casi está desaparecido, históricamente se eliminaron, por ser grande y\nsu buena madera.\nOtras especies de aves presentes: Sacatureal, cachudito del norte, matacaballos, pizarrita entre\notras.\nAl lado de Cuya observamos diferentes individuos de Picaflor de Arica, macho y hembras, lek\nestablecido por algunos machos, así como el despliegue de vuelos territoriales.\nA través de un proyecto GEF de especies amenazadas y bastante apoyo y entusiasmo regional del\nMMA se establecieron 5 micro reservas. Son áreas sin ningún tipo de figura de protección, solo\ndestinación de BN para ser administrados por MMA para la creación de microreserva del Picaflor de\nArica. En una de ellas se plantaron varias especies y en uno de los ensayos se privilegió el Tamarugo.\n0,5 ha la gestionada por el MMA regional, más otras 4 más grandes, 19 há y otras.\nLa ROC tiene 15 há que las administran como concesión con Bienes Nacionales, de las micro reservas\nes de las más grandes. Tienen un permiso anticipado mientras gestionan la concesión por 8 años.\nEl M.N. Picaflor de Arica, fue gestionado por Aves Chile (UNORCH) y luego en el Gobierno de Piñera\nlo pidieron para ser MN y hoy es administrador por Conaf. Un bosque lindo con senderos. Están\nplanificando su ampliación.\nEn la Micro reserva de Chaca, fuimos a ver plantaciones y restauración realizada por MMA y vimos\n2 nidos de Picaflor de Arica, más un nido de Picaflor del norte. Vimos a un adulto que alimentaba a\nun polluelo.\n3. CONSIDERACIONES GENERALES\nLa población del valle de Azapa es la menos viable de las tres analizadas. Este es el valle que tiene\nla mayor intervención humana, lo cual explica que esta población sea considerada en la categoría de\ncríticamente en peligro.\nLa población del valle de Camarones es la más viable, dado que este valle es el que posee menor\ngrado de intervención humana.\nEn el Valle de Vítor, la especie se encuentra en una situación intermedia con respecto a los otros\nvalles.\n4. TEMAS PRIORITARIOS Y PROYECCIONES PARA UN EVENTUAL ABORDAJE DEL\nPICAFLOR DE ARICA\n4.1. Tierras\n- Diagnóstico sobre la propiedad de la tierra para evaluar compra de tierras y tierras fiscales.\n- Identificar hábitat y corredores.\n- Evaluar posibilidad de que se conviertan algunos propietarios en socios para exista una actividad\nde coexistencia con el picaflor.\n- Caracterizar técnicas de cultivo, sistemas productivos, uso de pesticidas y otras prácticas agrícolas.\n4.2. Sitio de Hacienda Vitor (Micro reserva ROC)\nHay aspectos que se pueden abordar como restauración, agua, infraestructura entre otras.\n4.3. Normativa o fiscalización\nFortalecimiento de la protección de bosques, el tema lumínico (golondrinas de mar), reforzar el\nhecho de que el Picaflor de Arica es Monumento Natural. Participando de las instancias\ninstitucionales asociadas al abordaje de cuencas o proyectos como caminos asociados a amenazas.\n4.4. Trabajo colaborativo\nHistóricamente en torno a la especie han existido esfuerzos de la Unión de Ornitólogos de Chile y el\nDr. Cristián Estades (Laboratorio de Ecología y Vida Silvestre, Facultad de Ciencias Forestales y de\nConservación de la Naturaleza de la Universidad de Chile.\nDe manera más reciente la ROC viene desarrollando numerosas iniciativas en esta región\nrelacionadas al Picaflor de Arica y a otras especies amenazadas como Gaviotín chico, Golondrinas de\nmar.\nPor ello en la medida que se decida avanzar con el abordaje regional sería necesario establecer\nconvenios formales con las organizaciones colaboradoras.\n4.5. Enfoque multi especies y exploración de otras alianzas potenciales en la región\nEs importante considerar que la ROC como aliada estratégica tiene un equipo regional actuando en\nla zona de Arica y se encuentra abordando un trabajo proactivo de conservación en otras especies\ncon alto grado de amenaza como son gaviotín chico, golondrinas de mar del desierto entre otras.\nAdemás, existen vacíos de información de las áreas de invernada ocupadas por el Picaflor de Arica\npueden relacionarse a otras especies como la taruca o huemul del norte.\n4.6. Exploración otras especies – Taruca o Huemul del Norte\nSe encuentra considerado un viaje exploratorio para el primer semestre de 2026 a la zona de\ncordillerana de Arica para evaluar el potencial para abordar en el marco del Corredor Andino los\ndesafíos de la conservación de tarucas en la zona, junto al Dr. Nicolás Allende de Sudamérica Diversa\nquien por años se ha dedicado al monitoreo de poblaciones de taruca o huemul del Norte en la zona\ny el desarrollo de algunas estrategias de conservación, además de manera más reciente junto a\nConaf en el P.N. Volcán Isluga.\n5. OTRAS ESPECIES EN ESTA VISITA\n5.1. Golondrinas de Mar – Golondrinas del Desierto\nLas golondrinas de mar son pequeñas aves pelágicas, de vuelo rápido y ágil, que viven toda su vida\nen alta mar, visitando tierra solo para su reproducción. Existen 4 especies de golondrinas de mar\nobservadas regularmente en las aguas marinas al norte de Chile, que potencialmente pueden\nnidificar en el país: la Golondrina de mar chica (Oceanites gracilis), la Golondrina de mar peruana\n(Oceanodroma tethys), la Golondrina de mar negra (Oceanodroma markhami) y la Golondrina de\nmar de collar (Oceanodroma hornbyi).\nA pesar de ser especies regulares en la zona, para algunas de ellas muy poco se sabe de su biología\nreproductiva.\nLa Golondrina de mar chica es una especie común de observar en toda su distribución, sin embargo,\nsolo se conoce un sitio de reproducción en la Isla Chungungo (provincia de Elqui, Chile). Para este\nislote se han informado solo unos pocos nidos (Marín & Schlater 1983; Hertel & Torres-Mura 2003).\nLa Golondrina de mar peruana se reproduce en las islas Galápagos (O. t. tethys) y en islas frente a\nlas costas de Perú (O. t. kelsalli). Para Chile se ha reportado solo un sitio de nidificación en la Isla\nGrande, provincia de Copiapó (Bernal et al. 2006).\nPara la Golondrina de mar negra, hasta hace poco solo se conocía una colonia reproductiva de cerca\nde 2000-4000 parejas en la Península de Paracas, Perú (Jahncke 1993) y en 2013 se publicó el\ndescubrimiento de una nueva colonia en la provincia de Arica, Chile (Torres-Mura & Lemus 2013).\n5.2. Golondrina de mar negra (Hydrobates markhami)\nClasificación IUCN: Casi amenazada (NT). Clasificación RCE: En Peligro (EN)\nPequeña ave marina que se distribuye en aguas tropicales del Pacífico y que visita tierra firme solo\npara reproducirse, en el desierto del norte de Chile y sur de Perú. En el país se encuentran la mayoría\nde las colonias reproductivas descritas para la especie, en las regiones de Arica y Parinacota y\nTarapacá. Para nidificar, prefiere cavidades naturales asociadas a costras salinas a nivel del suelo.\nColoca un solo huevo por temporada y ambos miembros de la pareja se turnan durante la incubación\ny la alimentación del polluelo. Su plumaje es completamente pardo negruzco con bandas grises en\nlas alas y su cola es corta y bifurcada. Se alimenta de cefalópodos, crustáceos y peces, como la\nanchoveta o el pejerrey. Su principal amenaza es la contaminación lumínica proveniente de ciudades\ne industrias, que atraen y desorientan a volantones en sus primeros vuelos nocturnos en dirección\nal mar. Entre otras amenazas se describen la minería y el desarrollo de proyectos energéticos en\npleno desierto de Atacama.\nGolondrinas de mar negra en Arica - Hay algunos sectores con costras de sal y hacen sus nidos en\ngalerías subterráneas. No cavan, sino que ocupan las cavidades naturales que hay en este sustrato\nque se forma en años. Hay un tema importante de colisión de las golondrinas de mar con el tendido\neléctrico y la contaminación lumínica de ciudades. Hay un estudio piloto con disuasores de luz, en\nHawái se está usando con otro tipo de petrel, hace un tintineo leve y la golondrina lo puede\nreconocer.\nEn los valles de Chaca y Camarones la ROC ha instalado nidos artificiales, como cajitas de cemento\no de sustrato natural o híbridos, desde hace 2 años están en esto. Se estiman unos 2000 nidos en\n600 ha. Desde hace 15 años están cayendo y eso es por la llegada de las luces led, mucha luz\nnocturna y consecuente contaminación lumínica. Antes con las luces amarillas antiguas caían 2 o 3.\nEn la última temporada cayeron 4000 y 20.000 en Iquique en la temporada.\n5.3. Tres especies que caen en los Fiordos del Patagónicos\nComo información al margen es importante considerar que a la fecha hay 3 especies que caen en los\nfiordos patagónicos del sur.\n1. Golondrina de mar Pincoya (Oceanites pincoyae), Clasificación IUCN: Datos Insuficientes (DD) y\nClasificación RCE: No clasificada.\nUna de las aves marinas más enigmáticas y desconocidas del mundo, descrita para la ciencia\nrecientemente en 2013. Se distribuye por los canales australes y mar adentro desde el sur de\nTalcahuano hasta el norte de Aysén\nEn la cordillera de la zona central están un poco más avanzados y pueden tener ya un lugar de\ncapturas de golondrina de mar.\n2. Yunco Magallanes (Pelecanoides magellani) Clasificación IUCN: Preocupación Menor (LC) y\nClasificación RCE: Datos Insuficientes (DD). Sus sitios reproductivos no han sido descubiertos y solo\nse cuenta con un par de registros históricos en islas australes, los cuales describen que nidifica\ncolonialmente en madrigueras, colocando un solo huevo y que sus hábitos serían especialmente\nnocturnos en este periodo. Se alimenta principalmente de peces e invertebrados marinos ya sea en\nla superficie o buceando.\n3. Fardela chica (Puffinus elegans). Sumamente difícil de ver, pero que coincidentemente concentra\nla mayor parte de sus avistamientos en la zona que cubre entre la desembocadura del rio Llico y la\nisla Metalqui, en Chiloé. Se han realizado algunos esfuerzos particulares en el área de Estaquilla y\nMaullín, en grupos que hacen suponer algún comportamiento reproductivo. Existe la posibilidad de\nque esta fardela pueda estar más en islotes de Chiloé, algunas han caído en Fresia. Se desconocen\nlas zonas de nidificación.\nNOTA: Existen registro de golondrina de mar Pincoya en la zona al sur del Estero del Reloncaví y\nvarios registros costeros en la zona del PN Pumalín. Existe la posibilidad que nidifiquen en bosques,\nroqueríos, acarreos de piedras o zonas altas de la cordillera como ocurre en la zona central de Chile.\nEs importante ponerle atención a los Yuncos en la zona de Cabo Froward.\n5.4. Gaviotín chico (Sternula lorata)\nClasificación IUCN: En peligro (EN) Clasificación RCE: En Peligro (EN). Pequeño y amenazado gaviotín\nendémico de la corriente de Humboldt, que se reproduce durante primavera-verano en planicies\ncosteras de Chile y Perú. Nidifica en colonias entre la Región de Arica y Parinacota y la Región de\nAntofagasta, colocando dos huevos en una pequeña depresión en la arena y ambos padres se turnan\npara incubar. Luego de reproducirse migra hacia el norte llegando hasta la costa de Ecuador. Su\nalimento comprende principalmente peces que captura lanzándose en picada a más de 10 metros\nde altura. Enfrenta múltiples amenazas como la baja disponibilidad de alimento a causa de la\nsobrepesca, así como la presencia de vehículos motorizados, perros y la presión inmobiliaria en sus\nsitios de nidificación.\nSe buscan proteger sus sitios de nidificación en predios fiscales, como la Pampa Chacalluta, a través\nde la solicitud de concesiones y la implementación de planes de manejo para mitigar amenazas como\nla pérdida de hábitat y la depredación por perros, consolidando el trabajo de años en un Plan de\nRecuperación y Conservación (RECOGE).\nEn la zona de Arica la ROC maneja un área fiscal de 200 ha aledaña a un recinto militar como área\nde nidificación de gaviotín chico, se estiman entre 30 y 40 nidos y una población de unos 80 a 120\nindividuos en este sector. Se estimula el establecimiento de colonias a través de réplicas o señuelos\nartificiales de gaviotines en tierra.\nEl Área de Protección para el gaviotín chico Chacalluta es el único sitio de reproducción en la región\nde Arica y Parinacota, y el más septentrional dentro del territorio. Cuenta con aproximadamente un\n7% de la población nacional de la especie y presenta 2017 hectáreas de superficie. Con relación a su\nubicación, este se emplaza al norte de la ciudad de Arica, justo entre el límite internacional con Perú\ny la línea de costa. Uno de los objetivos propuestos contempla el avance en la protección oficial de\ncolonias reproductivas de importancia, su manejo y conservación.\nPara esto, y luego de un proceso de establecimiento de redes de apoyo en conjunto con la\nMunicipalidad de Arica y el Ministerio de Bienes Nacionales, se concretó la entrega del bien fiscal\npara fines de conservación a la ROC y cuenta con un Plan de Manejo vigente hasta el año 2034.\n5.5. Taruca o Huemul del Norte (Hippocamelus antisensis)\nClasificación IUCN: Vulnerable (V) Clasificación RCE: En Peligro (EN)\nSe recomienda ir a Chapiquiña antes de Putre, sector de Sapahuira, una especie de posada. En\nChapiquiña están las queñoas y los Polylepis. Un poco más allá esta Belén, un lugar bonito de\nterrazas, zona de Tarucas y eventual hábitat que se sobrepone entre Picaflor de Arica y Taruca.\n6. OTRAS NOTAS DE LA ZONA\n6.1. Experiencia RENAMU Desembocadura del río Lluta, comuna de Arica, región de Arica y\nParinacota\nReserva Natural Municipal (RENAMU) Desembocadura del Río Lluta y, posteriormente, como un\nSantuario de la Naturaleza, que abarca la desembocadura y el humedal asociado, conservando su\nnombre geográfico, pero añadiendo una figura legal de protección ambiental. El sitio se conoce\ncomúnmente como el Humedal del Río Lluta o Santuario Humedal Desembocadura Río Lluta, un\necosistema clave en el desierto de Atacama, rico en avifauna.\nNombre de protección: Reserva Natural Municipal (RENAMU) y Santuario de la Naturaleza\n(Santuario Humedal Desembocadura Río Lluta).\nDe las 270 ha. de extensión total del humedal, 75% del humedal es de propiedad privada, 25% es de\npropiedad fiscal.\n30,6 ha. se encuentran protegidas bajo la RENAMU, hoy Santuario de la Naturaleza.\nEl sitio alberga alrededor de 130 especies de aves (30% del total nacional), algunas de ellas\nendémicas de Sudamérica y muchas de ellas migratorias del hemisferio norte.\nEs gestionado de manera muy eficiente por la I.M de Arica y cuenta con guardafaunas municipales.\nEn el pasado existían muchos conflictos por basura, camping irregular entre otros problemas.\nExcelente modelo para implementar en las zonas de canquén colorado.\n6.2. Experiencia con radiotransmisores en Chorlo cabezón\nAcompañamos al equipo de la ROC en la captura y colocación de transmisores GPS a individuos de\nChorlo cabezón, de manera a conocer por primera vez los desplazamientos que realiza esta especie\ncuya distribución se restringe al extremo norte de Chile y Perú.\n6.3. Pingüinos\nPingüino de Humboldt es importante en el área costera de Arica.\nEl estado poblacional del pingüino de Humboldt en Arica, y en Chile en general, es preocupante y\ncrítico, habiendo sido reclasificado a "En Peligro de Extinción" a finales de 2025, debido a una\ndrástica disminución, afectando colonias desde Arica hasta Valparaíso, aunque sus principales\ncolonias están en el norte, incluyendo el sector de Arica y Paracas. Se estima que quedan pocos miles\nde ejemplares, y amenazas como la pesca incidental, el cambio climático y la influenza aviar ponen\nen riesgo su supervivencia, necesitando medidas urgentes de protección.\nhttps://repositorioambiental.mma.gob.cl/wp-content/uploads/2019/09/Cuadernillo-Pinguino-\n1.pdf', 'description': None, 'parent_drive_file_id': '1ERz-6WD0wNjkEDnv9JhqPieWo70Lwg01', 'children': []}, {'id': '1db9985c-5f48-4c51-b050-d616255479a0', 'drive_file_id': '10_QTHLkYbrezDzDqMqch8_9r4miXLzDt', 'name': 'Picaflor de Arica 2026 Versión Final 11Jun2026.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/10_QTHLkYbrezDzDqMqch8_9r4miXLzDt/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 45, 451000, tzinfo=datetime.timezone.utc), 'text_content': 'Picaflor de Arica en el marco del Corredor Andino\nContexto y rol de Rewilding Chile\nPropuesta de actividades definidas en conjunto con el Laboratorio de Ecología y Vida Silvestre de la U. de Chile\n(Dr. Cristián Estades) y la Red de Observadores y Vida Silvestre de Chile (ROC). Este plan de trabajo se ha\nconstruido posteriormente a nuestra visita a Arica, el primer documento generado de contexto y al desarrollo\nde varias reuniones técnicas y organizacionales para consensuar enfoques y áreas de trabajo de cada\norganización teniendo como foco el delicado estado de conservación de la especie.\nEn general el momento y motivación de los colaboradores no puede ser mejor, y somos en parte responsables\nde que hoy estén alineados. En la fase en que nos encontramos explorando proyectos y programas que podrían\no no en parte ser integrados al Corredor Andino. En el caso del Picaflor de Arica, hemos sido verdaderos\narticuladores en cuanto a promover proactivamente una mayor interacción entre AvesChile y la Red de\nObservadores de Aves y Vida Silvestre de Chile junto a nosotros como FRC.\nEntre los roles que FRC podría jugar en un eventual programa de Picaflor de Arica en el Corredor Andino y que\nme parecen importantes destacar:\n1. Responsables de reactivar, promover y articular el trabajo colaborativo entre actores principales vinculados\na la conservación del picaflor de Arica con el fin de abordar el alto riesgo de extinción de la especie y la\nmodificación y pérdida de su hábitat (con proyecciones hasta la alta Cordillera por tarucas y otras especies).\n2. Promover la construcción de una propuesta de manejo activo de la especie combinada con investigación\naplicada para el desarrollo de acciones de conservación concretas y sistemáticas en el tiempo.\n3. Apoyar la búsqueda de fondos junto a los otros colaboradores para la generación de información científica\ny técnica que permita ajustar la estrategia de conservación.\n4. Desarrollar gradualmente este programa de manera que permita sentar las bases iniciales de colaboración\nen el norte de Chile como stepping stone del Corredor Andino.\n5. Implementar acciones y estrategias de conservación y recuperación desde la experiencia del equipo de FRC\njunto a otros actores (ROC, LEVS de U de Chile) que están presentes en el territorio nacional y vinculados a la\nconservación de esta y otras especies.\nPropuesta de Líneas de Trabajo - Picaflor de Arica en el marco del Corredor Andino\nSocios estratégicos: Red de Observadores de Aves y Vida Silvestre de Chile (ROC), Unión de Ornitólogos de\nChile (AvesChile) y Laboratorio de Ecología y Vida Silvestre (LEVS) de la Universidad de Chile.\nOrganismos asociados: Ministerio de Medio Ambiente, American Bird Conservation (ABC).\nEn principio se definen 3 líneas principales de acción del trabajo colaborativo en torno a la especie:\n1. Censos y monitoreo (Aporte estimado y aprobado FRC 2026: M$11)\nEn esta línea de trabajo se cuenta con la larga trayectoria y liderazgo por parte del Dr. Cristian Estades del LEVS.\nEl desarrollo de censos y monitoreo permitirá incluir sitios relevantes para la especie y por primera vez hacer\nun barrido por ejemplo en la zona de Azapa, dirigido a sitios que nunca han estado dentro del muestreo de\nlargo plazo y que todavía podrían albergar algunos picaflores. Además, permitirá dar continuidad a los conteos\nhistóricos en el valle, los cuales en algunas ocasiones se han dejado de hacer cuando no se dispone de\nfinanciamiento.\n2. Investigación aplicada en manejo de Picaflor de Arica y su hábitat Aporte estimado FRC 2026: M$36\n2027: M$50,5)\nEsta línea ha sido sugerida como prioritaria por parte de Rewilding Chile para avanzar en la conservación de la\nespecie. Será liderada por el Dr. Estades desde el LEVS, pero en colaboración cercana con la ROC. Los más de\n20 años de experiencia con el Picaflor de Arica, han permitido a los investigadores familiarizarse con diversos\naspectos de la historia natural de la especie, así como de los factores que están detrás de su delicado estado\nde conservación. Este aprendizaje también ha permitido identificar brechas de conocimiento y líneas de\ninvestigación que son cruciales para contribuir al desarrollo de un plan de conservación exitoso para la\nespecie.\nA continuación, se resumen las principales líneas de trabajo que deberían abordarse dentro de los próximos 5\naños.\n2.1. Oferta continua de alimento (ALIMENTO)\nAntecedentes y justificación. Parte de la dificultad de proteger de manera efectiva a una población de\npicaflor de Arica en una “área segura” radica en el hecho de que la oferta local de néctar suele ser de baja\nduración por lo que las aves deben relocalizarse con frecuencia a otros sitios.\nObjetivos de manejo. Generar una comunidad vegetal capaz de producir néctar durante un período lo más\nlargo posible, reduciendo el riesgo de que los picaflores se expongan a peligros al desplazarse a áreas no\nprotegidas.\nDiseño general del estudio. 1. Estudiar la fenología (natural y con riego) de diferentes especies nectaríferas\nnativas. 2. Ensayar su reproducción y establecimiento. 3. Ensayar combinaciones de plantas que provean\nnéctar “en secuencia”. 4. Evaluar la producción de néctar a lo largo del año. 5. Evaluar la respuesta de los\npicaflores.\nExperiencia previa. Se conoce un número importante de especies útiles para el picaflor. Se realizó un estudio\nsobre manejo silvícola del Chañar para potenciar la floración (Fondo de Investigación del Bosque Nativo).\n2.2. Mejoras del hábitat de nidificación (NIDIFICACIÓN)\nAntecedentes y justificación. Observaciones sobre nidificación de la especie indican que la selección de un\nsitio en particular por parte de la hembra no sólo depende de la presencia de árboles adecuados y fuentes de\nnéctar cercana, sino que también de una serie de otros elementos de importancia como la abundancia de\ninsectos, agua y material para la construcción de nidos, entre otros.\nObjetivos de manejo. Atraer hembras a nidificar en sitios seguros y aumentar la tasa de éxito reproductivo.\nDiseño general del estudio. 1. Ensayar la introducción de recursos complementarios en una zona de\nnidificación. 2. Estos recursos comprenderán: bañeras (piletas con bomba solar), fibras (lana y/o fibras\nvegetales), dípteros pequeños (producidos mediante el manejo de vegetales en descomposición), calcio\n(recurso crucial para la formación de las cáscaras de los huevos). 3. Estudiar la tasa de utilización de estos\nrecursos por las hembras. 4. Comparar desempeño reproductivo del sitio manejado con un control.\nExperiencia previa. Se han realizado experimentos preliminares con todos los recursos mencionados, pero\npor razones logísticas no se pudo obtener resultados significativos.\n2.3. Creación de leks artificiales (LEKS)\nAntecedentes y justificación. Al igual que otras especies de colibríes, el Picaflor de Arica tiene un sistema\nreproductivo que se basa en que los machos y las hembras utilizan distintos tipos de ambiente. Mientras las\nhembras se concentran en las zonas de nidificación, los machos se agrupan en zonas llamadas “leks”, donde\nse despliegan y compiten por la atención de las hembras que sólo visitan el área para aparearse. Una\ncaracterística de estos leks es que están muy dispersos en los valles y que suelen mantenerse en los mismos\nsitios por muchos años. Esta “inercia conductual” hace que los machos sigan congregándose en lugares que,\npor ejemplo, se han ido deteriorando con el tiempo, lo que reduce sus posibilidades reales de reproducirse.\nAdemás, esta inflexibilidad conductual hace que sea muy difícil atraer a los machos a instalarse en un lugar\nnuevo (ej. una nueva área protegida).\nObjetivos de manejo. Atraer machos a instalar un lek en un sitio seguro, aumentando su tasa de sobrevivencia\ny éxito reproductivo.\nDiseño general del estudio. 1. Simular un lek mediante el uso de picaflores falsos y vocalizaciones. 2. Evaluar\nla tasa de visita de machos al “lek artificial”. 3. Evaluar la existencia de machos que se instalen definitivamente\nen la zona segura.\nExperiencia previa. Este experimento se ha realizado de manera parcial en tres ocasiones, ninguna de las\ncuales entregó resultados concluyentes. Las razones del fracaso fueron problemas con el diseño de los\nseñuelos (duración de los “picaflores artificiales” bajo el sol del desierto), y luego por el fallo de los altavoces\nque transmiten las vocalizaciones. Finalmente, superados estos problemas, existieron restricciones\npresupuestarias que impidieron un monitoreo eficaz de las tasas de visitas y las respuestas en general de los\nmachos al experimento.\n2.4. Manejo de la competencia con el picaflor de Cora (COMPETENCIA)\nAntecedentes y justificación. Una de las variables que ha influido en la declinación del picaflor de Arica, ha\nsido la competencia con el picaflor de Cora, un ave que colonizó la región en las últimas décadas.\nObjetivos de manejo. Mantener zonas “libre de picaflor de Cora” para favorecer al picaflor de Arica.\nDiseño general del estudio. 1. Evaluar protocolos de detección y captura de picaflores de Cora. 2. Evaluar\nopciones de relocalización de los picaflores de Cora capturados. 3. Comparar el desempeño reproductivo de\nlos picaflores de Arica en zonas con presencia de los competidores y en zonas manejadas.\nExperiencia previa. Como parte de una tesis doctoral (Ilenia Lazzoni, UCH) se evaluó detalladamente la\ninteracción entre las dos especies. Además, se realizó una experiencia piloto de captura y relocalización de\npicaflor de Cora, la que indicó que esta especie tiene una excelente capacidad de retornar a sus territorios si\nse los mueve dentro del mismo valle.\n2.5. Carga de pesticidas en néctar de flores visitadas por el picaflor de Arica\nAntecedentes y justificación. Una de las amenazas históricamente asociadas a la declinación del Picaflor\nde Arica ha sido el uso intensivo de pesticidas en los valles agrícolas, especialmente en Azapa. Estudios\nprevios han señalado que el aumento del uso de pesticidas coincidió temporalmente con la disminución de\nla especie, y que existen observaciones de aplicaciones cerca de sitios de alimentación y nidificación de\npicaflores. Además, se ha propuesto que los pesticidas podrían contaminar el néctar y afectar directamente\na las aves que dependen de este recurso energético.\nObjetivos de manejo. Evaluar si las flores utilizadas por el Picaflor de Arica contienen residuos de pesticidas,\ncon especial atención a áreas donde se utiliza Diazol, un pesticida actualmente usado en la zona. Ello para\nidentificar especies de plantas o sectores de mayor riesgo y orientar el manejo de zonas seguras de\nalimentación.\nDiseño general del estudio. Se dispondrán muestras de 500 μL de néctar artificial a lo largo de transectos que\nirradian desde puntos de aplicación de pesticidas (N=5) a distancias de 0, 25, 50, 100 y 150 m. El uso de néctar\nartificial en lugar de agua proporciona una matriz estandarizada y biológicamente relevante que aproxima el\nrecurso consumido por los picaflores, manteniendo al mismo tiempo una simplicidad analítica. Las muestras\nserán analizadas para detectar residuos de Diazinón/ Diazol con el fin de determinar si la deriva de pesticidas\ncontamina recursos similares al néctar y cómo la concentración de residuos disminuye con la distancia desde\nlas áreas de aplicación.\nExperiencia previa. Se conoce que el Picaflor de Arica utiliza diversas fuentes florales, incluyendo especies\nnativas como chañar, ornamentales y cultivos como alfalfa y cítricos. También se cuenta con experiencia\nprevia midiendo volumen, concentración y uso de néctar en chañar, granadas y cítricos, lo que entrega una\nbase metodológica directa para incorporar análisis toxicológicos del néctar.\n3. Levantamiento territorial ampliado y de detalle (Aporte aprobado FRC 2026: M$15)\nLa implementación de diversas acciones orientadas a la conservación del Picaflor de Arica, -desde la creación\nde nuevas micro reservas, hasta la promoción de prácticas agrícolas sustentables que mejoren las\ncondiciones para la especie a nivel de paisaje-, requieren de una comprensión adecuada del territorio en\nvarias dimensiones. La caracterización de aspectos como la división y propiedad predial, la presencia y tipos\nde vegetación nativa, uso del suelo y prácticas productivas, composición social, entre otros, constituyen\nelementos de base para orientar y planificar de buena forma los esfuerzos en el territorio.\nActualmente, la ROC cuenta con recursos desde ABC (50%) para ejecutar parcialmente esta caracterización,\nlos que se busca complementar con aportes de Rewilding Chile (50%). De esta manera se espera lograr una\ncaracterización con un alcance amplio, que combine una revisión exhaustiva de antecedentes de fuentes\nsecundarias, así como un trabajo de campo que permita recolectar datos primarios en terreno. Para ello, se\nespera:\ni) Recopilar y consolidar la información existente sobre los predios con presencia de picaflor de Arica en los\nvalles de Vítor y Camarones, incluyendo información: biológica y espacial sobre picaflor de Arica, catastral,\npredial y de propiedad, agrícola y productiva, hídrica, ambiental, normativa y de proyectos en el predio en\nparticular.\nii) Trabajo de campo y caracterización social, agrícola y ecológica de los predios, incluyendo entrevistas a\npropietarios, residentes y trabajadores para entender su relación con el predio, y disposición con el picaflor.\nAdicionalmente, se plantea realizar una caracterización de la vegetación de los predios productivos, para\nasociar tipos de manejo con la ocurrencia de picaflores.\nEl producto final consolidará todos los componentes anteriores en un informe único, acompañado de la base\nde datos catastral, las capas SIG, los instrumentos aplicados y los respaldos del trabajo de campo.\nAbordaje por parte de un equipo a nivel local de un catastro completo referente a la tenencia de la tierra,\nprácticas agrícolas, uso de la tierra y la identificación de procesos que se pueden proyectar con propietarios y\nadministradores de la tierra.\nFRC complementaría al aporte parcial que ha comprometido ABC a ROC en esta línea de manera de\ndesarrollar un levantamiento completo que es fundamental para desarrollar una estrategia de colaboración e\nintervención proactiva. En paralelo, incluye explorar la posibilidad de destinar a fines de conservación tierras\nasociadas a Ariztía en la zona.\nCostos estimados asociados a las líneas de acción del Programa Picaflor de Arica\nResumen detallado de costos estimados de las líneas de Investigación y Manejo\n33333\n3.1.2.3.4.5\n..... OMCMN\nT\nIn v e stig a ció n y M a n e jo P ica flo r d e A rica\nfe rta co n tín u a d e a lim e n to\ne jo ra s d e l h á b ita t d e n id ifica ció n\nre a ció n d e le k s a rtificia le s\na n e jo d e la co m p e te n cia co n e l p ica flo r d e C o ra\né cta r y P e sticid a s\no ta l e stim a d o In v e stig a ció n y M a n e jo (2 0 2 6 - 2\n2 0 2 6 +\n0 2 7 )\n2 0 2 6\n2 0 2 7\n2 0 2 7\np rim a v e ra - v\n1 0 .4 0 0\n7 .5 0 0\n8 .3 0 0\n0\n3 .0 0 0\n2 9 .2 0 0\n3 6 .0 0 0\n5 0 .5 0 0\n8 6 .5 0 0\ne\n2 0 2\nra n o\n6o\nto ñ o - in\n6 .8 0000\n6 .8 0\nv0\n0\nie rn o p rim a v e ra - v\n6 .9 0 0\n6 .5 0 0\n6 .3 0 0\n9 .2 0 0\n5 .0 0 0\n3 3 .9 0 0\ne\n2 0 2\nra n o\n7o\nto ñ o - in v ie\n6 .6 0 0\n00\n7 .0 0 0\n3 .0 0 0\n1 6 .6 0 0\nrn o\nM o\nM $ 2 0 2 6\n1 7 .2 0 0\n7 .5 0 0\n8 .3 0 0\n0\n3 .0 0 0\n3 6 .0 0 0\nn to s\nM $ 2 0 2 7\n1 3 .5 0 0\n6 .5 0 0\n6 .3 0 0\n1 6 .2 0 0\n8 .0 0 0\n5 0 .5 0 0', 'description': None, 'parent_drive_file_id': '1ERz-6WD0wNjkEDnv9JhqPieWo70Lwg01', 'children': []}]}, {'id': '6a86b387-ce9b-48ef-9342-93096de399cf', 'drive_file_id': '178NXwYEx2gcYFr3d58mycCynrntW6xb1', 'name': 'Presentaciones', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/178NXwYEx2gcYFr3d58mycCynrntW6xb1', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 9, 122000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': [{'id': 'a6ff613b-583e-4d54-9198-472ac62d8a4a', 'drive_file_id': '1c-UeBx3OUjl-PBMgeEQaYUIzf8RN_56U', 'name': 'PPT Colombia_v1.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1c-UeBx3OUjl-PBMgeEQaYUIzf8RN_56U/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 41, 779000, tzinfo=datetime.timezone.utc), 'text_content': 'CONECTANDO Y RESTAURANDO\nECOSISTEMAS A GRAN ESCALA\nSOMOS EL LEGADO DE\nTOMPKINS\nCONSERVATION\nPASADO PRESENTE\n11,8\n7,4\nMILL HÁ\nMILL HÁ\nPROTEGIDAS\nPROTEGIDAS\n17\n10\nPARQUES\nPARQUES\nNACIONALES\nNACIONALES\n¿QUÉ HACEMOS?\nMÁS DE 30 AÑOS\nCREANDO\nPARQUES NACIONALES\nEN CHILE\n7 PARQUES NACIONALES\n3 AMPLIACIONES\nEN ARGENTINA\n5 PARQUES NACIONALES\n2 PARQUES NACIONALES MARINOS\nSANTUARIO DE NATURALEZA PARQUE PUMALIN\n288.688,999 hectáreas\n2005, Ricardo Lagos E.\nEn el año 2005, siendo un área protegida privada, fue declarada\nSantuario de la Naturaleza, según Decreto Exento n.º 1.137 del\n18 de agosto del 2005 del Ministerio de Educación.\nPARQUE NACIONAL CORCOVADO\n294.000 HÁ\n2005, Presidente Ricardo Lagos E.\nPARQUE NACIONAL YENDEGAIA\n150.600 HÁ\n2013, Presidente Sebastián Piñera\nPN HORNOPIRÉN - PN PUMALIN DOUGLAS TOMPKINS — PN CORCOVADO - PN MELIMOYU\nPN ISLA MAGDALENA - PN CERRO CASTILLO - PN PATAGONIA - PN KAWÉSQAR\n(2018)\n530\nMIL HECTÁREAS\nDONADAS\n985\nHITO\nMIL HECTÁREAS\nFISCALES\nPARA LA\nCONSERVACIÓN\n2,6\nMILLONES DE HÁ\nRECLASIFICADAS\n4,6\nMILLONES DE HÁ\nPROTEGIDAS\n2 PARQUES MODELOS\nParque Nacional Pumalín Douglas Tompkins\nRegión de Los Lagos, Provincia de Llanquihue y de Palena\n402.392 hectáreas\nParque Nacional Patagonia\nRegión de Aysén, Provincia General Carrera y Capitán Prat\n304.527,75 hectáreas\nPARQUE NACIONAL\nPUMALÍN\nDOUGLAS TOMPKINS\nPARQUE NACIONAL\nPATAGONIA\n¿POR QUÉ RUTA\nDE LOS PARQUES?\n✓ 17\nPARQUES NACIONALES\n✓ 2800 ✓ 60+\nKILÓMETROS COMUNIDADES\n✓ 3\n✓ 11,8\nREGIONES\nMILLONES DE HECTÁREAS\n✓ 91%\nDE TERRITORIO PROTEGIDOS\nPARQUES NACIONALES\nLA RUTA DE LOS PARQUES\nalmacena el 30% de carbono en Chile\nCasi 3 veces más carbono por hectárea que la Amazonía\nRUTA DE LOS\nPARQUES\n558 ton de C/ha\nV\nAMAZONÍA\n206,47* ton de C/ha\nINVERSIÓN EN PARQUES\n“LA TASA DE RETORNO DE LOS PARQUES NACIONALES\nES DE USD 10 POR CADA DÓLAR INVERTIDO POR LOS\nCONTRIBUYENTES NORTEAMERICANOS”\n“LA MAYOR PARTE DE ESOS INGRESOS QUEDAN\nEN LAS COMUNIDADES ALEDAÑAS 100 KM ALREDEDOR\nDE LOS PARQUES NACIONALES”\nFundación Rewilding Chile firma protocolo de acuerdo con el Gobierno\nde Chile, para crear el nuevo Parque Nacional Cabo Froward\n(121.624,63 hectáreas)\nMarzo 2024\nVideo del futuro PNCF\nCorredor Andino:\nUna visión continental para el rewilding:\nRECUPERACIÓN DE ESPECIES CLAVES EN LOS ECOSISTEMAS\n¿CUÁLES SON LAS ESPECIES CLAVE?\nGrandes carnívoros, herbívoros y frugívoros como el puma, el huemul,\nel guanaco, el ñandú , el cóndor y otras especies con las que se\ndesarrollan estrategias basadas en el rewilding\n¿Qué busca el rewilding?\n- Restaurar la integridad ecológica a gran\nescala mediante un enfoque integral que\nabarca: especies clave, conectividad\necológica y áreas protegidas.\n- Concepto dinámico y multifacético, con\nvisión de futuro, que ha sido adaptado y\nreinterpretado en distintos contextos\nalrededor del mundo.\n“El rewilding ….complementaa otros métodos que buscan establecer redes\nde largo alcance de protección de la naturaleza, poniendo énfasis en la\nimportancia de la conectividad y la gran escala.\nDe esta manera, el rewilding es en tanto un fin, en el sentido de corregir\nnuestros errores pasados en el manejo, como una estrategia para\ngarantizar la viabilidad de las unidades de conservación. Esta combinación\ninusual de ser un fin y una estrategia a la vezes, quizás, su característica\nintelectualmente más atractiva.”\nMICHAEL SOULÉ Y JOHN TERBORGH (1999)\nECOSISTEMA COMPLETO\n- Tiene todas las especies que allí\nevolucionaron, mayormente\nextinguidas en los últimos 200 años\npor causas humanas.\n- Restituirlas a todas a veces es\nimposible y por ello se prioriza\nreintroducir a LAS ESPECIES CLAVE.\nPUMAS AUMENTAN LA SALUD DE LOS ECOSISTEMAS Y LA BIODIVERSIDAD\n• Nutrientes y hábitat para invertebrados\n• Enriquecen el suelo y la diversidad de plantas\n• Aumenta el acceso al alimento de pequeños mamíferos (armadillos)\n• Proveen de alimentos a otros carroñeros y carnívoros\n• Aves y armadillos se alimentan de gusanos e insectos en las carroñas\nEcosistemas\ncompletos y\nfuncionales\nEspecies claves,\nroles ecológicos,\nextinciones\necológicas y\nfuncionales e\ninteracciones\nCasos emblemáticos de Rewilding – Década de los 90 (US)\nEl Cóndor de California Lobos en Parque Nacional Yellowstone\nReintroducción de\n22 individuos - 360 31 lobos, 1995. PNY\n1988: Colaboración transfronteriza (Chile – Perú – Bolivia) para la\nreintroducción de la vicuña en Ecuador\n270 vicuñas donadas\nque conforman hoy\nuna población de\n6.000\n2004 – 2018:Conversión Estancia Valle Chacabuco en el Parque Nacional\nPatagonia\nDesde la Ruta de los Parques de la Patagonia al Corredor Andino:\nLa Patagonia chilena ha sido históricamente nuestro ámbito de acción.\nFrente a crecientes tasas de defaunación y pérdida de hábitats en todo\nel continente, nos hemos propuesto ampliar nuestro impacto hacia\nnuevos territorios.\nProyectamos nuestro trabajo hacia el Corredor Andino, entendido\ncomo el área de influencia de la cordillera de los Andes, desde\nColombia y Venezuela hasta el Cabo de Hornos en la Patagonia.\nMediante alianzas estratégicas, buscaremos expandir la recuperación\nde otras especies amenazadas y ecosistemas para integrar el rewilding\ncomo una estrategia de conservación a escala andina.\nSexta extinción masiva\nPredicción de los Riesgos de Extinción Globales de Especies\n• Predicción de la extinción de\ndistintas especies al 2100.\n• Puntos de mayor riesgo de\nextinción son Sudamérica,\nAustralia y Nueva Zelanda.\n• Se destaca la Cordillera de los\nAndes\nLiu, Runya, Haruka Ohashi, Akiko Hirata, Longlong Tang, Tetsuya Matsui, Kousuke Terasaki, Ryuzo Furukawa, and Norihiro Itsubo. 2024. "Predicting the Global Extinction Risk for 6569 Species\nby Applying the Life Cycle Impact Assessment Method to the Impact of Future Land Use Changes" Sustainability 16, no. 13: 5484. https://doi.org/10.3390/su16135484\nCorredor Andino:\nuna visión continental\npara el rewilding\nEscalar su impacto y expandir esta visión\nConcentraremos esfuerzos en especies\nemblemáticas presentes a lo largo del Corredor\nAndino: el cóndor, el huemul, el guanaco, el\nñandú y el puma.\nCorredor Andino\nPUDÚ GUANACO CÓNDOR CANQUEN COLORADO\nPudu puda Lama guanicoe Vultur gryphus Chloephaga rubidiceps\nPUMA RANITA DE DARWIN GATOS PEQUEÑOS ÑANDU/ CHOIQUE HUEMUL\nPuma concolor Rhinoderma darwinii Leopardus guigna Rhea pennata pennata Hippocamelus bisulcus\nEspecies de amplia distribución, equivalentes ecológicos y amenazadas\nAproximación del Corredor Andino\nFoco en especies amenazadas y los ecosistemas\n•\nEvaluación de la matriz del territorio\n•\nColaboración interinstitucional\n•\nInvolucramiento público-privado\n•\nCarácter transfronterizo\n•\nEnfoque continental\n•\nParticipación de comunidades y la sociedad en\n•\ngeneral\nCompromiso del Estado\n•\nCORREDOR\nDEL HUEMUL\nINAUGURACIÓN\nCENTRO DE\nRESCATE Y\nREHABILITACIÓN\nDEL HUEMUL\nCENTRO DE RESCATE Y\nREHABILITACIÓN\nDEL HUEMUL\nCorredor Andino\nTurismo Naturaleza en la Red de Santuarios de la RMS utilizando al guanaco como\n“especie bandera en la restauración del paisaje de montaña\nPrograma Piloto - Repoblamiento\nguanacos zona central y turismo de naturaleza\n→ Restauración de subpoblaciones de guanaco en la Región\nMetropolitana\n→ Promover el turismo de naturaleza en la Red de Santuarios\nde la RM\n→Guanaco como especie bandera en la restauración del paisaje\nde montaña.\n→Red de Santuarios de la Naturaleza (3) –FCFCN, U. de Chile –\nGORE – Rewilding Chile.\n→ Conaf, MMA, SAG, cámaras de turismo y municipios de\nBarnechea y San José de Maipo.\n→ Convenio de colaboración para establecer centros de\nreproducción de guanacos.\nAlianza colaborativa por el Cóndor Andino\nProyecto Manku\nCorredor Andino - Alcances y Proyecciones\nUn continuo con gradientes y diferentes contextos\n•\nAbordaje por especies con visión ecosistémica\n•\nGran escala y expansión, mayor impacto\n•\nSe busca consolidar el rewilding como estrategia\n•\nen la conservación de la naturaleza de Chile y\nSudamérica.\nNecesidad de escalar su impacto y expandir esta\n•\nvisión más allá de la Patagonia.\nEl Rewilding en Chile y el Corredor Andino\n• Red colaborativa que se extiende desde la\nPatagonia y sus mares para proteger y restaurar\necosistemas completos.\n• Abordar la recuperación de especies amenazadas y\nel restablecimiento de interacciones ecológicas\nclaves.\n• Promover sinergias entre países para optimizar\nrecursos, compartir aprendizajes y amplificar el\nimpacto.\n• Enfoque integral para establecer corredores y áreas\nsilvestres protegidas, restauración de hábitats\ncríticos, manejo activo, reintroducciones y\nrefuerzos poblacionales.\nCorredor Andino\nVisión de conservación continental de los\n•\necosistemas asociados a la Cordillera de los\nAndes, especies claves y en condición de\namenaza.\nDesde Venezuela hasta la confluencia de los\n•\nOcéanos Pacífico, Atlántico y Antártico por el\nsur.\nRevisión del estado de conservación global y\n•\nlocal de especies y estrategias de\nconservación implementadas.\nCordillera de Los Andes 9.000 Km\nMapa de actores involucrados en estas\n•\n7 países: Argentina, Chile, Bolivia, Perú, Ecuador,\niniciativas para aumentar la red de\nColombia y Venezuela.\nCordillera terrestre más larga\ncolaboración.\nSegunda más alta del planeta, después del\nAvanzar hacia los objetivos de biodiversidad al Himalaya.\n•\n2030.\nCÓNDOR\nVultur gryphus\nGAVIOTÍN\nCHICO\nSternula lorata\nOBJETIVOS DE\nLARGO PLAZO\nPUDÚ\nPudu mephistophiles\nRANA DEL LOA\n1 Telmatobius dankoi\nPUMA\nConsolidar la Ruta de los\nPuma concolor\nParques de la Patagonia como\nun referente de conservación a\nnivel continental\nHUEMUL VIZCACHA DE LA\nHippocamelus bisulcus MONTAÑA\nLagidium viscacia\n2\nSURI\nExpandir el rewilding hacia el Rhea pennata tarapacensis\nCorredor Andino\nTARUCA\nHippocamelus antisensis\nPICAFLOR DE ARICA\nEulidia yarrellii\nGUANACO\nLama guanicoe\nCHUNGUNGO\nCHINCHILLA Lontra provocax\nChinchilla chinchilla\nOtros aspectos a ser considerados por el Rewilding\nIniciamos con ecosistemas\n•\nPersonas se identifican con\n•\nespecies carismáticas\nEspecies claves y paraguas\n•\nFauna tiene más restricciones\n•\npara manejo\nFlora amenazada es importante\n•\nRewilding en áreas costeras y\n•\nmarinas', 'description': None, 'parent_drive_file_id': '178NXwYEx2gcYFr3d58mycCynrntW6xb1', 'children': []}, {'id': '71837388-e784-4a00-a5b0-2a4062dba516', 'drive_file_id': '14Au3edzfEiCpYRX_CqSUJkQyL9L52RC-', 'name': 'Rewilding Corredor Andino 2025.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/14Au3edzfEiCpYRX_CqSUJkQyL9L52RC-/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 43, 918000, tzinfo=datetime.timezone.utc), 'text_content': 'Corredor Andino:\nUna visión continental para el Rewilding:\nSOMOS EL LEGADO DE\nTOMPKINS CONSERVATION\nPASADO PRESENTE\n11,8 MILL HÁ\n7,4 MILL HÁ\nPROTEGIDAS\nPROTEGIDAS\n17\n10\nPARQUES\nPARQUES\nNACIONALES\nNACIONALES\nRECUPERACIÓN DE ESPECIES CLAVES EN LOS ECOSISTEMAS\n¿QUÉ HACEMOS?\n¿CUÁLES SON LAS ESPECIES CLAVE?\nGrandes carnívoros, herbívoros y frugívoros como el puma, el huemul,\nel guanaco, el ñandú , el cóndor y otras especies con las que se\ndesarrollan estrategias basadas en el Rewilding\nCORREDOR\nNACIONAL\nDEL HUEMUL\nINAUGURACIÓN\nCENTRO DE\nRESCATE DEL\nHUEMUL\nCENTRO DE RESCATE Y\nREHABILITACIÓN\nDEL HUEMUL\nCorredor Andino\n¿Qué busca el Rewilding?\n- Restaurar la integridad ecológica a gran\nescala mediante un enfoque integral que\nabarca: especies clave, conectividad\necológica y áreas protegidas.\n- Concepto dinámico y multifacético, con\nvisión de futuro, que ha sido adaptado y\nreinterpretado en distintos contextos\nalrededor del mundo.\n“El rewilding es el elemento más reciente en la historia del movimiento\ncientífico de la conservación. Sin embargo, no se debe utilizar como un\nenfoque aislado. Más bien, complementa a otros métodos que buscan\nestablecer redes de largo alcance de protección de la naturaleza, poniendo\nénfasis en la importancia de la conectividad y la gran escala.\nA diferencia de otros enfoques, facilita el diseño y la gestión de áreas\nprotegidas evitando que se aborden a las especies de manera individual.\nDe esta manera, el rewilding es en tanto un fin, en el sentido de corregir\nnuestros errores pasados en el manejo, como una estrategia para\ngarantizar la viabilidad de las unidades de conservación. Esta\ncombinación inusual de ser un fin y una estrategia a la vez es, quizás, su\ncaracterística intelectualmente más atractiva.”\nMICHAEL SOULÉ Y JOHN TERBORGH (1999)\nECOSISTEMA COMPLETO\n- Tiene todas las especies que allí\nevolucionaron, mayormente\nextinguidas en los últimos 200\naños por causas humanas.\n- Restituirlas a todas a veces es\nimposible y por ello se prioriza\nreintroducir a LAS ESPECIES\nCLAVE.\nPUMAS AUMENTAN LA SALUD DE LOS ECOSISTEMAS Y LA BIODIVERSIDAD\n✓ Nutrientes y hábitat para invertebrados\n✓ Enriquecen el suelo y la diversidad de plantas\n✓ Aumenta el acceso al alimento de pequeños mamíferos (armadillos)\n✓ Proveen de alimentos a otros carroñeros y carnívoros\n✓ Aves y armadillos se alimentan de gusanos e insectos en las carroñas\nEcosistemas\ncompletos y\nfuncionales\nEspecies claves,\nroles\necológicos,\nextinciones\necológicas y\nfuncionales e\ninteracciones\nCasos emblemáticos de Rewilding – Década de los 90 (US)\nEl Cóndor de California Reintroducción de Lobos en el Parque Nacional Yellowstone\n22 individuos - 360 31 lobos, 1995. PNY\n1988: Colaboración transfronteriza (Chile – Perú – Bolivia) para la reintroducción de la\nvicuña en Ecuador\n270 vicuñas\ndonadas que\nconforman hoy\nuna población de\n6.000\n2019: Rescate de la Rana del Loa. Herpetólogos y Zoológico Nacional\nEn Oasis de Calama herpetólogos encuentran los últimos 74\nindividuos e intervención de maquinaria pesada.\nRescate 1 - 60 ranas son trasladadas a la quebrada Ojo de\nOpache\nRescate 2 - 14 ranas trasladadas al Zoo Nacional de Chile. Se\nencontraban en muy mal estado de salud.\nPrograma de rehabilitación y crianza en acuarios\nespecialmente acondicionados con agua\npurificada y dieta variada de invertebrados.\nReproducción exitosa de algunas parejas produciendo 600\nrenacuajos. Proceso de recuperación incluyó\nasistencia nutricional, adaptacion a la vida en\ncautiverio y estimulo de la reproduccion.\nLa reproducción en cautiverio será inútil si no se reintroducen\nen su hábitat natural, por lo que resulta crucial\ntrabajar en la restauración de su hábitat.\n2004 – 2018:Conversión Estancia Valle Chacabuco en el Parque Nacional\nPatagonia\nDesde la Ruta de los Parques de la Patagonia al Corredor Andino:\nLa Patagonia chilena ha sido históricamente nuestro ámbito de\nacción.\nFrente a crecientes tasas de defaunación y pérdida de hábitats\nen todo el continente, nos hemos propuesto ampliar nuestro\nimpacto hacia nuevos territorios.\nProyectamos nuestro trabajo hacia el Corredor Andino,\nentendido como el área de influencia de la cordillera de los\nAndes, desde Colombia y Venezuela hasta el Cabo de Hornos\nen la Patagonia.\nMediante alianzas estratégicas, buscaremos expandir la\nrecuperación de otras especies amenazadas y ecosistemas para\nintegrar el rewilding como una estrategia de conservación a\nescala andina.\nSexta extinción masiva\nPredicción de los Riesgos de Extinción de Especies Globales\n• Predicción para el año 2100\nde las extinción de distintas\nespecies.\n• Puntos de mayor riesgo de\nextinción son Sudamérica,\nAustralia y Nueva Zelanda.\n• Se destaca la Cordillera de los\nAndes\nLiu, Runya, Haruka Ohashi, Akiko Hirata, Longlong Tang, Tetsuya Matsui, Kousuke Terasaki, Ryuzo Furukawa, and Norihiro Itsubo. 2024. "Predicting the Global Extinction Risk for 6569 Species by\nApplying the Life Cycle Impact Assessment Method to the Impact of Future Land Use Changes" Sustainability 16, no. 13: 5484. https://doi.org/10.3390/su16135484\nCorredor Andino:\nuna visión continental\npara el rewilding\nEscalar su impacto y expandir esta visión\nConcentraremos esfuerzos en las 5 especies\nemblemáticas presentes a lo largo del\nCorredor Andino: el cóndor, el huemul, el\nguanaco, el ñandú y el puma.\nCorredor Andino\n• Visión de conservación continental de los\necosistemas asociados a la Cordillera de los\nAndes, especies claves y en condición de\namenaza.\n• Desde Venezuela hasta la confluencia de los\nOcéanos Pacífico, Atlántico y Antártico por el\nsur.\n• Revisión del estado de conservación global y\nlocal de especies y estrategias de conservación\nimplementadas.\n• Mapa de actores involucrados en estas\nCordillera de Los Andes 9.000 Km\niniciativas para aumentar la red de\n7 países: Argentina, Chile, Bolivia, Perú,\ncolaboración.\nEcuador, Colombia y Venezuela.\nCordillera terrestre más larga\n• Avanzar hacia los objetivos de biodiversidad al\nSegunda más alta del planeta, después\n2030.\ndel Himalaya.\nAproximación del Corredor Andino\n• Foco en especies amenazadas y los\necosistemas que requieren\n• Evaluación de la matriz del territorio\n• Colaboración interinstitucional\n• Involucramiento público-privado\n• Carácter transfronterizo\n• Enfoque continental\n• Participación de comunidades y la\nsociedad en general\n• Compromiso del Estado\nCÓNDOR\nVultur gryphus\nGAVIOTÍN\nCHICO\nSternula lorata\nOBJETIVOS DE\nLARGO PLAZO\nPUDÚ\nPudu mephistophiles\nRANA DEL LOA\n1 Telmatobius dankoi\nPUMA\nConsolidar la Ruta de los\nPuma concolor\nParques de la Patagonia como\nun referente de conservación a\nnivel continental\nHUEMUL VIZCACHA DE LA\nHippocamelus bisulcus MONTAÑA\nLagidium viscacia\n2\nSURI\nExpandir el rewilding hacia el Rhea pennata tarapacensis\nCorredor Andino\nTARUCA\nHippocamelus antisensis\nPICAFLOR DE ARICA\nEulidia yarrellii\nGUANACO\nLama guanicoe\nCHUNGUNGO\nCHINCHILLA Lontra provocax\nChinchilla chinchilla\nEspecies de amplia distribución, equivalentes ecológicos y amenazadas\nTurismo Naturaleza en la Red de Santuarios de la RMS utilizando al guanaco como\n“especie bandera en la restauración del paisaje de montaña\nPrograma Piloto - Repoblamiento\nguanacos zona central y turismo de naturaleza\n→ Restauración de subpoblaciones de guanaco\nen la Región Metropolitana\n→ Turismo de naturaleza en la Red de Santuarios\nde la Región Metropolitana\n→Guanaco como especie bandera en la\nrestauración del paisaje de montaña.\n→Red de Santuarios de la Naturaleza – Santuario\nLagunillas - Santuario El Plomo - Santuario\nCascada – Fac. Cs.. Forestales y Cons. Naturaleza,\nU. de Chile – GORE Metropolitano – Fundación\nRewilding Chile.\n→ Conaf, MMA, SAG, cámaras de turismo y\nmunicipios de Barnechea y San José de Maipo.\n→ Convenio de colaboración para establecer\ncentros de reproducción de guanacos.\nREPOBLAMIENTO GUANACOS\nCONSERVACIÓN A GRAN ESCALA\nAlianza colaborativa por el Cóndor Andino\nProyecto Manku\nhttp://www.icesi.edu.co/wiki_aves_colombia/show_image.php?id=580\nOtros aspectos a ser considerados por el Rewilding\n• Iniciamos con ecosistemas\n• Personas se identifican con\nespecies carismáticas\n• Especies claves y paraguas\n• Fauna tiene más restricciones\npara manejo\n• Flora amenazada es importante\n• Rewilding en áreas costeras y\nmarinas\nCorredor Andino - Alcances y Proyecciones\nUn continuo con gradientes y diferentes contextos\n•\nAbordaje por especies con visión ecosistémica\n•\nGran escala y expansión, mayor impacto\n•\nSe busca consolidar el rewilding como estrategia\n•\nen la conservación de la naturaleza de Chile y\nSudamérica.\nNecesidad de escalar su impacto y expandir esta\n•\nvisión más allá de la Patagonia.\nEl Rewilding en Chile y el Corredor Andino\n• Red colaborativa que se extiende desde la\nPatagonia y sus mares para proteger y restaurar\necosistemas completos.\n• Abordar la recuperación de especies amenazadas y\nel restablecimiento de interacciones ecológicas\nclaves.\n• Promover sinergias entre países para optimizar\nrecursos, compartir aprendizajes y amplificar el\nimpacto.\n• Enfoque integral para establecer corredores y\náreas silvestres protegidas, restauración de\nhábitats críticos, manejo activo, reintroducciones y\nrefuerzos poblacionales,', 'description': None, 'parent_drive_file_id': '178NXwYEx2gcYFr3d58mycCynrntW6xb1', 'children': []}]}, {'id': '5901948d-7465-4ad1-8292-39a5f079a598', 'drive_file_id': '1AmsmKrUZ2sBLRYP5RqP2kieFLM7jnG3F', 'name': 'Proyecto Guanacos RM desde 2024', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1AmsmKrUZ2sBLRYP5RqP2kieFLM7jnG3F', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 4, 385000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': [{'id': 'f0b43c5a-7ca5-4ef2-85ba-49e02b636009', 'drive_file_id': '1x7xbWwjjed8eTg9IkmC5v7c67fhr8g-s', 'name': 'Borrador Guanaco vision_31.12.25_27.05.26L.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1x7xbWwjjed8eTg9IkmC5v7c67fhr8g-s/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 32, 860000, tzinfo=datetime.timezone.utc), 'text_content': 'MINUTA RESUMEN (BORRADOR)\nEL GUANACO COMO ESPECIE CLAVE DE LOS ECOSISTEMAS NATIVOS\nEN CHILE Y SU PROYECCION A ESCALA CONTINENTAL\n- CONTEXTO\nExisten especies nativas que requieren grandes espacios de territorio para establecer poblaciones\nque cumplan su función ecológica a largo plazo y ofrezcan servicios ecosistémicos que puedan\nutilizarse de forma sostenida por el ser humano en el tiempo. Por ello, estas especies, si son\ncarismáticas, pueden ser utilizadas como paraguas para proteger elementos desconocidos del\necosistema y como especie bandera para captar la atención de la ciudadanía y lograr apoyo\ngubernamental, beneficiando a otras especies menos atractivas.\nUna de las especies que cumple con estas condiciones es el guanaco, camélido sudamericano\nsilvestre de gran tamaño y fácil identificación que vive en la zona central de Chile, con una\ndistribución fragmentada, pero en reciente crecimiento numérico y expansión territorial. Gracias a\nque esta familia ha evolucionado en ambientes áridos, secos y fríos, es que aparentemente ha\nmostrado una mejor respuesta al cambio climático, extendiendo su distribución y aumentando\ntamaño poblacional. Una vez abundante en el pasado, su disminución en la Región Metropolitana\nde Santiago (RMS) se ha debido a constante cacería y ocupación de su hábitat por el ganado. Sin\nembargo, gracias a la prevención de amenazas y la protección que se ha dado a la única población\nnatural, de aproximadamente 300 individuos junto al Volcán Maipo en el recientemente creado\nSantuario de la Naturaleza Cruz de Piedra, es que se espera que esta población siga creciendo, y lo\nmás importante, siga extendiendo su distribución en la cordillera de la RMS, aprovechando el estatus\nde Sitios Prioritarios para la Conservación de la Biodiversidad de la Region Metropolitana para\n462.253 hectáreas en la comuna de San José de Maipo (Sitio 3 Altos del Maipo, sitio 4 El Morado,\nVolcán y San José de Maipo, y Sitio 5 Rio Colorado, Rio Olivares y Tupungato y Sitio 10 Zona Alto\nAndina del valle del Yeso. Además de Area de interés científico para efectos mineros DS 78/2006\nMinisterio de Minería, que blinda 244.475 hectáreas.\nAdicionalmente a esta población, se ha observado en los últimos años, y notoriamente a partir de la\npandemia, la migración y permanencia estacional de tropillas de guanacos en territorio cordillerano\nchileno en el valle del Yeso y del Volcán, las cuales han migrado desde Argentina por pasos de menor\nnivel altitudinal del rio Yeso y Volcán, desde las Areas Protegidas Volcán Tupungato y Laguna del\nDiamante de la República Argentina.\nEs por ello que este abordaje pretende generar un paisaje de conservación de montaña para el\nguanaco en las regiones de la zona central de Chile, a través de crear y promover territorios de\nconectividad para el guanaco en los Andes, trabajando de forma coordinada y planificada sobre los\nparches territoriales de propiedad pública y privada protegidos y sobre la matriz zonal, donde se\nintegran también diversas actividades de uso privadas no directamente ligadas a la conservación. A\ntravés de acciones de conservación para la especie se espera contar con una población sana y viable\na largo plazo que recupere su función ecológica en su ambiente natural en coexistencia con las\npoblaciones locales y sus actividades.\nLas acciones pasivas de conservación, como la protección del hábitat del guanaco, han demostrado\nefectividad tanto en áreas protegidas del SNASPE y privadas, como también en áreas de protección\nligadas a proyectos de inversión. Una vez que se han eliminado o disminuido los factores de amenaza\npara el guanaco, la especie por lo general se recupera rápida y naturalmente. Ejemplo de ello son\nlas poblaciones existentes en el PN. Torres del Paine, en la región de Magallanes, que en la década\ndel 70 contaba con 200 ejemplares y actualmente es uno de los principales atractivos turísticos;\ntambién la población protegida dentro de la propiedad de Minera los Pelambres (al sur de la región\nde Coquimbo), donde a fines de los 90s existían alrededor de 300 animales y luego de dos décadas\ny media ha aumentado en cuatro veces su tamaño; también el caso del Parque Andino Juncal (al sur\nde la región de Valparaíso) donde en los últimos años ha visto aumentado el número de guanacos\nque lo visitan durante la primavera y verano, situación que antes no se observaba.\nEs por ello que, el guanaco es un excelente indicador para evidenciar la efectividad de los manejos\nasociados a su protección, y paralelamente, también es un buen indicador cuando estos manejos no\nhan sido bien aplicados. Esto se aprecia en la disminución poblacional percibida de los guanacos en\nla costa de Atacama (PN Llanos de Challe y PN Pan de Azúcar), producto de la caza ilegal y la\npredación por perros. La protección y restauración de su hábitat en zonas estratégicas, permitirá el\navance y repoblamiento de zonas de la cordillera de Santiago donde antiguamente habitaba, el cual\npodría ser reforzado con acciones activas como la translocación estratégica de animales o de\nliberación de centros de rescate o reproducción.\nLa iniciativa de repoblamiento del guanaco asociada a la gestión de paisajes de conservación de\nmontaña, donde se utiliza al guanaco como especie bandera, se lograría a largo plazo gracias a la\ncolaboración público-privada (Figura 1). Ello mediante la articulación y coordinación de actores\ndirectos como la Red de Santuarios de la Naturaleza de RMS y las áreas protegidas del Estado que\ntienen su ubicación en la cordillera de los Andes en la misma región, y que poseen hábitat disponible\npara la especie pese a no tener grupos naturales de guanaco en sus propiedades en la actualidad.\nPara favorecer la conectividad y el repoblamiento de guanacos entre el Santuario de la Naturaleza\nCruz de Piedra, ubicado en el nacimiento de río Maipo, y las áreas dedicadas a la conservación en la\nRMS, se requiere trabajar fuertemente en la matriz de los territorios privados con fines de\nconservación o con actividades productivas diversas, bajo tres grandes conceptos: el paradigma de\nla sostenibilidad donde la producción contemple beneficios económicos, sociales y principalmente\nambientales; la restauración del paisaje donde privados puedan zonificar o destinar espacios al\ntránsito y permanencia de grupos de guanacos en sus propiedades y la promoción de centros de\nreproducción y translocaciones, además del control de las amenazas para la especie, tales como la\neliminación de la caza furtiva, la aplicación de buenas prácticas ganaderas y el control de perros de\nvida libre.\nSN Cruz de Piedra\na\nd\nv\nti\na c Actividad productiva sostenible\nd u\niv\nti\nd\no\nc e r p Control de amenazas\nn\no\nC\nz\nir Restauración del paisaje\nt\na\nM\nRescates, Centro de reproducción\ny translocaciones\nRed de Santuarios RMS y\nSNASPE de cordillera\nFigura 1. Esquema de repoblamiento de guanacos en la Región Metropolitana de Santiago.\nEsta iniciativa es compatible con la (a) Estrategia Nacional de Biodiversidad, (b) la inclusión del\nguanaco en la Convención de Especies Migratorias (CMS/\nhttps://www.cms.int/sites/default/files/document/cms_cop14_doc.31.4.3_listing-proposal-\nguanaco_s.pdf Y https://guanaconecta.com/es/) el cual otorga un marco de acuerdo para trabajar\ntransfronterizamente en la conservación de esta especie; (c) el área Prohibida de Caza Santiago\nAndino del SAG, que protege legalmente ,vedando la caza en todo el territorio de la comuna de San\nJosé de Maipo, (d) con la Planificación Estratégica para la conservación del guanaco en Chile central\nllevado a cabo por WCS, y con diferentes iniciativas de uso sustentable en ambientes de montaña,\ncomo es el turismo y ecoturismo.\nSe nos plantea una oportunidad única de poder trabajar de forma planificada y coordinada entre\ndiferentes actores para lograr tener junto a la principal metrópoli de Chile, un paisaje que haga\nmérito a su complejidad, que funcione como un ecosistema sano, que proteja sus recursos naturales\ny los servicios ambientales asociados, y que se utilice de forma sostenible, contribuyendo al\nabastecimiento de agua potable y riego agrícola; al bienestar humano y su salud mental, y aportando\nexperiencia y conocimiento como un laboratorio natural a la educación ambiental para la\nsustentabilidad en colegios y liceos de la región.\n- QUIENES SOMOS\nEl presente documento pretende aunar las visiones y objetivos compartidos del grupo de\ninstituciones que actualmente trabaja en el desarrollo de acciones para el repoblamiento de\nguanacos en la cordillera de la Región Metropolitana, en los predios de los miembros de la Red de\nSantuarios de la Naturaleza, y en el marco del proyecto “Turismo de Naturaleza en la Red de\nSantuarios utilizando al guanaco como especie bandera en la restauración del paisaje de montaña”.\nDicho proyecto, es ejecutado por la Facultad de Ciencias Forestales y Conservación de la Naturaleza\n(FCFCN) de la Universidad de Chile, y financiado por el Gobierno Regional de Santiago (GORE-RM),\npara la conservación de la biodiversidad y el desarrollo económico de las comunas de San José de\nMaipo y Lo Barnechea donde se localizan dichas Áreas Protegidas. Este proyecto aprobado en\noctubre de 2024, e iniciada su ejecución en noviembre de 2025, también cuenta con el apoyo técnico\ny financiero de la Fundación Rewilding Chile a través de un Convenio de Colaboración entre\nRewilding Chile y los S.N. San Francisco de Lagunillas y Quillayal, S.N. El Plomo, S.N. Cascada de las\nÁnimas, firmado el 12 de noviembre 2024, para el desarrollo de actividades conjuntas para la\nreproducción de guanacos con fines de conservación y el repoblamiento de esta especie en la pre\ncordillera y cordillera de la Región Metropolitana de Santiago.\nEl proyecto ha sido avalado mediante cartas de apoyo frente al GORE por el Ministerio de Medio\nAmbiente, la Corporación Nacional Forestal, los Municipios de Barnechea y San José de Maipo, las\nCámaras de Turismo local, la Asociación de Guías de San José de Maipo y diversas fundaciones como\nChile Sustentable y Kintu, entre otras\n- VISION\nLa visión del repoblamiento de guanacos, especialmente en la cordillera de Santiago, Chile, es un\nproyecto de restauración y rewilding (reasilvestramiento) a gran escala, liderado por entidades como\nla Red de Santuarios de la Naturaleza , Universidad de Chile y la Fundación Rewilding Chile\n(anteriormente Tompkins Conservation) mediante el cual se busca contribuir a restaurar el\necosistema andino, incluyendo el repoblamiento del guanaco y su rol de especie clave de estos\necosistemas, promoviendo el establecimiento de corredores biológicos nacionales y\ntransfronterizos, la puesta en valor del Patrimonio Ambiental y beneficiando la economía de las\ncomunidades locales, la educación y el turismo local y regional, con el objetivo a largo plazo de\nrecuperar poblaciones que sean capaces de sostenerse en el tiempo y que recuperen parte de su\ndistribución histórica , consolidando una reconexión con poblaciones de guanacos de Argentina.\n- OBJETIVO GENERAL\nEl objetivo general corresponde a la protección y restauración de los ecosistemas de montaña para\nla conservación de la biodiversidad, la cultura local y fomentar la conectividad y el repoblamiento\ndel guanaco en la Cordillera de la RM y en su sentido más amplio.\nEl objetivo general es tanto el repoblamiento del guanaco en la región como la restauración de los\necosistemas de montaña, para impulsar el turismo de naturaleza, promover y facilitar el desarrollo\nde estudios científicos -mediante monitoreos y censos-, e identificar y abordar las amenazas para\nesta especie. Esto bajo el concepto de restauración ecosistémica a escala de paisaje, incluyendo\nfauna nativa o “rewilding”; una estrategia de conservación que aborda los ecosistemas de manera\nintegral y dinámica y que fomenta la recuperación de la naturaleza mediante su manejo activo, para\nlo cual la colaboración entre instituciones resulta clave.\n- OBJETIVOS ESPECÍFICOS\nRestauración Ecosistémica: Recuperar la población de guanacos, incluyendo también su rol\necosistémico para restaurar las funciones del ecosistema andino a mayor escala representado por\nvegas, praderas y humedales, como así mismo su función en la cadena guanaco- puma-cóndor.\nRecuperación de Hábitats y Corredores: El establecimiento de tropillas sostenibles en el tiempo y la\nocupación por esta especie de valles y laderas de invernada, así como estacionalmente sectores de\naltura y corredores de la cordillera central y a lo largo de los Andes, conectando con áreas protegidas\nen Argentina.\nColaboración Pública Privada Amplia: Integrar a comunidades locales, municipios, universidades,\náreas protegidas privados y actores públicos en un esfuerzo conjunto.\nBeneficios Socio-Económicos: Impulsar el turismo de naturaleza y la investigación científica,\nreconociendo al guanaco como un símbolo de identidad y parte del patrimonio natural.\nConservación In - Situ y Ex - Situ: Promover y combinar estas estrategias, fomentando la protección\ndel hábitat y de las poblaciones existentes de guanacos, así como la reproducción en centros\nespecializados (como en santuarios), las translocaciones y el rescate de individuos.\n- ESTRATEGIA Y ACCIONES\nTraslado de Individuos, Translocaciones y Rescates: En el contexto del proyecto, se han trasladado\nguanacos desde otras regiones (como Longotoma en la región de Valparaíso y Canela en la región\nde Coquimbo) a los Santuarios de la Naturaleza de la Región Metropolitana.\nCentros de Reproducción: Se están instalando o ampliando centros para reproducción en 3\nSantuarios de la Naturaleza de la Region Metropolitana, para así generar individuos que puedan\nconformar grupos de liberación en dichas áreas protegidas.\nPromoción y Creación de Corredores: Generar estrategias de colaboración y trabajo conjunto para\nutilizar territorios continuos (como Santuarios, Areas Protegidas Publicas, predios públicos y\nprivados colindantes, etc.) para promover la constitución de corredores biológicos para la especie\nen la RM, con otras regiones a nivel nacional y de carácter transfronterizo entre Chile y Argentina.\nManejo de la Cordillera: Implementar un plan de manejo general para la en las comunas de montaña\ncomo San José de Maipo y Lo Barnechea, reconociendo y poniendo en valor su importancia. No\nperder de vista la Cordillera de la Costa.\n- DESAFÍOS\nPresión Histórica: La disminución de guanacos en la cordillera de la Region Metropolitana de\nSantiago, así como en otras regiones de Chile central, se debe principalmente a la caza furtiva y la\ncompetencia con el ganado.\nAmenazas Actuales: Los perros asilvestrados durante los últimos años también representan una\namenaza para las poblaciones de guanacos y la caza furtiva sigue estando presente en diversos\nniveles en las regiones del país.\nGestión de intereses y aliados posibles de la iniciativa: El proyecto de reproducción y liberación de\nguanacos con fines de conservación, como asimismo la reducción de amenazas a la especie para\nimpulsar su repoblamiento en la cordillera de la Región Metropolitana, ha concitado amplio interés\nen varias instituciones, que buscan sumarse a la iniciativa. Es importante que las instituciones que\nactualmente desarrollan el proyecto, evalúen alternativas de trabajo y metodologías para que las\ninstituciones interesadas puedan sumarse a la iniciativa desde sus particularidades.\n- RUTA DE TRABAJO / PROXIMOS PASOS 2026\n1. Completar la infraestructura de los 3 centros de reproducción y su respectiva regularización\nante el SAG. Avances en la reproducción (conformación de grupos reproductivos y búsqueda de\nnuevos individuos para ampliar la masa reproductiva), perfeccionar los protocolos sanitarios y de\nalimentación y monitoreo de los primeros nacimientos.\n2. Consolidar una estructura de gobernanza del proyecto con las instituciones integrantes del\nproyecto, colaboradores y aliados y avanzar hacia la creación de un grupo de trabajo, o conformación\nde una “mesa intersectorial del repoblamiento de guanaco”, liderando su constitución y permitiendo\nincorporar y alinear a otros aliados y colaboradores que deseen ser parte de este movimiento de\nrepoblamiento (Rewilding) en distintas regiones de Chile y con una mirada a escala continental.\n3. Avanzar con la planificación de las actividades de turismo de naturaleza, con enfoque de lista\nverde de la UICN y de un buffer social para la conservación, incorporando a las comunidades,\narrieros, autoridades y gremios locales en las comunas de Lo Barnechea y San José de Maipo.\n4. Con el fin de acelerar el proceso de repoblamiento, sería deseable explorar la posibilidad de\ntranslocar guanacos desde Cruz de Piedra en la RM, o desde las regiones de Valparaíso y Coquimbo\nhacia los centros de reproducción. E incluso desde Argentina, por ejemplo, aprovechando los\ncontactos técnicos y político de la Universidad de Chile, del Gobierno Regional y desde las\nfundaciones integrantes del proyecto. (En este último caso, desde el punto de vista de\ninfraestructura significaría cumplir con la cuarentena y algunos otros procedimientos de los cuales\nya se tiene experiencia previa como por ejemplo con la translocación de ñandúes de Argentina a\nChile).\n5. En el ámbito de la información y la investigación, es clave diseñar un programa que permita\nsistematizar, desafíos, aprendizajes, resultados de las acciones del proyecto en el ámbito de: (a) la\nreproducción con fines de conservación; (b) la estrategia de liberaciones pasivas y repoblamiento;\n(c) la gestión y prevención de amenazas; y (d) la sustentabilidad financiera de mediano y largo plazo\npara la sustentabilidad de las líneas de trabajo del proyecto.\nEn el punto 5 considerar la gobernanza local. Periodicidad en nuestras reuniones a los aprendizajes\nde cada centro, el tema con el SAG.\nParámetros suficientes para tener una estructura de reproductiva, como 10 o 15 jóvenes, cuantas\nhembras necesitamos, como las mantendremos en los recintos, vamos a juntar en un centro para\nliberar o en cada centro. La liberación debe ser sistemática, con 2 o 3 años de reproducción\nconstante.\nArea de reproducción, área de crianza a 3 años, zona de aclimatación. Sería ideal tener 3 puntos para\nliberar.\nEstá comprometido el lanzamiento del proyecto con el Gobernador.', 'description': None, 'parent_drive_file_id': '1AmsmKrUZ2sBLRYP5RqP2kieFLM7jnG3F', 'children': []}, {'id': '70a061f9-8852-4122-8720-c6349a69a52e', 'drive_file_id': '1-6ZatH-QiNVnfc9sRddUn0PYCFYeGk1W', 'name': 'ENCUENTRO GUANACO_11.06.26.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1-6ZatH-QiNVnfc9sRddUn0PYCFYeGk1W/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 35, 354000, tzinfo=datetime.timezone.utc), 'text_content': 'ENCUENTRO COLABORATIVO POR EL GUANACO,\nESPECIE CLAVE DE LOS ECOSISTEMAS ANDINOS\nJUEVES 30 JULIO, SANTIAGO DE CHILE\nEl proyecto GORE- Universidad de Chile tiene como objetivo general la protección y restauración de\nlos ecosistemas de montaña para la conservación de la biodiversidad, la cultura local y el\nrepoblamiento del guanaco en la Cordillera de la Región Metropolitana.\nLa convocatoria a este encuentro lo realiza esta alianza integrada por la Red de Santuarios de\nNaturaleza de la Región Metropolitana, Universidad de Chile y Fundación Rewilding Chile.\n- Fecha propuesta: jueves 30 julio, 2026.\n- Horario: 8:30 a 14:00.\n- Con coffee break.\n- Solicitamos la sala en la Universidad Adolfo Ibañez (UAI), también Benito esta averiguando\nen las salas nuevas del Universidad de Chile.\nObjetivo: Un encuentro ampliado a todas las organizaciones y personas que estén trabajando o\nhayan estado involucradas en acciones de conservación y manejo relacionadas al guanaco. Esto\npermitirá generar un espacio para compartir experiencias, aprendizajes y proyectar en el mediano\nplazo la conformación de una futura mesa de trabajo para para articular esfuerzos y darle impulso\nestratégico a la conservación del guanaco incluyendo iniciativas como el repoblamiento activo.\nResultado esperado: Una declaración de intenciones o manifiesto general que incluya una visión y\nlos ejes de trabajo, como también las áreas geográficas. Los temas más en detalle como el ejemplo\nla colaboración especificas se verán caso a caso posterior al encuentro.\nPROGRAMA PROPUESTO\n8:30-9:00 INICIO Y BIENVENIDA DEL ENCUENTRO\n- Sara Larrain y/o Benito González, entregan un contexto general de esta alianza que convoca\na este “Encuentro colaborativo por el guanaco”, explicando el propósito de esta instancia,\nde trabajar en colaboración y relacionarlo a los objetivos del proyecto y la importancia de\nque estemos todos los que estamos contribuyendo desde distintos ejes con esta especie\nclave en la cordillera de Los Andes.\n- 3 minutos al Gobernador.\n- 3 minutos al SAG.\nEstructura de los paneles:\n- Cada moderador debe tener al menos unas 3 preguntas por cada invitado.\n- Cada panelista tiene 5 minutos para una presentación para contar su experiencia y referirse\nal tema del panel (puede ser con una ppt corta)\n9:00 – 10:00 PRIMER PANEL: “PLANES DE CONSERVACIÓN Y PROTECCIÓN DEL GUANACO”.\n5 minutos de preguntas\nModerador:\nInvitados:\n- Diego Flores, WCS\n- Juan José Donoso, TNC\n- Tomas Saratscheff, SBAP\n- Xxxxxxxx, IUCN/ Grupo de Especialistas en Camélidos Sudamericanos (GECS)\nPreguntas:\n10:00 – 11:00 SEGUNDO PANEL: “CONSERVACIÓN IN SITU”\n5 minutos preguntas\nModerador:\nInvitados:\n- Catherine Kenrick, Parque Andino Juncal\n- Miguel Diaz, CONAF\n- Loreto González, Fundo Cruz de Piedra\nPreguntas:\n11:00 – 12:00 TERCER PANEL: “MANEJO Y CONSERVACIÓN EX SITU”\n5 minutos preguntas\nModerador:\nInvitados:\n- Xxxxx, Parque Hacienda El Durazno\n- Xxxxx, Los 3 centros de la Red de Santuarios\n- Fernando Vidal, Fauna Andina\nPreguntas:\n12:00 – 13:00 CUARTO PANEL: “APOYO AL DESARROLLO LOCAL Y TURISMO”\n5 minutos preguntas\nModerador:\nInvitados:\n- Matías Guerrero, Kintu\n- Alexandra Petermann, Fundación Huilo Huilo\n- Xxxxxx, Andes Santiago o Transforma Turismo\nPreguntas:\nINVITADOS\nDirector de CONAF\nDirector SAG\nDirector SBAP\nAlgunos de servicios claves de afuera de la región como Nicolás Soto de Magallanes y otros.\nGobernador\nMunicipalidades\nZOO Metropolitano\nBuin zoo\nCerefan\nLampa zoo\nBioparque Sata Rosa del Carmen, Quilpué\nParque Safari\nFIAA, que han sido donantes del proyecto de Cascada\nToda la red de Santuarios de la RM\nSopraval\nWanaku Akunkawa\nCerro Guido\nCortes Solari-Matias Alcalde\nProyecto Manku\nLuksic\nExplora\nGasco\nIbañez Atkinson\nOtras Universidades\nBonacic (PUC)\nCRAR-Unorch\nLaboratorio y ecología de Vida Silvestre, U de Chile.\nFundación Yastay\nFAVET, Universidad de Chile.\nAsíConservaChile', 'description': None, 'parent_drive_file_id': '1AmsmKrUZ2sBLRYP5RqP2kieFLM7jnG3F', 'children': []}]}, {'id': 'c3f254c9-4fd1-417d-b24a-0cafa14c3906', 'drive_file_id': '1bzksGfod6zHjEPCF8cv8n3XAxc6ACp7c', 'name': 'Visión Estratégica 2035', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1bzksGfod6zHjEPCF8cv8n3XAxc6ACp7c', 'modified_time': datetime.datetime(2026, 6, 22, 18, 35, 45, 590000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': [{'id': '65da6893-b142-4272-a92e-78770f897919', 'drive_file_id': '1MiPidbjvQvRHaGlSSdncZTfbqALMuti-', 'name': 'readme.txt', 'mime_type': 'text/plain', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1MiPidbjvQvRHaGlSSdncZTfbqALMuti-/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 56, 816000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1bzksGfod6zHjEPCF8cv8n3XAxc6ACp7c', 'children': []}]}, {'id': 'ba388aba-4fd4-4055-9e48-2efcfa55bd3b', 'drive_file_id': '1dhbQxH8IUVgiUxKRRwJ64JD9Us9pic87', 'name': 'Talking Points Andean Corridor (esp 2) 04.03.26.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1dhbQxH8IUVgiUxKRRwJ64JD9Us9pic87/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 56, 866000, tzinfo=datetime.timezone.utc), 'text_content': 'TALKING Points | Corredor Andino\nREWILDING DE LOS ANDES\nEl Corredor Andino como Visión de Conservación\nContinental (2035)\n¿QUÉ ES EL CORREDOR ANDINO?\nEl Corredor Andino es una estrategia de rewilding continental diseñada para restaurar\necosistemas completos en secciones clave de la cordillera de los Andes, que supera los\n9.000 kilómetros. Su objetivo es reconectar los paisajes y recuperar especies clave como el\ncóndor, el puma y el guanaco — promoviendo la convivencia.\nEsto no se trata de proteger áreas aislada.\nSe trata de restaurar procesos ecológicos a gran escala — aumentar la resiliencia\nclimática y prevenir futuras extinciones.\n¿POR QUÉ LOS ANDES?\nLos Andes forman uno de los sistemas montañosos más extensos y ricos\nbiológicamente de la Tierra.\nEsta cadena montañosa continua es el eje ecológico de Sudamérica, extendiéndose a lo\nlargo del borde occidental del continente durante casi 9.000 km, desde el norte de\nVenezuela pasando por Colombia, Ecuador, Perú, Bolivia, Chile y Argentina, moldeando\nalgunos de los paisajes y la diversidad ecológica más espectaculares del continente.\nLos Andes contienen las principales fuentes de agua dulce del continente. Es un punto\ncaliente de biodiversidad global y regula el clima regional. Es una plataforma estratégica\npara la resiliencia futura.\nSin los Andes, el continente perdería su estructura ecológica fundamental.\nReconectar ecosistemas fragmentados, recuperar especies amenazadas y clave, fortalecer\nla resiliencia climática y consolidar una red colaborativa internacional: el Corredor Andino\nbusca restaurar los procesos ecológicos a escala continental.\nEsto no es simplemente expansión territorial. Es la expansión de la continuidad ecológica.\nUN MOMENTO DECISIVO PARA LA ACCIÓN\nEstamos viviendo un momento decisivo en la historia planetaria. La pérdida de la\nnaturaleza ya no es una advertencia científica futura, sino una realidad presente. Estamos\nexperimentando una sexta extinción masiva, y Sudamérica — especialmente los Andes —\nse sitúa como uno de sus epicentros globales.\nComo columna vertebral ecológica de un continente, los Andes son un sistema que sostiene\nel agua, el clima, las culturas y algunas de las especies más icónicas del planeta.\nSin embargo, hoy en día, ese sistema está fragmentado.\nEn muchas regiones, los ecosistemas permanecen en pie, pero son ecológicamente\nincompletos. Han perdido grandes herbívoros, depredadores ápice y carroñeros. Y cuando\nesas especies desaparecen, se pierden más que individuos — desaparecen funciones. Las\ncascadas tróficas se interrumpen. La resiliencia se debilita. La erosión de la capacidad de\nsostener la vida a lo largo del tiempo.\nLa pregunta fundamental es: ¿Nos limitaremos a proteger lo que quede? ¿O\nrestauraremos lo que se ha perdido?\nEl Corredor Andino es nuestra respuesta.\nNo es un parque. No es un proyecto aislado.\nEs una visión continental restaurar la integridad ecológica de la cadena montañosa más\nlarga del planeta.\nLa conectividad importa\nLa cordillera de los Andes funciona como un sistema ecológico continuo moldeado por\ngradientes altitudinales y climáticos.\nLa naturaleza prospera en la conectividad y en el libre movimiento de especies salvajes a\ntravés de vastos paisajes ininterrumpidos. No basta con proteger islas de biodiversidad,\ndebemos unirlas, creando corredores que permitan que los ecosistemas prosperen en su\nconjunto.\nSin conectividad, las poblaciones se aíslan, la variabilidad genética disminuye, aumenta el\nriesgo de extinción local y las migraciones y movimientos estacionales se ven interrumpidos.\nRewilding de los Andes\nEl rewilding propone:\nRestaurar ecosistemas completos\nRecuperar especies clave\nReactivar interacciones ecológicas\nTrabajar a escala de paisajes y conectividad ecológica.\nEl rewilding es tanto una reparación histórica como una estrategia con visión de futuro.\nEl Corredor Andino operacionaliza esta visión mediante:\n● Integración de áreas protegidas\n● Restauración de hábitats críticos\n● Implementación de gestión activa y aumentos y reintroducciones de especies\n● Avanzar en un enfoque transfronterizo permanente\nLa conectividad andina es la columna vertebral física que permite que el rewilding funcione\na una escala verdaderamente continental.\nTRABAJO CON ESPECIES CLAVE ANDINAS\nNuestra visión se basa en una idea simple pero poderosa: si recuperamos especies clave\nque se extienden a lo largo del Corredor Andino más amplio — como el cóndor, el puma,\nel guanaco, el huemul y el ñandú — y reconectamos los ecosistemas que requieren,\npodemos restablecer procesos ecológicos completos.\n● El cóndor andino (Vultur gryphus) es una de las aves voladoras más grandes del\nmundo y un carroñero icónico de los Andes, desempeñando un papel ecológico\nfundamental al eliminar carroñas y limitar la propagación de enfermedades. Está\ncatalogado como Vulnerable por la UICN.\n● El huemul (Hippocamelus bisulcus) es un ciervo en peligro de extinción, endémico\nde los Andes del sur de Chile y Argentina. En su época de extensión, la especie ha\nsufrido un dramático declive debido a la pérdida de hábitat, fragmentación,\ntransmisión de enfermedades por el ganado, depredación por perros y\nperturbaciones humanas. Actualmente está catalogado como En Peligro de\nExtinción por la UICN, con menos de 1.500 individuos restantes en todo el\nmundo,\n● El guanaco (Lama guanicoe) es el mayor camélido salvaje originario de\nSudamérica y el ancestro salvaje de la llama. Habita una amplia variedad de hábitats\nabiertos a lo largo de los Andes, desde Perú y Bolivia hacia el sur, pasando por Chile\ny Argentina hasta Tierra del Fuego. Se estima que la población es de\naproximadamente 1,5 a 2,5 millones de individuos, representando sólo entre el 3%\ny el 10% de la población histórica total, que se estimaba en unos 30 a 50 millones\nantes de la llegada de los conquistadores españoles. La especie ha perdido\naproximadamente el 60% de su área de distribución original. Está catalogado como\nde baja preocupación por la UICN.\n● El ñandú (Rhea pennata) es un ave grande no voladora, endémica del sur de\nSudamérica, que habita estepas patagónicas, praderas y mesetas altas andinas en\nChile y Argentina, desde la Patagonia central hasta Tierra de Fuego, actualmente\ncatalogada como Casi Amenazada por la UICN.\n● El puma (Puma concolor), es el mamífero terrestre más grande distribuido en\nAmérica, abarcando desde Canadá hasta el sur de la Patagonia. En los Andes,\nocupa una diversidad de hábitats —desde montañas y bosques de gran altitud hasta\npraderas y estepas— y desempeña un papel fundamental como depredador de alto\nnivel, regulando las poblaciones de herbívoros y manteniendo el equilibrio del\necosistema.\nRecuperando y fortaleciendo estas especies icónicas, podemos reactivar la dinámica natural\nque sostiene la vida.\nLa experiencia ya nos ha demostrado que esto es posible. Hemos visto cómo los\necosistemas comienzan a recuperarse cuando regresan grandes vertebrados. Hemos sido\ntestigos de cómo la restauración activa puede transformar paisajes degradados en sistemas\nfuncionales y resilientes.\nAhora, el reto es escalar.\n¿CÓMO LO HACEMOS?\nEscala desde la Patagonia hasta el eje andino completo. Escala desde proyectos locales\nhasta una red ecológica transfronteriza. Escala desde una conservación fragmentada hasta\nuna estrategia continental sistémica.\nUna oportunidad histórica\nEl Corredor Andino no es solo una propuesta de conservación. Es una invitación a participar\nen la restauración de la naturaleza a escala continental. Es para aumentar la resiliencia\nclimática en todo un continente. Es para evitar futuras extinciones. Es dejar un legado\ntangible y medible para las futuras generaciones.\nEstamos en un momento único.\nTenemos ciencia. Tenemos la experiencia. Tenemos asociaciones.\nLo que determinará la magnitud del impacto es la decisión de actuar ahora.\nEnfoque y proyecciones\nEl Corredor Andino es una estrategia de rewilding continental liderada por Rewilding Chile\npara integrar los esfuerzos nacionales e internacionales a través de los Andes en una red\ncoordinada y transfronteriza. Su propósito es revertir las tendencias de extinción, restaurar\nhábitats críticos, proteger refugios de biodiversidad y asegurar corredores ecológicos\ncapaces de sostener poblaciones viables y ecosistemas funcionales.\nReconociendo que la crisis ecológica trasciende las fronteras nacionales, el Corredor\nabarca Colombia, Venezuela, Ecuador, Perú, Bolivia, Chile y Argentina — escalando la\nexperiencia probada desde la Patagonia hasta el eje andino completo.\nEsta visión continental integrada busca:\n● Aumentar la escala e impacto de la conservación\n● Alinear a los diversos actores de todos los países\n● Comparte conocimientos y lecciones aprendidas\n● Optimiza los recursos mediante la colaboración\nEn su núcleo, el Corredor Andino integra áreas protegidas en una red conectada, combina\nla restauración activa con reintroducciones y aumentos estratégicos de especies, fortalece\nla conectividad ecológica transfronteriza y fomenta las asociaciones público-privadas y la\nparticipación comunitaria como pilares esenciales para el éxito de la conservación a largo\nplazo.\nUna visión continental basada en el modelo probado de rewilding desarrollado en la\nPatagonia y la Ruta de los Parques.\nConservación a escala en acción: avances estratégicos a través de\nlos Andes\nEn todos los Andes, especies emblemáticas se están convirtiendo en catalizadores de\ncambios sistémicos. Los siguientes casos ilustran cómo la acción coordinada, la\ncolaboración transfronteriza y la gestión adaptativa están traduciendo una visión continental\nen una recuperación ecológica tangible.\nRewilding del Guanaco: un modelo de alianza replicable\nExperiencias como el proyecto de repoblación de guanacos en el centro de Chile,\ndesarrollado en colaboración con la Red de Santuarios Naturales (SNRM) y la Facultad de\nCiencias Forestales y Conservación de la Naturaleza de la Universidad de Chile, ilustran\ncómo la restauración a escala ecosistémica puede adaptarse a paisajes más fragmentados\ncon una historia reciente de extinción local.\nLa acción coordinada, la gestión semi-cautiva de la especie y un plan de liberación gradual\n—combinados con la recuperación natural que el guanaco ya ha experimentado en partes\nde los Andes Metropolitanos— ofrecen ahora una vía tangible para apoyar su recuperación\nen la región más densamente poblada de Chile.\nEl proyecto de Rewilding de Guanaco en el centro de Chile ofrece un ejemplo convincente\nde:\n● Colaboración intersectorial entre organismos públicos, el ámbito académico,\norganizaciones de conservación y actores locales.\n● Restauración basada en la ciencia mediante manejo semicautivo y liberación\ngradual.\n● Prueba de que el rewilding funciona en paisajes fragmentados y densamente\npoblados.\n● Modelo escalable para otras regiones andinas, generando recuperación ecológica y\noportunidades económicas locales.\nCóndor Andino: Un imperativo de recuperación continental\nEl cóndor andino (Vultur gryphus) está clasificado como Vulnerable en la Lista Roja de la\nUICN, con un estimado de ~6.700 individuos maduros restantes en toda su área de\ndistribución. Las poblaciones del norte están especialmente en riesgo, con extinciones\nlocales en Venezuela y números críticamente bajos en Colombia (~130) y Ecuador (~150).\nChile y Argentina representan los bastiones del sur, con hasta ~2.000 individuos maduros\ncada uno, y la mayor población conocida del noroeste de la Patagonia (con ~300\nindividuos).\nLas principales amenazas para su supervivencia incluyen la pérdida de hábitat, el\nenvenenamiento, la reducción de la disponibilidad de alimento y las colisiones con\ninfraestructuras eléctricas.\nRestaurar al cóndor en toda su área histórica requiere una acción continental coordinada:\nmonitoreo permanente, reducción de amenazas y translocación estratégica para reforzar\npoblaciones agotadas. Chile, Argentina y Colombia ya han implementado iniciativas de\nrefuerzo mediante programas de rescate, rehabilitación y cría en cautividad, y las\nliberaciones bajo el Proyecto Manku han fortalecido las poblaciones silvestres.\nSe está llevando a cabo un esfuerzo colaborativo con la Fundación Parque Jaime Duque\nen Colombia dentro del Proyecto Manku para apoyar la recuperación binacional del cóndor.\nRestaurar este icónico carroñero — esencial para la salud de los ecosistemas en los Andes\n— sigue siendo uno de los mayores retos y oportunidades de conservación en Sudamérica.\nMientras tanto, en el centro de Chile se está construyendo un nuevo centro de reproducción\nde cóndores.\nColaboración Binacional para la Recuperación del Suri (Rhea pennata)\nEn Perú, los esfuerzos nacionales de conservación del suri (ñandu del norte) combinan la\ncría en cautividad y otras medidas ex situ dentro de una estrategia más amplia de\nrecuperación de especies. Actualmente se está desarrollando una alianza colaborativa con\ninstituciones peruanas, trabajando junto al Servicio Nacional Forestal y de Fauna Silvestre y\nel Proyecto Binacional Especial del Lago Titicaca, en coordinación con Bolivia.\nComo parte de este esfuerzo, se está estableciendo un Centro de Conservación y Rescate\ndedicado en la región de Vilacota–Maure para apoyar la investigación, protección y\nreproducción en instalaciones diseñadas para replicar el hábitat natural de alto Andino de la\nespecie. Las lecciones aprendidas y la amplia experiencia adquirida en la gestión y\nrecuperación del ñandú en el Parque Nacional de la Patagonia se han vuelto muy valiosas\npara fortalecer los esfuerzos de recuperación del suri en Perú."\nUn precedente transfronterizo: La reintroducción de la vicuña en\nEcuador\nEn Sudamérica, ya tenemos un valioso precedente de reintroducción transfronteriza dentro\ndel Corredor Andino: Chile —junto con Perú y Bolivia— desempeñó un papel principal en la\nexitosa reintroducción de la vicuña en Ecuador en 1988.\nEste logro demuestra que cuando los países andinos unen fuerzas, es posible implementar\nacciones coordinadas que reviertan la pérdida de biodiversidad más allá de las fronteras\nadministrativas.\nEl Corredor Andino es más que una estrategia de conservación.\nEs un compromiso continental restaurar los sistemas de soporte vital a gran escala.\nDesde la Patagonia hasta los Andes tropicales, tenemos la oportunidad de reconectar\npaisajes, recuperar especies y reconstruir la resiliencia para las generaciones venideras\nLa ciencia es clara. El modelo funciona. Las alianzas están surgiendo.\nLo que definirá el resultado será nuestra decisión colectiva de actuar —\ncon valentía y ahora.\n-----------------------------------------------------------------------------------------------------------\nRelaciones ecológicas entre la Patagonia y los Andes\nsudamericanos\nLa fauna de la Patagonia y los Andes sudamericanos están estrechamente interconectadas\na través de una historia biogeográfica compartida. Muchas especies están adaptadas a\nclimas fríos y ventosos y a terrenos accidentados, y varias cumplen roles ecológicos\nsimilares en diferentes ecosistemas.\nEspecies clave como el guanaco (Lama guanicoe), el cóndor andino (Vultur gryphus), el\npuma (Puma concolor ) y el zorro culpeo (Lycalopex culpaeus ) habitan tanto la estepa\npatagónica como la cordillera andina. Además, especies distintas suelen servir como\nequivalentes ecológicos, desempeñando funciones comparables en diferentes hábitats.\nEspecies compartidas (Patagonia y los Andes)\nMamíferos:\nGuanaco (Lama guanicoe), puma (Puma concolor), zorro culpeo (Lycalopex culpaeus),\nzorro chilla (Lycalopex griseus), chingue de la Patagonia (Conepatus humboldtii).\nAves:\ncóndor andino (Vultur gryphus), ñandú (Rhea pennata), águila chilena (Geranoaetus\nmelanoleucus), flamenco chileno (Phoenicopterus chilensis).\nEquivalentes ecológicos\n● Grandes herbívoros de montaña y estepa:\nEl guanaco (Patagonia y los Andes) es el equivalente funcional de la vicuña\n(Vicugna vicugna), que habita la puna andina. Donde sus áreas de distribución se\nsolapan, las dos especies coexisten pero están separadas por altitud.\n● Herbívoros forestales:\nEl huemul del sur (Hippocamelus bisulcus) en los bosques andino-patagónicos del\nsur es el equivalente ecológico de la taruca o huemul del norte (Hippocamelus\nantisensis) en los Andes del norte.\n● Felinos pequeños:\nLa güiña (Leopardus guigna), el gato de Geoffroy (Leopardus geoffroyi) y el gato de\nlos pajonales (Leopardus pajeros) en los bosques y estepas patagónicas son\nequivalentes ecológicos del gato andino (Leopardus jacobita) a mayor altitud.\n● Pequeños herbívoros y roedores de estepa:\nLas Vizcachas (Lagidium spp. y las chinchillas (Chinchilla spp.) ocupan hábitats\nrocosas andinos, mientras que los tuco-tucos patagónicos (Ctenomys spp.) son\nequivalentes ecológicos a los tuco-tucos de los Andes.\n● Pequeño ciervo del bosque:\nEl pudú del sur (Pudu puda) tiene equivalentes ecológicos cercanos en los Andes\ndel norte, incluyendo dos especies del género Pudella, que ocupan nichos similares\nen Perú, Ecuador y Colombia.\nColonización longitudinal: La "Carretera Andina"\nA diferencia de las cordilleras que aíslan fuertemente los ecosistemas, los Andes funcionan\ncomo un corredor longitudinal que permite:\n● Dispersión a gran escala norte-sur\n● Adaptación climática gradual\n● Reemplazo ecológico progresivo\nEsta colonización longitudinal se facilita por gradientes climáticos progresivos y la presencia\nde ecosistemas equivalentes a diferentes elevaciones, creando una continuidad\nbiogeográfica que sustenta el continuo andino.\nEl cóndor andino es uno de los ejemplos más emblemáticos: ocupa casi todo el eje andino,\ndesde Colombia hasta la Patagonia, lo que refleja esta conectividad longitudinal continua.', 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': []}, {'id': '9c22c3a1-759b-4548-a08a-c30a316341d5', 'drive_file_id': '1JnsD4zgWKVAEymxe40m3NH-w-6SDejJ5', 'name': 'Doc. Corredor Andino - 2024', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1JnsD4zgWKVAEymxe40m3NH-w-6SDejJ5', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 44, 78000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': [{'id': '158331ca-62d8-48d7-9a15-260d1719c29f', 'drive_file_id': '1DUQtKOg3e0n3NvxwLF68ZVLPhIXmk4s6', 'name': 'Resumen Dcto Extendido Corredor Andino_02.08.25.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1DUQtKOg3e0n3NvxwLF68ZVLPhIXmk4s6/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 38, 39, 836000, tzinfo=datetime.timezone.utc), 'text_content': "MINUTA DE DOCUMENTO ORIGINAL DE AGOSTO DEL 2024\nDel Corredor Andino a los mares del fin del mundo\nExpandiendo el impacto del Rewlding desde la Patagonia por Sudamérica\nTABLA DE CONTENIDOS\n1. Introducción\n2. Ecosistemas terrestres\n3. Ecosistemas marinos\n4. Corredor Andino: visión y desafíos\n5. Especies claves en el ecosistema del corredor andino\n6. Criterios de selección de especies, áreas y ecosistemas a abordar\n7. Transferencia de la experiencia de Rewilding Chile en Patagonia hacia el Corredor Andino\n8. Próximos pasos\nAgosto 2025\n1. INTRODUCCION\nRewilding Chile es una fundación sin fines de lucro y parte del legado de Douglas y Kristine Tompkins,\nquienes a inicios de los años 90 decidieron dedicar su vida a conservar la belleza y la biodiversidad\nde la Patagonia chilena para contrarrestar la crisis de extinción de especies y el cambio climático.\nTres décadas después, Rewilding Chile sigue profundamente comprometida con la visión de sus\nfundadores: los ecosistemas saludables y su complejidad de especies, interrelaciones y procesos\ndarán a los seres vivos una oportunidad de perpetuarse en el tiempo. Con esa visión, Fundación\nRewilding Chile y su socio Tompkins Conservation, han trabajado en la conservación de los\necosistemas de la Patagonia chilena para enfrentar los factores que amenazan global y localmente a\nla biodiversidad.\nEl rewilding es una estrategia para la conservación integral que incluye la implementación de\nacciones como: la creación de parques nacionales terrestres y marinos, la restauración de los\necosistemas, el manejo activo de especies amenazadas, la promoción del bienestar de las\ncomunidades locales, además del activismo y la educación pública para fomentar una cultura de\nconservación. A través del rewilding, la Fundación Rewilding Chile busca conservar ecosistemas\nsaludables y funcionales que permitan que las áreas de protección sean un motor para el desarrollo\nlocal, donde el turismo de naturaleza se constituye como un eje estratégico de este desarrollo.\nLa Fundación Rewilding Chile ha concentrado su área de trabajo en la Patagonia chilena, que\ncomprende la parte sur de la región de Los Lagos, la región de Aysén y la Región de Magallanes y\nAntártica chilena. La Ruta de Los Parques Nacionales de la Patagonia es un corredor de conservación\nimpulsado por Rewilding Chile y conformado por un grupo de 17 parques nacionales desde la ciudad\nde Puerto Montt (41ºS) al Cabo de Hornos (56ºS). Estos parques nacionales representan a 4\necorregiones terrestres: bosque magallánico sub antártico, bosque templado valdiviano, estepa\npatagónica y una gran superficie de rocas y hielos. La Fundación promueve la Ruta de los Parques de\nla Patagonia como una visión de conservación para el territorio, que plantea equilibrar la protección\nde la naturaleza con el desarrollo económico de sus comunidades a través del turismo como\nconsecuencia de la conservación.\nNos encontramos próximos al año 2030 y la biodiversidad sigue disminuyendo en todo el planeta.\nUna respuesta concreta a la actual crisis ambiental es asegurar que la conservación de la\nbiodiversidad permita proteger la capacidad de los ecosistemas de ofrecer bienestar y beneficios a\nlas personas y a otros seres vivos.\nEste documento es un resumen del original que tiene por objetivo compartir algunos antecedentes\nque permitan elaborar una visión de conservación continental y una propuesta para la conservación\nde los paisajes de la Cordillera de los Andes y sus especies características y sus hábitats, desde\nVenezuela por el norte hasta la confluencia de los Océanos Pacífico, Atlántico y Antártico por el sur,\nque permita alcanzar los objetivos de biodiversidad al año 2030. Para esto se requiere hacer una\nrevisión del estado de conservación global y local actual de algunas especies asociadas a la Cordillera\nde Los Andes, las estrategias de conservación implementadas para su conservación y los actores\ninvolucrados en estas iniciativas.\n2. ECOSISTEMAS TERRESTRES\nAmérica del Sur abarca una superficie de 17,9 millones de kilómetros cuadrados y alberga 215\necorregiones terrestres (Olson et al. 2001). Las ecorregiones terrestres reflejan las distribuciones de\nuna amplia gama de fauna y flora en todo el planeta y facilitan la planificación de la conservación a\nescala mundial y regional. Es un marco de clasificación basado en los conocimientos biogeográficos\nexistentes y cada ecorregión representa biotas distintas. Esta clasificación proporciona un marco\npara las comparaciones entre unidades y la identificación de hábitats y conjuntos de especies\nrepresentativas.\nEn específico, La Cordillera de Los Andes es una cadena montañosa ubicada en la costa occidental\ndel continente Sudamericano, la cual atraviesa el territorio de 7 países: Argentina, Chile, Bolivia,\nPerú, Ecuador, Colombia y Venezuela. Con más de 9.000 kilómetros de longitud, siguiendo la cadena\nmontañosa y más de 6.000 metros de altitud, es la cordillera terrestre más larga y la segunda más\nalta del planeta, después del Himalaya.\nLa Cordillera de los Andes se origina por la subducción de la placa continental sudamericana con una\nserie de placas oceánicas. Su morfología ha sido modelada a través del tiempo por procesos que\ntienen lugar en su superficie: el proceso glaciario dadas sus altas cumbres y otros procesos fluviales,\neólicos, volcánicos y de remoción en masa. La combinación de estos procesos le confieren la\ncaracterística de ser cordones montañosos separados por valles. Su mayor elevación corresponde al\nAconcagua que alcanza 6.960 metros de altitud en Argentina.\nEcorregiones de los países del corredor andino (Olson et al. 2001)\nLos países andinos (Chile, Argentina, Bolivia, Perú, Ecuador, Colombia, Venezuela) abarcan una\nsuperficie de ～8,8 millones de kilómetros cuadrados y albergan 136 ecorregiones, las que\nrepresentan el 63% del total de ecorregiones sudamericanas. Las ecorregiones Puna y Puna árida de\nlos Andes centrales son comunes a Chile, Argentina, Perú y Bolivia. Chile y Argentina comparten 5\necorregiones: Bosque subpolar magallánico, Bosque templado valdiviano, Estepa patagónica, Estepa\nandina del sur y hielos/rocas. Chile y Perú comparten únicamente la ecorregión Desierto de Sechura.\nPor último, Chile alberga 2 ecorregiones continentales que no se representan en los mencionados\npaíses, a saber: Desierto de Atacama y Matorral chileno.\nLos Andes se encuentran entre las regiones con mayor biodiversidad del planeta. Se calcula que la\nCordillera de los Andes alberga a unas 40.000 especies de plantas y miles de vertebrados, con niveles\nexcepcionalmente altos de endemismo. Además, sus bosques naturales, matorrales y pastizales\nproporcionan servicios ecosistémicos críticos, como la protección del suelo, el almacenamiento de\ncarbono y agua para millones de personas.\nSe prevé que el cambio climático afecte a la biodiversidad de las montañas desplazando las áreas de\ndistribución de las especies y los biomas que conforman. El alcance y la variación regional de estos\nefectos son aún poco conocidos, sobre todo en los Andes, de gran biodiversidad. Se prevé que los\ncambios climáticos futuros (2040 - 2070) sean más perceptibles en las zonas de mayor altitud de los\nAndes tropicales (hasta 4 °C según el RCP 8.5), mientras que en los Andes templados se prevé un\naumento de la temperatura de hasta 2 °C. En el peor escenario, se prevé que los bosques caducifolios\ntemplados y los pastizales y estepas de los Andes centrales y meridionales registren las mayores\npérdidas de espacio climático adecuado (30% y 17%-23%, respectivamente).\nLa gran vulnerabilidad de estos biomas contrasta con la escasa atención prestada por los\ninvestigadores al modelamiento de la distribución de las especies andinas. Entre los vacíos de\nconocimiento más importantes cabe citar la falta de un listado de plantas andinas, la insuficiente\ndensidad de las estaciones meteorológicas en zonas de gran altitud, la falta de climatologías de alta\nresolución que tengan en cuenta la compleja topografía y los procesos climáticos de los Andes, la\ninsuficiencia de datos para modelar procesos demográficos y ecológicos y escaso uso de datos\npaleográficos para modelar la distribución. Dado el largo rango latitudinal y elevacional escarpado,\nlos Andes tienen una alta variabilidad en el clima.\nComprender los vínculos entre el clima y la vegetación natural, y predecir el impacto del cambio\nclimático futuro, es por lo tanto importante tanto para la conservación como para el bienestar\nhumano en los Andes y las tierras bajas adyacentes.\nEn los países andinos existen alrededor de 2.400 áreas protegidas al año 2021, de las cuales\naproximadamente 1.356 tienen al menos el 50% de su extensión en la región andina. Chile es el país\nque empezó a establecer áreas protegidas más temprano, a principios del siglo XX. A partir del año\n2000 hay un incremento notable en el número de áreas protegidas cuya extensión tiene al menos el\n50% en la región andina, particularmente en Colombia. Antes del año 2000 la mayoría de las áreas\nprotegidas fueron establecidas principalmente en la región no andina, siendo esto más notorio en\nVenezuela. Sin embargo, en términos de extensión, es en la década de los años 1970s cuando más\nextensión de la región andina fue protegida, mientras que en la región no andina esto ocurrió en los\naños 1990s.\n3. ECOSISTEMAS MARINOS\nSudamérica que abarca una variedad de ecosistemas costeros, entre ellos, manglares, arrecifes de\ncoral, pastos marinos, marismas, lagunas costeras, playas de arena, praderas de algas y la región de\nlos fiordos del sur de Chile. Además, gran relevancia le confieren las islas oceánicas: Galápagos, Coco,\nMalpelo, así como las islas Malvinas y Antillas, que surgen en el sur Atlántico y Mar Caribe,\nrespectivamente. Las masas oceánicas que rodean a América del Sur aportan significativamente a la\ndiversidad y la productividad de los ecosistemas costeros de la región. Las que se encuentran frente\na las costas de Perú y Chile poseen las aguas de más alta productividad pesquera y sostienen una de\nlas cinco pesquerías comerciales más importantes del mundo.\nLas clasificaciones biogeográficas son esenciales para desarrollar sistemas ecológicamente\nrepresentativos de áreas protegidas, según lo exigen los acuerdos internacionales. También\npermiten determinar si existen muestras de cada ecorregión en las Áreas Marinas Protegidas y en\nqué proporción (Spalding et al. 2007, Ministerio del Medio Ambiente 2016). Los 7 países que\ncomponen el corredor andino (Chile, Argentina, Bolivia, Perú, Ecuador, Colombia, Venezuela)\nrepresentan 3 reinos, 6 provincias y 14 ecorregiones.\nEcorregiones marinas representadas en los países del corredor andino (Spalding et al. 2007).\nEl océano es dinámico y está en constante movimiento. El movimiento más intenso y visible ocurre\nen la superficie. Estos movimientos son las olas, mareas y las corrientes superficiales. Estos\nmovimientos promueven la mezcla de las aguas oceánicas y tiene efectos sobre la vida en los mares.\nLas corrientes y las olas están influenciadas por los vientos. Las corrientes marinas transportan\ngrandes cantidades de agua y energía en forma de calor, por lo que influyen en la distribución de la\nsalinidad y de la temperatura. Como resultado afecta el clima y la productividad de las aguas.\nHacia el extremo sur del continente americano confluyen masas de agua de diferente procedencia,\nlo que genera una enorme diversidad de condiciones ambientales. Las corrientes marinas de los\nOcéanos Pacífico, Atlántico y Antártico convergen en la Patagonia creando una explosión de vida.\nAguas del Pacífico, más frías y menos saladas penetran a través de los canales oceánicos y se\nencuentran con aguas atlánticas, más cálidas y salinas, dando lugar a un gradiente de salinidad y\ntemperatura a través de los senos, fiordos y bahías.\nEl aporte de agua dulce procedente de las fuertes precipitaciones en la costa oeste, de los ríos y del\ndeshielo de los glaciares de la Cordillera de Darwin también contribuye a esta variabilidad,\ngenerando un sistema de estuario en la capa más superficial que difiere de las condiciones en las\nzonas más profundas de las aguas magallánicas. El agua antártica de la corriente Circumpolar\nAntártica, fría y más profunda, conecta estos dos océanos a través del Paso de Drake, en su límite\nmás austral. Esta heterogeneidad oceanográfica convierte este lugar en un mosaico dinámico de\ncomunidades marinas que se interrelacionan entre sí a escalas que van desde los pocos centímetros\na largas distancias de cientos de kilómetros y que sostienen procesos ecológicos vitales, siendo una\nreserva de vida y un patrimonio de gran riqueza.\nLa Corriente de Humboldt, es una corriente oceánica fría que fluye en dirección norte a lo largo de\nla costa occidental de Sudamérica, también se la conoce como Corriente Peruana o Corriente del\nPerú. Es una de las más importantes del mundo y ejerce influencia determinante sobre el clima de\nla costa peruana con cielos cubiertos de neblinas, ausencia de lluvias y temperaturas templadas\ndurante el invierno. Por la latitud, el clima debería corresponder a la zona intertropical; pero las\naguas frías enfrían a su vez a la atmósfera. La corriente ocurre desde la isla de Chiloé (Chile) hacia el\nnorte, pero principalmente a lo largo del litoral peruano.\n4. CORREDOR ANDINO: VISION Y DESAFIOS\nLa Patagonia chilena se presenta como un modelo de rewilding, donde todavía existen fragmentos\nextensos de naturaleza relativamente intacta, en muchos de los cuales se han logrado grandes\navances en la consolidación de vastas extensiones de parques nacionales, conformando áreas\nsilvestres bajo la más alta categoría de protección. La ejecución de proyectos de translocación de\nhuemules y ñandúes han demostrado no solo la viabilidad técnica para recuperar poblaciones\ndebilitadas o al borde de la extinción local, sino también la capacidad de generar efectos positivos\nen la biodiversidad a escala ecosistémica, ya que al restablecer estas especies clave se reactivan\nprocesos tróficos y se refuerzan cadenas de interacción que devuelven la salud a los sistemas\nnaturales. La creación y ampliación de parques nacionales ha sido clave para asegurar hábitat para\ntodas estas especies con una mirada de conservación a gran escala.\nTrasladar este modelo de éxito a otros tramos del Corredor Andino exige construir alianzas entre el\nmundo público, el sector privado y las comunidades locales en todos los países que lo conforman.\nExperiencias como el proyecto de repoblamiento de guanacos en la zona central, desarrollado en\ncolaboración con la red de Santuarios de la Naturaleza de la Región Metropolitana y la Universidad\nde Chile, ilustran cómo la restauración a escala de ecosistemas puede adaptarse a ambientes más\nfragmentados y con un historial de extinción local reciente. A partir de la acción coordinada, el\nmanejo de la especie en semicautiverio y un plan gradual de liberación, hoy se vislumbra un camino\nde esperanza para apoyar la recuperación del guanaco en la región más densamente poblada de\nChile y extender estas acciones a otros puntos de los Andes donde se requiera, generando así nuevas\noportunidades para el turismo de naturaleza y una integración a las economías locales.\nVarias especies en condición de extrema amenaza plantean desafíos urgentes que reclaman\nrespuestas técnicas y acciones inmediatas. Por ejemplo, el picaflor de Arica, ya extinto en Perú, y\ncuya población ha caído de unos 2.000 ejemplares hace dos décadas a apenas 300 en el valle de\nCamarones y valles aledaños, exige la implementación y protección de las áreas y refugios críticos\nque necesita, así como el desarrollo de iniciativas de manejo activo de la especie. Asimismo, la ranita\ndel Loa, recientemente rescatada desde su último refugio natural, refuerza la importancia de contar\ncon centros de reproducción en cautiverio que permitan su resguardo, mientras se gana tiempo para\ntomar medidas en las áreas en que puede habitar la especie a fin de evitar su extinción inminente.\nEn la misma línea, la ranita de Darwin, anfibio endémico de los bosques templados del cono sur, es\nposiblemente el segundo anfibio más amenazado de Chile, lo que refuerza el llamado a actuar en\nconjunto para su conservación frente a la preocupante pérdida de su hábitat, así como el avance del\nhongo quítrido.\nEl cóndor andino, muy amenazado especialmente en su distribución norte entre Colombia y Bolivia,\nrequiere de un sistema de monitoreo permanente y reducción de amenazas (entre las que se\nencuentran envenenamientos, colisiones, reducción de fuentes de alimento) y la puesta en marcha\nde translocaciones que aseguren un flujo de individuos desde las zonas donde su población\nabundante goza de mayor salud hacia las zonas donde sus números están gravemente reducidos.\nRecuperar al cóndor en la extensión de su distribución original, se presenta como uno de los grandes\ndesafíos para el continente, donde Chile, Argentina y Colombia ya han implementado iniciativas de\nreforzamiento poblacional utilizando el rescate y la reproducción de individuos en cautiverio, así\ncomo las liberaciones de individuos rescatados y rehabilitados.\nEn Sudamérica ya contamos con un valioso antecedente de rewilding transfronterizo para el\nCorredor Andino, donde Chile (junto a Perú y Bolivia) tomó un rol protagónico con la exitosa\nreintroducción de la vicuña en Ecuador. Este logro demuestra que, cuando los países andinos unen\nfuerzas, es posible implementar acciones para revertir tendencias de pérdida de biodiversidad más\nallá de las fronteras administrativas. Inspirados en este precedente, el Corredor Andino aspira a\npromover, replicar y ampliar iniciativas de rewilding, asegurando que la recuperación de especies\nclave de los ecosistemas, la restauración de hábitats y el control de amenazas se realicen de forma\nintegrada a lo largo de la extensión de la cordillera y donde se presenten los mayores desafíos para\nla conservación.\nEn Chile, estos desafíos son amplios, y se expresan con particular claridad al considerar el conjunto\ndiverso de especies que habitan los ecosistemas del Corredor Andino, desde las altas cumbres de\nlos Andes hasta la costa del océano Pacífico. Además de los casos destacados previamente, es\nfundamental actuar sobre las amenazas que afectan a otros grupos clave, recordando que el\nrewilding busca restituir la salud de ecosistemas completos. También se destacan los herbívoros de\nmontaña como las diferentes especies de vizcacha pertenecientes al género Lagidium, y especies\ncon alto grado de amenaza, como la taruca o huemul del norte (Hippocamelus antisensis), y el suri\no ñandú del norte (Rhea pennata tarapacensis), cuya recuperación es esencial para el equilibrio\necológico de los ecosistemas altoandinos.\nEn las zonas boscosas y de menor altitud, cobran relevancia especies como la guiña (Leopardus\nguigna) y el pudú del sur (Pudu puda), los cuales comparten amenazas similares vinculadas a la\nfragmentación del hábitat, la expansión urbana y el desplazamiento por animales domésticos. Los\nmustélidos semiacuáticos como el huillín (Lontra provocax) y el chungungo (L. felina) representan\nverdaderos centinelas de la salud de los ecosistemas ribereños y costeros, y su conservación requiere\nmedidas urgentes de preservación de hábitat, control de amenazas locales y monitoreo a largo plazo.\nEn estas líneas, el rewilding en ambientes costeros y marinos representa un elemento fundamental\ndentro de esta visión continental. La extensa costa chilena, desde la Región de Arica y Parinacota\nhasta la de Magallanes y la Antártica Chilena, donde destacan ecosistemas de alta relevancia como\nla Reserva Nacional Pingüino de Humboldt y los fiordos y canales de la Patagonia, ofrece desafíos\nparticulares para la protección y restauración a gran escala. Iniciativas orientadas a la recuperación\nde grandes especies clave y migratorias, como ballenas y tiburones, deben complementarse con la\nprotección de hábitats de alta relevancia como los bosques de macroalgas (Macrocystis pyrifera) y\nlos hotspots de biodiversidad bentónica.\nDe este modo, el rewilding en Chile se proyecta como el punto de partida del Corredor Andino, una\nred colaborativa que se extiende desde la Patagonia y sus mares por la espina dorsal del continente\npara proteger y restaurar ecosistemas completos. Al escalar hacia el norte la recuperación de\nespecies al borde de la extinción, así como el restablecimiento de interacciones ecológicas clave, es\nnecesario crear sinergias transfronterizas orientadas a optimizar recursos, compartir aprendizajes y\namplificar el impacto de cada acción. Este enfoque integral articula el manejo activo, las\nreintroducciones o refuerzos poblacionales, la restauración de hábitats críticos y el establecimiento\nde corredores en una matriz compuesta por áreas silvestres protegidas, sus zonas buffer y\ncomunidades rurales. Así, desde el extremo austral del mundo, el rewilding se perfila como una hoja\nde ruta continental para frenar la pérdida acelerada de biodiversidad, aquella que, como advertía\nDouglas Tompkins, constituye “la madre de todas las crisis”.\n5. ESPECIES CLAVES EN EL ECOSISTEMA DEL CORREDOR ANDINO\n5.1. ESPECIES Y TERRITORIOS EN LOS CUALES ESTAMOS TRABAJANDO:\nA. Cóndor (Vultur gryphus) - VU\nDistribución (países) según IUCN: Argentina, Bolivia, Chile, Colombia, Ecuador y Perú.\nTerritorios: Patagonia, Región Metropolitana, Ecuador y Colombia.\nOrganizaciones asociadas: Proyecto Manku (Chile), Parque Jaime Duque (Colombia), Proyecto\nFundación Cóndor Andino (Ecuador).\nAcuerdos actuales: Convenio de colaboración con UNORCH, convenio de colaboración con UNORCH,\nFundación Filantropía Cortes Solari y Fundación Meri.\nB. Guanaco (Lama guanicoe) - LC\nDistribución (países) según IUCN: Argentina, Bolivia, Chile, Paraguay y Perú.\nTerritorios: Patagonia y Región Metropolitana.\nOrganizaciones asociadas: Red de Santuarios de Naturaleza de la Región Metropolitana.\nAcuerdos actuales: Convenio de colaboración con Santuario Lagunilla, Santuario El Plomo y\nSantuario Cascadas. Convenio de colaboración con Santuario Lagunilla, Santuario El Plomo y\nSantuario Cascadas y Sopraval SPA.\nC. Suri (Rhea pennata tarapacensis) – LC / Ñandú (Rhea pennata) - LC\nDistribución (países) según IUCN: Argentina, Bolivia, Chile y Perú.\nTerritorios: Patagonia (Ñandú de Darwin - Rhea pennata) y Perú.\nOrganizaciones asociadas: Servicio Nacional Forestal y de fauna silvestre de Perú (SERFOR) y el\nCentro de Rescate del Proyecto Especial Binacional Lago Titicaca (PELT).\nAcuerdos actuales: pronto a firmar convenio de colaboración con SERFOR de Perú.\n5.5. ESPECIES Y TERRITORIOS A EVALUAR EN EL MEDIANO PLAZO Y LARGO PLAZO:\nA. Huemul (Hippocamelus bisulcus) - EN\nDistribución (países) según IUCN: Chile y Argentina.\nTerritorios: Ruta de los parques de la Patagonia y Nevado de Chillán.\nOrganizaciones asociadas: CONAF Ñuble.\nAcuerdos actuales: Ninguno.\nB. Taruca (Hippocamelus antisensis) - VU\nDistribución (países) según IUCN: Chile y Argentina.\nTerritorios: Ruta de los parques de la Patagonia y Nevado de Chillán.\nOrganizaciones asociadas: CONAF Ñuble.\nAcuerdos actuales: Ninguno.\nC. Picaflor de Arica (Eulidia yarrellii) - CR\nDistribución (países) según IUCN: Chile y Perú (posiblemente).\nTerritorios: Valle de Camarones en la Región de Arica y Parinacota.\nOrganizaciones asociadas: ROC y U. De Chile.\nAcuerdos actuales: Ninguno.\nD. Gaviotín chico (Sternula lorata) - EN\nDistribución (países) según IUCN: Ecuador, Chile y Perú, costa del Pacífico.\nTerritorios: Valle Camarones y Tacna.\nOrganizaciones asociadas: ROC.\nAcuerdos actuales: Ninguno.\nE. Aves nidificantes del desierto (Golondrinas de Mar y Gaviota de Garuma)\nla Golondrina de mar negra (Hydrobates markhami) está clasificada como En Peligro (EN), mientras\nque la Golondrina de mar peruana (Hydrobates tethys) y la Golondrina de mar de collar (Hydrobates\nhornbyi) están clasificadas como Vulnerable (VU). La Gaviota garuma (Leucophaeus modestus) se\nconsidera globalmente de Preocupación Menor según la IUCN.\nDistribución (países) según IUCN: Chile y Perú (posiblemente).\nTerritorios: Valle de Camarones en la Región de Arica y Parinacota.\nOrganizaciones asociadas: ROC y U. De Chile.\nAcuerdos actuales: Ninguno.\nF. Chungungo (Lontra felina) - EN / Huillín (Lontra provocax) - EN\nDistribución (países) según IUCN: Chungungo zona costera rocosa del océano Pacífico, desde el norte\nde Perú hasta el extremo sur de Chile y Argentina. El Huillín antiguamente se distribuía hasta la\nRegión de O'Higgins, pero actualmente se considera extinta hasta la del Bío Bío y se encuentra en\npeligro desde La Araucanía hasta Magallanes. El Huillín en Argentina, se distribuye a lo largo de los\nAndes, desde Tierra del Fuego hasta el sur de la provincia de Neuquén.\nTerritorios: Cabo Froward, Pumalin, zona central de chile.\nOrganizaciones asociadas: Fundación Lontra y Universidad Tierra del Fuego.\nAcuerdos actuales: Ninguno.\nG. Armadillos de Los Andes: Quirquincho de la puna (Chaetophractus vellerosus) - LC, el piche\n(Zaedyus pichiy) - LC, y el peludo (Chaetophractus villosus) - LC\nDistribución (países) según IUCN: Quirquincho de la Puna se encuentra en el norte de Chile,\nespecíficamente en el altiplano, desde Arica y Parinacota hasta Antofagasta. El Piche se distribuye\npor la zona centro-sur de Chile. El Peludo habita en la Patagonia, desde la región de Aysén hasta\nMagallanes, incluyendo Tierra del Fuego.\nTerritorios:\nOrganizaciones asociadas: Fundación Armadillos de Chile.\nAcuerdos actuales: Ninguno.\nH. Ciervos enanos de Los Andes: Pudú (Pudella mephistophiles) – VU / Pudú (Pudu pudu) -\nNT\nDistribución (países) según IUCN: en los Andes de Colombia, Ecuador y Perú; Chile y Argentina,\nrespectivamente.\nTerritorios: Perú, Colombia y Patagonia.\nOrganizaciones asociadas: Centro de Ornitología y Biodiversidad de Lima. Universidad del Cauca\nPopayán Colombia.\nAcuerdos actuales: Ninguno.\nI. Anfibios: Rana del Loa (Telmatobius dankoi) – CR / Ranita de Darwin (Rhinoderma\ndarwinii) - EN\nDistribución (países) según IUCN: Oasis del desierto de Atacama, Región de Antofagasta y la\nPatagonia, respectivamente.\nTerritorios: Desierto de Atacama y Patagonia, respectivamente.\nOrganizaciones asociadas: Zoo Metropolitano, UNAB, ONG Ranita de Darwin.\nAcuerdos actuales: Convenio por firmar con ONG Ranita de Darwin y UNAB. Convenio en\npreparación con el ZOO Metropolitano vinculado a Ranita de Darwin.\nJ. Chinchillídeos Andinos: Chinchilla cola corta (Chinchilla chinchilla) - CR y Chinchilla cola\nlarga (Chinchilla lanígera) - VU\nDistribución (países) según IUCN: La chinchilla de cola corta solo en Chile, aunque su distribución\noriginal era más amplia Chile, Perú, Bolivia y Argentina, habitando en la región Andina. La chinchilla\nde cola larga en Atacama y Coquimbo.\nTerritorios: Región de Coquimbo en la Reserva Nacional Las Chinchillas y sus alrededores.\nOrganizaciones asociadas: CONAF Coquimbo. Universidad de Tarapacá. Universidad San Sebastián.\nZoo Metropolitano.\nAcuerdos actuales: Ninguno.\nK. Chinchillídeos Andinos: Vizcacha de montaña (Legidium viscacia) - LC / Vizcacha Austral\n(Legidium wolffsohni) - DD\nDistribución (países) según IUCN: Ambas vizcachas habitan zonas rocosas de la Cordillera de los\nAndes. La vizcacha austral en el extremo sur de Argentina y Chile. La vizcacha de montaña se\nencuentra en el sur de Perú, oeste y centro de Bolivia, norte y centro de Chile y oeste de Argentina.\nOtras Vizcachas de la zona: Vizcacha andina (Lagidium peruanum) - LC, de Perú, Bolivia, Chile y\nArgentina. Vizcacha (Lagostomus maximus) - LC: Argentina, sur de Paraguay y Bolivia.\nTerritorios: Norte de Chile y Patagonia, respectivamente.\nOrganizaciones asociadas: Universidad de Tarapacá. Universidad San Sebastián.\nAcuerdos actuales: Ninguno.\nL. Flamencos (Phoenicopterus sp.)\nDistribución (países) según IUCN: Flamenco chileno en Chile (Phoenicopterus chilensis) - NT,\nArgentina, Bolivia, Perú, Ecuador, Paraguay, Uruguay y Brasil. Flamenco andino (Phoenicoparrus\nandinus) - VU está en Perú, Chile, Bolivia y Argentina. Flamenco James (Phoenicoparrus jamesi) - NT\nen las mesetas altoandinas de Perú, Chile, Bolivia y Argentina.\nTerritorios: Patagonia y altiplano Andino.\nOrganizaciones asociadas:\nAcuerdos actuales: Ninguno.\nM. Vicuña (Vicugna vicugna) – LC\nEl grupo de especialistas en camélidos sudamericanos de la IUCN que está Benito González.\nN. Puma (Puma concolor) - LC\nHay que trabajar el tema de la coexistencia. En el caso por ejemplo del proyecto repoblación de\nguanacos en la Región Metropolitana, será un tema que enfrentar.\nCATEGORIAS Y ESTADOS DE CONSERVACIÓN IUCN\n- Extinta (EX),\n- Extinta en estado silvestre (EW),\n- En peligro crítico (CR),\n- En peligro (EN),\n- Vulnerable (VU),\n- Casi amenazada (NT),\n- Preocupación menor (LC),\n- Datos insuficientes (DD) y\n- No evaluada (NE)\n6. CRITERIOS DE SELECCION DE ESPECIES, ÁREAS Y ECOSISTEMAS A ABORDAR\n- Capacidades instaladas y experticia en las especies y ecosistemas que viene trabajando FRC.\n- Capacidades instaladas y experticia los colaboradores con quienes hemos gestados acciones a\ndiferentes niveles: público, académico, ONG’s y organizaciones locales.\n- Urgencia frente al estado de conservación y nivel más alto de categoría de amenaza de la especie\n(en peligro crítico, en peligro de extinción, vulnerable) con una aproximación del Rewilding por\necorregiones a una determinada latitud, incluyendo variación altitudinal en algunos casos.\n- Existencia de áreas protegidas o con algún grado incipiente de avances en su protección e\ninterrelación con otras especies, ecosistemas o ecorregiones.\n- Oportunidad institucional relacionada a la conservación y manejo de una especie, territorio,\necosistema o ecorregión particular\n- Existencia de socios locales o regionales estratégicos con quienes se compartan valores,\nfundamentos y oportunidades de intercambio de modelos de trabajo y aprendizajes.\n7. TRANSFERENCIA DE LA EXPERIENCIA DE REWILDING CHILE EN LA PATAGONIA CHILENA HACIA\nEL CORREDOR ANDINO\nLas capacidades y fortalezas del equipo de la Fundación Rewilding Chile luego de estos 30 años\ntrabajando en el territorio de la Ruta de los Parques son múltiples y permitirían fortalecer las\ncapacidades de organizaciones locales o regionales que han desarrollado actividades relacionadas a\nalgunos ecosistemas y especies amenazadas en áreas del Corredor Andino. Desde los procesos\nrelacionados a la creación de parques, el análisis de la matriz de hábitat y la tenencia de la tierra,\nconstrucción y de propuestas y estrategias de conservación, abordaje de amenazas y monitoreo de\nla vida silvestre, propuestas de manejo e intervención, socialización con actores, gestión técnica y\ncolaborativa con las instituciones, privados y la incidencia en políticas de conservación.\n8. PROXIMOS PASOS\n- Revisar, evaluar y priorizar la lista de especies, ecosistemas y gradientes involucrados.\n- Visitas a terreno y reunión junto a organizaciones claves de algunos territorios. Como ejemplos:\nNorte: Picaflor de Arica, Golondrinas del desierto, Gaviotín chico, Suris y Tarucas.\n- Visita al área del Corredor Nevados de Chillan – Laguna del Laja para evaluar situación de\nhuemules en el sector, iniciativas existentes, y entender el trabajo de CONAF y otros actores en\nlos últimos años en este territorio.\n- Visita a las áreas de intervención de Fundación Lontra en Chile.\n- Explorar otros ámbitos de colaboración e interacción con el Zoológico Metropolitano referido a\nflamencos y chinchillas.", 'description': None, 'parent_drive_file_id': '1JnsD4zgWKVAEymxe40m3NH-w-6SDejJ5', 'children': []}, {'id': '0a61b583-851d-4fba-8ce6-26b52b183ae1', 'drive_file_id': '12tQEn3qa47bE4T6Yqi7-yALBKA7l25ND', 'name': 'Complementación Protocolo de Acuerdo_04.05.26_12.05.26.docx', 'mime_type': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/12tQEn3qa47bE4T6Yqi7-yALBKA7l25ND/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 55, 589000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1JnsD4zgWKVAEymxe40m3NH-w-6SDejJ5', 'children': []}, {'id': 'fbfa1fa0-0346-4adf-96f4-806f701621c1', 'drive_file_id': '1m7fCGCti23awvrmZypGa17Ow5qVCHDBW', 'name': 'Doc. Extendido_Corredor Andino Sudamericano (120526).pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1m7fCGCti23awvrmZypGa17Ow5qVCHDBW/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 38, 17, 375000, tzinfo=datetime.timezone.utc), 'text_content': 'Del corredor andino a los mares del fin del mundo\nExpandiendo el impacto de la restauración de la\nPatagonia por América del Sur\n(Documento Extemso)\n16 de agosto de 2024\nINDICE DE CONTENIDOS\n1. INTRODUCCIÓN 3\n2. CONTEXTO BIOGEOGRÁFICO 4\n3. ESTADO DE CONSERVACIÓN, ESTRATEGIAS Y ACTORES\n17\nLOCALES\nA. CÓNDOR (Vultur gryphus) 14\nB. PUMA (Puma concolor) 34\nC. GUANACO (Lama guanicoe) 55\nD. VICUÑA (Vicugna vicugna) 74\nE. ÑANDÚ DE DARWIN (rhea pennata) 96\nF. HUEMUL (Hippocamelus bisulcus) 114\nG. TARUCA (Hippocamelus antisensis) 121\nH. FLAMENCOS (Phoenicopterus sp.) 124\nI. OTRAS ESPECIES DE INTERÉS 130\n4. ENTREVISTAS 155\n1. EDUARDO PAVEZ (BIOAMÉRICA CONSULTORES) 155\n2. MIGUEL DÍAZ (CORPORACIÓN NACIONAL FORESTAL) 155\n3. ÁLVARO PROMIS (UNIVERSIDAD DE CHILE) 156\n4. BENITO GONZÁLEZ (UNIVERSIDAD DE CHILE) 156\n5. CHARIF TALA (MINISTERIO DEL MEDIO AMBIENTE) 157\n6. CRISTIÁN ESTADES (UNIVERSIDAD DE CHILE) 158\n7. CLAUDIO CUNAZZA (CORPORACIÓN NACIONAL FORESTAL) 159\n8. FEDERICO LUEBERT (UNIVERSIDAD DE CHILE) 160\n2\n1. Introducción\nDesde hace más de tres décadas, Tompkins Conservation Chile, luego Fundación Rewilding\nChile, ha trabajado en la conservación de los ecosistemas de la Patagonia chilena para\nenfrentar las amenazas de la extinción global de especies y del cambio climático. A través del\nrewilding, la Fundación busca conservar ecosistemas saludables y funcionales que permitan\nque las áreas de protección sean un motor para el desarrollo local, donde el turismo de\nnaturaleza se constituye como un eje estratégico de este desarrollo (Fundación Rewilding\n2023).\nLa Ruta de Los Parques Nacionales de la Patagonia (RPNP) es un corredor de conservación\nque conforman un grupo de áreas silvestres protegidas desde la ciudad de Puerto Montt (41º\nlatitud sur) al Cabo de Hornos (56º latitud sur). Los parques nacionales a lo largo de la Ruta\nde los Parques alcanzan una superficie de 114.510 kilómetros cuadrados y representan a 4\necorregiones terrestres: bosque magallánico sub antártico, bosque templado valdiviano,\nestepa patagónica y una gran superficie de rocas y hielos (Promis et al. 2019).\nNos encontramos próximos al año 2030 y la biodiversidad sigue disminuyendo en todo el\nplaneta. Una respuesta concreta a la actual crisis ambiental es asegurar que la conservación\nde la biodiversidad permita proteger la capacidad de los ecosistemas de ofrecer bienestar y\nbeneficios a las personas y a otros seres vivos.\nEste documento tiene por objetivo analizar los antecedentes que permitan elaborar una visión\nde conservación continental y una propuesta para la conservación de los paisajes de la\nCordillera de los Andes y sus especies características y sus hábitats, desde Venezuela por el\nnorte hasta la confluencia de los Océanos Pacífico, Atlántico y Antártico por el sur, que permita\nalcanzar los objetivos de biodiversidad al año 2030.\nA continuación, se presenta una revisión del estado de conservación global y local actual de\nalgunas especies asociadas a la Cordillera de Los Andes, las estrategias de conservación\nimplementadas para su conservación y los actores involucrados en estas iniciativas.\n2. Contexto biogeográfico\nAmérica del Sur abarca una superficie de 17,9 millones de kilómetros cuadrados y alberga 215\necorregiones terrestres (Olson et al. 2001) (Figura 1).\nLas ecorregiones terrestres reflejan las distribuciones de una amplia gama de fauna y flora en\ntodo el planeta y facilitan la planificación de la conservación a escala mundial y regional. Es\nun marco de clasificación basado en los conocimientos biogeográficos existentes y cada\necorregión representa biotas distintas (Dasmann 1973, Dasmann 1974, Udvardy 1975). Esta\nclasificación proporciona un marco para las comparaciones entre unidades y la identificación\nde hábitats y conjuntos de especies representativas (Olson et al. 2001).\n3\nFigura 1. Ecorregiones de América del Sur (Olson et al. 2001).\n4\nFigura 2. Litología y bioclimas de América del Sur\n5\nFigura 3. Clases de elevación y geoformas de América del Sur\n6\nAmérica de Sur fue clasificada por Hueck (1978) en regiones boscosas (originales) para el\ncontinente: las regiones de bosques septentrionales (17) y bosques meridionales. A\ncontinuación, se lista la clasificación de las regiones boscosas sudamericanas. La Figura 4\nmuestra como pueden estructurarse las regiones boscosas dentro de la Neotropis y la\nsubantártica.\n1. Bosques septentrionales\n1.1. bosques del Amazonas y del Orinoco (1-14)\n1.2. regiones boscosas de las laderas orientales de los Andes (15-17)\n1.3. región de los bosques pluviales del Pacífico y el Caribe (18)\n1.4. región de los bosques alisios colombiano venezolanos (19)\n1.5. bosque pluvial costero de Brasil (20)\n1.6. región costera de Brasil (20a)\n1.7. región de los bosques subtropicales del Brasil oriental y meridional (21)\n1.8. región de los bosques de araucaria del sur de Brasil (22)\n1.9. regiones boscosas del Chaco y sus regiones marginales (23-24)\n1.10. paisajes de sabanas de Santa Cruz y Trinidad (25)\n1.11. bosques en las colinas de Velasco (26)\n1.12. regiones de campos cerrados de Brasil central (27-28)\n1.13. regiones de la catinga del Brasil nororiental (29-30)\n1.14. región con Orbigna martiana (31)\n1.15. bosques secos del Caribe en Colombia y Venezuela (32)\n1.16. valles secos del interior andino (33)\n1.17. región del Paraná inferior con el Delta (34)\n2. Bosques meridionales\n2.1. bosques subtropicales de xerófitas y durifoliadas (35)\n2.2. bosque pluvial valdiviano (36)\n2.3. región de los bosques de Nothofagus oblicua y de Nothofagus procera (37)\n2.4. bosques de araucaria chileno - argentinos (38)\n2.5. bosques patagonicos y magallánicos siempreverdes (39)\n2.6. bosques patagónicos y magallánicos deciduos (40)\n7\nFigura 4. Regiones boscosas de Sudamérica (Hueck 1978).\n8\nLa Cordillera de Los Andes es una cadena montañosa ubicada en la costa occidental del\ncontinente Sudamericano, la cual atraviesa el territorio de 7 países: Argentina, Chile, Bolivia,\nPerú, Ecuador, Colombia y Venezuela. Con más de 9.000 kilómetros de longitud, siguiendo la\ncadena montañosa (Graham 2009) y más de 6.000 metros de altitud, es la cordillera terrestre\nmás larga y la segunda más alta del planeta, después del Himalaya (Tovar et al. 2023)(Figura\n5).\nFigura 5. Paisajes comprendidos en la Cordillera de los Andes.\n.\nLa Cordillera de los Andes se origina por la subducción de la placa continental sudamericana\ncon una serie de placas oceánicas. Su morfología ha sido modelada a través del tiempo por\nprocesos que tienen lugar en su superficie: el proceso glaciario dadas sus altas cumbres y\notros procesos fluviales, eólicos, volcánicos y de remoción en masa. La combinación de estos\nprocesos le confieren la característica de ser cordones montañosos separados por valles. Su\nmayor elevación corresponde al Aconcagua que alcanza 6.960 metros de altitud en Argentina\n(Instituto de Estudios Andinos 2024).\nLos países andinos (Chile, Argentina, Bolivia, Perú, Ecuador, Colombia, Venezuela) abarcanuna\nsuperficie de ～8,8 millones de kilómetros cuadrados y albergan 136 ecorregiones (Figura 6),\nlas que representan el 63% del total de ecorregiones sudamericanas (Tabla 1). Las\necorregiones Puna y Puna árida de los Andes centrales son comunes a Chile, Argentina, Perú\ny Bolivia. Chile y Argentina comparten 5 ecorregiones: Bosque subpolar magallánico, Bosque\n9\ntemplado valdiviano, Estepa patagónica, Estepa andina del sur y hielos/rocas. Chile y Perú\ncomparten únicamente la ecorregión Desierto de Sechura. Por último, Chile alberga 2\necorregiones continentales que no se representan en los mencionados países, a saber:\nDesierto de Atacama y Matorral chileno.\nTabla 1. Superficie y ecorregiones por país del corredor andino\nPaís Ecorregiones Superficie %\n(millones km2)\nChile 12 0,73 9\nArgentina 19 2,77 34\nBolivia 16 1,08 13\nPerú 18 1,28 16\nEcuador 11 0,25 3\nColombia 35 1,13 14\nVenezuela 25 0,90 11\nTotal 136 ～8,8 100\nFigura 6. Ecorregiones de los países del corredor andino\n10\nFigura 7. Superficie por ecorregión presente en los países andinos\n11\nLos Andes se encuentran entre las regiones con mayor biodiversidad del planeta (Myers et al.\n2000). Se calcula que los Andes albergan unas 40.000 especies de plantas y miles de\nvertebrados, con niveles excepcionalmente altos de endemismo (Kreft & Jetz 2007,\nPennington et al. 2010, Tovar et al. 2022). Además, sus bosques naturales, matorrales y\npastizales proporcionan servicios ecosistémicos críticos, como la protección del suelo, el\nalmacenamiento de carbono y agua para millones de personas (Buytaert et al. 2011,\nDiazgranados et al. 2021, Masiokas et al. 2019, Peña et al. 2018, Tovar et al. 2022).\nLa biodiversidad de los Andes comprende 4 grandes tipos de paisaje: bosques, matorrales,\npastizales y glaciares. El 56 % de las áreas naturales protegidas (1.356) de los países (Chile,\nArgentina, Bolivia, Perú, Ecuador, Colombia y Venezuela) están en la Región Andina (Iniciativa\nAndina de Montañas 2024). En la Cordillera de los Andes destacan 3 puntos calientes de\nbiodiversidad: Tumbes-Chocó-Magdalena, los Andes tropicales y los bosques chilenos de\nlluvias invernales y Laurisilva Valdiviana. Los desafíos de la biodiversidad andina contemplan\ncerrar vacíos de información, integrar la biodiversidad en la planificación económica pública y\nprivada y escalar prácticas de manejo de la biodiversidad. Las oportunidades: Soluciones\nBasadas en Naturaleza (NbS), servicios ecosistémicos y educación.\nFigura 8. Biomas andinos identificados basados en mapas de vegetación (a), Temperatura\nmedia anual (ºC) y Precipitación anual total (mm por año)\n12\nLos biomas andinos identificados por Tovar et al. (2022) incluyen: bosques y matorrales\náridos, bosques templados de coníferas, bosques mediterráneos deciduos, bosques templados\ndeciduos, bosques áridos, bosques montanos semideciduos, bosques montanos\nsiempreverdes, bosques y matorrales esclerófilos mediterráneos, estepa altoandina árida,\nestepa altoandina húmeda, praderas y matorrales altoaninos húmedos y muy húmedos, vegas\ny bofedales.\nSe prevé que el cambio climático afecte a la biodiversidad de las montañas desplazando las\náreas de distribución de las especies y los biomas que conforman. El alcance y la variación\nregional de estos efectos son aún poco conocidos, sobre todo en los Andes, de gran\nbiodiversidad (Tovar et al. 2022).\nSe prevé que los cambios climáticos futuros (2040 - 2070) sean más acusados en las zonas\nde mayor altitud de los Andes tropicales (hasta 4 °C según el RCP 8.5), mientras que en los\nAndes templados se prevé un aumento de la temperatura de hasta 2 °C. En el peor escenario,\nse prevé que los bosques caducifolios templados y los pastizales/estepas de los Andes\ncentrales y meridionales registren las mayores pérdidas de espacio climático adecuado (30%\ny 17%-23%, respectivamente)(Tovar et al. 2022).\nLa gran vulnerabilidad de estos biomas contrasta con la escasa atención prestada por los\ninvestigadores a la modelización de la distribución de las especies andinas. Entre los vacíos\nde conocimiento más importantes cabe citar la falta de un listado de plantas andinas, la\ninsuficiente densidad de las estaciones meteorológicas en zonas de gran altitud, la falta de\nclimatologías de alta resolución que tengan en cuenta la compleja topografía y los procesos\nclimáticos de los Andes, la insuficiencia de datos para modelar procesos demográficos y\necológicos y escaso uso de datos paleográficos para modelar la distribución. Dado el largo\nrango latitudinal y elevacional escarpado, los Andes tienen una alta variabilidad en el clima\n(Espinoza et al. 2020, Pabón et al. 2020, Tovar et al. 2022).\nComprender los vínculos entre el clima y la vegetación natural, y predecir el impacto del\ncambio climático futuro, es por lo tanto importante tanto para la conservación como para el\nbienestar humano en los Andes y las tierras bajas adyacentes.\nEn los países andinos existen alrededor de 2.400 áreas protegidas al año 2021, de las cuales\naproximadamente 1.356 tienen al menos el 50% de su extensión en la región andina. Chile\nes el país que empezó a establecer áreas protegidas más temprano, a principios del siglo XX.\nA partir del año 2000 hay un incremento notable en el número de áreas protegidas cuya\nextensión tiene al menos el 50% en la región andina, particularmente en Colombia. Antes del\naño 2000 la mayoría de las áreas protegidas fueron establecidas principalmente en la región\nno andina, siendo esto más notorio en Venezuela. Sin embargo, en términos de extensión, es\nen la década de los años 1970s cuando más extensión de la región andina fue protegida,\nmientras que en la región no andina esto ocurrió en los años 1990s.\nLas comunidades asentadas en los Andes han cultivado una relación estrecha con la naturaleza\ndurante cientos a miles de años dependiendo de la zona de la cordillera. La diversidad natural\nde los Andes se entrelaza con la diversidad cultural de la región, expresada en sus lenguas\noriginarias (quechua o kichwa, aymara, mapundungun, entre otras), en sus tradiciones y sus\noriginales prácticas de uso de los recursos naturales en un contexto ambiental agreste que\nplantea nuevos retos cada día. La importancia del patrimonio cultural amerita igualmente su\nconservación, salvaguarda y puesta en valor, como importante componente de la reafirmación\nde la identidad andina y del capital cultural y social de la región (FAO, 2011).\n13\nLa Iniciativa Andina de Montañas es una plataforma integrada por los siete países que\ncomparten un territorio común: la Cordillera de los Andes. De manera voluntaria, buscan\nfortalecer el diálogo regional orientado a promover y emprender acciones conjuntas\nencaminadas a la conservación y el desarrollo sostenible de las montañas andinas.\nhttps://iam-andes.org/\nLa Iniciativa Andina de Montañas ha desarrollado un Plan de Acción 2022 – 2025 al cual se\npuede acceder en línea https://iam-andes.org/wp-content/uploads/2022/08/PLAN-DE-\nACCION-IAM-alta-res.pdf. La Iniciativa tiene conformados grupos de trabajo y contactos por\npaís https://iam-andes.org/wp-content/uploads/2023/08/Grupos-de-trabajo-de-montana.pdf\ny dispone una Plataforma de indicadores socio-ambientales en la Región Andina\nhttps://indicadores-andinos.condesan.org/. El ámbito de la biodiversidad, dispone de\ninfografías con información agregada para la Cordillera de los Andes https://iam-\nandes.org/wp-content/uploads/2022/04/infografia-Biodiversidad_en_los_Andes.pdf.\nPor último, cabe destacar el Intercambio de experiencias entre los Andes, Alpes y Cárpatos.\nExplorando vías de gobernanza en las montañas para un desarrollo resiliente al cambio\nclimático las que se pueden consultar en el enlace https://iam-andes.org/wp-\ncontent/uploads/2024/05/Mountains-POLICY-BRIEF-version-ESP_.pdf\n3. Estado de conservación, estrategias y actores locales\nA continuación se exponen los antecedentes recopilados sobre las especies principales, a\nsaber: Cóndor, Puma, Guanaco, Vicuña, Ñandú de Darwin, Huemul, Taruca y los Flamencos\nchileno, andino y de James.\nPara cada una de estas especies se presentan a continuación los antecedentes sobre su estado\nde conservación global, las ecorregiones terrestres de Sudamérica presentes en su área de\ndistribución y su estado de conservación, estrategias de conservación y actores relevantes,\nidentificados para cada país en que se encuentran presentes.\nAdicionalmente, se incluyen otras especies de interés pertinentes de considerar en el análisis\nde especies andinas amenazadas, las cuales fueron mencionadas en las entrevistas sostenidas\ncon expertos. Estas especies alcanzan un número total de 25 y para cada una de ellas se\npresenta su mapa de distribución y estado de conservación global. Las especies incluidas\ncorresponden a: Pudú, Gato andino, Güiña, Chichilla cola corta, Chinchilla cola larga, Vizcacha,\nVizcacha austral, Quirquincho de la puna, Piche, Yaca del norte, Picaflor de Arica, Canquén\ncolorado, Piuquén, Pato cortacorrientes, Chorlo chileno, Lagarto gruñidor, Rana del Loa, Sapo\nde Philippi, Ranita de Darwin, Orestias de Parinacota, Chungará y Lauca, Polylepis sp., Ciprés\nde la Cordillera y Araucaria araucana.\na. Cóndor (Vultur gryphus)\nLa especie se distribuye a lo largo de la Cordillera de Los Andes y es considerada residente\nen Chile, Argentina, Bolivia, Perú, Ecuador y Colombia (Houston 1994, Wallace et al. 2020,\nBirdlife International 2020). Es considerada visitante en Venezuela, Paraguay y Brasil (Birdlife\nInternational 2020). Sus poblaciones son extremadamente raras en la porción norte de su\ndistribución, particularmente en Venezuela, donde la especie posiblemente ya no sea residente\n(Birdlife International 2020). La especie es naturalmente escasa y la población global se estima\nen 10.000 individuos (Birdlife International 2020).\n14\nFigura 10. Cóndor (Vultur gryphus)\ni. Ecosistemas representados en su distribución\nLa especie habita principalmente en regiones montañosas, en matorrales y praderas abiertas\nsobre los 5.000 metros de altitud y los bosques adyacentes de alta y media montaña.\nDescienden a tierras bajas en regiones desérticas y al borde costero en Chile y Perú (Houston\n1994, Parker et al. 1996). Su área de distribución se estima en 1,2 millones de kilómetros\ncuadrados y abarca 46 ecorregiones terrestres (Olson et al. 2001) (Figura 11). Las\necorregiones más representacas corresponden a: Bosque subpolar magallánico (53%),\nPáramo andino del norte (13%), Bosque templado valdiviano (6,1%), Puna húmeda andina\ncentral (3,2%), Páramo de la cordillera central (2,7%) y Estepa patagónica (2,1%).\n15\nFigura 11. Ecorregiones terrestres en la distribución de Cóndor andino (Vultur gryphus).\nii. Estado de conservación y amenazas globales\nVultur gryphus ha sido clasificado en estado de conservación VULNERABLE (VU) a nivel global\n(Birdlife International 2020), es decir que la especie está en riesgo alto de extinción en estado\nde vida silvestre. La evaluación de su estado [A4cde; C2a(i)] justifica en la reducción del\ntamaño de la población (A), una reducción mayor o igual al 30% en un período de 10 años o\ntres generaciones (4) causada por una reducción del área de ocupación, extención de\npresencia y/o calidad del hábitat (c), niveles de explotación reales o potenciales (d) y por el\nefecto de taxones introducidos, hibridación, patógenos, contaminantes, competidores o\nparásitos (e). El tamaño de la población se estima en menos de 10.000 individuos maduros\n(C), con una disminución en el número de individuos maduros (2) y estructura poblacional\n(a). Se estima que ninguna subpoblación contiene más de 1.000 individuos maduros (i).\nLa tendencia actual de las poblaciones es decreciente por causa de la persecución antrópica\ndirecta, el envenenamiento por plomo y el uso de cadáveres envenenados. Se estima que sus\npoblaciones han disminuido entre un 30 y 50 % en 3 generaciones, que equivalen a 86,7 años\n(Wallace et al. 2020).\n16\nLa especie está claramente adaptada a una mortalidad y un rendimiento reproductivo\nexcepcionalmente bajos, por lo que es muy vulnerable a eventos demográficos negativos,\nincluida la persecución humana, que persiste en toda su área de distribución debido a\nsupuestos ataques al ganado (Houston 1994, Cailly Arnulphi et al. 2017).\nLas amenazas del cóndor fueron listadas por Wildlife Conservation Society (2020): cambio de\nhábitat, caza, intoxicación por plomo, envenenamiento de cadáveres, competencia con perros\ndomésticos y asilvestrados, falta de carroña, usos en rituales y artesanías folclóricas y otras\nmenos comunes como el atropellamiento, cautiverio y acercamiento a nidos por turismo.\nLas observaciones realizadas en la última década han confirmado que los individuos atacan\nocasionalmente las partes blandas del cuerpo del ganado doméstico juvenil (Rios per Wallace\n2004, Vargas & Sáenz obs. pers. per Wallace in litt. 2020). Las observaciones intensivas de\nterreno muestran que este parece ser un evento extremadamente raro que representa menos\ndel 1% de las mortalidades de ganado (Ballejo et al. 2020).\nAdemás, la persecución de pumas y zorros mediante el envenenamiento ilegal de cadáveres\nestá afectando gravemente a la especie en Argentina, Chile, Colombia, Ecuador, Perú y\nprobablemente Bolivia (Pavez & Estades 2016, Alarcón & Lambertucci 2018, Pauli I 2018,\nPiana 2019, Estrada Pacheco 2020, Sáenz & Méndez per Wallace in litt. 2020, Wiemeyer in\nlitt. 2020) y ha aumentando su intensidad. A principios de año 2020, se habían reportado 225\nindividuos en toda el área de distribución, con alrededor del 50% de los casos registrados\nresultando en mortalidad, aunque este porcentaje está sesgado por los animales de los centros\nde rescate y las tasas de mortalidad son probablemente más altas, ya que muchas víctimas\nde envenenamiento muertas no son detectadas o reportadas en toda el área de distribución\n(Birdlife International 2020).\nLa especie es altamente dependiente de los cadáveres de herbívoros exóticos en Argentina,\nque constituyen el 98% de su dieta, lo que la hace vulnerable a los cambios en la ganadería\ny al consumo de munición de caza (Lambertucci et al. 2009). La competencia interespecífica\npor los cadáveres con el buitre negro americano Coragyps atratus, que recientemente han\ncomenzado a ocupar las mismas áreas, puede tener un efecto negativo sobre las poblaciones\nde cóndor andino (Carrete et al. 2010, Ballejo et al. 2018).\nVarios estudios han revelado la importancia de otras amenazas para la especie, incluyendo el\nenvenenamiento por plomo (Lambertucci et al. 2011, Wiemeyer et al. 2017, Plaza et al. 2020),\nel uso ilegal en eventos folclóricos (Piana 2014, Piana2019), el comercio ilegal de vida silvestre\n(Williams et al. 2011), el uso como mascotas (Pavez y Estades 2016), las colisiones con\ninfraestructura eléctrica y de telecomunicaciones (Lambertucci obs. pers.), la competencia con\nperros asilvestrados (Méndez & Vargas obs. pers.) y la pérdida de hábitat por la conversión\nde vegetación natural para uso agrícola y plantaciones (Vargas in litt. 2020).\n17\nFigura 12. Distribución histórica de Vultur gryphus en América del Sur.\n18\nFigura 13. Áreas donde Vultur gryphus ha sido extirpado.\n19\nFigura 14. Distribución de localidades confirmadas de Vultur gryphus.\n20\nEn Chile, Argentina y Colombia se han implementado Programas de reintroducción utilizando\nel rescate y la reproducción de individuos en cautiverio (Hilty & Brown 1986, Houston 1994,\nAstore et al. 2017, Birdlife International 2020). Las acciones de conservación implementadas\nreportadas a nivel global incluyen:\n● Censos de población mediante fotografía/video para reconocer aves individuales en las\nestaciones de alimentación (Ríos-Uzeda & Wallace 2007, Méndez et al. 2019)\n● Recuentos de sitios de descanso (Kusch 2006, Lambertucci et al. 2008, Lambertucci\n2013, Cailly Arnulphi et al. 2013, Naveda et al. 2016, Vargas et al. 2018).\n● Estudios genéticos (Alcaide et al. 2010, Padró et al. 2018, 2019, Perrig et al. 2019).\n● Estudios de telemetría satelital en curso en Argentina, Bolivia, Perú, Ecuador y\nColombia están comenzando a revelar la escala de los movimientos individuales,\nademás de ayudar a identificar y determinar subpoblaciones en toda la zona.\nLas acciones propuestas para la conservación de la especie (Wallace et al. 2020) incluyen:\n● Incrementar los esfuerzos para censar a la población, especialmente en Chile,\nArgentina y Perú (Wallace et al. 2020)\n● Desarrollar análisis y planes de conservación específicos e integrales con acciones de\nconservación integradas y diversas para las Unidades Prioritarias de Conservación del\nCóndor Andino identificadas (Wallace et al. 2020)\n● Trabajar con los gobiernos locales para abordar las amenazas más apremiantes a las\npoblaciones, incluida la introducción de legislación sobre el uso de venenos en\ncadáveres dirigida a la vida silvestre en general (Wallace et al. 2020).\n● Resaltar la relevancia cultural única de la especie en un esfuerzo por reducir la\npersecución local ante los conflictos con los propietarios ganaderos.\niii. Chile\n1. Estado de conservación\nEl rango histórico del Cóndor en Chile es casi continuo a lo largo de los Andes, desde Arica\nhasta Cabo de Hornos, alcanzando la costa en el extremo norte y sur del país (Goodall et al.\n1946). Este rango ha sido corroborado por el Atlas de Aves Nidificantes de Chile (Medrano et\nal. 2018) aunque en muchos sitios no hay registros de nidos confirmados. Existe un vacío\ngrande de información sobre la distribución histórica del Salar Atacama y en una porción del\naltiplano chileno.\nLas estimaciones de poblaciones máximas en Chile y en Argentina son de alrededor de 2.000\nindividuos (Wallace et al. 2020). La población mas grande se ubica en el noreste de la\nPatagonia compuesta por aproximadamente 300 individuos, que incluyen 200 individuos\nmaduros (Lambertucci 2010, Birdlife Internacional 2020).\nEn el marco del Reglamento de Clasificación de Especies Silvestres (RCE), el año 2018 se\nestableció que la categoría de conservación del Cóndor en Chile es CASI AMENAZADA (NT)\npues NO cumple con los umbrales de ninguno de los criterios para ser clasificada en alguna\nde las categorías de amenaza de UICN 3.1 (CHILE Ministerio del Medio Ambiente 2018).\nEl Reglamento de la Ley de Caza lo clasifica como VULNERABLE (VU) desde la Región de Arica\ny Parinacota hasta la Región del Maule, como una especie RARA desde la Región de Biobío a\nla Región de Los Lagos y FUERA DE PELIGRO en la Región de Aysén y Magallanes (CHILE\nMinisterio de Agricultura 1998).\n21\nEn Chile, sus poblaciones se consideran declinando (Jaksic & Jiménez 1986), especialmente\nen la Región Metropolitana (Jaksic et al. 2001). El año 2006 la especie fue declarada\nMonumento Natural (CHILE Ministerio de Agricultura 2006). También se ha clasificado como\nVULNERABLE (Glade 1988, Rottmann & López-Calleja, 1992) e INADECUADAMENTE\nCONOCIDO (Estades 2001).\nEn el extremo sur se ha evaluado como FUERA DE PELIGRO (Venegas & Sielfeld 1998) y\nDESCONOCIDO (Jaksic et al. 2002).\n2. Estrategias y actores locales\nEn 1990 se dio inicio al trabajo sistemático de estudio y conservación del cóndor en Chile, con\nprospecciones en la cordillera patagónica y central de Chile, en las que participaron el\nornitólogo y cineasta francés Michel Terrasse y los jóvenes ornitólogos chilenos Eduardo\nPavez, Christian González y Charif Tala. Entre 1992 y 1994, con el apoyo de la División Andina\nde CODELCO, Eduardo Pavez y Charif Tala realizaron los primeros estudios sistemáticos de\ncóndores en Chile y desarrollaron una intensa campaña de educación ambiental en torno a la\nespecie.\nEn marzo de 2000, durante la Primera Reunión Internacional de Especialistas en Cóndor\nrealizada en Venezuela y organizada por la Word Wildlife Fund (WWF), se estableció una\nEstrategia Sudamericana para el Cóndor Andino. Sobre la base de dicha estrategia, Chile y\nArgentina unieron sus esfuerzos materializando el Programa Binacional de Conservación del\nCóndor Andino Chile – Argentina (PBCCA). Como primer paso en esta estrategia binacional se\ndesarrolló, en la cordillera de Chile central, la liberación de 4 cóndores nacidos en Chile y 4\nen Argentina.\nEl PBCCA fue organizado en Argentina por el Zoológico de Buenos Aires, la Fundación\nTemaikén y la Fundación Bioandina Argentina. En Chile el PBCCA fue organizado por AvesChile\ny contó con la participación del Centro de Rehabilitación de Aves Rapaces (CRAR) y del\nZoológico Nacional del Parque Metropolitano de Santiago.\nDesde que se recibió el primer cóndor en el Centro de Rehabilitación de Aves Rapaces (CRAR)\nen 1993, se ha trabajado con 180 cóndores ocupándose de su asistencia, tratamiento\nveterinario, rehabilitación y manejo en cautiverio. Al día de hoy, se han liberado 80 cóndores\nrehabilitados o nacidos en el CRAR y el trabajo ha sido reconocido por la Unión Internacional\npara la Conservación de la Naturaleza UICN en Global conservation translocation perspectives,\nReintroduction Specialist Group (Soorae 2021). A partir de 2019, con la incorporación al\ntrabajo de la Fundación MERI como socio, conformó el Proyecto Manku. Son colaboradores\nestratégicos del Proyecto el Zoológico Nacional del Parque Metropolitano, Rewilding Chile,\nantes Tompkins Conservation Chile y el vínculo con el Estado se realiza a través del Servicio\nAgrícola y Ganadero (SAG) del Ministerio de Agricultura.\nEl Proyecto Manku es una iniciativa de la Unión de Ornitólogos de Chile en asociación con la\nFundación MERI y cuenta con el valioso apoyo del Zoológico Nacional y de Tompkins\nConservation. El objetivo principal del Proyecto Manku es contribuir al estudio y conservación\ndel cóndor en Chile. Para el alcance de tal objetivo se han propuesto las siguientes acciones:\n● Estudio de biología de la especie. Dados los escasos antecedentes sobre la biología del\ncóndor, se considera importante el estudio de esta especie en su ambiente natural. El\nesfuerzo de investigación se concentra, por ahora, en la cordillera central de Chile.\nEntre los tópicos abordados se considera la caracterización y el uso del hábitat, biología\n22\nreproductiva, caracterización y uso de condoreras, conducta social frente a la carroña\ny el seguimiento satelital de los cóndores liberados.\n● Rehabilitación de cóndores dañados. Los cóndores dañados o decomisados por el\nServicio Agrícola y Ganadero (SAG) llegan al Zoológico Nacional. Una vez examinados,\nrevisadas las lesiones y entregados los tratamientos médicos necesarios, son enviados\nal Centro de Rehabilitación de Aves Rapaces (CRAR) donde, de ser posible, se\nrehabilitan.\n● Cría y liberación de ejemplares nacidos en cautiverio: Desde 1999 algunos de los\ncóndores mantenidos en el Centro de Rehabilitación de Aves Rapaces (CRAR), que\nestán imposibilitados de ser liberados, se reproducen. En el año 2000 se obtuvo la\nprimera puesta exitosa y el ejemplar nacido, llamado Pillán, fue liberado en 2001.\nDesde entonces, 25 cóndores han nacido en cautiverio y la mayoría han sido liberados.\n● Programa de educación y difusión. La implementación de este programa quiere\ndestacar al cóndor y la Cordillera de los Andes dentro de un marco de valoración\nambiental, cultural y científico. Consideran las siguientes actividades:\n● Charlas y conferencias en distintas instituciones y colegios, juntas vecinales de\ncomunidades aledañas al ecosistema andino.\n● Publicación de artículos en prensa donde se da a conocer el trabajo de\nrehabilitación e investigación del cóndor. Artículos en revistas especializadas y\nlibros.\n● Colaboración en notas y programas de radio y televisión, realización y\ncolaboración en documentales.\n● Actividades educativas, principalmente orientadas a niños, asociadas a las\nliberaciones de cóndores.\n●\nLa Unión de Ornitólogos de Chile (AvesChile) ha desarrollado un trabajo intenso de\nrehabilitación, reproducción en cautiverio y liberación de cóndores a través de su Centro de\nRehabilitación de Aves Rapaces (CRAR). Las liberaciones de cóndores tienen un importante\nimpacto en las comunidades (Pavez & Saucedo 2017) lo que ha contribuido, desde hace\naproximadamente 25 años de trabajo ininterrumpido, a crear conciencia respecto del valor\nnatural y cultural del cóndor.\nWildlife Conservation Society (2020) señala algunas acciones de conservación implementadas\nen Chile:\n● El Zoológico Nacional y el Centro de Rehabilitación para Aves Rapaces (Aves Chile)\nmantiene un programa de recuperación y reintroduce los cóndores rehabilitados a la\nnaturaleza.\n● La ONG Amigos del Cóndor tiene un programa de estudio para localizar nidos, refugios\ny sitios de forrajeo, complementando la base de datos de eBird (Universidad de\nCornell) que es administrada en Chile por la Red de Observadores de Aves y Vida\nSilvestre de Chile (ROC).\n● El Centro para Aclimatación Zoológica (CAZ) y la Municipalidad Lo Barnechea instalaron\nun área de alimentación dentro del Santuario de la Naturaleza Yerba Loca (Santiago)\ncon el objetivo de complementar la dieta del cóndor y de promover la educación\nambiental.\nEl amplio ámbito de movimiento, que incluye Chile y Argentina, remarca la necesidad de\ncoordinar esfuerzos binacionales para el estudio y conservación de esta especie y considerar\nestrategias que incluyan amplios territorios de uso humano extensivo (Pavez 2014).\n23\nSe han identificado 5 grandes unidades de conservación prioritarias del Cóndor Andino en\nChile: Huascoaltinos, Chile Central, Los Ríos, Los Lagos, Patagonia y Magallanes (Wildlife\nConservation Society 2020).\niv. Argentina\nEl cóndor en Argentina se distribuye históricamente a lo largo de toda la Cordillera de los\nAndes, desde Jujuy hasta Tierra del Fuego, así como hacia el este, en las sierras centrales de\nlas provincias de San Luis y Córdoba (Lambertucci 2007). Existen registros históricos de\ncóndores en la costa atlántica de la Patagonia (BirdLife International 2017). Sin embargo, los\nmás recientes fueron obtenidos hace más de un siglo.\nLa información actual disponible de la zona central de Argentina sugiere que la distribución\nhistórica del cóndor no se modificó desde entonces, como lo indican las recientes\nobservaciones, desde el año 2014 al presente, en las sierras del norte de Córdoba (Cerro\nColorado, San Pedro Norte). Ellas representan los primeros registros después de 50 años\n(Gargiulo 2014, Gordillo & Heredia com. Pers.). Su distribución actual se corresponde con la\nhistórica, sin incluir la costa de la provincia de Chubut ni el norte de Santa Cruz en la Patagonia,\ndonde han sido localmente extirpados. Si bien los datos son escasos, se cree que la especie\nen el pasado era relativamente más abundante en esas zonas. (Wildlife Conservation Society\n2020).\n1. Estado de conservación\nEl Ministerio de Ambiente y Desarrollo Sustentable de la Nación la ha catalogado, a nivel\nnacional, como una especie AMENAZADA.\n2. Estrategias de conservación y actores locales\nEl Programa de Conservación del Cóndor Andino se conformó el año 1991 en el marco del\nPrograma Binacional Chile - Argentina. El Plan Integral para la conservación del Cóndor Andino\ntiene por objetivo generar un plan que reúna el último adelanto biotecnológico con la\ncosmovisión de los pueblos originarios para alcanzar los objetivos del Programa Binacional. El\nPlan es liderado por la Fundación BIOANDINA, organización sin fines de lucro que desde el\naño 2000 tiene por objetivo la protección de la vida silvestre y su ambiente.\nhttps://www.bioandina.org.ar/\nDesde el año 2009, el Programa de Conservación del Cóndor Andino ha reportado el\nnacimiento de 9 pichones en la meseta de Somuncurá y en la costa atlántica Patagónica,\n(Jácome 2010, Astore et al. 2016). El éxito de este programa de reintroducción, a lo largo de\n15 años, ha permitido el retorno de esta especie a un área donde estuvo extinta por más de\nun siglo (Conway 2005, Jácome et al. 2005).\nLa información satelital del Programa de Conservación del Cóndor Andino (PCCA) muestra la\ndistribución de estas aves en la parte sur de la provincia de Santa Cruz, que comprende al\nParque Nacional Los Glaciares y también a Chile. Los datos nocturnos de geoposicionamiento\nhan documentado sus lugares de descanso en esta región (De Martino et al. 2011).\nDesde el año 2000, el Centro de Rescate y Rehabilitación del Cóndor Andino del Programa de\nConservación del Cóndor Andino (PCCA), en asociación con las autoridades de medio ambiente\npertinentes, ha intervenido en el rescate de más de 80 cóndores en el norte de Argentina, de\n60 en el centro de Argentina, de más de 100 en el norte de la Patagonia y de 20 en el sur de\nla Patagonia (Wildlife Conservation Society 2020).\n24\nLa primera liberación del Programa de Conservación del Cóndor Andino se realizó en el año\n1997 en Valle Encantado (Río Negro) con el fin de desarrollar la tecnología de seguimiento\nsatelital del cóndor andino (Astore 2001, Sestelo 2003).\nDesde entonces, el Programa ha completado más de 40 liberaciones de ejemplares en el norte\nde Argentina, más de 30 en la zona central, más de 70 en el norte de Patagonia (51 de ellos\nen la costa atlántica patagónica) y 2 en el sur de la Patagonia. Todos estos ejemplares\nprovenían de acciones de rescate y fueron rehabilitados en el Centro de Rescate del Programa\nde Conservación del Cóndor Andino, que en la actualidad funciona en el Ecoparque de Buenos\nAires. Todos los animales liberados fueron marcados y algunos de ellos fueron seguidos por\nradio telemetría y transmisión satelital (De Martino et al. 2011, Astore et al. 2016).\nEn el norte de Argentina, las áreas naturales protegidas de la provincia de Jujuy fueron\ndeclaradas Santuario del Cóndor para la Conservación de la Naturaleza (Jácome & Lambertucci\n2000) gracias a un acuerdo de colaboración entre el Ministerio de Ambiente de la Provincia de\nJujuy y la Fundación BIOANDINA.\nDe manera similar, en el norte de la Patagonia, las áreas naturales protegidas de la Provincia\nde Mendoza fueron declaradas Santuario del Cóndor para la Conservación de la Naturaleza,\ngracias a un acuerdo de colaboración entre el Ministerio de Tierras, Ambiente y Recursos\nNaturales de la Provincia de Mendoza, su Dirección de Recursos Naturales Renovables y la\nFundación BIOANDINA. En el marco del Plan, se reconoce la importancia ecológica y cultural\ndel cóndor andino, y la necesidad de trabajar en su conservación (Jácome & Lambertucci\n2000).\nComo parte de un Plan Integral de Conservación, el Programa de Conservación del Cóndor\nAndino, lleva adelante programas educativos a distintos niveles en las cuatro regiones (norte,\ncentro, Patagonia norte, Patagonia sur) que incluyen acciones de difusión en los medios de\ncomunicación, trabajo con las comunidades locales, encuestas sobre prácticas ganaderas y\nexposiciones científicas, culturales y educativas. Antes de cada liberación, las comunidades\nlocales realizan ceremonias milenarias que consagran el retorno de las aves y su armoniosa\nconvivencia con todas las formas de vida (Jácome 2016).\nSe identifican 6 unidades de conservación prioritarias de Cóndor Andino en Argentina: Norte,\nCentro, Patagonia norte, Meseta de Somuncurá, Patagonia Sur y Tierra del Fuego.\nv. Perú\n1. Estado de conservación\nEl cóndor andino fue clasificado como EN PELIGRO (EN) (PERÚ Ministerio de Agricultura 2018).\nEsta categoría se asignó debido al tamaño de la población, que se considera inferior a 1.500\nindividuos y a las amenazas que enfrenta por persecución directa, tráfico ilegal, entre otras,\nincluida la pérdida de hábitat. El gobierno peruano también aprobó la Ley 20.303 que declara\nde interés nacional y de necesidad pública la protección y la conservación del cóndor andino.\nEl Gobierno Regional de Ayacucho emitió la Ordenanza Regional (2018) declarando al cóndor\nandino como una especie de interés regional y promoviendo la implementación de\nmecanismos que apoyen la conservación de la especie, como la educación ambiental en los\ndistritos Andamarca, Chipao, Cabana Sur y Aucará. El Gobierno Regional de Cuzco creó el\nÁrea de Conservación Regional Choquequirao (103.814 ha) (PERÚ Ministerio del Medio\nAmbiente 2010).\n25\nEl cóndor andino está ampliamente distribuido en el Perú andino, por encima de los 3.000\nmetros sobre el nivel del mar, en las cordilleras Occidental y Oriental (Schulenberg et al.\n2010). También está presente de manera irregular a lo largo de la costa desde Ica hasta\nTacna, en el sur, y desde Piura hasta Lambayeque en el norte (Stucchi 2013), con tres\npoblaciones estables costeñas en la Zona Reservada de Illescas (Piura), la Reserva Nacional\nde Paracas (Ica) y la Reserva Nacional San Fernando (Ica).\nTodavía no se dispone de una estimación confiable de la población total de cóndores andinos\nen Perú. Históricamente, las estimaciones de población solo existían para regiones específicas\ndel país, por ejemplo, en la península de Illescas y en Olmos Ñaupe, en Piura, se estimaron\n115 y 120 individuos, respectivamente, entre 1980 y 1982 (Wallace & Temple 1988, Temple\n& Wallace 1989).\nHistóricamente, el cóndor andino se encontraba en grandes áreas en todo el país, desde el\nocéano Pacífico, hacia el oeste, hasta los bosques de neblina y el páramo de las montañas,\nen la vertiente oriental de los Andes. La distribución de los registros sistematizados del cóndor\nandino respalda esta opinión experta, con una distribución bastante representativa de\nlocalidades conocidas.\nSolo hay dos áreas donde el cóndor andino ya no existe en Perú:\nÁrea 1. En el sur y el oeste de Tumbes y en el centro y el oeste de Piura. Esta área incluye\ngran parte del desierto Sechura, desde nivel de mar hasta 500 metros de altura hacia el este.\nLa ausencia del cóndor andino aquí se atribuye a la falta de recursos alimenticios en el centro\nde Piura y a la fuerte presencia humana cerca de la costa en las regiones de Piura y Tumbes.\nTambién se debe considerar que estas áreas cambian considerablemente durante los eventos\nde El Niño y podrían en estos años poblarse de vegetación herbácea y permitir la cría de\nganado.\nÁrea 2: Cajamarca central. Esta área tiene un hábitat adecuado para la especie porque la\nelevación varía de 1.000 a 3.500 metros sobre el nivel del mar e incluye ecosistemas como\nlas jalcas andinas bifurcadas por cañones profundos y montañas, desde los 800 hasta los\n4.000 metros sobre el nivel del mar. La ausencia del cóndor andino en este lugar es probable\nque se deba a una fragmentación severa del hábitat asociada a la persecución y al posible\nenvenenamiento de cóndores por parte de los rancheros.\nPiana y Angulo (2015) sistematizaron información sobre la abundancia de cóndores andinos\nen 17 sitios a lo largo de los Andes y en la costa, donde se estima que las poblaciones son\nmayores a seis individuos. Estos datos se obtuvieron de observaciones directas,\ncomunicaciones personales con evidencia fotográfica y mediante la revisión de datos de la\nplataforma eBird. Muchas de estas localidades eran dormideros o lugares de vuelo obvios y\nrepetidos, que podrían estar asociados con dormideros. El número de individuos detectados\nutilizando esta sistematización fue entre 155 y 249 individuos.\n2. Estrategias de conservación y actores locales\nEl gobierno peruano anunció en 2015 la aprobación del Plan Nacional para la Conservación\ndel Cóndor Andino realizado por el SERFOR del Ministerio de Agricultura y Riego y el Ministerio\ndel Medio Ambiente.\nEs importante resaltar la creación de áreas protegidas naturales que resguardan el hábitat,\nsitios de anidación y dormideros para el cóndor andino, como es el caso de la Zona Reservada\n26\nIllescas, el Parque Nacional Río Abiseo, el Parque Nacional Huascarán, la Reserva Paisajística\nNor Yauyos-Cochas, la Reserva Nacional Paracas, la Reserva Nacional Barbara D´Achille\nPampa Galeras, la Reserva Nacional San Fernando, la Reserva Paisajística Subcuenca de\nCotahuasi y la Reserva Nacional Salinas y Aguada Blanca.\nAunque las áreas protegidas juegan un rol importante en la preservación del hábitat del cóndor\nandino en Perú, Piana (2018) encontró que el área de distribución potencial para el cóndor\nandino, como un sustituto de la estimación de la extensión de presencia de la especie en Perú,\nera de 481.760 kilómetros cuadrados y de esta extensión solo el 2 % se encontraba\nexclusivamente dentro de áreas protegidas.\nLas acciones de conservación para la especie deben implementarse con comunidades locales\ny asegurar la protección de hábitats dentro de las tierras comunales, mediante acuerdos de\nconservación con las autoridades comunales, como también de áreas de conservación\nregionales y privadas. Se identificaron 4 unidades de conservación prioritarias del cóndor\nandino en Perú: Illescas, Páramos de Piura-Bosque Seco de Cajamarca, Pataz Río Abiseo\nCelendin-Cordillera Blanca-Central y Sur del Perú.\nvi. Bolivia\n1. Estado de conservación\nDurante la última clasificación de los vertebrados amenazados de Bolivia, el cóndor andino\nfue catalogado como VULNERABLE (VU) (Balderrama et al. 2009). Adicionalmente, la Ley\nNº1.524 del Estado Plurinacional de Bolivia (2023) tiene por objetivo garantizar la protección\ny conservación del Cóndor Andino en el Estado Plurinacional de Bolivia. En Bolivia la población\nse estima en 1.400 individuos (Méndez et al. 2019) y se conoce muy poco acerca del estado\npoblacional de la especie en el país (Ríos-Uzeda & Wallace 2007).\nExpertos identificaron el área alrededor del Parque Nacional Sajama como una zona donde las\npoblaciones de cóndores habían existido históricamente, donde ahora ya no están presentes.\nAlgunos reportes, no confirmados, indican un posible retorno de la especie que amerita una\nmayor investigación.\nEl cóndor es reconocido como una especie amenazada que requiere esfuerzos de conservación\npara asegurar su futuro. Además, el cóndor andino es el ave nacional de Bolivia y un símbolo\nnacional. Culturalmente, el cóndor, también es conocido como kuntur en quechua y kunturi\nen aymara, se lo compara con la figura del mallku, que en quechua y aymara significa líder.\nEl símbolo del mallku es el cóndor y muchas veces estas palabras se utilizan indistintamente\nen las regiones altoanidas.\n2. Estrategias de conservación y actores locales.\nEl Sistema Nacional de Áreas Protegidas de Bolivia (SNAP) tiene 22 áreas protegidas\nnacionales, que representan casi 17 % del territorio nacional.\nHasta la fecha, hay registros de la presencia de cóndor andino en 14 de las áreas protegidas:\nÁrea Natural de Manejo Integrado Nacional Apolobamba, Parque Nacional y Área Natural de\nManejo Integrado Madid, Parque Nacional y Área Natural de Manejo Integrado Cotapata,\nParque Nacional Sajama, Parque Nacional Tunari, Parque Nacional Carrasco, Parque Nacional\ny Área Natural de Manejo Integrado Amboró, Parque Nacional y Área Natural de Manejo\nIntegrado Kaa-Iya, Área Natural de Manejo Integrado El Palmar, Parque Nacional Torotoro,\nReserva Nacional Fauna Andina Eduardo Avaroa, Reserva Nacional de Flora y Fauna Tariquía,\n27\nParque Nacional y Área Natural de Manejo Integrado Aguaragüe y Reserva Biológica Cordillera\nde Sama.\nA nivel nacional, Armonía ejecuta un programa de conservación enfocado en censos de\npoblación para el cóndor andino (Méndez 2013a, Méndez 2013b, Méndez et al. 2013).\nWildlife Conservation Society (WCS) también reconoce al cóndor andino como una especie\npaisaje y desarrolla un programa de monitoreo y acciones de conservación de la especie en\nel noroeste de Bolivia (Coppolillo et al. 2004, Painter et al. 2006, Ríos-Uzeda & Wallace 2007,\nNallar et al. 2008, Wallace et al. 2011, Aliaga et al. 2012, Zapata et al. 2012, Wallace 2013a).\nEste interés a nivel de paisaje se convirtió en un esfuerzo transfronterizo para caracterizar la\ndistribución de cóndor andino en Bolivia y en Perú (Wallace et al. 2015) que culminó en una\nbase de datos regional, con 3.750 puntos de distribución en el continente.\nSe han identificado 3 unidades de conservación prioritarias en Bolivia: Puna-Apolobamba,\nPuna-Turari-Valles Boliviano Tucumano y Sur de Bolivia.\nvii. Ecuador\n1. Estado de conservación\nSe ha intentado varias veces estimar el tamaño de la población del cóndor andino en Ecuador.\nSin embargo, estas iniciativas han estado limitadas por el rango espacial y los esfuerzos de\nmuestreo. En el año 2015, después de que la información de telemetría satelital estuvo\ndisponible, se realizó el primer censo cubriendo todo el país (Naveda-Rodríguez et al. 2016).\nEste censo se implementó simultáneamente en 70 dormideros. Se registraron 93 individuos y\nse estimó una población de 94 - 102 individuos. En el año 2018, se repitió el censo\naumentando el esfuerzo a 180 dormideros. La estimación poblacional del segundo censo fue\nde 197 individuos (ICB 95% = 140 - 270) (Vargas et al. 2018).\n2. Estrategias de conservación y actores locales\nEn el año 2009, el Ministerio del Ambiente creó el Grupo Nacional de Trabajo del Cóndor\nAndino (GNTCA) que apoya y coordina el trabajo de los técnicos de las ONG, de funcionarios\nde áreas protegidas y de funcionarios de gobiernos locales y nacionales, en temas de la\nconservación del cóndor andino en el país. El Grupo Nacional de Trabajo del Cóndor Andino\n(GNTCA) está conformado por una serie de organizaciones: Aves y Conservación (BirdLife en\nEcuador), Fundación Jocotoco, Wildlife Conservation Society Ecuador, Fundación Cóndor\nAndino (FCA), The Peregrine Fund, Fundación Zoológica del Ecuador, Parque Cóndor,\nBioparque Amaru, Fundación Galo Plaza Lasso, Centro de Rescate Ilitío y el Zoológico de\nBaños. Las últimas seis organizaciones albergan 18 cóndores en cautiverio. El Grupo Nacional\nde Trabajo del Cóndor Andino (GNTCA) maneja esta población cautiva, con 2 parejas\napareadas exitosamente. Hay otras 4 parejas en proceso de formación y 2 juveniles que\npodrían aparearse y producir pichones en el futuro.\nDesde el año 2012, The Peregrine Fund y Fundación Cóndor Andino han estudiado los\ncóndores andinos enfocándose en su hábitat, su biología de reproducción y su movimiento\nespacial (Vargas et al. 2016). Como parte de este estudio, 9 cóndores andinos fueron seguidos\ncon rastreadores satelitales y otros 3 individuos con marcadores en el ala. Estas aves han\nproporcionado información espacial antes no conocida de los Andes ecuatorianos (Vargas et\nal. 2016). Este proyecto también documentó 13 diferentes nidos y monitoreó\nsistemáticamente 9 nidos activos (Vargas et al., datos no publicados).\n28\nLos datos de este proyecto se han utilizado como insumos para varios programas de educación\ny sensibilización realizados por el Ministerio del Ambiente, el Fondo para la Protección del\nAgua (FONAG), la Empresa Pública de Cuenca (ETAPA), zoológicos orientados a la\nconservación, personal de la Fundación Cóndor Andino (FCA) y miembros del Grupo Nacional\nde Trabajo del Cóndor Andino (GNTCA).\nLos dormideros y los nidos más importantes están localizados en Antisanilla (Provincia de\nPichincha). Estas localidades han sido adquiridas y convertidas en reservas privadas por la\nFundación Jocotoco, que protegen 5.000 hectáreas de páramos y humedales, incluyendo 5\ndormideros y 4 nidos conocidos. Entre estos dormideros, se encuentra el Peñón del Cóndor,\nun acantilado grande donde se han contado hasta 31 cóndores.\nEn 2009, el Ministerio del Ambiente de Ecuador y el Grupo Nacional de Trabajo del Cóndor\nAndino (GNTCA) publicaron la Estrategia de Conservación del Cóndor Andino. Hasta el 2017,\nesta estrategia ha estado guiando las acciones de conservación en Ecuador.\nActualmente, se ha completado un Plan de Acción para la Conservación del Cóndor Andino\n(Ministerio del Ambiente y The Peregrine Fund 2018).\nviii. Colombia\nEn Colombia se estima la presencia de 130 individuos de cóndores incluyendo ejemplares\nreintroducidos (Renjifo et al. 2006).\nLa escasa información disponible sobre el estado de las poblaciones de la especie sugiere que\nla mayor parte de los individuos se concentra en la cordillera Oriental y en la zona norte entre\nla serranía del Perijá y la Sierra Nevada de Santa Marta.\nLos trabajos más recientes, realizados en distintas regiones del país, muestran que se han\nregistrado una población aproximada de 16 individuos en el departamento de Boyacá\n(Fundación Biodiversa & Fundetrópico 2015). Para el páramo del Almorzadero, en el\ndepartamento de Santander, la población estimada es de entre 13 y 20 individuos, en censos\nrealizados entre el año 2014 y 2016, con una proporción de sexos ligeramente a favor de las\nhembras adultas (0,75:1) y una proporción de individuos inmaduros y adultos algo superior\npara estos últimos (0,9:1) (Fundación Neotropical 2017). En el Parque Nacional Natural Los\nNevados se registraron 9 individuos, con 6 machos y 3 hembras (CORPOCALDAS & FUMSOL\n2008).\nHistóricamente, el cóndor andino se distribuía a lo largo de toda la región andina colombiana,\nprincipalmente en las cordilleras Central y Oriental (Olivares 1963, Rodríguez et al. 2006)\ndonde se han documentado 20 localidades, que incluye la única observación realizada en el\nmunicipio de Tumaco, cerca de la costa Pacífica colombiana (Tovar 1995).\nSin embargo, en la década de los 80, las poblaciones de cóndores se redujeron\nsignificativamente y se restringieron a 2 localidades completamente separadas, la Sierra\nNevada de Santa Marta, en el norte, y Nariño en el sur, en la frontera con Ecuador (Rodríguez\net al. 2006).\nLos páramos del suroriente antioqueño, en el extremo norte de la cordillera Central\ncolombiana, se identificaron como un área donde el cóndor andino ya no existe, a pesar de\nlos registros históricos que datan de la década de 1930 (Tovar 1985) y de un intento fallido\npor establecer un núcleo de reintroducción de la especie en la zona (Arango-Caro et al. 2016).\n29\nActualmente, las poblaciones de cóndor andino en Colombia se encuentran muy reducidas en\nnúmero y restringidas a unas pocas localidades montañosas aisladas. Estos lugares\ncorresponden a regiones parcial o totalmente deshabitadas donde se han conservado en\nestado silvestre y a los cinco núcleos de repoblación ya consolidados y el núcleo propuesto\npara Siscunsí en Boyacá (Barrera & Ramírez 2003). Una aproximación a la distribución actual\nde ejemplares a lo largo de los Andes colombianos se puede observar en la Figura 15 aunque\nla información requiere de verificación y actualización en campo.\nFigura 15. Distribución del Cóndor Andino en Colombia.\nLa mayor parte de las ganaderías establecidas en los Andes se han localizado en sectores muy\nescarpados, donde las posibilidades para agricultura son mínimas, las cuales coinciden en el\nhábitat natural del cóndor andino. Esto resulta en una relación muy directa del ganadero con\nlos cóndores, los cuales son considerados erróneamente como una amenaza. En razón a esta\ncreencia, el ganadero utiliza diversos métodos para exterminar los cóndores que se acerquen\nen busca de alimento (Barrera & Feliciano 1994).\nTradicionalmente, se han atribuido propiedades curativas a algunas partes corporales del\ncóndor andino, razón por la cual se le persiguió en algunas regiones. Algunas comunidades\ndel sur de Colombia creen que sus huesos molidos curan el reumatismo y la parálisis, el interior\nde su estómago para el cáncer, el corazón reducido a polvo para curar la epilepsia y los\ndefectos cardiacos (Olivares 1963, McGahan 1973). Otros factores han tenido una incidencia\nmenor pero significativa en la desaparición de la especie: la contaminación de fuentes hídricas,\n30\nla destrucción de su hábitat e incluso la cacería deportiva (Ministerio del Medio Ambiente,\nVivienda y Desarrollo Territorial 2006).\nConsiderando que la tasa reproductiva de la especie es muy baja debido al prolongado cuidado\nparental de los polluelos y a las fluctuaciones en la disponibilidad de alimento en el medio\nnatural, para que su población se mantenga estable se necesitan igualmente tasas de\nmortalidad muy bajas. Cobra relevancia la incidencia humana en la conservación de la especie\nya que cualquier daño, por mínimo que sea, puede ocasionar un efecto negativo e incluso\nirreparable (Ministerio del Medio Ambiente, Vivienda y Desarrollo Territorial 2006).\n1. Estado de conservación\nEl Cóndor de los Andes fue catalogado como una especie EN PELIGRO CRÍTICO (CR) según\nel listado oficial de las especies silvestres amenazadas de la diversidad biológica continental y\nmarina costera colombiana (COLOMBIA Ministerio del Ambiente y Desarrollo Sostenible 2017).\n2. Estrategias de conservación y actores locales\nEn Colombia, destaca la publicación de 2 directrices para la conservación del cóndor. El\nPrograma Nacional para la Conservación del Cóndor Andino se publica el año 2006 y su\nobjetivo es proponer, ajustar, concretar y desarrollar estrategias de manejo interinstitucional\ny participativo del Cóndor Andino en Colombia, mediante la articulación de actores, la\neducación ambiental y la vinculación de las comunidades en el manejo de poblaciones\nnaturales, núcleo de repoblación y ejemplares en cautiverio para promover la investigación,\nla conservación y el aprovechamiento sostenible de la especie y su hábitat. El Programa se\nestablece para un período de 10 años.\nEl Plan de manejo y conservación del Cóndor de Los Andes se publica en 2017 por y para la\njurisdicción de la Corporación Autónoma de Cundinamarca (CAR). Su objetivo es desarrollar\nestrategias para la conservación, protección y manejo sostenible de las poblaciones de Cóndor\nde los Andes y los ecosistemas asociados para enfrentar las diferentes amenazas que son\nidentificadas en su jurisdicción.\nSus objetivos específicos incluyen: generar conocimiento de las poblaciones de Cóndor de Los\nAndes en los ecosistemas donde se distribuye la especie dentro de la jurisdicción, generar\nestrategias participativas para reducir y mitigar las presiones que se ejercen sobre la especie\ndentro de su hábitat, diseñar y desarrollar actividades de educación ambiental que promueven\nla conservación de la especie y el conocimiento de su ecología y su hábitat y generar espacios\nde articulación con las diferentes entidades gubernamentales y no gubernamentales,\nempresas privadas, entidades académicas y de investigación, asociaciones y comunidades\nlocales para realizar acciones que permitan la conservación de la especie.\nCon el objetivo de recuperar las poblaciones de la especie que se encontraban bastante\nreducidas en la década de los 80, en el año 1989 se inició un proceso de reintroducción que\nse extendió hasta el año 2013, en el cual se liberaron 69 ejemplares en 8 núcleos de\nreintroducción distribuidos en las cordilleras Central y Oriental:\n1. Resguardo Indígena Chiles, 2. Parque Nacional Natural Puracé, 3. Parque Nacional Natural\nLos Nevados, 4. Parque Nacional Natural Chingaza, 5. Páramo de San Cayetano, 6. Páramo\nde Siscunsí, 7. Zona Amortiguadora del Parque Nacional Natural El Cocuy y 8. Páramo de\nBelmira (aunque este núcleo no fue exitoso y fue necesario recapturar los cóndores liberados)\n(Rodríguez et al. 2006, Arango-Caro et al. 2016). Adicionalmente, algunas entidades\n31\nambientales de carácter regional han desarrollado procesos de educación ambiental y\nmonitoreo de la especie, como en el caso de CORPOCALDAS, CORPOCHIVOR, CORPOBOYACA\ny CAS.\nRecientemente, se evidenció un fuerte conflicto entre las comunidades campesinas del páramo\ndel norte de la cordillera Oriental y la población de cóndores andinos que habita en esta zona,\ndebido a posibles eventos de depredación de corderos. Con el fin de reducir este conflicto, la\nFundación Neotropical en alianza con el Parque Jaime Duque y el Sistema Nacional de\nAprendizaje (SENA) desarrollaron un proyecto para implementar sistemas de semiestabulación\nde las ovejas, a fin de reducir la probabilidad de su pérdida por la fauna silvestre y de mejorar\nlos niveles de productividad del sistema ganadero. Adicionalmente, en el marco de este\nproyecto se firmaron 12 acuerdos de conservación con la población local para proteger a largo\nplazo la especie y su hábitat (Fundación Neotropical 2018).\nSe identificaron 8 Unidades de Conservación Prioritarias del Cóndor Andino en Colombia\nrepresentando la extensión del país: Sierra Nevada de Santa Marta, Serranía del Perijá,\nPáramos de los Andes Noreste (Santurbán, Almorzadero, Parque Nacional Cocuy), Corredor\ndel Páramo (Guantiva, La Rusia, Iguaque), Parque Nacional Chingaza, Parque Nacional Los\nNevados, Parque Nacional Puracé y Reserva Indígena Chiles, con los páramos al borde de\nEcuador. Expertos identificaron dos unidades de conservación del cóndor andino en Ecuador.\nUno se encuentra en el norte y centro de los Andes, el segundo en el centro de los Andes en\nel área alrededor del Parque Nacional Sangay y el tercero en el sur del país.\nMarca Alejandra Parrado-Vargas. Bióloga Investigadora de The Peregrine Fund y de la\nFundación Neotropical. Fundación Cóndor Andino. Fundación Neotropical. The Peregrine Fund.\nCongreso Internacional de Cóndor Andino. Primer Festival Nacional de Cóndor Andino\n(Santander).https://es.mongabay.com/2022/08/conservacion-del-condor-andino-en-\ncolombia-maria-alejandra-parrado-entrevista/\nFigura 16. Listado expertos Cóndor (Vultur griphus)\n32\nix. Venezuela\n1. Estado de conservación\nEl cóndor andino ha sido clasificado como una especie EN PELIGRO (EN) de extinción en\nVenezuela y se incluye en la lista de animales vedados para la caza (República de Venezuela\n1996). Asimismo, ha sido clasificado como una especie EN PELIGRO CRITICO (CE) de\nextinción según el criterio D de la Lista Roja de la UICN (Sharpe et al. 2015). Fue propuesto\ncomo una especie VULNERABLE (VU) según el criterio B de la Lista Roja de la UICN (Naveda-\nRodríguez 2015).\nLa historia natural de la especie en el territorio venezolano es desconocida. Naveda-Rodríguez\n(2015) estimó que la extensión de la presencia y del área de ocupación del cóndor andino en\nVenezuela es de 16.544 kilómetros cuadrados y de 6.566 kilómetros cuadrados,\nrespectivamente. Estas áreas de distribución geográfica se encuentran en la Cordillera de\nMérida y en la Sierra de Perijá.\nEl estatus del cóndor andino como especie residente en Venezuela ha sido cuestionado por la\ncomunidad de ornitólogos. Aguilar (2000) considera a esta especie como un visitante ocasional\nya que no existen registros biológicos, arqueológicos ni antropológicos de la presencia y de\neventos reproductivos del cóndor en los Andes venezolanos.\nEl tamaño poblacional del cóndor andino en Venezuela sigue siendo desconocido, sin\nestimaciones de población, a pesar de los esfuerzos de reintroducción en la década de los 90.\nSharpe y colaboradores (2015) estimaron un tamaño poblacional menor a 50 individuos\nmaduros; sin embargo, esta estimación no está respaldada con datos cuantitativos obtenidos\na partir de muestreos en campo.\n2. Estrategias de conservación y actores locales\nDurante 1993 y 2001, 13 individuos nacidos en los zoológicos de Argentina y Estados Unidos\nfueron liberados en el páramo de Mifafí, en la Cordillera de Mérida, como parte de un programa\nde reintroducción poblacional, sin el éxito esperado.\nDesde 1992, los zoológicos venezolanos han realizado esfuerzos de reproducción ex situ, con\n12 ejemplares documentados actualmente (ocho machos, cuatro hembras) en cuatro centros.\nEn teoría, las áreas naturales protegidas cumplen su función de resguardar el hábitat del\ncóndor en los Andes venezolanos. Gran parte del área de su distribución geográfica, en la\nCordillera de Mérida y la Sierra de Perijá, se encuentra dentro del sistema de áreas protegidas.\nE specíficamente, el 39 % y el 61 % de la extensión de presencia y del área de ocupación del\ncóndor andino en Venezuela, respectivamente, están dentro de las áreas protegidas\nnacionales del país (Naveda-Rodríguez 2015).\nLa Alianza Estratégica para la Repoblación del Cóndor de Los Andes en Venezuela tiene por\nobjetivo crear en el Estado De Mérida un Centro de atención, reproducción y reintroducción\nde especies rapaces venezolanas como el Cóndor de Los Andes y de esta manera desarrollar\nun programa de investigación y conservación in situ. En la iniciativa participan el Ministerio\ndel Poder Popular para el Ecosocialismo, la Gobernación del Estado de Mérida, Animal\nHackingg, Parque Les Aigles du Leman, ONG Copher, Mundo Zafari Zoo.\nLas áreas prioritarias de conservación del cóndor andino en Venezuela corresponden a la\nSierra de Perijá y centro y sur de la Cordillera de Mérida. Estas áreas están recibiendo más\n33\natención por parte de la comunidad de ornitólogos y de conservacionistas a raíz del\navistamiento de varios individuos en los años 2016 y 2017.\nb. Puma (Puma concolor)\nEl área de distribución geográfica del puma es la más grande de cualquier mamífero terrestre\nen el hemisferio occidental, desde Canadá, pasando por Estados Unidos, América Central y\nAmérica del Sur, hasta el extremo sur de Chile (Sunquist & Sunquist 2002). Es considerado el\nanimal del nuevo mundo de mayor distribución (Miller et al. 1983).\nFigura 17. Ilustración Puma (Puma concolor)\nEl puma es un felino adaptable y se encuentra en todos los principales tipos de hábitat de\nAmérica, incluidos los Andes de altura, hasta los 5.800 metros sobre el nivel del mar en el sur\nde Perú (Sunquist y Sunquist 2002).\nEl puma fue eliminado de toda la mitad oriental de América del Norte en 200 años, después\nde la colonización europea (Nowell & Jackson 1996). En Florida persiste una supoblación\nremanente EN PELIGRO (EN) de extinción.\nEn Sudamérica, se identifican 4 subespecies de puma: Puma concolor capricornensis (Este de\nSudamérica), Puma concolor cabrerae (Sudamércia Central), Puma concolor puma (Sur de\nSudamérica) y Puma concolor concolor (Norte de Sudamérica).\ni. Ecosistemas representados en su distribución\nEsta especie se encuentra en una amplia gama de hábitats, en todo tipo de bosques, así como\nen tierras bajas y desiertos montanos. Varios estudios han demostrado que prefiere un hábitat\ncon vegetación densa de sotobosque. Sin embargo, los pumas pueden vivir en hábitats muy\nabiertos con sólo un mínimo de cubierta vegetal (Nowell & Jackson 1996). Los pumas\ncoexisten con los jaguares en gran parte de su área de distribución en América Latina y pueden\npreferir hábitats más abiertos que su competidor más grande, aunque ambos pueden\nencontrarse en bosques densos (Sunquist y Sunquist 2002).\n34\nFigura 18. Ecorregiones terrestres en la distribución Puma (Puma concolor)\nii. Estado de conservación, estrategias y amenazas globales\nEsta especie está catalogada como PREOCUPACION MENOR (LC) porque es uno de los\nmamíferos más ampliamente distribuidos en el hemisferio occidental. Aunque ha sido\nextirpado de su área de distribución anterior en el medio oeste y el este de América del Norte\n(Nowell & Jackson 1996), está intentando recolonizar esta región (Thompson & Jenks 2010,\nLaRue et al. 2012) y las poblaciones están lo suficientemente sanas para la captura regulada\nen oeste de América del Norte. Sin embargo, se considera que está disminuyendo en otras\nzonas de su área de distribución y, como gran carnívoro estrechamente vinculado a otras\nasociaciones de vida silvestre y hábitat, desde una perspectiva social y política su conservación\ny gestión presenta numerosos desafíos.\nEsta especie está protegida en gran parte de su área de distribución y su caza está prohibida\nen la mayor parte de Argentina y en toda Brasil, Bolivia, Chile, Colombia, Costa Rica, Guayana\nFrancesa, Guatemala, Honduras, Nicaragua, Panamá, Paraguay, Surinam, Venezuela y\nUruguay. Existen regulaciones de caza vigentes en Canadá, México, Perú y Estados Unidos\n(Nowell & Jackson 1996). La especie está incluida en el Apéndice II de la CITES y las\nsubespecies de América Central y Oriental en el Apéndice I.\n35\nLos pumas están amenazados por la pérdida y fragmentación de su hábitat y la caza furtiva\nde sus presas silvestres. Son perseguidos en toda su área de distribución por la caza de\nrepresalia debido a la depredación del ganado, y debido al temor de que supongan una\namenaza para la vida humana (UICN Cats Red List Workshop 2007).\nLos pumas han matado a varias personas en el oeste de Canadá y Estados Unidos en los\núltimos años. Los pumas se cazan legalmente en muchos estados del oeste de EE.UU., aunque\nsu caza se prohibió por referéndum popular en California en el año 1990. Los atropellos son\nla principal causa de mortalidad en la subpoblación en peligro de la pantera de Florida, y las\ncarreteras muy transitadas son una barrera importante para los movimientos y la dispersión\nde los pumas (Sunquist y Sunquist 2002).\nExiste la necesidad de implementar programas para mitigar los conflictos por la depredación\ndel ganado y estudiar el efecto real de la depredación del puma versus el jaguar en el ganado\n(UICN 2007).\niii. Chile\nEl Puma vive en todo Chile continental, en una gran diversidad de ambientes, excluyendo la\nIsla de Chiloé, el Archipiélago de los Chonos y las Guaitecas y el territorio ubicado al sur del\nEstrecho de Magallanes.\n1. Estado de conservación\nLa especie fue calificada como VULNERABLE (VU) en toda su distribución según el Libro Rojo\nde los Vertebrados Terrestres (Glade et al. 1988). Posteriormente, fue calificada como EN\nPELIGRO (EN) por el Reglamento de la Ley de Caza (Ministerio de Agricultura 1998). Aplica\ndesde la Región de Arica y Parinacota hasta la Región del Maule.\nEn el marco del séptimo proceso de Clasificación de Especies, la especie fue incluida en la\ncategoría CASI AMENAZADA (NT)(CHILE Ministerio del Medio Ambiente 2011). La justificación\nseñala que la especie NO cumple con los umbrales de ninguno de los criterios para ser\nclasificada en alguna de las categorías de amenaza de UICN 3.1 (Extinta, Extinta en la\nNaturaleza, En Peligro Crítico, En Peligro o Vulnerable). Se considera que, al seguir operando\nlas amenazas actuales, Puma concolor está próxima a satisfacer los criterios, o posiblemente\nlos satisfaga, en el futuro.\nSus amenazas incluyen la pérdida y degradación de hábitat por causas antrópicas y la caza o\ncaptura de individuos. Es considerado un animal perjudicial para la ganadería, por lo que es\nacosado y cazado furtivamente (Schlatter et al. 1987).\nZunino (1990) indica que, de todas las especies de carnívoros presentes en el Parque Nacional\nTorres del Paine, Puma concolor es el más escaso, debido a la gran presión antrópica. Se\nrepliega normalmente en tierras altas e inaccesibles. La reducción severa de los ungulados\npor cacería o la deforestación, unido a la persecución, son las probables causas (Nowell &\nJackson 1996).\n2. Estrategias de conservación y actores locales\nEn Chile, destacan las siguientes acciones implementadas para la conservación de la especie:\n36\n● Plan Nacional Conservación del Puma (2009). Tiene por objetivo integrar los esfuerzos\nde los organismos públicos, la academia, el sector privado y la sociedad civil, para la\nprotección de la especie. Participan las siguientes instituciones: Servicio Agrícola y\nGanadero (Ministerio de Agricultura), Corporación Nacional Forestal (Ministerio de\nAgricultura), Comisión Nacional del Medio Ambiente (Secretaría General de la\nPresidencia).\n● Programa Nacional de Conservación y Manejo de carnívoros silvestres y desarrollo\nagropecuario sustentable. En base a lo planteado en el Plan Nacional de Conservación\nde puma, y de objetivos que son extrapolables a otros carnívoros, se plantean\nactividades especificas para avanzar en el cumplimiento de los objetivos de disminuir\nel conflicto entre conservación de las especies y la depredación de ganado doméstico.\n● Restauración de hábitat Parque Nacional Patagonia. Creación de un área protegida de\ngran extensión y estado biológico degradado por impacto de la ganadería, acción que\nha resultado en la restauración de la ecorregión de la estepa patagónica y poblaciones\nde guanaco.\n● Monitoreo en Parque Nacional Torres del Paine. Tiene por objetivo determinar el\nimpacto que tiene el puma como predador sobre poblaciones de herbívoros nativos y\ndomésticos en el escenario de transición de una estancia ganadera hacia un área\nprotegida. Instituciones: Fundación Rewilding Chile, NatGeo, Universidad de California\nDavis.\n● Investigación Pumas Parque Nacional Torres del Paine. Tiene como objetivo conocer\nla rutina alimenticia y comportamiento del puma que se desplaza en el territorio de la\nReserva de la Biósfera de Torres del Paine, específicamente en el sector del Cerro\nGuido, estancias aledañas y Parque Nacional Torres del Paine.\niv. Argentina\nEl Puma es una especie generalista que habita gran parte del territorio argentino, incluyendo\nzonas altamente modificadas por acciones antrópicas.\nEn Argentina, se documenta su presencia en las ecorregiones terrestres: Bosque Atlántico del\nalto Paraná, Bosques húmedos de Araucaria, Yungas andinas del sur, Bosques subantárticos,\nBosques templados valdivianos, Chaco seco, Chaco húmedo, Espinal, Pampas húmedas,\nMonte de llanuras, Estepa patagónica, Sabana inundada del Paraná, Sabanas mesopotámicas\ndel cono sur, Puna seca andina central, Puna andina central, Monte de altura y Estepa andina\ndel sur (Ministerio del Medio Ambiente y Desarrollo Sostenible 2019).\nHistóricamente, el puma estuvo presente en casi todo el territorio argentino, con excepción\nde Tierra del Fuego y otras islas del Atlántico sur (Cabrera 1961). En el siglo pasado, con el\navance de las actividades agropecuarias, fue extirpado de la mayor parte de la Patagonia\n(Novaro & Walker 2005), de grandes extensiones de la región pampeana (Parera 2002, DE\nLucca 2010, 2011) y buena parte de las Provincias de Entre Ríos y Corrientes. Sin embargo,\nla especie mantuvo una amplia distribución a nivel nacional y en las últimas décadas ha vuelto\na ocupar la mayor parte de su rango histórico.\nLas mayores amenazas corresponden a la pérdida de hábitat y caza directa ilegal. También\nse documentan como amenazas el atropellamiento en rutas, la reducción del número de\npresas, la captura de ejemplares, incendios, degradación de hábitat, impactos por turismo y\ndepredación de perros (Ministerio del Medio Ambiente y Desarrollo Sostenible 2019).\nLocalmente, el puma puede estar sufriendo retracciones puntuales en algunas regiones\n37\nproducto de la persecución directa y la expansión de la frontera agropecuaria (Aprile et al.\n2012).\n1. Estado de conservación\nDebido a su amplia distribución y que sus poblaciones son continuas con las de países vecinos,\nel estado del puma se ha considerado en la categoría de PREOCUPACIÓN MENOR (LC)\n(ARGENTINA Ministerio del Medio Ambiente y Desarrollo Sostenible 2019).\n2. Estrategias de conservación y actores locales\nA la fecha, no existe un Plan Nacional. No obstante, en 2010 se delinearon algunas pautas\npara promover dicho plan, a partir del Taller Nacional sobre el Puma realizado en Mendoza\njunto a la Red de Acción contra el tráfico de especies silvestres (Chabez & Nigro 2010).\nSu protección y manejo es regulada por cada provincia de acuerdo a sus legislaciones y su\nadhesión a la Ley Nacional de Fauna. Su caza está prohibida en Mendoza, Córdoba, Misiones,\nLa Pampa. La caza control por recompensas está reglamentada en Chubut y Río Negro.\nTambién se habilita su caza control en la Provincias de Santa Cruz y del Neuquén (Ministerio\ndel Medio Ambiente 2019).\nEn las Provincias de Neuquén y Mendoza, existen experiencias de manejo con metodologías\nno letales como perros protectores de ganado, corrales anti-predadores y disuasivos lumínicos\n(Novaro et al. 2019). En algunas localidades de las Yungas en las Provincias de Jujuy y Salta,\nse trabaja con productores locales para adaptar prácticas ganaderas tendientes a minimizar\nel conflicto con carnívoros, incluyendo la creación y mejoramiento de corrales y el uso de\ndisuasivos. En Buenos Aires, algunos productores han comenzado a usar perros protectores\nde ganado para reducir y evitar los ataques del Puma. En la Provincia de Misiones, la Ley de\nConservación de Grandes Felinos prevé la elaboración de una Comisión de Aanejo y acciones\nque involucran al Puma.\nEn Neuquén, se llevan a cabo diferentes estrategias vinculadas a minimizar la pérdida por\ndepredación en ganadería menor. Para algunos casos, se autoriza la caza del ejemplar y para\notros, se recomienda e incentivan los métodos no letales (Monteverde, no publicado).\nEn Mendoza, también se promueven métodos no letales (Bolgeri, no publicado). En Chubut,\ndesde el año 2005 el Puma es declarado especie perjudicial para la ganadería y se habilitó\nhasta el año 2009 la caza control, sin restricciones de número, edad o sexo. En las Provincias\nde Santa Cruz y Río Negro, el Puma también se considera perjudicial para la ganadería y se\nhabilita la caza control con recompensas económicas, según las disposiciones y normativas\nanuales.\nEn el Parque Nacional Monte León se eliminaron 4 individuos, en el año 2009, con el objetivo\nde disminuir su presencia en la zona de uso público y minimizar el impacto sobre la colonia\nde Pingüino de Magallanes. La medida no fue exitosa (Llanos, no publicado).\nEn la Provincia de Corrientes, en el año 2013, el gobierno provincial recibió un macho adulto\ncapturado en Bellavista, el cual fue traslocado a la Estancia Iberá y monitoreado mediante\ncollar satelital. La medida no fue exitosa (Solís, no publicado).\nSe enfatiza su importante rol ecológico como depredador tope y se sostiene la recomendación\nde monitorear algunas de sus subpoblaciones que se perciban bajo amenaza, ya que pueden\nestar en riego por la persecución directa de la especie o la modificación del hábitat y llegar a\n38\ndesaparecer como ha ocurrido en muchas regiones durante el siglo XX (Ministerio del Medio\nAmbiente y Desarrollo Sostenible 2019).\nEl documento Aportes preliminares para un Plan de Conservación y Manejo del Puma en la\nRepública Argentina (Chebez y Nigro 2008) entrega antecedentes, medidas de conservación\nimplementadas y medidas faltantes por implementar con relación a la especie. Sus autores\npertenecen a la Fundación AZARA de Historia Natural y Red Yaguareté\n(www.redyaguarete.com.ar).\nFigura 19. Distribución Puma en Argentina (Chebez y Nigro 2009).\nÁreas protegidas.\nEn Argentina, el Puma se encuentra al amparo de los Parques Nacionales Iguazú, Río\nPilcomayo, Chaco, Baritú, Calilegua, El Rey, El Leoncito, Sierra de las Quijadas, Lihué Calel,\nLanín, Nahuel Huapi, Lago Puelo, Los Alerces, Perito Moreno y Los Glaciares, el Monumento\nNatural Bosque Petrificado, la Reserva Natural Estricta San Antonio, la Reserva Natural\nFormosa (Heinonen Fortabat & Chebez, 1997). Chebez (2009) agrega además las Reservas\nNacionales El Nogalar y General Pizarro y los Parques Nacionales Mburucuyá, Copo, Los\nCardones, Campo de los Alisos, San Guillermo, Quebrada del Condorito, Talampaya y Monte\nLeón, amén de numerosas reservas provinciales y privadas que lo contienen aunque sea\nparcialmente. Si bien hay buena información sobre ausencia y presencia de la especie en las\náreas protegidas, no existen censos o estudios sobre su comportamiento, por ejemplo,\ndeterminando si son ejemplares transeúntes o sedentarios y si las poblaciones son viables.\nZoológicos y centros de cría en cautiverio.\nEsta presente prácticamente en todas las colecciones zoológicas, no porque sea una especie\nparticularmente buscada, sino por rebotes del problema de mascotismo que se trató más\narriba y algunas veces de animales problema. Los animales son mantenidos mayormente con\nfines de exhibición y las poblaciones cautivas no son parte de ningún programa de recría, ni\nde conservación ex situ, que permita manejar stocks poblacionales por separado.\nActualmente, se crían indiscriminadamente, mezclando sangres, orígenes y eventuales\nsubespecies. Como todo gran carnívoro, la conservación ex situ no es una medida priorizada\n39\nni recomendable pero su presencia habitual y numerosa en los zoológicos es una realidad. Los\nzoológicos deberían ir desprendiéndose de aquellos animales de sangre “mezclada” o de\nprocedencia desconocida o dudosa y comenzar a priorizar la presencia (y eventual cría) de los\nde origen conocido. Es importante recordar que los pumas que permanecen en cautiverio, son\nfácilmente imprimidos, es decir, se acostumbran al hombre y a las rutinas, lo que los\ntransforma en un potencial peligro ante una liberación. Tenemos entendido que actualmente\nen el Zoológico de Buenos Aires se estaría confeccionando un Stud Book de la especie.\nMedidas propuestas o faltantes.\nDesarrollar una Estrategia Nacional de Conservación y Manejo del Puma, evaluar el conflicto\nganadero y caza control, realizar capacitación de personal para distinguir si la predación se\natribuye a la especie, análisis de la caza deportiva, conocer su situación en áreas protegidas,\ndifusión peligrosidad para las personas, atropellamientos, elaborar campañas educativas para\nevitar el mascotismo, aprobar por Ley a nivel nacional el Programa Nacional de Conservación\ny Manejo, profundizar estudios taxonómicos, evaluar fuentes de financiamiento y desarrollar\ncampañas de educación, difusión y comunicaciones en general sobre la especie.\nProyecto Puma de las Pampas.\nEl Proyecto Puma de las Pampas comenzó́ a trabajar a la luz la recolonización de esta especie\nextirpada en la ecorregión pampeana, documentándola y dándola a conocer. La dinámica del\nproceso hace que sea cada más frecuente la aparición de ejemplares en entornos urbanos y\nganaderos y los posibles conflictos se multiplican. El proyecto tiene por objetivo aportar\nconocimiento, herramientas y acciones para lograr la convivencia del puma con las personas\nen la ecorregión pampeana.\nLos objetivos específicos del proyecto Puma de las Pampas incluyen: actualizar la distribución\ndel puma en la ecorregión pampeana, identificar subpoblaciones y potenciales corredores de\ndispersión, examinar amenazas para la especie, conocer percepciones de productores y\ncazadores, evaluar el grado de conflicto puma - hombre, monitorear poblaciones consideradas\nfuente (Sistema de Ventania, Buenos Aires y Lagunas del sur y Bañados de Saladillo, Córdoba),\nconcientizar a la población rural, búsqueda conjunta de intervenciones que disminuyan\nincidentes, establecer protocolo para atender incidentes de depredación y colaborar en el\ncombate de la caza furtiva. Director del Proyecto: Eduardo De Lucca. Instituciones\nresponsables: AZARA Fundación de Historia Natural, Predadores de Argentina. Centro para el\nestudio y manejo de los predadores de la Argentina.\n40\nFigura 20. Poster difusión conservación del Puma de las Pampas\nAUTORES Y COLABORADORES PUMA ARGENTINA\n41\n42\n43\n44\nv. Bolivia\nLa especie está ampliamente distribuida en la mayor parte de Bolivia y llega a ser común en\nel área por debajo de los 2.000 metros de altura, particularmente en el bosque húmedo\ntropical (Lobao-Tello 1986). En Bolivia se encuentra en todo tipo de hábitats en áreas con\npoca influencia humana y ocasionalmente en áreas suburbanas (Pacheco y Salazar 1996).\nLa presencia del puma en el altiplano boliviano parece estar ligada a áreas cercanas a\ncordilleras y serranías e incluso en estas zonas no es común (Gallardo et al. 2009). El puma\nha sido registrado en bosques siempreverdes de llanura, bosques submontanos de transición\no siempreverdes, bosques ribereños, sabanas inundadas, llanuras inundadas y bosques de la\nvertiente oriental de los Andes hasta los 3.000 metros. La especie se ha reportado en las áreas\nprotegidas: Estación Biológica Beni, El Dorado, Amboró, Noel Kempff Mercado, Manuripi\nHeath, Ríos Blanco y Negro, Madidi, Pilón Laja y Tairiquía. Los pobladores de la Reserva\nEduardo Avaroa indican que el puma habitaba dicha región en el pasado y que desapareció\ncuando disminuyeron las vicuñas (Salazar no publicado).\nFigura 21. Mapa Distribución Puma en Bolivia (Pacheco y Salazar 1996)\n1. Estado de conservación\nTarifa (1995) considera esta especie dentro de la categoría DATOS INSUFICIENTES (DD)\n(Pacheco y Salazar 1996). Los félidos que habitan Bolivia parecen no en peligro de extinción\n(Lobao-Tello 1986, Tarifa 1995). Lobao-Tello (1986) indica que los pumas no son cazados\ncomercialmente, sino ocasionalmente por rancheros, cazadores deportivos y trabajadores de\naserraderos, especialmente cuando se los encuentra cerca de las propiedades ganaderas. El\npuma no está seriamente amenazado por la cacería oportunista, ni debido a la alteración del\nhábitat, sino más bien por la disminución de algunas de sus presas favoritas tales como Rhea\namericana (Lobao-Tello 1986).\nSin embargo, Iriarte y colaboradores (1990) indican que en Sudamérica las aves no forman\nun ítem apreciable en la dieta de este félido y que los pumas predan preferentemente sobre\nmamíferos de mediano tamaño como: capibaras (Perú y Brasil), armadillos (Paraguay y Brasil),\npudú (Chile) y liebres europeas introducidas (sur de Chile). Posiblemente, el factor más\nimportante que amenaza este félido sea la presencia humana.\n45\n2. Estrategias de conservación y actores locales\nEn la publicación Bases para la conservación de félidos en Bolivia (Pacheco & Salazar 1996)\nse señala que, aún considerando que las áreas protegidas en Bolivia cumplieran con su\nobjetivo de protección de la vida silvestre, se estima que solamente 3 son lo suficientemente\ngrandes como para albergar poblaciones viables de las dos especies de félidos más grandes\nde Bolivia (Puma concolor y Panthera onca).\nEl hecho de que las áreas protegidas sean en general muy pequeñas para asegurar la\nconservación de félidos de gran tamaño es un problema común con otros países, por ejemplo,\nen países amazónicos (Redford & Robinson 1991) y en Chile (Mella & Simonetti 1994). Sin\nembargo, ninguna de las especies de félidos de Bolivia está restringida a las áreas protegidas.\nEsto es importante, ya que se considera que la conservación fuera de las áreas protegidas\npuede ser la única alternativa para evitar la extinción de algunas especies.\nAdicionalmente, señala que para asegurar la conservación de félidos en Bolivia es necesario\nponer en marcha programas de conservación y manejo que consideren áreas, públicas o\nprivadas, fuera de las áreas de protección de vida silvestre. Estos programas deben considerar\nla diversidad de condiciones de uso de la tierra en que tendrán que aplicar.\nLas áreas dedicadas a Bosques Permanentes de Producción son especialmente interesantes,\npor su gran tamaño y grado de perturbación antrópica aceptable. Otras áreas de interés son\nlas grandes propiedades, particularmente aquellas dedicadas a la ganadería. Es importante\nnotar que algunas estancias ganaderas son también Refugios de Vida Silvestre (El Dorado,\nEspíritu).\nUna de las conclusiones de este trabajo es que se necesita con urgencia obtener información\nbásica sobre félidos silvestres. Tres especies pueden señalarse como claves por su situación\ny características: el puma, el jaguar y el gato andino.\n● En relación al puma y el jaguar, para estimar la viabilidad de poblaciones son\nnecesarios estudios de abundancia y ámbito de hogar en diferentes hábitats nos\nindicarían con mayor precisión sus requerimientos. Estudios sobre sus movimientos\naportarían al diseño de manejo del hábitat, que ayude a los individuos a moverse en\nun hábitat que poco a poco irá fragmentándose. Estudios de sus hábitos alimenticios\nnos indicarían la importancia real de los animales domésticos en la dieta de estos\nfélidos, punto de especial importancia para la discusión de su conservación en áreas\nprivadas.\n● El gato andino es una especie en general rara y de distribución restringida en Bolivia\ny también en Chile (Glade et al. 1988). Debido a lo ya fragmentario de sus poblaciones,\nestudios sobre depresión de la viabilidad génica por endocruza pueden ser altamente\nbeneficiosos para evaluar la necesidad de iniciar programas de manejo activo en el\ncorto plazo. Estudios sobre abundancia, ámbito de hogar, movimientos y patrones\nalimenticios son de gran importancia para dar base científica a los esfuerzos de\nconservación de este félido.\nGallardo y colaboradores (2009) señalan que la depredación de animales domésticos por el\npuma en el Parque Nacional Sajama (PNS) genera un fuerte conflicto entre los intereses\neconómicos de las comunidades locales y la conservación de esta especie. El objetivo de este\ntrabajo es proporcionar información sobre el estado de la población del puma dentro de PNS\ny presentar las posibles opciones para atenuar el conflicto. El análisis de siete microsatélites\ndel ADN extraídos de muestras fecales de puma, permitió identificar cinco individuos y según\n46\nlas estimaciones de densidad la población máxima esperada para el Parque Nacional Sajama\nes de 10 pumas adultos. Los pumas del Parque Nacional Sajama mostraron una alta diversidad\ngenética (H=0.94) y un flujo relativamente alto de genes, en comparación con otras\npoblaciones del puma.\nPor estas razones, la caza de pumas dentro del Parque Nacional Sajama no debe ser\nconsiderada como una solución para el conflicto. Se sugieren las siguientes alternativas: 1)\nmejorar varios aspectos de las prácticas del manejo del ganado, 2) probar el uso de prácticas\nde condicionantes de aversión al sabor, 3) explorar mercados especiales para carne y fibra de\nanimales domés- ticos del SNP (amigables con los depredadores), 4) eco-turismo selectivo, 5)\nremuneración económica por medio de proyectos ligados explícitamente a la conservación. Si\nno se toman acciones rápidas para resolver el conflicto, los ganaderos del PNS tomarán sus\npropias acciones que probablemente afectarán negativamente a la población del puma.\nvi. Perú\nEl bosque seco norperuano se compone de distintos tipos de ecosistemas, como son los\necosistemas de bosque estacionalmente seco de llanura (BS tipo sabana y BS de piedemonte)\ny los ecosistemas de bosque estacionalmente seco de colina y montaña (BS de lomada, BS de\ncolina baja, BS de colina alta, BS de montaña y Bosque Subhúmedo de montaña (Ministerio\ndel ambiente [MINAM], 2019).\nDe acuerdo con SERFOR, Puma concolor se distribuye, principalmente, en el bosque seco de\ncolina, BS de llanura y el BS montano. Es en estos ecosistemas en que la especie tiende a\nmovilizarse, al igual que las especies que son parte de su dieta, como el venado de cola blanca\n(Odocolieus virginianus), el zorro costeño (Lycalopex sechurae) y del lagarto (Callopistes\nflavipunctatus). Superponiendo las actividades antropogénicas mencionadas anteriormente\npara el bosque seco y los ecosistemas que lo conforman y que son hábitat de la especie de\nestudio, es posible entender que el hábitat de Puma concolor se encuentra en proceso de\nfragmentación (Mendoza 2023) (Figura 22).\nA nivel de ecosistemas peruanos, la especie habita en los pastizales, montes ribereños, zonas\ncosteras, páramos, lomas, selva baja, ceja de selva, zonas agrícolas, sabana húmeda tropical,\nambientes semidesérticos con cactáceas columnares, bosques (seco, lluviosos montanos,\ntropical del pacífico) y en áreas próximas a los asentamientos humanos (Jiménez et al. 2010,\nGrimwood 1969, Romo 1995, Zeballos et al. 2000). En cuanto a gradiente altitudinal, ha sido\nposible su avistamiento hasta los 5.800 metros sobre el nivel del mar (Redford & Eisenberg\n1992).\nA escala de Lambayeque, Puma concolor habita en los distritos de Oyotún, Chongoyape,\nIncahuasi, Cañaris, Pitipo, Olmos, Motupe, Salas y Chóchope. El bosque seco de colina es el\necosistema más recurrente en que vive, seguido del bosque seco de llanura y el bosque\nmontano. Asimismo, Puma concolor comparte ecosistemas y distritos con sus presas.\n47\nFigura 22. Distribución del puma andino en el Perú (Mendoza 2023)\n1. Estado de conservación\nA escala nacional, su estado de conservación en CASI AMENAZADO (NT) (MINAGRI 2014). No\nobstante, a escala local, en las áreas protegidas de Lambayeque fue calificado CASI\nAMENAZADO (SERNANP 2015) y EN PELIGRO (EN) de extinción (Farro y Santa Cruz 2018) en\nRefugio de Vida Silvestre Laquipampa, EN PELIGRO (EN) de extinción (SERNANP 2010) en el\nSantuario Histórico Bosque de Pómac, AMENAZADO en Bosque Moyano – Palacio (MINAM\n2011) y AMENAZADO en Bosque Huacrupe – La Calera (MINAM 2011) (Mendoza 2023).\n2. Estrategias de conservación y actores locales\nEn el departamento de Lambayeque hay siete ANP y solo una de ellas se ubica en Olmos. Esta\nes el ACR Bosque Huacrupe-La Calera, cuya extensión es de 7.272,27 hectáreas (MINAM\n2011). Su objetivo es conservar una muestra representativa del bosque seco de sabana o\nllanura en la región, asegurando el uso sostenible de la flora y fauna por parte de la población.\nOtro objetivo de la ACR es conservar el hábitat y las poblaciones de las siguientes especies:\ncóndor andino (Vultur gryphus), puma andino (Puma concolor), murciélagos (Eptesicus\ninnoxius), boa peruana (Boa constrictor ortonii) y sancarranca (Bothrops barnetti) (Mendoza\n2023).\nMendoza (2023) realiza una propuesta de conservación diseñando un corredor ecológico para\nel puma andino (Puma concolor). Posterior a la superposición de elementos antropogénicos,\nse identificaron las áreas de Olmos que reciben menor impacto humano y los parches boscosos\nmenos fragmentados y que aún cumplen con la función de ser hábitat para Puma concolor.\nEs relevante no solo identificar los parches a conectar, sino también zonas óptimas que\npermitan el tránsito de la especie, las cuales deben representar bajos niveles de peligro\noriginados por la presencia de actividades y elementos humanos. De igual manera, es\nimportante que estas zonas óptimas presenten características naturales que son parte de la\necología de la especie.\nUno de los parches se localiza en el límite norte del área de estudio, ya que la superposición\nde capas muestra escasa presencia humana ahí en contraste con otras zonas. El segundo\n48\nparche corresponde al ACR Bosque Huacrupe – La Calera, también ubicado en la zona norte.\nAmbos parches están en área premontana. El producto final es un mapa del modelamiento\n(Figura 23) que corresponde al enlace de fragmentos seleccionados por medio de diez bandas\nde conexión. Estas poseen distintas anchuras representadas por porcentajes, siendo las más\ndelgadas o las más cercanas a 0% las que mayor idoneidad ecológica presentan para la\nespecie. Igualmente se incluye la ruta de mínimo coste y los puntos críticos que se generan\npor la intersección de las vías con el corredor. Se determinó proponer un corredor en una\nzona específica tras identificar la perturbación humana a escala del distrito, pues hay zonas\nmás fragmentadas y aisladas que otras. Es importante mantener la conectividad entre la ACR\ncon otros parches, pues parte de la economía en esta área es la agricultura, conllevando a la\nfragmentación en una zona con límites predefinidos. Esto reduce el área de dispersión de las\nespecies en su interior y es necesario que tengan un territorio más amplio que mantenga sus\nrequerimientos ecológicos.\nFigura 23. Propuesta de corredor andino para Puma concolor (Mendoza 2023)\nvii. Ecuador\nEn Ecuador presenta una extensa área de ocupación, habitando en todas las regiones\nbiogeográficas del país, excepto en las Islas Galápagos (Tirira 1999). Hay evidencias de su\npresencia desde el nivel del mar hasta los 4.500 metros de altitud, siendo posible encontrarla\nen prácticamente todas las reservas estatales que existen dentro del Ecuador continental\n(Tirira 2011).\n1. Estado de conservación\n49\nNo existen datos sobre la situación actual del puma en el Ecuador. A pesar de esto, no queda\nduda que es una especie que sufre de una intensa y permanente presión externa,\nprincipalmente ocasionada por la drástica reducción de la cobertura vegetal original.\nSe estima que las poblaciones más saludables están presentes en la baja Amazonía y en las\nestribaciones orientales de los Andes, pues en estas zonas todavía existen importantes\nextensiones de bosques naturales y grandes reservas estatales. Aquellas que habitan en las\nzonas templadas, altoandinas y al occidente de los Andes, deben encontrarse seriamente\namenazadas, e incluso varias de ellas extintas, como ha ocurrido en buena parte de los valles\ninterandinos y en los bosques secos suroccidentales.\nEl puma ha sido calificado como VULNERABLE (VU) en el Libro Rojo de Mamíferos del Ecuador\n(Tirira 2011), pues se estima que no deben existir más de 10.000 individuos adultos y que\nsus poblaciones se han reducido en por lo menos un 10% en las últimas tres generaciones, a\nconsecuencia de la pérdida de su hábitat y a la presión por cacería (Tirira 2011).\n2. Estrategias de conservación y actores locales\nEl libro rojo de los mamíferos de Ecuador (Tirira 2011) señala que las medidas de conservación\npropuestas para la especie, compartidas con el jaguar, son las siguientes:\n● Realizar investigaciones que contribuyan al conocimiento científico del puma, en\nparticular, desarrollar estudios sobre su densidad y dinámica poblacional, así como\nllevar a cabo una evaluación de la efectividad de las áreas protegidas donde habita\ncomo mecanismo de conservación de la especie.\n● Determinar cuál es la superficie mínima para que existan poblaciones viables y\nestablecer si las áreas protegidas existentes cumplen con estos requisitos, caso\ncontrario será necesario ampliarlas o proponer otras nuevas. De igual manera, es\nnecesario establecer su sensibilidad a la deforestación y a la presencia humana, así\ncomo su nivel de afectación y sustentabilidad frente a la cacería furtiva y por parte de\nlas comunidades indígenas, de preferencia dentro de áreas protegidas.\n● Desarrollar campañas nacionales de educación ambiental y conservación en contra del\ntráfico ilegal y comercialización de pieles, colmillos o garras de jaguares, con énfasis\nen los pobladores de las zonas donde habita esta especie, en particular en aquellas en\nestado crítico, de influencia directa de cazadores o cerca de alguna de las áreas\nprotegidas del país.\n● También se considera importante emprender proyectos para la reproducción y crianza\nen cautiverio, dentro de los cuales deberán tomarse en cuenta todos los\nrequerimientos de alimentación, salud, higiene y espacio físico.\n●\nEn marzo de 2021 un puma capturado en una propiedad privada fue trasladada por la Unidad\nde Vida Silvestre del Ministerio del Medio Ambiente y Agua, médicos veterinarios de la\nUniversidad de San Francisco de Quito, miembros del Bosque Protector La Perla y personal de\nla Unidad de Protección del Medio Ambiental de la Policía Nacional al Zoológico Isla Del Tapir,\ndonde se realizó el respectivo análisis clínico, el aislamiento y monitoreo temporal para\ndeterminar su reinserción. Se estableció que la liberación era viable por lo que se instaló un\nsistema de monitoreo satelital en colaboración con la Fundación Oso Andino. Se determinó\nque el área protegida Parque Nacional Cotacachi Cayapas fue seleccionado por presentar\ncaracterísticas geográficas y ecológicas idóneas. La hembra fue trasladada vía aérea, con el\napoyo de las Fuerzas Armadas, para su liberación.\n50\nviii. Colombia\nEn todo Colombia únicamente se encontraría distribuido el Puma concolor concolor (Jorgenson\net al. 2006; Shaw et al. 2007). Esta especie puede encontrarse desde los 0 hasta los 4.800\nmetros sobre el nivel del mar, en una gran variedad de hábitats, incluyendo bosque húmedo,\nbosque seco, sabanas, humedales, llanos y desiertos, paramos, bosques andinos, alto andinos\no montanos. Algunos estudios han demostrado que esta especie prefiere hábitats con buena\ncobertura vegetal, no obstante, se ha registrado que pueden vivir en hábitats fragmentados\ncon poca cobertura boscosa (Nowell & Jackson 1996, Emmons 1999, Jorgenson et al. 2006).\n1. Estado de conservación\nEl Puma ha sido catalogado como CASI AMENAZADO (NT) según la categoría nacional\ncolombiana. A pesar de su plasticidad para adaptarse a ambientes transformados, está hoy\nausente del 40% de su distribución histórica y es el protagonista de los conflictos con\nganadería en gran parte de su territorio (Botero, Bohórquez et al. 2018).\nLos felinos en Colombia han sufrido, en general, procesos de disminución del tamaño de sus\npoblaciones, y algunos, en particular, de extinción local debido a la persecución directa e\nindirecta por parte de los trabajadores de las fincas. Los cambios en las economías locales, la\ndeforestación, la cacería indiscriminada y la transformación de los hábitats para explotaciones\nagropecuarias o ganaderas son algunas de las presiones a las que se tienen que enfrentar las\npoblaciones de pumas.\nEl conflicto con predadores felinos es particularmente desafiante, porque la fragmentación de\nsu ecosistema no sólo lo aísla y reubica espacialmente, sino que también lo obliga a modificar\nsu dieta obligándolo a alimentarse de animales domésticos (perros, gatos, ganado, entre\notros), pues estos se encuentran más accesibles en ambientes más alterados por la acción\nantropogénica (Restrepo-Cardona et al. 2020).\nEn el caso particular colombiano, la principal presión que adolecen felinos como el Puma\nconcolor, es la cacería indiscriminada apoyada bajo la justificación de que los pumas depredan\nganado (Crawshaw & Quigley 2002). Los ganaderos perciben la presencia de grandes felinos\nen sus tierras como una amenaza a sus rebaños y a sus familias (Zimmermann et al. 2005,\nBoulhosa & Azevedo 2014). Esta dinámica predador - presa ocurre dentro de un esquema\nsocioeconómico que hace que su protección sea difícil, dado los perjuicios económicos que\npueden generar (Zimmermann et al. 2005).\nHay estudios que demuestran que son más las pérdidas de bovinos por malos manejos\nsanitarios, inanición y accidentes, que los causados por felinos en las fincas ganaderas. No\nobstante, la tolerancia de los propietarios a los eventos de depredación por parte de los felinos\nsuele ser menor que cuando los bovinos mueren por otras causas (robo, enfermedades o\nlesiones), provocando la ira del ganadero y la eliminación del depredador (grandes\nfelinos)(Hoogesteijn et al. 1993).\n2. Estrategias de conservación y actores locales\nLa conservación de las poblaciones de grandes felinos como el puma (Puma concolor)\ninvolucra una red de actores, procesos, instituciones y otros organismos, que enfrentan\ncotidianamente diferentes retos (dificultad en los monitoreos, difícil acceso a las zonas,\nfinanciación para estudios, pocos registros etc.) para evitar su disminución en el territorio\ncolombiano. Para ello, se han diseñado diferentes planes y estrategias como educación\nambiental, talleres y asesorías técnicas, con los que se busca incentivar la creación de reservas\n51\nde la sociedad civil, restauración, reforestación y creación de corredores biológicos que\nconecten diferentes parches de bosque (Valencia 2020).\nLa ley colombiana en múltiples ocasiones ha buscado preservar, conservar y proteger a los\nanimales silvestres evitando así ́su caza y comercialización de pieles o partes de los animales\ncon fines peleteros. La Ley Nº84 (1989) señala que la caza de animales silvestres, bravíos o\nsalvajes está prohibida en todo el territorio nacional, exceptuando en el caso en que sea de\nsubsistencia y la especie silvestre que se caza no esté prohibida total, parcial, temporal o\ndefinitivamente para evitar la extinción de alguna especie, por la entidad administradora de\nlos recursos naturales. Sin embargo, las poblaciones de pumas, aunque están casi\namenazadas, muchas veces son cazadas por represalia o por las percepciones construidas que\ntienen las comunidades y por los ganaderos sobre los pumas (Botero-Cruz et al. 2016)\nomitiendo la ley, al no tener muchas veces presencia y control estatal, gubernamental y de\nlas autoridades ambientales (Valencia 2020). Solo el 14 % del hábitat potencial de la especie\nen el país está localizado dentro de áreas protegidas. El 86 % está por fuera, lo que hace a\nlos grandes felinos bastante susceptible a la cacería (González 2018).\nArias-Alzate y colaboradores (2011) mencionan las siguientes recomendaciones:\n● Son necesarias más investigaciones a largo plazo sobre esta especie, tanto en aspectos\nde su biología, distribución, ecología, dinámica poblacional, para así ́tener un mejor\nentendimiento sobre su dinámica en los ecosistemas donde habita y así ́poder crear e\nimplementar planes de manejo y conservación más adecuados.\n● Hay que hacer énfasis tanto en diferentes escales locales, regionales, como nacionales,\nque involucren a las poblaciones locales, dueños de las tierras y las diferentes\nentidades, para así ́ generar grupos de trabajo interdisciplinarios, que coadyuven al\nentendimiento e importancia de la conservación del Puma en la zona, ue en su mayor\nmedida se encuentra afectada por el conflicto con el hombre.\n● Es necesaria la realización de estudios detallados sobre la ecología, biología y aspectos\npoblacionales a largo plazo sobre este y otros felinos, como de sus presas potenciales,\npara tener una mejor comprensión sobre el estado de las poblaciones de estas especies\ny así ́consolidar e implementar mejor los esfuerzos de conservación.\n● Es importante la implementación y protección de corredores y áreas de bosque\nubicadas en el área y otras zonas de Antioquia, de gran importancia para los felinos\nsilvestres, ya que les sirve principalmente para desplazarse entre fragmentos para\nencontrar refugio, cazar sus presas potenciales y mantener una conexión y flujo entre\nlas posibles poblaciones presentes en Antioquia y otros departamentos aledaños.\n● Dado que con este estudio se evidencio que el conflicto felino-humanos es una de las\nprincipales amenazas para la conservación de los felinos en Antioquia, se recomienda\nla creación de un programa de capacitación a la comunidad, principalmente dirigida a\nlas poblaciones afectadas por este conflicto, donde en talleres participativos se haga\nénfasis en la importancia ecológica de estas especies, se les muestre todas las\ndiferentes estrategias de manejo del ganado y con ello disminuir la depredación.\n52\n53\nix. Venezuela\nEn Venezuela, el Puma habita en los estados andinos, los llanos y la selva amazónica, donde\nenfrenta diversas amenazas como la pérdida y fragmentación de su hábitat, la caza furtiva, el\nconflicto con los humanos por el ganado y la competencia con otros depredadores como el\ncoyote y el lobo. Esta especie es uno de los siete felinos silvestres registrados para Venezuela\ny el estado Lara (Bisbal 1992, Linares 1998, Madi et al. 2009, Sánchez y Lew 2010, Vázquez\net al. 2011).\nVenezuela ha sido reconocida como uno de los quince países con mayor diversidad zoológica\ndel planeta y, en particular, posee una extraordinaria riqueza de mamíferos, con 388 especies\nregistradas hasta el momento (Madi et al. 2008). Esta cifra representa el 7,07% del total de\nlos mamíferos identificados del planeta y ubicándolo en el cuarto puesto en diversidad del\nNeotrópico y en el octavo en el ámbito mundial para esta clase. Esta elevada riqueza es el\nresultado de dos factores: por un lado la gran heterogeneidad de hábitats óptimos para el\ndesarrollo de estos grupos de vertebrados, originados por las características geográficas,\nclimáticas y orográficas de nuestro territorio, y por el otro la historia evolutiva de los diferentes\nlinajes (MARN 2000, FLSCN 2010, MPPA et al. 2010).\nEl estado Lara contribuye a esa megadiversidad de una forma significativa. Si bien representa\napenas el 2,15% de la superficie del país, la confluencia de cuatro biorregiones con\ncaracterísticas propias han permitido la presencia del 45% del total de mamíferos reportados\npara Venezuela. Destaca la biorregión de los Andes, con 35 especies, siendo la de mayor\nendemismo, teniendo como posible causa la diversidad de hábitats que tienen origen en este\nconjunto de cadenas montañosas, lo que resalta la importancia de la conservación in situ que\nbrindan los Parques Nacionales y otras áreas de la zona andina, y de lograr la consolidación\nde un corredor biológico entre los mismos que incremente la viabilidad de las poblaciones y\nla protección de especies claves como el oso frontino Tremarctos ornatus y de otros\nvertebrados (Vázquez et al. 2011, Vázquez et al. 2015).\n1. Estado de conservación\nEn Venezuela, el Puma está catalogado como una especie CASI AMENAZADA (NT) (Rodríguez\n& Rojas-Suárez 2008).\n2. Estrategias de conservación y actores locales\nEstudios en atropellos de felinos en el estado de Lara, consideran necesario implementar en\nlos diseños de vías terrestres (carreteras, autopistas y vías ferroviarias) el paso o tránsito de\nfauna tanto en puentes como en túneles según se amerite. El cercado, la colocación de avisos\nde advertencias y los señalamientos informativos, reduciría la presencia de animales en las\nvías y de esta forma moderar la conducta vial de los conductores. Otro enfoque obedece a la\nnecesidad de fortalecer el sistema de áreas protegidas con vocación conservacionista como\nson los parques nacionales, ya que muchos registros ocurren en parques o próximos a sus\nlímites.\nPuma yagouaroundi, tal como lo señala Bisbal (1992), es una especie que por su variabilidad\nde hábitat, amplia distribución y cierta adaptabilidad como carroñero y depredador de aves\nde corral en zonas agrícolas, sus poblaciones no se encuentran amenazadas, y es quizás por\nello sea el félido de la fauna silvestre arrollada en la entidad larense más común, siendo más\nconspicuo en la biorregión del Sistema de Colinas Lara Falcón.\n54\nc. Guanaco (Lama guanicoe)\nEl guanaco, junto a la vicuña (Vicugna vicugna), la alpaca (Vicugna pacos) y la llama (Lama\nglama), pertenece al grupo de los camélidos sudamericanos y es el herbívoro nativo de mayor\ntamaño (110-140 kg en adultos) en los ambientes áridos del oeste y sur de Sudamérica.\nEl guanaco fue el herbívoro dominante del sur de Sudamérica luego de la extinción de la\nmegafauna del pleistoceno, con un número estimado de individuos de 30-50 millones hasta\nel siglo XIX (Raedeke 1979). En particular, predominó en la estepa patagónica (Markgraf,\n1985), donde cumplió un importante rol ecológico en el ecosistema, impactando la\ndistribución, abundancia y composición de las comunidades vegetales. Fue un recurso básico\npara la subsistencia de las poblaciones aborígenes precolombinas, proveyendo alimento,\nvivienda y vestimenta (Borrero, 2001).\nSu distribución abarca desde Perú hasta Tierra del Fuego y desde el nivel del mar hasta los\n4.600 metros sobre el nivel del mar (Puig 1995). El guanaco es una especie con un área de\ndistribución amplia y discontinua, que se extiende desde el norte de Perú (8°S) hasta la isla\nNavarino en el sur de Chile (55°S), desde el Océano Pacífico en el noroeste hasta el Océano\nAtlántico en el sureste y desde el nivel del mar hasta los 5.000 metros sobre el nivel del mar\nen la Cordillera de los Andes (Franklin 1982, González et al. 2006). La población total de\nguanacos se estima entre 1,4 y 2,1 millones de individuos (Baldi et al. 2016).\nLa población original de guanacos abarcaba una distribución a lo largo de toda Sudamérica y\nantes de la conquista europea fue estimada entre 30 y 50 millones de individuos según datos\nde densidad obtenidos en censos realizados en la Patagonia (Raedeke 1979). Si bien estas\napreciaciones nunca fueron confirmadas científicamente, es posible que, ante la disponibilidad\nde forraje, agua y pocos predadores naturales, las densidades poblacionales fueran altas y\ncasi al límite de la capacidad de carga de muchos sistemas naturales. Durante el período de\ncolonización europea, las poblaciones habrían disminuido drásticamente (Franklin & Fritz\n1991). Se estima que a fines del siglo XIX la población total de guanacos estaba en el orden\nde los 7 millones de individuos (Cabrera & Yepes 1960, Torres 1985).\nConsiderando la poca información existente sobre el tamaño de sus poblaciones y la calidad\nde los hábitats que ocupa, se conoce que aproximadamente el 91% de la población total se\nencuentra en Argentina donde no está considerada EN PELIGRO, 9% en Chile donde es\nconsiderada VULNERABLE (VU). En Bolivia < 0.02%, Paraguay < 0.01% y Perú < 0.5% las\npoblaciones son consideradas EN PELIGRO (EN) (González et al. 2006).\n55\nFigura 24. Guanaco (Lama guanicoe)\ni. Ecosistemas representados en su distribución\nEl guanaco se distribuye en una superficie 1,6 millones de kilómetros cuadrados y abarca 21\necorregiones terrestres (Figura 25). Ocupa principalmente la ecorregión Estepa patagónica\n(34%) y Monte bajo (20%). En menor proporción, destacan las ecorregiones: Monte alto\n(7%), Puna de los Andes centrales (7%) y Estepa de los Andes del sur (7%).\n56\nFigura 25. Ecorregiones en la distribución de Guanaco (Lama guanicoe).\nii. Estado de conservación y amenazas globales\nEl estado de conservación de la especie se ha clasificado como PREOCUPACIÓN MENOR (LC)\nporque su distribución continental es amplia y alcanza alrededor de un millón de kilómetros\ncuadrados, el tamaño total de su población presunta es alrededor de un millón de adultos y\npor la presencia de numerosas áreas protegidas en todo su rango de distribución (56) las que\nabarcan alrededor de 146 mil kilómetros cuadrados (Baldi et al. 2016).\nEl estado de conservación del guanaco ha sido clasificado como EN PELIGRO (EN) en Bolivia,\nPerú y Paraguay. El guanaco es una especie categorizada como PREOCUPACIÓN MENOR (LC)\nen Venezuela, Colombia y Ecuador.\n57\nSu distribución se ha visto gravemente afectada por los seres humanos. La caza constante, la\nocupación humana, la fragmentación del hábitat, la competencia con el ganado y la instalación\nde cercos (Torres 1992, Franklin et al. 1997, González et al. 2006) han reducido la distribución\ndel guanaco al 26% de su distribución original (Franklin 1982, Ceballos & Ehrlich 2002).\nNumerosas poblaciones locales han sido extirpadas generando una distribución altamente\nfragmentada en muchas regiones (Housse 1930, MacDonagh 1949, Mann et al. 1953, Cunazza\net al. 1995, Torres 1992, González et al. 2006, Baigún et al. 2007).\nLas principales amenazas del guanaco son la degradación del hábitat debido al pastoreo\nexcesivo, la competencia con herbívoros introducidos y la degradación del hábitat debido a\nlas industrias extractivas (Wildlife Conservation Society 2012).\nLa caza ilegal es una de las amenazas históricas de la especie que está impactando\nfuertemente las poblaciones pequeñas y de baja densidad (González 2010a, Wildlife\nConservation Society 2012). Igualmente, importante es la caza continua de poblaciones\nnuméricamente recuperadas (Lambertucci & Speziale 2011) basada en el antagonismo hacia\nla especie por parte del ganado y los terratenientes que han presionado a los gobiernos para\ncontrolar el número de guanacos. Ejemplos de esta situación se dan en la Patagonia y en las\npoblaciones de los Andes de Chile central.\nLas actividades como la caza, la minería, la exploración y extracción de petróleo, los cercos\npara el ganado, el desarrollo de infraestructura y la pérdida de hábitat, a menudo imponen\nbarreras a la migración y el movimiento entre poblaciones. La pérdida de conectividad ha\nresultado en poblaciones pequeñas, cerradas, aisladas y bajo un riesgo de colapso debido a\nla pérdida de variación genética y estocasticidad ambiental o demográfica, siendo esta última\nmuy relevante para poblaciones excesivamente pequeñas. Sin embargo, investigaciones\nrecientes en una pequeña población aislada de guanacos indican que tal aislamiento puede\nno ser el problema de la pérdida de diversidad genética en el corto plazo (70 años) aunque\nlas consecuencias a largo plazo son inevitables (González et al. 2014).\nEn la Patagonia se está desarrollando la esquila viva de guanacos capturados con\nfinanciamiento del gobierno argentino. Si se gestionan adecuadamente, estos programas\npueden ofrecer una alternativa a las economías locales y la reevaluación de las actitudes\nnegativas de los propietarios de tierras hacia la especie (Franklin et al. 1997, Lichtenstein &\nCarmanchahi 2012, Lichtenstein 2013).\nMás de 11.000 guanacos fueron esquilados entre los años 2004 y 2008, pero sólo un\nporcentaje muy pequeño de la población total de guanacos está bajo ese manejo (Lichtenstein\n2013). Se están evaluando y monitoreando los efectos de la utilización sostenida de fibra,\nespecialmente donde los guanacos se concentran en poblaciones dispersas de alta densidad\n(Ovejero et al. 2013, Carmanchahi et al. 2015). Para incentivar la comercialización, Argentina\nestá desarrollando y promocionando los hilados e hilos de guanaco.\nLos guanacos han sido cazados legalmente en Chile desde 2003, con presión para un manejo\nsimilar en la Patagonia argentina, con el fin de reducir la densidad y los conflictos con la\nproducción ganadera y la silvicultura. Sin embargo, un estudio reciente reveló que la caza de\nguanacos adultos por sí sola no reduce el daño del ramoneo a la regeneración de Nothofagus\nen Tierra del Fuego, Chile (Martínez-Pastur et al. 2016). Aún así, la recolección de guanacos,\nautorizada y organizada por el gobierno, ha resultado en la exportación de carne, ha\ncontribuido al valor de la especie y ha comenzado a reducir los conflictos tradicionales con\nganaderos y silvicultores.\n58\niii. Chile\nEn Chile, los guanacos se encuentran desde Putre, en la frontera norte con Perú, hasta la isla\nNavarino en el extremo sur de Tierra del Fuego (González et al. 2013). Las mayores\npoblaciones de guanacos de Chile se concentran en el extremo sur, en las regiones de\nMagallanes y Aysén. En el resto del país, poblaciones pequeñas y fragmentadas de guanacos\nse encuentran en las estribaciones andinas del extremo norte, en pequeños focos dispersos a\nlo largo de la costa, en la zona centro norte de los Andes bajos y en Chile central\nexclusivamente en los Andes (González 2010a, González et al. 2013). La población de\nguanacos en Chile se estima entre 270 y 300 mil individuos (Baldi et al. 2016).\nSu abundancia en la zona austral lo ha hecho conocido en el ámbito forestal. Allí ramonea\nbrotes y hojas de la lenga, lo que afecta el crecimiento y regeneración de rodales sujetos a\nmanejo en Tierra del Fuego (Cavieres y Fajardo 2005). También es conocida su población en\nel Parque Nacional Torres del Paine, donde su alta densidad y tolerancia a la presencia humana\nhace de ellos un atractivo turístico (Franklin et al., 1997). Sin embargo, esta imagen pública\nde especie sin problemas contrasta diametralmente con la situación que viven otras\npoblaciones a lo largo del país (González 2010).\nLos factores que afectan a la especie muchas veces actúan en conjunto u operan de forma\ndiferenciada temporal y espacialmente (Figura 26). Otros problemas no han sido abordados\ncomo el cambio climático, el cual sería un factor que está afectando a la biodiversidad mundial\n(Root et al. 2003). Figura 26 presenta un mapa con presencia de guanacos (confirmada en\nrojo y probable en rosado) y principales factores de amenaza (González 2010).\nLos principales factores de amenaza considerados son: competencia potencial con el ganado,\nmodificación y exclusión de hábitat, caza ilegal, barreras al desplazamiento, impacto de los\nperros, actividades de uso mal planificadas, enfermedades, hibridismo con camélidos\ndomésticos sudamericanos y la existencia de poblaciones extintas y prontas a extinguirse.\nFigura 26. Mapa presencia de guanaco y sus amenazas en Chile (González 2010)\n59\nFigura 27. Resultados de la calificación de amenazas directas para las poblaciones de\nguanacos de Chile central.\n1. Estado de conservación\nEn Chile, la especie está clasificada como VULNERABLE (VU) desde la Región de Arica y\nParinacota hasta la Región de Los Lagos, PREOCUPACIÓN MENOR (LC) entre la Región de\nAysén y Región de Magallanes (Ministerio del Medio Ambiente 2011).\nLa Figura 28 presenta la estimación poblacional y el estado de conservación del guanaco por\nregión administrativa en Chile y área protegida, de acuerdo con estándares de Glade (1998):\nE=Extinto, P=Peligro de extinción, V=Vulnerable, F=Fuera de peligro de extinción (González\net al. 2010).\nFigura 28. Estimación poblacional y el estado de conservación por región administrativa\n60\nLa Corporación Nacional Forestal, CONAF, basada en la opinión de expertos, lo clasificó como\nVULNERABLE (VU) (Glade 1998). Por otro lado, en base a la distribución, tamaño poblacional,\necosistemas que ocupa, entre otros, el guanaco ha sido clasificado también como\nVULNERABLE (VU) (Cofré y Marquet 1999).\nA nivel nacional actúa la Ley de Caza No 19.473, la cual establece su prohibición de caza en\ntodo el país (Servicio Agrícola y Ganadero, 1998), pudiéndose realizar su manejo en lugares\nespecíficos, tanto in situ como ex situ, que cuenten con antecedentes biológico poblacionales,\ny bajo una fuerte fiscalización por parte del Servicio Agrícola y Ganadero. El Reglamento lo\nclasifica de acuerdo a zonas administrativas, estando en el norte, centro y sur clasificado como\nEN PELIGRO DE EXTINCIÓN (EN), mientras que en la zona austral, como VULNERABLE (VU).\nFinalmente, a nivel de regiones administrativas, se considera al guanaco EXTINTO (EX) en 3\nregiones, EN PELIGRO DE EXTINCIÓN (EN) en 7 regiones y en 2 regiones como VULNERABLE\n(VU). Sólo en la región de Magallanes y Antártica Chilena está Fuera de Peligro (Glade 1988).\nEl guanaco está protegido por una serie de convenios internacionales y por la legislación\nchilena (Iriarte, 2000). Cabe destacar entre ellas el convenio CITES (Convención Internacional\nsobre el Comercio de Flora y Fauna Silvestre), donde el guanaco se ubica en el Apéndice II,\nlo cual significa que es posible realizar un comercio internacional regulado de sus productos.\n2. Estrategias de conservación y actores locales\nLas acciones de conservación se han enfocado en la generación de un cuerpo legal que\nprotege a individuos y promueve el manejo sustentable de poblaciones, y a través de la\nprotección in situ por medio de la creación de áreas silvestres, protegiendo a poblaciones y\nsu hábitat. También se han realizado traslocaciones las que no han tenido éxito en establecer\npoblaciones viables en el tiempo (González 2010).\nEn Chile existen 13 áreas silvestres protegidas por el Estado (SNASPE), que listan dentro de\nsu fauna al guanaco. La superficie de estas áreas alcanza el 5% aproximadamente del hábitat\nque históricamente ha utilizado la especie en Chile (Cunazza, 1992). También son de\nimportancia las áreas protegidas privadas que poseen poblaciones de guanacos, los que\naumentan la superficie de protección al doble. La preocupación de algunas mineras en la zona\ncentro y norte, y de ONGs en la zona austral han permitido aumentar la superficie de\nprotección para la especie. El principal problema que poseen algunos terrenos privados, es la\ncarencia de protección legal, incentivos y planes de manejo que aseguren una gestión\nsustentable (Pauchard y Villarroel 2002). Adicionalmente, algunas de las áreas de protección\nno cumplirían con el tamaño mínimo que sustente una población viable de 500 individuos\n(Simonetti y Mella 1997), por lo que es importante aplicar acciones más allá de sus límites,\ncomo generar áreas buffer, proteger los hábitat promoviendo su conectividad, entre otros\n(González 2010).\nSeminario sobre Manejo Sustentable de Guanaco y Vicuña. En el año 1998 se realizó un\nSeminario sobre el Manejo Sustentable de Guanaco y Vicuña, organizado por el Servicio\nAgrícola y Ganadero, la Fundación para la Innovación Agraria y la Pontificia Universidad\nCatólica de Chile. Las ponencias del Seminario fueron publicadas.\nPlan Nacional de Conservación de Guanaco 2010 – 2015. El año 2010 se elaboró el Plan\nNacional de Conservación del Guanaco liderado por la Corporación Nacional Forestal, donde\nse planifica a un plazo de 5 años.\n61\nRecuperación del hábitat de Guanaco en el Parque Nacional Patagonia. Fundación\nRewilding.Antes de la creación del Parque Nacional Patagonia, en el sector del Valle Chacabuco\nla ganadería extensiva tradicional ejercía el control de predadores (zorros, pumas y aves\nrapaces) y además desplazaba a los herbívoros nativos, como guanacos y huemules, quienes\ncompetían por espacio y acceso a los recursos forrajeros (coironales, humedales, matorrales\ny bosques). Para recuperar estos ecosistemas degradados, se implementaron diversas\nacciones, entre las que destacan: la remoción gradual del ganado doméstico, el retiro de\ncercos y postes que excluían y limitaban el desplazamiento del guanaco y el monitoreo a largo\nplazo.\nEstos esfuerzos e conservación significaron que el guanaco y otras especies lograran recuperar\nel hábitat perdido y en la actualidad son más de 3.000 los guanacos los que habitan el Parque\nNacional Patagonia. La población de guanacos es controlada por el puma, el que a su vez\nprovee de carroñas a una diversidad de otras especies, entre las que destacan el cóndor\nandino, el carancho, el zorro y el armadillo. Desde el año 2006 se realiza en forma sistemática\nun censo anual de población. Se espera que área de ocupación del guanaco siga aumentando,\ncontribuyendo con sus importantes roles ecológicos, tales como: herbívoro de bajo impacto,\ndispersador de semillas, fuente de reciclaje a través de sus estercoleros y ser parte de la\ncadena trófica, al ser dieta de los grandes carnívoros silvestres, como el puma. Asimismo, su\ndentadura permite que corte el vegetal sin arrancarlo, lo que no provoca daño a las pasturas,\ngenerando una recuperación de éstas.\nPlanificación Estratégica para la Conservación del Guanaco en Chile Central\nLa reciente Planificación Estratégica para la Conservación del Guanaco en Chile Central.\nRecuperando al jardinero de Los Andes (Silva et al. 2024) se ha planteado los siguientes\nobjetivos:\n● Establecer acciones que permitan abordar las causas subyacentes a las principales\namenazas del guanaco en Chile central.\n● Establecer criterios para la toma de decisiones en torno a proyectos de reintroducción\ny otras traslocaciones de guanacos en Chile central\nLas principales amenazas identificadas en la zona central de Chile corresponden a: minería,\ncaza ilegal, conflicto con ganadería trashumante y carreteras y caminos públicos. Otros\nfactores transversales identificados en relación a la conservación del guanaco corresponden\nal déficit de áreas protegidas en Chile central y la necesidad de desarrollar estrategias de\nconservación transfronterizas (Silva et al. 2024).\nLa planificación considera la implementación de las siguientes acciones y actores involucrados\npara enfrentar las amenazas de la especie:\n1. Minería\na. Acciones\ni. Impulsar una iniciativa coordinada para estandarizar e integrar la\ninformación de base relativa a la presencia del guanaco en la\nprecordillera y cordillera de Chile central, con el fin de mejorar la\nidentificación y evaluación de impactos potenciales de la minería (y\notras actividades) sobre la especie.\nii. Identificar zonas clave (alimentación, refugio, conectividad) para las\npoblaciones del guanaco en Chile central y promover la declaratoria de\nZona de Interés Científico para Efectos Mineros en ellas.\n62\niii. Promover la integración al SEIA de criterios específicos para la\nevaluación de impactos sobre especies de amplio ámbito de hogar,\ncomo el guanaco (instructivo, guía metodológica).\nb. Actores involucrados\ni. Ministerio del Medio Ambiente.\nii. Ministerio de Minería\niii. Servicio de Evaluación Ambiental\niv. Universidades y Centros de Investigación\nv. Organizaciones de la Sociedad Civil\nvi. Consultores ambientales\n2. Caza ilegal\na. Acciones\ni. Identificar zonas prioritarias para la fiscalización por conocida o\nprobable ocurrencia de caza de guanaco (p.ej. sectores cordilleranos\nutilizados para narcotráfico) y/o comercialización de sus subproductos),\ny promover una acción coordinada con las instituciones fiscalizadoras y\nel Ministerio Público para una adecuada fiscalización y mayor\nprobabilidad de éxito en el proceso de denuncia, investigación y\nsanción.\nii. Reforzar la capacidad de fiscalización ciudadana en zonas prioritarias,\na través del trabajo con las comunidades locales y la acreditación de\ninspectores de caza adhonorem.\nb. Actores involucrados\ni. Servicio Agrícola y Ganadero\nii. Ministerio Público\niii. Policia de Investigaciones de Chile\niv. Carabineros de Chile\nv. Municipios afectados por narcotráfico\nvi. Gobiernos regionales\nvii. Universidades y otros centros de investigación\nviii. Organizaciones de la Sociedad Civil\nix. Propietarios de predios afectados\n3. Conflicto con ganadería trashumante\na. Acciones\ni. Dar continuidad a iniciativas que apunten a fomentar las buenas\nprácticas en la ganadería trashumante, a través de la planificación\nintegrada del uso del territorio e incentivos económicos , incorporando\nlas proyecciones de cambio climático para las áreas de pastoreo.\nii. Desarrollar investigación e intervenciones para mejorar la coexistencia\nentre la ganadería y la vida silvestre, desde un enfoque socioecológico,\napun-tando a fortalecer la resiliencia de los sistemas ante el cambio\nclimático (p.ej. ecoturismo como alternativa de diversificación\neconómica para arrieros conocedores de los territorios).\nb. Actores involucrados\ni. Ministerio de Agricultura\nii. Ministerio del Medio Ambiente\niii. Universidades y Centros de Investigación\niv. Municipios\n63\n4. Carreteras y caminos públicos\na. Acciones\ni. Evaluar la efectividad de las medidas de mitigación de impactos de\ncaminos implementadas en Chile y la evidencia científica e incorporarlos\nen el Manual de Carreteras del MOP.\nii. Realizar estudios e investigaciones sobre la relación entre el guanaco\n(y potencialmente otros grandes vertebrados) y los caminos,\nconsiderando estudios de dinámicas poblacionales en áreas con\nproyectos viales para apoyar la medida 4.1.\nb. Actores involucrados\ni. Ministerio de Obras Públicas\nii. Universidades y Centros de Investigación\niii. Corporación Nacional Forestal\n5. Déficit de áreas protegidas en Chile central\na. Acciones\ni. Identificar zonas aptas para la recolonización pasiva por guanaco en\nChile central, en base a criterios de factibilidad ecológica (cercanía y\nconectividad con poblaciones existentes, aptitud del hábitat,\nproyecciones climáticas, entre otros), y social (menor prevalencia de\namenazas, predisposición favorable en actores locales, entre otros).\nii. Promover el establecimiento de áreas protegidas y Otras Medidas\nEfectivas de Conservación Basadas en Áreas (OMEC) en las zonas de\nChile central actualmente habitadas por guanaco y aquellas que sean\naptas para la recolonización pasiva por la especie, en el marco del\ncumplimiento de la meta de conservar al menos 30% de las zonas\nterrestres al 2030 (acuerdo de Kunming Montreal, Convenio de\nDiversidad Biológica).\nb. Actores involucrados:\ni. Universidades y Centros de Investigación\nii. Gobiernos regionales\niii. Municipios\niv. Ministerio del Medio Ambiente\nv. Servicio Agrícola y Ganadero\nvi. Privados\nvii. Organizaciones No Gubernamentales\n6. Ausencia de estrategias de conservación transfronterizas\na. Acciones:\ni. Mantener un conocimiento actualizado de las poblaciones ubicadas al\notro lado de la frontera, y un diálogo colaborativo con las instituciones\ntrasandinas relacionadas.\nii. Promover estrategias de conservación transfronterizas, tanto a nivel del\nmanejo de las unidades poblacionales compartidas con Argentina y el\ncontrol de sus amenazas, así como a nivel de acciones e instrumentos\nde política pública y puesta en valor de la especie en general.\nb. Actores involucrados:\ni. Ministerio de Relaciones Exteriores\nii. Ministerio del Medio Ambiente\niii. Organizaciones de la Sociedad Civil\nLos autores de este trabajo se listan a continuación:\n64\n● Wildlife Conservation Society Chile.\n○ Claudia Silva\n○ Mariana Thienel\n○ Bárbara Saavedra\n○ Camila Muñoz\n○ Diego Yañez\n● Grupo Especialistas Camélidos Sudamericano (GECS)\n○ Benito González. LEVS-UCHILE - CSE Chile IUCN. Académico de la Universidad\nde Chile. Presidente del Grupo de Especialistas en Camélidos Sudamericanos\n(GECS/CSE/UICN)\n○ Matías Guerrero, Meredith Root-Bernstein. Instituto de Ecología y Biodiversidad\n(IEB) - ONG KINTU\n○ Solange Vargas. Instituto de Ecología y Biodiversidad (IEB) - ONG YASTAY\n● Ministerio del Medio Ambiente (Charif Tala)\n● Corporación Nacional Forestal (Miguel Díaz, Ricardo Quilaqueo, Moisés Grimberg)\n● Servicio Agrícola y Ganadero (Rafael Asenjo).\niv. Argentina\nEn Argentina se encuentran la mayoría de los guanacos que quedan en el mundo. Aunque su\ndistribución cubre casi toda la Patagonia argentina, las poblaciones de guanacos parecen estar\nmás dispersas hacia las provincias del norte del país (Chubut, Río Negro, Neuquén y Mendoza)\nen comparación con la región sur (Santa Cruz y Tierra del Fuego)(Baigun et al. 2007, Sociedad\npara la Conservación de la Vida Silvestre 2012). La distribución está muy fragmentada en\npoblaciones relictas en las provincias de La Pampa y el suroeste de Buenos Aires. En el centro\ny norte de Argentina, la distribución del guanaco está restringida a la mitad occidental del país\na lo largo de las montañas preandinas y andinas hasta la frontera con Bolivia (Baigún et al.\n2007). Recientemente, se ha reportado una población relicta en el árido Chaco del noroeste\nde Córdoba (Schneider et al. datos no publicados) y en Córdoba se han reintroducido (Barri y\nCufré 2014). La población de guanacos en Argentina se estima entre 1,2 y 1,8 millones de\nindividuos (Baldi et al. 2016).\nEn Argentina el área de distribución geográfica del guanaco comprende diferentes territorios\nde las provincias de: Tierra del Fuego, Santa Cruz, Chubut, Río Negro, Neuquén, La Pampa,\nBuenos Aires, San Luis, Córdoba, Mendoza, San Juan, La Rioja, Catamarca, Tucumán, Salta y\nJujuy.\nEn la Argentina, la abundancia de guanacos es mayor en las zonas protegidas, por ejemplo,\nlas Reservas La Payunia en la Provincia de Mendoza (Candia et al. 1993, Puig et al. 2003) y\nAuca Mahuida en la Provincia de Neuquén (Radovani et al. 2004), en zonas poco habitadas y\nde difícil acceso y en ambientes de baja productividad donde no se desarrolla la actividad\nganadera. A pesar de que existen registros de poblaciones pequeñas de alta densidad en\náreas protegidas de la Provincia del Chubut, las poblaciones con densidades ecológicamente\nfuncionales son excepcionales y se hallan separadas por grandes extensiones sin guanacos o\ncon densidades muy bajas (Baldi et al., 1997; Baldi et al., 2001; Saba et al., 2004).\n1. Estado de conservación\nAl no estar amenazadas las poblaciones de guanaco en Argentina, no se ha evaluado su estado\nde conservación a la fecha.\n65\n2. Estrategias y actores locales\nConservación del guanaco en Argentina. Propuestas para un Plan Nacional de Manejo (Nugent\net al. 2006). La formulación de los objetivos de la propuesta de plan de manejo para el\nGuanaco en la Argentina está basada en la necesidad de asegurar los mecanismos de\nconservación para que la especie siga cumpliendo sus roles tanto biológicos, económicos como\nculturales.\nEn estos términos quedaron planteados como siguientes objetivos:\n● Propender al mantenimiento de poblaciones, sus hábitats y la diversidad biológica,\nminimizando los impactos sobre la especie y los ecosistemas que habitan.\n● Posibilitar la recuperación de la especie en densidades ecológicamente funcionales.\n● Mantener la conectividad de sus poblaciones, tendiente a garantizar la diversidad\ngenética a lo largo del rango de distribución de la especie.\n● Fomentar la diversificación productiva rural y una distribución equitativa de beneficios\na partir del manejo sustentable de la especie.\nSe identifican las siguientes amenazas directas:\n● La degradación y fragmentación del hábitat que ocupa la especie.\n● La caza furtiva o ilegal, las actividades de comercio ilegal y la extracción no planificada\ncon fines económicos, sea para reducir la carga de un predio o para iniciar planteles\nde cría, todas presiones tendientes a reducir el stock.\n● Las interacciones interespecificas, tanto las competitivas con otros herbívoros nativos,\no introducidos, como la depredación natural por carnívoros.\n● Las catástrofes naturales de origen climático (nevadas, heladas, sequías), por ejemplo,\nlas de origen volcánico o sísmico. e) Fenómenos relacionados con el cambio climático\n(aridización, desertificación, etc.).\nSe identifican las siguientes amenazas indirectas:\n● La debilidad institucional en el control de actividades ilegales, sean locales o\ngeneralizadas, que agrava el efecto de otros factores.\n● La ausencia previa de planes de manejo, aun cuando sea localmente, afecta la\nefectividad de un sistema integral de protección.\n● La estructura de tenencia de tierra, por cuanto afecta e interfiere en la conexión de\nlas poblaciones y la ocupación efectiva del hábitat.\nSe proponen las siguientes Líneas de acción generales:\n● Desarrollo de capacidad técnica para evaluar el estado de conservación del recurso,\nestablecer las pautas de manejo y evaluar la sustentabilidad de las prácticas de\naprovechamiento de la especie.\n● Fortalecimiento de las instituciones para dar impulso a planes de manejo provinciales,\npromoviendo el accionar coordinado entre jurisdicciones en la evaluación de proyectos\nproductivos y de conservación, y homologando los instrumentos de diagnóstico y de\nfiscalización y la resolución de conflictos interjurisdiccionales.\n● Promoción de las prácticas de manejo mediante acciones de educación, difusión y\ncapacitación sobre la sustentabilidad desde el punto de vista ecológico, económico y\nsociocultural.\nSe proponen las siguientes acciones específicas:\n● Producción y disponibilidad de la información necesaria para la gestión del recurso.\n66\n● Evaluación de la sustentabilidad del uso de la especie desde el punto de vista ecológico,\neconómico y sociocultural, considerando las amenazas directas e indirectas.\n● Promoción del manejo del guanaco a través de posibles prácticas sustentables de uso\nde la especie.\n● Generación de un sistema de gestión y normativa armónico que garantice la\nconservación y uso sustentable de la especie\n● Fortalecimiento de las áreas naturales protegidas existentes y creación de nuevas\náreas.\n● Estimulación de la participación comunitaria en la conservación de la especie.\nLas conclusiones del trabajo se listan a continuación:\n● La posibilidad de transferir parte de los beneficios del aprovechamiento de la fibra de\nguanaco hacia el financiamiento de investigaciones, tareas de fiscalización y\nfortalecimiento de áreas protegidas para la especie es parte de una estrategia posible\npara integrar en el plan pautas de manejo sustentable y conservación. Existen como\nantecedente en el país experiencias exitosas de manejo para otras especies.\n● Alentar el aprovechamiento sustentable de animales vivos es, como punto de partida,\nun reaseguro de que con el impulso de actividades productivas no se favorecerá la\nreducción de las poblaciones de guanacos.\n● En un escenario futuro y ante las distintas realidades regionales y provinciales, se\npodrán plantear otras alternativas de uso, las cuales deberán ser explicitadas con su\nfundamentación técnica y los mecanismos específicos de evaluación de\nsustentabilidad, considerados en el marco de la visión y los objetivos del plan de\nmanejo de la especie.\nOrganizaciones y actores involucrados\n● Departamento de Fauna y Ambiente Natural, Tierra del Fuego. Adriana Guillén.\n● Dirección de Fauna Silvestre. Nación. Alejandro González.\n● CONICET UNPA Alejandro Traviani\n● CONICET CEAN WCS Andrés Novarro\n● WCS Carolina Marull\n● Municipalidad de Malargüe\n● Dirección de Fauna Silvestre de la Nación.\n● Dirección de Fauna SIlvestre de Río Negro\n● Dirección de Recursos Renovables de la Nación\nLa Secretaría de Ambiente y Desarrollo Sustentable de la Nación aprobó el Plan Nacional para\nel Manejo Sostenible del Guanaco (PNMSG), mediante la Resolución 243/2019 y de acuerdo\na los lineamientos elaborados por la Mesa Interinstitucional. La norma establece un marco de\npolíticas nacionales para promover la conservación y el uso sustentable de poblaciones de\nguanaco en todo el país y es fruto del trabajo de la Mesa Interinstitucional que, además del\nSENASA y Ambiente, está integrada por las Secretarías de Planeamiento y Políticas en Ciencia,\nTecnología e Innovación Productiva; de Agricultura, Ganadería y Pesca; de Emprendedores y\nPymes; el Instituto Nacional de Tecnología Industrial (INTI) y el Consejo Nacional de\nInvestigaciones Científicas y Técnicas (CONICET).\nv. Bolivia\nEn Bolivia, persiste una población relicta de guanacos en la región del Chaco (Cuéllar y Fuentes\n2000) y recientemente se han reportado avistamientos en las tierras altas del sur, entre Potosí\ny Chuquisaca (Núñez 2008). Aunque Pinaya (1990) informó la presencia de guanacos en el\n67\nsureste de Tarija, estos registros necesitan confirmación. La población de guanacos en Bolivia\nse estima entre 150 y 200 individuos (Baldi et al. 2016).\nEn Bolivia, el guanaco ha sido históricamente registrado en las regiones altoandina y puna (en\ndepartamentos de Potosí y Chuquisaca) y llanura chaqueña (Tarija y Santa Cruz) (Cunazza et\nal. 1995, Tarifa 1996).\nEl último informe sobre el estado de conservación de la fauna en Bolivia indica que el guanaco\nde la región altoandina y puna estaría extinto en estado silvestre (Bernal & Silva 2003). Esta\napreciación se hizo con base en la carencia de observaciones de la especie en el campo por\ninvestigadores durante los últimos 18 años (Núñez 2008).\nAlzérreca (1982) registró a la especie en la región de Mochara (en el límite entre los\ndepartamentos de Potosí y Chuquisaca) y Pinaya (1990) al oeste de la Cordillera de Sama (en\nel departamento de Tarija) (Villalba 1992). Esta información fue corroborada durante un taller\nde especialistas realizado en el año 2001 (Flores & Miranda 2003).\nEn los últimos años, las únicas observaciones directas de guanaco en estado silvestre en\nBolivia fueron realizadas para la zona del Chaco, al sureste del departamento de Santa Cruz\nen la frontera con Paraguay (Cuéllar & Fuentes 2000), donde habita la subespecie Lama\nguanicoe voglii, sobre la cual existen informes (Anderson 1997, Cuéllar & Fuentes 2000,\nCuéllar & Noss 2003).\nFigura 29. Registros de presencia de guanaco en la región altoandina de Bolivia (Nuñez\n2008).\n1. Estado de conservación\nEn Bolivia, el guanaco está calificado EN PELIGRO CRÍTICO (EN) de extinción dada la\nreducción de sus poblaciones y su área de distribución. El Decreto Supremo Nº 11.238\n(Gobierno de Bolivia 1973) prohíbe la caza y captura de la especie y el primer Libro Rojo de\nVertebrados de Bolivia lo calificó EN PELIGRO (EN).\n68\nLos cálculos realizados por varios investigadores entre los años 2008 y 2011 estimaban que\nla población de la especie estaba por debajo de los 200 individuos en todo el Chaco boliviano\n(Rivadeneira 2019). Aunque en el Altiplano se consideraba extinto, Núñez (2006) registró\nalgunos individuos en Potosí (Rivadeneria 2019).\n2. Estrategias de conservación y actores locales\nEl guanaco del Chaco boliviano es una especie reconocida como uno de los 7 símbolos de la\nAutonomía Guaraní Charagua Iyambae y su territorio, ubicado en el sur del departamento de\nSanta Cruz, es testigo de la dramática reducción de su población. El territorio Charagua aún\nmantiene el ecosistema mejor conservado del bosque chaqueño, a diferencia de lo que sucede\nen el Chaco paraguayo, argentino y brasileño. Por ello, su protección es muy importante para\nasegurar la conservación de la especie.\nEn este territorio se establecerá la nueva zona reservada para el guanaco: El Área de Vida\nGuajukaka. Ubicada al sur del Parque Nacional y Área Natural de Manejo Integrado Kaa Iya\ndel Gran Chaco, será la cuarta zona reservada que se establezca en el territorio guaraní\nboliviano. Las otras zonas reservadas son el Parque Nacional y Área Natural de Manejo\nIntegrado Otuquis y el Área de Conservación Ñembi Guasu. Las cuatro formarán un corredor\ncontinuo de bosques protegidos. La Autonomía Guaraní Charagua Iyambae se encuentra en\nla última etapa del proceso de creación del Área de Vida Guajukaka, una zona protegida de\n285.000 hectáreas repletas de planicies arenosas dedicadas al guanaco.\nUn proyecto de monitoreo con cámaras trampa se lleva adelante en ambos lados de la frontera\ndel Chaco paraguayo y boliviano para conocer la situación real de la especie categorizada EN\nPELIGRO CRÍTICO (CE) en ambos países. Los primeros resultados del monitoreo con las\ncámaras trampa del área fronteriza dan cuenta de 13 especies captadas, entre ellas 1\nguanaco, el primer registro que se dispone para el Chaco paraguayo.\nSimilar monitoreo se ha planificado para el Parque Nacional Médanos del Chaco, en el marco\ndel Programa de Conservación de Especies de la ONG GUYRA por ser el único lugar donde se\nhan avistado guanacos. Viviana Rojas. Coordinadora del Programa Conservación de Especies\nONG GUYRA.\n69\nFigura 30. Mosaico de Conservación Guaraní (Bolivia)\nEl\nvi. Perú\nEn Perú, la población de guanacos más septentrional de América del Sur se encuentra a 8°S\nen la Reserva Nacional Calipuy (Franklin 1975, Linares et al. 2010). Al sur, las poblaciones\nllegan a la Reserva Nacional Salinas Aguada Blanca (16°S) y se ha registrado una población\nde guanacos en el área del Nevado Salcantay (Wheeler 2006, Veliz & Hoces 2007). La\npoblación de guanacos en Perú se estima en 3.000 individuos (Baldi et al. 2016).\nEn Paraguay, se ha informado de una pequeña población relicta en el noroeste del Chaco\n(Villalba 2004) que se estima entre 20 y 100 individuos en total (Baldi et al. 2016).\nEl guanaco en Perú pertenece al género Lama, correspondiendo a la especie Lama guanicoe,\ny exactamente del subtipo cacsilensis, con una población aproximada a 3.900 individuos,\nsegún el censo que realizó el CONACS en 1997 (Ministerio del Medio Ambiente 2010).\n1. Estado de conservación\nEn el Perú están declarados PELIGRO DE EXTINCIÓN (EN) motivo por el cual fue creada la\nReserva Nacional de Calipuy (RNC) en 1981 (Wheeler 1991).\n2. Estrategias y actores locales\nEn el Perú existen 3 áreas protegidas con guanacos: La Reserva Nacional de Calipuy, la\nReserva Nacional Salinas y Aguada Blanca, y las zonas aledañas a la Reserva Nacional Pampa\nGaleras. En la primera, donde se encuentra la mayor concentración de guanacos del país, sólo\nse realiza una vigilancia parcial, pero es bastante inaccesible, quedando relativamente\nautoprotegida. En la segunda se cuenta con controles y censos regulares desde 1983,\ntratándose de una población de guanacos sedentaria. En las proximidades de Pampa Galeras,\n70\nlos controles son esporádicos debido a la falta de recursos financieros (Ministerio del Medio\nAmbiente 2010).\nEn la Reserva Nacional de Calipuy se encuentra la mayor concentración de guanacos del país,\nsólo se realiza una vigilancia parcial, pero es bastante inaccesible, quedando relativamente\nautoprotegida (Puig et al. 1995). El territorio donde se ubica actualmente la Reserva Nacional\nde Calipuy, hace más de 50 años atrás, perteneció a la hoy extinta Hacienda de Calipuy, de\npropiedad de la familia Ganoza Porturas; que en ese entonces la hacienda criaba más de 5.000\nvacunos, los cuales eran cuidados por personas que en grupos de 8 rotaban cada semana, y\nque no solamente cuidaban el ganado sino también los guanacos, cuya población se estimaba\nen 2,000 individuos. Lo más importante durante la Hacienda es que el ingreso a ella estaba\nprohibido, de tal manera que había un control estricto y era imposible que puedan ingresar\ncazadores.\nSegún los censos anuales, las poblaciones de esta especie en la Reserva Nacional de Calipuy\nhan declinado en el tiempo debido a la caza furtiva, alteración del hábitat, limitados recursos\npara la protección y control del área, escaso nivel de conciencia de la población para su\nconservación y la ausencia de un plan de manejo para la conservación que oriente la\nrecuperación de sus poblaciones y su hábitat a través del manejo sostenible de este camélido\nen el ámbito de esta Área Natural Protegida-ANP del departamento de La Libertad (Ministerio\ndel Medio Ambiente 2010).\nFigura 31. Población de Guanacos en la Reserva Nacional de Calipuy (2010)\nEn julio del año 2003 se inició un estudio científico a gran escala para evitar la extinción de la\nespecie, conocido como GUANACO 1. Es un proyecto financiado por la Iniciativa Darwin\n(Inglaterra) y liderado por Michael Brudford perteneciente a la Universidad de Cardiff\n(Inglaterra) y Jane Wheeler, actual Presidenta del Instituto de Investigación y Desarrollo de\nCamélidos Sudaméricanos (CANOPA). Utilizando una combinación de estudios genéticos,\nanálisis de viabilidad poblacional y sobrevivencia ecológica, el proyecto se ha propuesto la\nmeta de desarrollar un plan de manejo para la conservación, fortalecer las capacidades\ntécnicas para implementarlo y continuar con estudios en especies peruanas amenazadas en\nel futuro (Wheeler 1991).\n71\nLa población de guanacos en la Reserva Nacional Calipuy es estable con ligera tendencia a la\nbaja. El 74% de la población son adultos, el 16% juveniles y el 10% chulengos. Estos se\nagrupan en su mayoría (73%) en grupos familiares y en menor proporción en grupos de\nmachos (10%) y solitarios (17%). La territorialidad de los grupos familiares se acentúa en las\nzonas de mayor densidad. La densidad promedio para el área fue alta (5,7 guanacos por\nkilómetros cuadrados). Sin embargo, la población estuvo replegada en la zona norte, que está\nsobre los 3.000 metros sobre el nivel del mar y es la más vigilada, siendo esta la preferida por\nlos grupos familiares. En la zona occidental, bajo los 3.000 metros de altitud y más cerca a la\nzona de ganadería, la densidad fue mucho más baja, albergando principalmente solitarios y\ngrupos de machos. La altura y temperatura son límites críticos en la distribución del guanaco\nen la Reserva, éstas pueden representar una fuerte restricción a futuros crecimientos\npoblacionales. Es necesario estudiar los efectos del cambio climático, ya que el incremento de\nla temperatura replegaría más la población de guanacos de la Reserva, poniendo en riesgo su\nviabilidad (Linares et al. 2010)\nPlan de Manejo para la Conservación del Guanaco en la Reserva Nacional CALIPUY (2010).\nMinisterio del Ambiente / SERNAMP / Reserva Nacional Calipuy\nLa propuesta de Plan de Manejo para la Conservación del Guanaco en la Reserva Nacional\nCALIPUY (Ministerio del Medio Ambiente 2010) tiene como visión a largo plazo la recuperación\ny la conservación de la especie en poblaciones silvestres ecológicamente funcionales en su\nrango de distribución. El Plan fue elaborado bajo la coordinación de la Gerencia Regional de\nRecursos Naturales y Gestión Ambiental del Gobierno Regional de La Libertad, la Jefatura de\nla Reserva Nacional de Calipuy y el Servicio Nacional de Áreas Naturales Protegidas por el\nEstado - SERNANP. El Plan fue enriquecido con el apoyo técnico de instituciones nacionales,\nregionales y distritales, centros de investigación (universidades) y ONGs. La propuesta resume\nlos fundamentos que permitirán identificar y reducir las amenazas para la especie y los\nlineamientos de un plan de conservación.\nLa iniciativa se plantea los siguientes objetivos:\n● Recuperar las poblaciones de guanaco sobre la base de la capacidad de carga de la\nReserva.\n● Restaurar los hábitats del guanaco con enfoque ecosistémico.\n● Realizar estudios de diversidad genética de poblaciones de guanaco en la Reserva para\ncomparar la variabilidad genética con respecto a las otras poblaciones distribuidas al\nsur del país.\n● Fortalecer y establecer redes de control y vigilancia contra la caza furtiva y uso no\nautorizado de pastizales de la Reserva.\n● Fomentar campañas de sensibilización para la población local sobre los servicios\necosistémico que ofrece la Reserva Nacional de Calipuy.\nEl Plan propone las siguientes acciones generales:\n● Desarrollo de capacidad técnica para evaluar el estado actual (recuperación y\nconservación) del recurso y evaluar la sostenibilidad de las prácticas para la\nrecuperación y conservación de las poblaciones de guanaco y su hábitat.\n● Promover el fortalecimiento de la institucionalidad regional y local para la\nimplementación e impulso del plan de conservación, promoviendo el accionar\ncoordinado entre jurisdicciones en la evaluación de proyectos de conservación y\nproductivos, y homologando los instrumentos de diagnóstico y de fiscalización y la\nresolución de conflictos interjurisdiccionales.\n72\n● Promoción de las prácticas de conservación del guanaco mediante acciones de\neducación, difusión y capacitación, para lograr el equilibrio y la sostenibilidad desde el\npunto de vista ecológico y sociocultural.\n● Establecer las sinergias interinstitucionales para fortalecer las acciones de control y\nvigilancia de la Reserva.\n● Promover incentivos para las poblaciones locales que coadyuven a los objetivos de la\nReserva.\n● Promover iniciativas para instalar sistemas de circuitos turísticos en la Reserva.\nLas acciones específicas del Plan incluyen:\n● Producción y disponibilidad de la información necesaria para la gestión de la especie.\nConsidera la creación de una Basa de Datos georreferenciados en Sistema de\nInformación Geográfico, la dentificación de acciones de conservación y la evaluación\ny monitoreo de poblaciones y acciones.\n● Fortalecimiento de acciones de vigilancia de la especie, difusión y promoción para su\nconservación. Considera las metas de reducir la caza furtiva y la promoción de\nprogramas para la difusión y desarrollo de capacidades productivas en la zona de\namortiguamiento de la reserva.\n● Generación de un sistema de gestión legal y armónico que garantice la conservación\nde la especie. Considera gestionar el financiamiento para la operación del Comité de\nGestión de la Reserva. Incluye la meta de promover la generación y difusión de la\nnormatividad legal sobre la conservación y protección del guanaco.\n● Estimulación de la participación ciudadana en la conservación de la especie en la\nReserva. Considera las metas de desarrollar y aplicar una estrategia de educación y\ncomunicación sobre las problemáticas que enfrenta el guanaco y la importancia de su\nconservación e instalar grupos interdisciplinarios voluntarios conformados por\ninstituciones científicas a través de redes de nivel local, regional, nacional e\ninternacional.\nProyecto de Investigación: Desarrollo de un sistema de geolocalización para el estudio del\ncorredor biológico y conservación de la Lama guanicoe en la Reserva Nacional de Salinas y\nAguada Blanca de la Región de Arequipa basado en sensores inalámbricos. El proyecto es\nfinanciado por FONDECYT y el Banco Mundial y desarrollado en colaboración con el Cite textil\nArequipa y la Université de Bretagne Sud de Francia.\nEste proyecto permitirá realizar el estudio del corredor biológico de camélidos andinos\n(guanacos y vicuñas) en la la Reserva Nacional de Salinas y Aguada Blanca, Arequipa.\nCorresponde a un proyecto de investigación aplicada para el desarrollo e implementación de\nun sistema de localización de objetos basado en una red de sensores móviles y la aplicación\npara el estudio del corredor biológico de camélidos sudamericanos con el fin de ayudar en su\npreservación.\nInvestigadora y Contacto Principal: María Armas marmas@inictel-uni.edu.pe\nCo- Investigadores: Oscar Llerena, Rubén Acosta, Ricardo Yauri, Mariano Chuchón, Luighi\nViton, Jinmi Lezama.\nCo- Investigadores Asociados: Emmanuel Boutillon (Universite Bretagned Sub – Laboratoire\nLab-STICC), Guido Chirinos (Instituto Tecnológico de la Producción – ITP), Dario Sullca\n(Instituto Tecnológico de la Producción – ITP)\nTesistas: Oscar Marín (INICTEL-UNI), Kenny Cucho (INICTEL-UNI), Emilio Lovatón (INICTEL-\nUNI), Christian Astorga (Instituto Tecnológico de la Producción – ITP)\n73\nManejo Sostenible del Guanaco. Protección y Conservación del Hábitat del Guanaco en la\nComunidad Campesina de Susapaya, Provincia de Tarata, Tacna.\nEl objetivo del proyecto consistió ́ en conservar y proteger el hábitat del guanaco para\ncontribuir al manejo sostenible de la especie, generando oportunidades de desarrollo entre\nlos miembros de la Comunidad Campesina de Susapaya, mediante el ecoturismo.\nPara tal efecto se realizó el manejo adecuado de 4.241 hectáreas del terreno comunal para la\nprotección de las poblaciones de guanaco (Lama guanicoe) EN PELIGRO DE EXTINCIÓN (EN).\nSe realizaron también actividades que permitieron afrontar los conflictos de convivencia entre\nlos comuneros y la fauna silvestre: la instalación de cercos perimetrales de 850 hectáreas de\ncultivo y el fortalecimiento de capacidades para la conservación y protección de la\nbiodiversidad de flora y fauna silvestre disponible en el territorio. Estas acciones a su vez\npermitieron el incremento poblacional de la fauna silvestre en peligro de extinción de un 98\n%. Además, se construyeron dos estructuras de represamiento de agua con capacidad de\nalmacenamiento de 15.000 m3 y 80 m3, ubicados en las zonas de Calocco y Cospampa,\nrespectivamente, para el almacenamiento de agua de lluvia para regar los pastos naturales\ndel área de manejo. De manera complementaria, se instaló un mirador rural denominado\nAncocollo, el Mirador de Mil Caras, con acceso seguro a través de la construcción de un camino\nhacia la cima del cerro Ancocollo, el cual está a disposición de los turistas que deseen admirar\nla belleza paisajística conservada del territorio.\nLas organizaciones involucradas en esta experiencia se listan a continuación:\n● Programa de las Naciones Unidas para el Desarrollo (PNUD)\n● Fondo de Pequeñas Donaciones del Fondo del Medio Ambiente Mundial (PPD)\n● Ministerio del Ambiente (MINAM)\n● SERFOR (Tacna) - Administración Técnico Forestal y de Fauna Silvestre MOQUEGUA\n● Municipalidad Distrital de Susapaya\nPlan de Acción de Conservación del Guanaco de la Región Ayacucho (2022 - 2027). Consejo\nRegional del Gobierno Regional de Ayacucho.\nd. Vicuña (Vicugna vicugna)\nLa distribución de la especie abarca la Puna y las provincias biogeográficas altoandinas de\nChile, Argentina, Bolivia y Perú, en un rango latitudinal que se extiende 2.800 kilómetros entre\nPerú y Argentina. La población aislada en Ecuador, resultante de una donación de Chile, Bolivia\ny Perú, representa la distribución más septentrional de la especie.\nLa población total de vicuñas de América del Sur se estima en 500 mil individuos, de los cuales\nel 46% se encuentra en Perú, el 29% en Bolivia, el 21% en Argentina, el 3% en Chile y el 2%\nen Ecuador. Las dos subespecies reconocidas, la V. vicugna mensalis del norte y la V. vicugna\nvicugna del sur, se encuentran en Chile y Bolivia. Argentina tiene sólo V. vicugna vicugna,\nmientras que Perú y Ecuador sólo tiene V. vicugna mensalis.\n74\nFigura 32. Vicuña (Vicugna vicugna)(Foto: Sebastián Navajas)\nConvenio para la Conservación de la Vicuña http://www.conveniovicuna.org/\nEl Convenio para la Conservación y Manejo de la Vicuña es un acuerdo internacional en el que\nlos gobiernos signatarios (Argentina, Bolivia, Chile, Ecuador y Perú) consideran que la\nconservación de la vicuña constituye una alternativa de producción económica, en beneficio\ndel poblador andino. Asimismo, reconocen que existe la necesidad de asumir un compromiso\npara su protección y aprovechamiento gradual bajo control del Estado, aplicando las técnicas\npara el manejo de la fauna silvestre que determinen los organismos oficiales competentes de\ncada gobierno.\nLos Gobiernos de las Repúblicas de Bolivia, Chile, Ecuador y Perú, animados del propósito de\ncontinuar fomentando la conservación y el manejo de la vicuña, y en consideración a la\nexperiencia recogida en la ejecución del Convenio para la Conservación de la Vicuña suscrito\nen La Paz, en el año 1969, resuelven celebrar un nuevo Convenio para la Conservación y\nManejo de la Vicuña, en Lima en el año 1979, sumándose la República de Argentina en el año\n1988.\nSegún información del Convenio Vicuña, la población de vicuña de las partes alcanza 471.209\nindividuos en una superficie de 16 millones de hectáreas (Tabla 3)(Convenio Vicuña 2024).\nTabla 3. Presencia de Vicuña por países miembros del Convenio (2017)\nPaís Población Hectáreas Año Fuente\nArgentina 72.678 12.300 2006 Convenio 2017\nBolivia 163.330 5.357.800 2006 Convenio 2007\nChile 10.015 575.250 2014 Convenio 2015\nEcuador 7.185 58.560 2016 MAE 2016\nPerú 218.000 6.661.498 2016 MINAGRI 2016\nTOTAL 471.209 16.081.464 2006-2017\n75\nPor otra parte, Wheeler (2006) presenta en su publicación Historia Natural de la Vicuña la\npoblación andina de vicuña entre los años 2001 y 2003 con información proveniente del\nConvenio (Figura 33).\nFigura 33. Población andina de Vicuña (Wheeler 2006)\nFigura 33. Mapa de la distribución de Vicuña en la Cordillera de los Andes. Las cifras\ncorresponden a vicuñas totales por unidad administrativa. Los censos son de año 1997 en\nPerú, 1996 Bolivia, 1997 en Chile y Argentina entre 2004 y 2005 (Laker et al. 2006).\nEl Plan de Acción Nacional del Convenio Vicuña (2018) propone los siguientes objetivos\nestratégicos y líneas de acción:\n76\n● Fortalecimiento institucional y desarrollo de capacidad técnica\n○ Realizar censos estandarizados de poblaciones de vicuña\n○ Realizar programas de concientización y educación de comunidades en\nconservación\n○ Fortalecer las áreas protegidas existentes e implementar otras\n○ Asegurar la disponibilidad de recursos humanos y financieros\n● Investigación para la conservación y el manejo participativo\n○ Concientizar, educar y capacitar a las comunidades en los mecanismos de\nparticipación en la gestión\n○ Fortalecer la Organización Social\n● Fortalecimiento organizativo y participación comunitaria\n○ Promover el manejo y aprovechamiento en silvestrería\n○ Establecer criterios y procedimientos adecuados para la captura y técnicas de\nesquila\n○ Facilitar acceso a asistencia financiera, infraestructura y equipamiento\n○ Capacitar y asistir técnicamente a la población local en el manejo de la especie\n○ Establecer criterios estandarizados para el manejo en semi cautiverio y\nmecanismos de supervisión\n○ Desarrollar un marco normativo tendiente a la protección y conservación del\npatrimonio genético de los países del convenio.\n● Aprovechamiento y comercialización de la fibra\n○ Posicionar la fibra y sus derivados en mercados internos e internacionales\n○ Promover la generación de valor agregado en sus diferentes productos\n○ Identificar y fortalecer las diferentes cadenas de comercialización\n○ Desarrollar un sistema tendiente a la adecuada certificación de procesos y\nproductos\n○ Identificar y facilitar el acceso a mecanismos para la generación de líneas de\nfinanciamiento incluyendo la cooperación internacional\n○ Desarrollar capacidades de negociación de pobladores locales en forma\norganizada\n○ Desarrollar procedimientos estandarizados para el correcto uso de la marca\nvicuña-país de origen y so compromiso de aplicación.\n● Promover el desarrollo de líneas de investigación\n○ Priorizar los temas de investigación básica, aplicada y evaluación de impactos.\n○ Orientar recursos financieros para el desarrollo de la ciencia y tecnología\n○ Promover la participación y cooperación a nivel nacional e internacional de\norganismos públicos y privados vinculados con la investigación , la\nconservación y el manejo.\n● Fortalecer los sistemas de fiscalización y control\n○ Fomentar el fortalecimiento político, institucional y legal\n○ Capacitar a autoridades de Medio Ambiente, Aduaneras, Fuerzas de Seguridad,\nPoder Judicial y otras entidades de control\n○ Fortalecer la coordinación interinstitucional a nivel nacional y entre países\n● Sensibilizar y concientizar a la población en general y a los tomadores de decisión en\ntemas de conservación de la vicuña\n○ Realizar campañas de difusión a nivel nacional y en los ámbitos político, judicial\ny administrativo\n○ Fortalecer los mecanismos de coordinación interinstitucional\n● Diseñar e implementar un sistema de seguimiento y evaluación del Plan de Acción\n● Mantener y actualizar permanentemente la información y coordinación entre las\nPartes.\n77\nPuntos Focales del Convenio Vicuña (2018)\n● Argentina. Dirección Nacional de Biodiversidad, Secretaría Política Ambiental en\nRecursos Naturales, Ministerio del Medio Ambiente y Desarrollo Sustentable. Buenos\nAires. Contacto: Daniel Ramadori edramadori@ambiente.gob.ar\n● Ecuador. Ministerio del Medio Ambiente. Quito. Contacto:\nmarcelo.pino@ambiente.gob.ec\n● Perú. Servicio Nacional Forestal y de Fauna SIlvestre del Ministerio de Desarrollo\nAgrario y Riego - MIDAGRI. Dirección de Gestión Sostenible del Patrimonio de Fauna\nSilvestre. Lima. Contactos: acalderon@serfor.gob.pe y cmichaud@serfor.gob.pe\n● Bolivia. Dirección General de Biodiversidad y Áreas Protegidas. Ministerio de Medio\nAmbiente y Aguas. Contacto: teresaaralenyperez@gmail.com y\njorgelaura3@gmail.com\n● Chile. Corporación Nacional Forestal. Región de Arica y Parinacota. Contacto:\nhector.penaranda@conaf.cl y carlos.nassar@conaf.cl\nEn conformidad con el Principio de Precaución y teniendo en cuenta la información actual, se\nconsidera que la población total de vicuña está aumentando. No obstante lo anterior, existen\nincertidumbre debido a:\n● Las metodologías empleadas en los distintos países son diferentes. En algunos casos,\nlos censos son extrapolaciones o estimaciones, mientras que en otros corresponden a\nconteos reales;\n● Los censos no están actualizados. Por ejemplo, el censo nacional en Argentina es del\naño 2006, en Bolivia del año 2009 y en Perú del año 2012, y\n● Se sospecha que la población total de vicuñas es mayor ya que varios censos se\nrealizaron principalmente en áreas protegidas, a pesar de que las vicuñas se\nencuentran más allá esos espacios.\nGrupo de Especialistas en Camélidos Sudamericanos\nhttps://www.camelid.org/index.php/es/nosotros/publiaciones-miembros\ni. Ecosistemas representados en su distribución\nVicugna vicugna es una especie que habita la Cordillera de los Andes desde los 3.000 a los\n5.000 metros sobre el nivel del mar (Acebes et al. 2018). Su distribución ocupa una superficie\nde 619 mil kilómetros cuadrados y abarca 15 ecorregiones terrestres: Puna (34%), Puna árida\n(25%) y Puna húmeda de los Andes centrales (14%). En menor proporción, destacan las\necorregiones terrestres: Desierto Sechura (9%), Yunga peruana (9%) y Estepa de los Andes\ndel sur (5%).\nHabita ambientes de clima frío y seco, dominados por vegetación xerófila y grandes áreas de\nsuelo desnudo (Franklin 2011). Los hábitats de las vicuñas incluyen humedales someros -\ntambién llamados vegas en Chile y Argentina, bofedales en Bolivia y bofedales o mojadales\nen Perú- comunidades de plantas halófilas, estepas herbáceas, estepas arbustivas con\nsuculentas (Pujalte y Reca 1985).\nLas vegas o bofedales son extremadamente escasos en toda la región, pero son intensamente\nutilizados por las vicuñas debido a la presencia de agua y de forraje de alta calidad, en\ncomparación con los hábitats xéricos ampliamente distribuidos (Lucherini 1996). Los patrones\nde actividad y movimientos diarios de las vicuñas están fuertemente influenciados por la\ndisponibilidad de agua, especialmente durante el verano, dado que son bebedores obligados\n(Franklin 2011). Durante la noche y la mañana, las vicuñas se trasladan a las laderas para\nevitar la depredación de los pumas (Renaudeau d\' Arc et al. 2000, Donadio & Buskirk 2016) y\nzorros culpeos (Franklin 1978).\n78\n79\nFigura 34. Ecorregiones terrestres en distribución de Vicugna vicugna\nii. Estado de conservación y amenazas globales\nEl estado de conservación de la vicuña ha sido calificado como PREOCUPACIÓN MENOR (LC)\ndebido a su amplio rango de distribución, tamaño de la población, la tendencia creciente y su\npresencia en varias áreas protegidas, lo que coincide con la última evaluación realizada el año\n2008 (Acebes et al. 2020).\n80\nFigura 35. Estado de conservación de Vicugna vicugna en Argentina, Bolivia, Chile y Perú.\nAmenazas globales https://www.camelid.org/index.php/es/especies/vicunias\nAmenazas directas\n1. Caza furtiva.\n2. Degradación y fragmentación del hábitat .\n3. Competencia con el ganado doméstico.\n4. Instalación de corrales en gran escala.\n5. Promoción de pacovicunia, (híbrido resultante de la cruza de alpacas y vicuñas) y\ncomercialización de su fibra.\nAmenazas indirectas\n1. Debilidad institucional.\n2. Falta de áreas protegidas efectivas.\n3. Falta de suficiente legislación para regular usufructo y propiedad del recurso.\n4. Falta de información sobre efectos de planes de manejo a nivel individual y poblacional.\n5. Falta de suficientes incentivos para población local para la conservación de la especie.\n6. Existencia de un importante mercado de fibra de origen ilegal.\n7. Minería y proyectos de infraestructura de gran escala.\nLa caza furtiva ha aumentado en forma preocupante durante la última década por lo que los\nprogramas de conservación de la especie deben considerar un adecuado control local e\ninternacional de esta actividad ilícita. El control inadecuado y la prohibición de la\ncomercialización de la fibra de vicuña en los mercados internacionales son los principales\nmotivos de preocupación.\nEs importante reforzar y promover acciones para controlar la situación actual a fin de evitar\nel riesgo de recrear las circunstancias pasadas que dejaron a la especie al borde de la extinción\ndurante los años 60 del siglo pasado. Se han desarrollado planes nacionales de conservación\ny manejo de la especie, pero existen incertidumbres ya que no siempre se ha logrado su\nimplementación.\n81\nLa esquila viva de vicuñas está muy extendida en los Andes y la mayoría de estas prácticas\nse encuentran dentro del desafiante marco del uso sostenible real. La conservación de la\nespecie requiere un mayor compromiso por parte de las comunidades locales y las autoridades\nencargadas de proteger la especie y su hábitat. También requiere un control más estricto del\nproceso de comercialización. Además, la enfermedad sarna causada por el ácaro Sarcoptes\nscabiei está aumentando a un ritmo alarmante en varias poblaciones de Perú, Bolivia,\nArgentina y Chile. Las causas identificadas incluyen la presencia de animales domésticos con\nmalos controles sanitarios y otros individuos de vicuña infectados por malas prácticas de\nmanejo.\nLa preocupación por esta situación ha obligado a las autoridades a iniciar programas de\ninvestigación, especialmente en poblaciones cuya supervivencia está en riesgo. El impacto del\ncambio climático en los hábitats extremadamente áridos de las vicuñas ubicados a gran altitud\nes una preocupación real, especialmente en combinación con el deterioro de pastizales debido\nal sobrepastoreo por parte del ganado doméstico. Además, un riesgo que no debe descuidarse\nes la hibridación de vicuñas con alpacas, una forma ilegal de exportar genes de vicuña.\nFinalmente, el impacto de la expansión de las actividades mineras en los Andes requiere\ninvestigación científica y el monitoreo de la especie para asegurar que no se vea afectada\nnegativamente.\nSe recomienda estudiar las poblaciones de vicuña mediante el método de muestreo a\ndistancia, ya sea para estudios terrestres o aéreos, ya que se basa en suposiciones más\nrealistas en lugar de los métodos de transectos en franjas de ancho fijo que tienden a\nsubestimar el número de poblaciones (Buckland et al. 1993). Sin embargo, cuando las cifras\nson demasiado bajas, como en las poblaciones relictas o nuevas, y el trabajo de campo\ntopográficamente factible, los conteos totales directos son apropiados. Se necesita una\nactualización de la población total de la especie utilizando metodologías basadas en\ninferencias.\nLa caza furtiva provocada por las demandas de fibra de vicuña en el mercado ilegal\ninternacional sigue siendo la principal amenaza para la especie. Según la Reunión Técnica del\nConvenio de la Vicuña (2015) ha habido, con excepción de Ecuador, un aumento alarmante\nde la caza furtiva de vicuñas en toda su área de distribución, afectando especialmente a\npoblaciones chilenas aisladas y relictas, cuya distribución marginal aumenta su vulnerabilidad.\nEntre los factores que facilitan la caza furtiva de vicuñas en los Andes se encuentran los\nsiguientes (SACSG 2014):\n● El amplio rango geográfico de las poblaciones de vicuñas y las extensas áreas\nfronterizas entre los países involucrados;\n● Las características geográficas de la zona, con bajas densidades poblacionales de\nvicuña y alto grado de aislamiento;\n● La falta de recursos humanos y técnicos dedicados a la protección de la especie en los\npaíses anfitriones;\n● El alto valor de los productos de fibra y vicuña en el mercado internacional;\n● La existencia de un mercado sustancial de fibras y artesanías ilegales a nivel local;\n● La falta de castigo efectivo para los cazadores ilegales;\n● La insuficiente confiscación de productos ilegales;\n● Las limitadas fuerzas de seguridad coordinadas dentro y entre países;\n● Los limitados beneficios para las comunidades locales e insuficiente apoyo e incentivos\npara desarrollar el uso legal de la vicuña, lo que resulta en mayores beneficios de los\nusos ilegales que de los legales.\n82\nA continuación, se listan las algunas propuestas para la conservación de la especie:\nCon relación a la cooperación entre países andinos, se proponen las siguientes medidas:\n● Intensificar de la cooperación inter-fronteriza entre países vecinos, incluidas las fuerzas\nde seguridad, que permitan el control de las fronteras internacionales para optimizar\nlos esfuerzos para eliminar el tráfico ilegal.\n● Revisión crítica del cumplimiento de acuerdos y documentos previos, desarrollados\ndurante las Reuniones Técnicas de la Convención de la vicuña sobre caza furtiva y\ntráfico de vicuñas.\n● Registro estandarizado en los cinco países de la fibra obtenida legalmente, su\nprocesamiento, importaciones y exportaciones, para poder monitorear su\ncomercialización.\nSe propone la implementación de las siguientes medidas a nivel nacional:\n● Difusión de información sobre sanciones legales y actualización de las leyes nacionales,\nregionales y locales para hacerlas más efectivas contra la caza furtiva y la\ncomercialización ilegal de fibra y productos de vicuña.\n● Facilitar y apoyar a las comunidades andinas locales en el desarrollo de capacidades\ntécnicas y organizativas para cosechar fibra de sus vicuñas bajo estrictos protocolos\nde bienestar animal.\n● Apoyo gubernamental a las comunidades andinas locales en la comercialización y valor\nagregado de fibra legal, simplificando el proceso y fortaleciendo las etapas de la\ncadena legal del negocio.\n● Suministrar suficiente fibra legal para uso artesanal local a precios subsidiados para\nminimizar el uso ilegal y aumentar el valor agregado de los procesos en los países de\norigen.\n● Fortalecer e implementar a nivel nacional esquemas de supervisión, control legal y\nrastreo del origen de la fibra, desde el corte hasta su conclusión en la cadena de\nsuministro (esquilado, almacenamiento, transformación, comercialización y\nexportación).\n● Capacitar permanentemente a las autoridades policiales, judiciales y aduaneras sobre\nla legislación aplicable y otros temas relacionados con la producción y movimiento de\nfibra, como la identificación de fibras de camélidos y sus subproductos.\n● Intensificar las incautaciones de prendas de vestir ilegales y aplicación de sanciones a\nquienes participen en su compra o venta.\n● Implementar campañas informativas y de concientización, especialmente en sitios\nturísticos y aeropuertos, alertando a los turistas sobre los requisitos que deben cumplir\nlos productos legales elaborados con fibra de vicuña.\nCon relación a la cooperación entre países exportadores e importadores, se propone\nimplementar las siguientes medidas:\n● Fortalecer las redes de cooperación local y agilizar la comunicación entre las\nautoridades CITES y los países importadores y exportadores.\n● Desarrollar y colaborar en la implementación de sistemas de rastreo internacional del\norigen de productos y subproductos de vicuña.\n● Fortalecer los controles en los países importadores sobre el procesamiento y la\ncomercialización de productos y subproductos de vicuña.\niii. Chile\nEl morfotipo Vicuña del Norte se distribuye en Chile entre el límite con Perú hasta los 20°22’S,\nabarcando las Regiones de Arica y Parinacota y de Tarapacá. La Vicuña Austral se distribuye\nentre los 19°S hasta los 23°33’S en la Región de Atacama, a la altura de Vallenar (Vilina et al.\n83\n2015). Existe una zona de solapamiento de los morfotipos en la región de Tarapacá (19°S a\n20°22’S), lo cual sustenta los resultados de análisis genéticos que detectan una zona de\ncontacto genético mucho más extensa, entre aproximadamente los paralelos 18°30’S y\n21°30’S (Ministerio del Medio Ambiente 2019).\nEn Chile, su distribución altitudinal, se establece como cota de elevación máxima del área de\ndistribución de la subespecie mensalis los 5.000 metros sobre el nivel del mar (límite Este)\nque coincide en gran parte con el límite fronterizo con Bolivia respectivamente; y como cota\nde altitud mínima los 3.700 metros sobre el nivel del mar (límite Oeste). Para la subespecie\nmorfológica vicugna, se reporta desde su límite máximo a los 4.700 hasta su límite inferior en\nla cuenca del Salar de Punta Negra, a 2.900 metros sobre el nivel del mar (Ministerio del Medio\nAmbiente 2019).\nLa evaluación de las poblaciones de vicuña a nivel nacional del año 2016, señalan que la\npoblación total de vicuñas es de 12.103 ejemplares, de las cuales 84,4 % corresponde a la\nVicuña del Norte (10.215 ejemplares) y 15,6 % a la Vicuña Austral (1.888 ejemplares). En\nChile, las poblaciones de vicuña se encuentran en 4 regiones administrativas: Arica y\nParinacota (85%), Tarapacá (2%), Antofagasta (11%) y Atacama. (2%). La distribución más\naustral de la especie en Chile es 28°S (Vilina et al. 2015) (Ministerio del Medio Ambiente\n2019).\n1. Estado de conservación\nLa categoría de Conservación de la Vicuña, según Reglamento de Clasificación de Especies\nSilvestres (RCE) es: VULNERABLE (VU) (Ministerio del Medio Ambiente 2019). González y\nGrimberg concuerdan en clasificar de manera separada a ambas subespecies:\nConcuerdan en clasificar a la subespecie Vicuña austral como EN PELIGRO (EN), por criterio\nC. Pequeño tamaño de la población y disminución, ya que existirían menos de 2.500,\nindividuos adultos maduros y se evidencia una reducción poblacional en los últimos 20 años,\ncorrespondiente a 2 generaciones (esta reportado que la vicuña podría vivir unos 10 años en\nvida libre) de más de un 20% (aplicar principio precautorio). El criterio de rebaja, por eventual\nrecolonización de individuos, no aplicaría para esta subespecie, ya que no es tan evidente la\nposibilidad de recolonización desde el sur de Bolivia o desde el este de Argentina. Desde el\nnorte se reporta una zona donde ambas subespecies de hibridan (Ministerio del Medio\nAmbiente 2019).\n2. Estrategias de conservación y actores locales\nEntre las estrategias y acciones de conservación implementadas en Chile destacan, la\nexperiencia de conservación de la Vicuña en el Parque Nacional Lauca, el diseño de un Plan\nNacional de Conservación de la Vicuña, la creación de áreas silvestres protegidas para la\nprotección de sus poblaciones silvestres y el estudio del deterioro de los pastizales alto andinos\ninvolucrados en la disminución de sus poblaciones.\nLa población de vicuñas en Chile mostró cierta recuperación como resultado de la\nimplementación de acciones de conservación, incluyendo la creación de varias áreas\nprotegidas, disminuyendo el alto riesgo de extinción en el pasado. Sin embargo, estudios\nrecientes han revelado una disminución de la población total de casi 5000 animales entre 2008\ny 2017. Además, sigue habiendo poblaciones pequeñas y aisladas que requieren la aplicación\nde planes de conservación eficaces (Acebes et al. 2018).\n84\nEn la actualidad, la Corporación Nacional Forestal de Chile (CONAF) realiza censos anuales\nmediante conteos directos dentro de las áreas protegidas donde habita la especie, apoya\nvarios proyectos de investigación y lleva a cabo un programa de educación ambiental a largo\nplazo a través de diversos medios de comunicación. En el marco del Plan Nacional de\nConservación de la Vicuña existen dos estrategias diferentes en función de las subespecies de\nvicuña y de su estado de conservación. Así, las poblaciones de la subespecie norte (V.v.\nmensalis) están incluidas en el Apéndice II de CITES y se gestionan bajo un uso sostenible\n(comercio de fibra de vicuña) orientado a incrementar los ingresos económicos de las\ncomunidades locales, mientras que las poblaciones de la subespecie sur (V.v. vicugna) están\nincluidas en el Apéndice I. Las acciones de gestión están orientadas a la protección de las\npoblaciones relictas, especialmente en áreas protegidas, estando pendiente su ratificación a\ntravés del Plan Nacional de Conservación de la Vicuña Austral (Acebes et al. 2018).\nConservación de la Vicuña en el Parque Nacional Lauca (1975 - 1985)\nLa conservación de la Vicuña se fortaleció en Chile con la creación del Parque Nacional Lauca\nen 1970. Aunque legalmente la especie estuvo protegida por la Ley de Pesca y Caza, se estimó\nnecesario concentrar los esfuerzos de protección en aquella unidad que concentraba la mayor\npoblación remanente. El primer censo se llevó a cabo en 1976 y arrojó un total de 2.176\nanimales distribuidos en los territorios comprendidos por la cuenca del Salar de Surire, las\npampas de Paquisa, las pampas y bofedales de Guallatire, las pampas y bofedales de\nParinacota y las pampas y bofedales de Caquena (González et al. 2000).\nSe diseñó un Plan de Protección y Vigilancia del Parque Nacional Lauca de superficie 520.000\nhectáreas (Torres et al. 1978) que incluyó la identificación de las amenazas a la especies, la\ndistribución territorial de patrullajes, la coordinación con las fuerzas policiales y militares para\nel control de la caza interna y externa (Bolivia), la contratación y la capacitación de personal\nde todos los niveles, el equipamiento e infraestructura y las técnicas de control de avance de\nlos objetivos del plan.\nEn 1981 se comprobó que el aumento de la población había alcanzado a territorios que no se\npensó podían ser ocupados por la especie. Se comprobó que es posible lograr la conservación\nde la vicuña en estado silvestre en territorios donde habitan comunidades humalas de origen\naymara con intereses económicos y sociales propios (González et al. 2000).\nComo la protección de la vicuña se beneficiaron otras especies silvestres con problemas de\nconservación: Guanaco (Lama guanicoe) y Taruca (Hippocamelus antisis) tuvieron aumentos\ninteresantes en los territorios aledaños a las zonas de patrullaje y vigilancia del Parque\nNacional Lauca. La recuperación de la población de vicuñas en el Parque Nacional Lauca tuvo\ncomo característica la integración de 3 elementos claves: la necesidad de recuperar una\npoblación en peligro, el factor cultural social y el factor económico (González et al. 2000).\nPlan Nacional de Conservación y Manejo de la Vicuña en Chile (Galaz & González 2003).\nProducto de la gran envergadura regional que ha alcanzado el manejo de la vicuña y\nconsiderando las expectativas propuestas para su conservación, en el año 1999 la Corporación\nNacional Forestal (CONAF) asumió el desafío de llevar adelante el Plan Nacional de\nConservación y Manejo de la Vicuña. Esta propuesta está firmemente ligada a la Estrategia\nNacional de Desarrollo del Rubro Camélidos y al Programa para la Conservación de Flora y\nFauna Silvestre Amenazada de Chile. Alcanza la luz gracias al financiamiento aportado por la\nFundación para la Innovación Agraria, a través del proyecto Conservación y Manejo de la\nVicuña (Vicugna vicugna) en Chile.\nPlan Nacional fue generado a través de un Seminario de Planificación que se desarrollo en\nNoviembre de 2002 en la ciudad de Arica. La iniciativa fue organizada por la Corporación\nNacional Forestal de la Región de Tarapacá y auspiciada por la Fundación para la Innovación\n85\nAgraria (FIA) y las compañías mineras Escondida, Doña Inés de Collahuasi y QUIBORAX.\nAuspiciaron el Proyecto Manejo y Conservación de Camélidos Sudamericanos (MACS) de la\nPontificia Universidad Católica de Chile y la Corporación Nacional Forestal (CONAF).\nPatrocinaron el Servicio Agrícola y Ganadero y el Proyecto Vicuña.\nEl Plan considera un Sistema de Control y Vigilancia para la Protección de la Vicuña en las\náreas silvestres protegidas de la Provincia de Parinacota: Parque Nacional Lauca, Reserva\nNacional Las Vicuñas y Monumento Natural Salar de Surire. La superficiede patrullaje abarca\n358.313 hectáreas en la precordillera y altiplano, zona que concentra cerca del 97% de la\npoblación total de vicuñas del país.\nCon el objetivo de realizar un manejo de dichas poblaciones orientado a integrar a la vicuña\nal desarrollo de las zonas altoandinas de la provincia de Parinacota, se propone un sistema\ncompuesto por 7 funciones principales:\n1) identificación de los sitios de captura\n2) mangas de captura\n3) sistema de arreo\n4) captura\n5) esquila\n6) encierro para liberación\n7) monitoreo\nEl Plan Nacional de Conservación (2003) destaca algunas consecuencias económicas del\nmanejo de las poblaciones andinas, dado que la recuperación en la vicuña en la Región de\nArica y Parinacota y Región de Tarapacá, ha producido diversos efectos negativos en el\nsistema productivo de las comunidades andinas de Putre, General Lagos y Colchane, a saber:\n▪ Aumento de la carga animal en las praderas naturales que ha contribuido a degradar\nlos herbazales.\n▪ Competencia en el consumo de forraje con especies domésticas como alpacas, llamas\ny ovinos\n▪ Transmisión de enfermedades parasitarias externas entre especies domésticas y\nsilvestres (sarna)\n▪ La demanda de manejo de la especie muchas veces se transforma en un rechazo\ndirecto hacia las vicuñas dentro de los circuitos de pastoreo debido a la mejor oferta\nde forraje, ello conlleva se produzca la caza furtiva.\n▪\nLas áreas protegidas en Chile con presencia de la especie (Convenio Vicuña 2024):\nÁrea Silvestre Protegida Superficie (ha)\nParque Nacional Llullaillaco 268.671\nReserva Nacional Las Vicuñas 209.131\nParque Nacional Volcán Isluga 174.774\nParque Nacional Lauca 137.883\nParque Nacional Los Flamencos 73.987\nParque Nacional Nevado Tres Cruces 58.082\nMonumento Natural Salar de Surire 11.298\nTotal (ha) 933.826\nIndividuos de la subespecie morfológica V. v. mensalis, está presente en cuatro áreas de\nprotección oficial presentes en su distribución, según el siguiente detalle: Parque Nacional\nLauca, Región de Arica y Parinacota, Reserva Nacional Las Vicuñas, Región de Arica y\nParinacota, Monumento Natural Salar de Surire, Región de Arica y Parinacota, Parque\nNacional Volcán Isluga, Región de Tarapacá. En función de los antecedentes señalados, el\n86\n44,4 % del hábitat de la vicuña del norte se encuentra protegido en unidades del SNASPE\n(Ministerio de Medio Ambiente 2019).\nIndividuos de la subespecie morfológica V. v. vicugna, está presente en 4 áreas de protección\noficial presentes en su distribución, según el siguiente detalle: Parque Nacional Volcán Isluga,\nRegión de Tarapacá, Reserva Nacional Los Flamencos, Región de Antofagasta, Parque\nNacional Llullaillaco, Región de Antofagasta, Parque Nacional Nevado de Tres Cruces, Región\nde Atacama. En función de los antecedentes señalados, solo el 7,6 % del hábitat de la vicuña\naustral se encuentra protegidos en unidades del SNASPE.\nConservación in-situ de Vicuñas en Chile (Jerry Laker & Cristian Bonacic) Macaulay Land Use\nResearch Institute, Aberdeen, Reino Unido Fauna Australis, Facultad de Agronomía e\nIngeniería Forestal. Pontificia Universidad Católica de Chile.\nEl Proyecto MACS, una iniciativa de investigación con financiamiento del programa UE-INCO,\nha investigado las implicancias ecológicas, económicas y sociales de diferentes alternativas de\nmanejo. Desde la liberalización de CITES diversas estrategias de manejo han emergido a lo\nlargo del altiplano basadas en las propias prioridades políticas de cada país.\nEn Chile, después de alcanzar una población de alrededor de 22.000 en 1990, los censos han\nmostrado un descenso persistente hasta el nivel actual de 12.000 individuos. Hay una\ncombinación de factores que al parecer han contribuido a esta situación, tal como degradación\nde vegetación por impacto de niveles no sostenibles de pastoreo, sequía, deterioro en la\ncondición de los bofedales.\nNuevas técnicas para la evaluación post hoc de la condición de recursos forrajeros se utilizan\nen este estudio. El estudio muestra las áreas que están expuestas a fluctuaciones en oferta\nde materia verde y concluye que son estas mismas áreas, los partes más marginales del\nterritorio protegido en que la población de vicuñas ha mostrado una disminución importante.\nEsto evidencia que el factor mas implicado en la caída poblacional ha sido el impacto de la\ndegradación de los pastizales, probablemente exagerado por niveles de precipitación bajo el\npromedio.\niv. Argentina\nEn Argentina, la especie se encuentra en las provincias de Jujuy, Catamarca, Salta, La Rioja y\nSan Juan. La distribución más austral de la especie en América del Sur se encuentra en la\nReserva de la Biósfera San Guillermo, en la provincia de San Juan, Argentina.\nLa población total de vicuñas en Argentina se estima entre 72.678 y 127.072 individuos (Censo\nNacional 2006, Baigún et al. 2008) y el área de distribución actual de la especie en Argentina\n(Arzamendia et al. 2019) se presenta en la Figura 36.\nLa vicuña ocupa el sur de los Andes Centrales donde se encuentran dos unidades\nmorfoestructurales bien definidas geológicamente: la Puna (Jujuy, Salta y Catamarca) y la\nCordillera Frontal (Catamarca, San Juan)(Bonaparte 1978). Se encuentra presente en las\necorregiones Argentinas : Altos Andes y Puna. Adicionalmente, se encuentra presente el las\nsiguientes ecorregiones terrestres globales: ecorregión Puna Seca Andina Central, Puna\nAndina Central y Estepa Andina del Sur (Arzamendia et al. 2019). La vicuña ocupa 6 fisonomías\ndiferentes de vegetación: halofítica, vegas, estepas graminosas, praderas, estepas arbustivas\ny estepas arbustivas abiertas en parte con cactáceas columnares y tolares (Hueck y Seibert\n1972).\n87\nFigura 36. Mapa área de distribución actual de Vicuña (Arzamendia et al. 2019)\n1. Estado de conservación\nLa Categorización de Mamíferos de Argentina (Arzamendia et al. 2019) calificó la Vicuña\n(Vicugna vicugna) como de PREOCUPACIÓN MENOR (LC). La justificación de la categorización\nse señala a continuación.\nVicuña es una especie asociada a las culturas andinas desde hace unos 11.000 años, sin\nembargo, estuvo al borde de la extinción en la década del 60 debido a la caza iniciada desde\nla conquista para obtener su pelaje. Desde hace unas décadas, se ha recuperado en gran\nparte de su área de distribución. En Argentina, luego de estrictas medidas de conservación\naplicadas desde la década del 70, se han registrado incrementos poblacionales. Desde el año\n1996 se clasifica como de BAJO RIESGO y desde 2008 como PREOCUPACIÓN MENOR (LC)\n(Arzamendia et al. 2019).\nDesde el año 1997, las poblaciones de Jujuy y Catamarca han pasado a CITES II,\npermitiéndose su uso mediante captura y esquila en vivo, práctica que se inició en cautiverio\ny posteriormente en silvestría, desde el año 2003. En la última década se ha registrado un\nincremento poblacional de la especie, estimándose el número total de la población de más de\n100.000 individuos y una población actual estable. Sin embargo, dado la posibilidad de uso\nmaterial de la especie, el alto valor económico de su fibra, productos y subproductos, es\nimportante señalar que es clave para su conservación, la implementación de programas de\nmanejo a largo plazo que incluyan un estricto control a nivel local, nacional e internacional.\nLa caza furtiva sigue siendo una amenaza para la especie y se han registrado aumentos\npreocupantes en los últimos años debido al control deficiente tanto en terreno como de los\n88\nprocesos de producción y comercialización de los productos derivados de la especie\n(Arzamendia et al. 2019).\nLa tendencia de la poblacional actual es estable. El último censo nacional completo se realizó\nhace más de una década (Baigún et al. 2008) por lo que no es posible realizar un análisis a\nescala nacional. En ese censo se constataba una tendencia creciente respecto a censos\nrealizados previamente. Sin embargo, en algunos censos realizados recientemente, la\nsituación es heterogénea con algunas subpoblaciones que parecen mostrar un ligero aumento,\nmientras que otras subpoblaciones son tendentes a la estabilidad y /o mostraron disminución.\nSe podría considerar entonces, a nivel regional (país) una tendencia poblacional media estable\npara los próximos años. La población total se ha estimado en más de 70.000 individuos\n(Arzamendia et al. 2019).\nLa calificación de la especie lista y categoriza de 1 (menor) a 5 (mayor) el grado de las\namenazas de la especie (Arzamendia et al. 2019).\n▪ Caza directa ilegal (Grado 5)\n▪ Enfermedades, fragmentación poblaciones y degradación de hábitat (Grado 4)\n▪ Pérdida de hábitat para la especie (Grado 3)\n▪ Atropellamiento en rutas, Urbanizaciones, Infraestructura energética, impacto de\nespecies exóticas y contaminación (Grado 2)\n▪ Depredación por perros (Grado 1)\n▪\nSu estatus de conservación y situación ambiental es heterogéneo. La caza furtiva continúa\nsiendo la principal amenaza sumada a la pérdida de hábitat por sobrepastoreo del ganado y\nla fragmentación debido a la expansión de actividades como minería, turismo y obras de\ninfraestructura (Arzamendia et al. 2012, Mata et al. 2012, Vilá 2012).\nActualmente, genera preocupación la sarna o escabiosis, enfermedad que afecta la salud y\nsupervivencia de las vicuñas y el sustento económico de las comunidades manejadoras. Su\nimpacto puede ser altamente negativo. Un brote de sarna detectado en 2014 diezmó las\nvicuñas del Parque Nacional San Guillermo, con pérdidas del 85% de la población (Donadio &\nPerrig 2017; Aued 2018; Ferreyra 2018). La incidencia de estas enfermedades, está\nrelacionada también con manejos improvisados, falta de bienestar animal y aplicaciones\nincorrectas de tratamientos sanitarios (Arzamendia et al. 2019).\nLas capturas de vicuñas silvestres son actividades riesgosas que exigen planificación y\npersonal capacitado. Las autoridades no incorporan criterios de bienestar animal en la\nfiscalización y hay experiencias de capturas con alta mortalidad y sufrimiento animal.\nOtras amenazas son la falta de diferenciación en políticas de manejo, entre camélidos\ndomésticos y silvestres, tratándolos como “ganado”, la transformación de la especie en un\n“commodity” que conlleva a sobreexplotación y a la pérdida del rol de la especie en el\necosistema (Arzamendia et al. 2019).\nOtras amenazas potenciales son la reproducción de paco-vicuñas (híbridos de vicuñas-\nalpacas), con fines comerciales y proyectos de criopreservación de embriones de camélidos\nque podrían encubrir la posibilidad de apropiación y traslado de los silvestres como si fueran\ndomésticos a áreas fuera de su distribución natural (Arzamendia et al. 2019).\nOtras amenazas registradas son el atropellamiento en rutas asfaltadas de alta montaña\n(corredores transfronterizos) y la depredación por perros (Arzamendia et al. 2019).\nii) Estrategias de conservación y actores locales\n89\nLa vicuña en Argentina está presente en 10 áreas protegidas en las Provincias de Jujuy, Salta,\nCatamarca, La Rioja y San Juan, las que abarcan una superficie total de 31.811 kilómetros\ncuadrados.\nProvincia de Jujuy:\n▪ Reserva Provincial Altoandina de la Chinchilla\n▪ Parque Provincial Laguna de Leandro\n▪ Reserva de Fauna u Flora Olaroz-Cauchari\nProvincia de Salta: Reserva Provincial de Fauna de los Andes\nProvincia de Catamarca: Reserva de la Biósfera Laguna Blanca\nProvincia de La Rioja: Reserva Provincial Laguna Brava\nProvincia de San Juan:\n▪ Reserva de la Biósfera San Guillermo\n▪ Parque Nacional San Guillermo\n▪ Reserva Provincial San Guillermo\n▪\n2. Estrategias de conservación y actores locales\nArzemendia y colaboradores (2019) menciona los Planes de acción y/o Proyectos de\nconservación o manejo actuales:\nEl Convenio Internacional de Conservación y Manejo de la Vicuña, marco para el manejo de\nla especie en los países vicuñeros, contempla un Plan de acción con Objetivos estratégicos y\nsus respectivas Líneas de acción, los que se revisan cada 10 años. Desde el año 2012, la\nSecretaría Provincial de Biodiversidad (SB) dependiente del Ministerio de Ambiente de la\nProvincia de Jujuy, trabaja siguiendo los lineamientos del Plan Provincial de Conservación y\nManejo Sustentable de la Vicuña en Silvestría (PCMV), Ley Provincial Nº 5.634/09 y su Decreto\nReglamentario Nº 5.175/14.\nLos lineamientos planteados para un plan de conservación y uso sustentable de Vicuñas en la\nProvincia de Jujuy (Arzimendia et al. 2012) se proponen los siguientes objetivos estratégicos\nque guían las líneas de acción sugeridas:\nObjetivo 1. Asegurar la conservación de la vicuña y el hábitat en la provincia de Jujuy\n▪ Realizar censos estandarizados de poblaciones de vicuña\n▪ Realizar programas de concientización y educación en las temáticas de conservación\n▪ Fortalecer las áreas protegidas existentes e implementar otras.\n▪ Asegurar la disponibilidad de recursos humanos y financieros\n▪ Desarrollar y aplicar sistemas estandarizados de monitoreo de poblaciones con manejo\ny sin manejo y evaluación de hábitats\n▪ Definir unidades de conservación\nObjetivo 2. Asegurar la participación local en la conservación y el uso sustentable de la vicuña.\n▪ Concientizar, educar y capacitar a las comunidades\n▪ Establecer mecanismos de participación efectiva de las partes interesadas y\ncomunidades locales en la gestión y toma de decisiones y en la distribución justa y\nequitativa de los beneficios de la conservación y uso sustentable.\n▪ Fortalecer la organización social\nObjetivo 3. Establecer mecanismos de manejo y aprovechamiento sustentable de la especie.\n▪ Fomentar el manejo y aprovechamiento en silvestría bajo criterios de bienestar animal\n▪ Establecer criterios y procedimientos adecuados para la captura de individuos.\n▪ Establecer procedimientos estandarizados de técnicas de esquila\n90\n▪ Facilitar el acceso a asistencia financiera, infraestructura y equipamiento.\n▪ Establecer estrictos criterios de control y fiscalización de los animales en cautiverio y\nde la fibra generada en los criaderos.\n▪ Desarrollar un marco tendiente a la protección y conservación del patrimonio genético\nObjetivo 4. Desarrollar una estrategia de comercialización ambientalmente sustentable,\neconómicamente rentable y socialmente justa.\n▪ Posicionar la fibra y sus derivados en mercados internos e internacionales\n▪ Promover la generación de valor agregado en sus diferentes productos\n▪ Identificar y fortalecer las diferentes cadenas de comercialización\n▪ Desarrollar un sistema tendiente a la adecuada certificación de procesos y productos\n▪ Identificar y facilitar acceso a líneas de financiamiento y cooperación internacional\n▪ Desarrollar capacidades de gestión y negociación de pobladores locales en forma\norganizada\nObjetivo 5. Promover del desarrollo de líneas de investigación\n▪ Priorizar los temas de investigación básica, aplicada y evaluación de impactos.\n▪ Promover la participación y cooperación a nivel provincial, nacional e internacional de\norganismos públicos, privados vinculados a la investigación, la conservación y el\nmanejo.\nObjetivo 6. Fortalecer sistemas de fiscalización y control\n▪ Fomentar el fortalecimiento político, institucional y legal\n▪ Capacitar autoridades de medio ambiente, aduaneras, fuerzas de seguridad, poder\njudicial y otras entidades de control.\n▪ Fortalecer la coordinación interinstitucional a nivel provincial y nacional\n▪ Combatir el furtivismo y el tráfico ilegal de especímenes de vicuña.\nObjetivo 7. Sensibilizar y concientizar a la población y a los tomadores de decisión de temas\nde conservación de la vicuña\n▪ Realizar campañas de difusión\n▪ Fortalecer mecanismos de coordinación interinstitucional\nObjetivo 8. Diseñar e implementar un sistema de seguimiento y evaluación el Plan de Acción.\n▪ Diseñar e implementar un sistema de seguimiento y evaluación del Plan de Acción.\n▪\nDesde el año 2012 a la actualidad, 12 comunidades de los Departamentos Santa Catalina,\nYavi y Rinconada, desarrollan Planes de Manejo Locales con el asesoramiento y capacitación\nde la Secretaría Provincial de Biodiversidad (SB), el grupo Vicuñas, Camélidos y Medio\nAmbiente (VICAM), el Consejo Nacional de Investigaciones Científicas y Técnicas (CONICET),\nla Universidad Nacional de Jujuy (UNJU), la Subsecretaría de Agricultura Familiar Delegación\nJujuy (SsAF) y el Instituto Nacional de Tecnología Agropecuaria (INTA)-IPAF NOA.\nEn este contexto, se realizaron 52 manejos de captura y esquila (chakus) obteniéndose\naproximadamente 650 kilogramos de fibra en el periodo 2012 – 2017. En la provincia de\nCatamarca 5 comunidades desarrollan planes de manejo de captura y esquila en silvestría,\ncosechando aproximadamente 600 kilogramos de fibra entre 2012 - 2017.\nLa Dirección Nacional de Biodiversidad del Ministerio de Ambiente y Desarrollo Sustentable de\nla Nación, convocó en 2018 a diversos actores e instituciones para participar en la elaboración\ndel Plan Nacional de Conservación y Manejo de la Vicuña. El uso de la vicuña, planteado como\nestrategia de conservación de la especie, requiere de abundantes y continuos conocimientos\ncientíficos que permitan desarrollar estrategias de manejo adaptativo de la especie.\nConsiderando que las acciones derivadas de cualquier plan de manejo generan presiones en\nlas poblaciones naturales, el desarrollo de un Plan Nacional de Manejo de la Vicuña, requiere\n91\nconocer previamente las bases biológicas y sociales que serán afectadas por estas\nintervenciones para poder medir sus consecuencias, evitando o minimizando sus impactos\nnegativos y potenciando los positivos. Por ello es imprescindible, seguir estudiando los\nprocesos evolutivos, ecológicos (dinámica poblacional, genética) y antrópicos (evaluaciones\nde los manejos de la especie y ecosistémicos) que afectan a la especie silvestre, a largo plazo,\na diferentes escalas y profundizar en aspectos y/o problemáticas emergentes, como la\nincidencia de enfermedades.\nVicuñas, Camélidos y Medio Ambiente (VICAM) www.vicam.org.ar\nv. Bolivia\nEn Bolivia, las poblaciones de vicuña se encuentran en 5 de los 9 departamentos bolivianos:\nLa Paz, Cochabamba, Oruro, Potosí y Tarija. La especie también ha sido reportada en el\ndepartamento de Chuquisaca, lo cual aún no ha sido confirmado (Ministerio de Medio\nAmbiente y Agua 2012). La población de vicuñas en Bolivia se estima en entre 112.490 (Censo\nNacional 2009) y 163.331 individuos (Convenio Vicuña 2017). https://bolivia.wcs.org/es-es\nLa vicuña en Bolivia está presente en 4 áreas protegidas: Parque Nacimiento Sajama, Área\nProtegida Apolobamba, Reserva Biológica Cordillera de Sama y Reserva Nacional de Fauna\nAndina Eduardo Abaroa.\nWildlife Conservation Society Bolivia (2024) señala que la población de vicuñas (Vicugna\nvicugna) en el norte de La Paz, se encuentra en la meseta de Ulla Ulla, en el área protegida\nde Apolobamba, a 4.300 metros de altura, zona caracterizada por la existencia de praderas y\nbofedales aptos para la crianza de camélidos altoandinos. Esta región ha sido clasificada como\nuna de las ocho unidades de conservación de vicuñas en Bolivia y presenta la más alta\ndensidad poblacional de la especie.\nLa puna de Ulla Ulla formó parte del antiguo territorio del señorío Kallahuaya y actualmente\nestán asentadas 27 comunidades que conforman la Asociación Regional de Manejadores de\nla Vicuña de Apolobamba. En 1965 se contabilizaron en la región apenas 96 ejemplares de\nvicuña, demostrando que la especie se encontraba en peligro de extinción. Con la finalidad de\nasegurar la permanencia de la especie, en 1972 se creó la Reserva Nacional de Fauna Ulla\nUlla, actualmente incluida dentro del Área Natural de Manejo Integral Apolobamba. En 1979,\nsiete años después de establecida la reserva, se produjo un incremento de 1.139 individuos;\nen los siguientes censos el aumento fue significativo: en 1996 se registraron 6.536, en 1999\n7.522, en 2002 8.556, en 2005 10.350, en 2008 11.365 y en 2009 11.778 vicuñas (Wildlife\nConservation Society Bolivia 2024).\nEn 2001, Wildlife Conservation Society Bolivia realizó un análisis sobre la distribución de la\nvicuña en Apolobamba, a través de la aplicación de cuestionarios estándar a los\nguardaparques del área. Con la información de los puntos de observación de la vicuña (grupos\nfamiliares y machos solitarios), se estableció su distribución potencial en el área y se diseñó\nel paisaje biológico de la especie.\nWildlife Conservation Society Bolivia brindó apoyo financiero para la realización de los censos\nanuales de vicuña entre 2002 y 2005, y colaboró en la digitalización de los datos de los censos\nde vicuñas de 2008 y 2009. El éxito alcanzado en la recuperación de la vicuña, hace prever\nque su población continuará incrementándose y que la distribución de la especie podrá ser\nmonitoreada para conocer su expansión en la región.\nPor otra parte, entre 2006 y 2008, Wildlife Conservation Society Bolivia ejecutó estudios\nsanitarios de enfermedades en vicuñas y animales domésticos de Apolobamba, en\n92\ncoordinación con la dirección del área protegida y las comunidades de Antaquilla, Caalaya,\nCañuhuma, Curva, Lagunillas, Medallani, Nube Pampa y Puyo Puyo. Los resultados muestran\nque el 94% de las vicuñas evaluadas se encontraba en buen estado de salud, mientras que\nel 31% de alpacas y el 59% de ovinos presentaron signos de enfermedad.\n1. Estado de conservación\nActualmente la vicuña no está categorizada como una especie amenazada, dado que sus\npoblaciones se han recuperado notablemente en todo el rango de su distribución; sin\nembargo, en la década de los 60 estuvo a punto de extinguirse. Para el 2008 la población de\nvicuñas en los cuatro países ha sido estimada en 400.953 animales y en Bolivia se contaron\n112.249 vicuñas durante el censo del año 2009 (Ministerio de Medio Ambiente y Agua 2010).\nNo obstante, la caza continúa siendo la principal amenaza para la especie, así como la\ntendencia a manejar la especie en cautiverio o a realizar cruzas con alpacas (Lichtenstein et\nal. 2008). En Bolivia, además de la cacería furtiva se considera que la competencia con el\nganado y el deterioro de los pastizales son factores que pueden influir en un mediano plazo\nen la especie.\n2. Estrategias de manejo y actores locales\nEl Reglamento para la conservación y manejo de la Vicuña, desarrollado por el Ministerio de\nDesarrollo Sostenible y Medio Ambiente (1997) se plantea el objetivo es regular la\nconservación sostenible de la vicuña en el marco de lo establecido en la Ley de Medio\nAmbiente, el Convenio para la Conservación y Manejo de la Vicuña, la Convención sobre\nComercio Internacional de Especies Amenazadas de Flora y Fauna Silvestres (CITES) y otros\nconvenios internacionales y demás disposiciones legales vigentes relativas a la conservación\nde la vida silvestre.\nEl Reglamento establece que Vicuña (Vicugna vicugna) es una especie de la vida silvestre,\npatrimonio natural y de dominio originario del Estado, su conservación es de interés cultural,\nsocial, económico y ecológico.\nTambién establece que el Ministerio de Desarrollo Sostenible y Medio Ambiente, mediante la\nSecretaria Nacional de Recursos Naturales y Medio Ambiente (SNRNMA), es la autoridad\nnacional responsable y competente de la conservación de la vicuña, a través de su instancia\ntécnica la Dirección Nacional de Conservación de la Biodiversidad (DNCB). Esta Secretaría\ntiene las siguientes atribuciones y funciones:\n● Normar, fiscalizar y autorizar las actividades de preservación, protección, manejo,\nrepoblamiento y uso sostenible de la vicuña y de su hábitat.\n● Aprobar el Programa Nacional de Conservación de la Vicuña y coordinar su ejecución\ncon instituciones involucradas en el tema.\n● Promover la capacitación de las comunidades campesinas en actividades de manejo y\naprovechamiento de la vicuña y en la comercialización de sus productos. Asimismo, facilitar\nel intercambio de experiencias a nivel nacional e internacional.\n● Aprobar los Planes de Manejo de la Vicuña (PMV), previo dictamen de la Prefectura\ncorrespondiente.\n● Fomentar la investigación científica básica y aplicada para el manejo y uso sostenible\nde la vicuña. Llevar el Registro Único de la Vicuña (RUV) y emitir la certificación respectiva.\n● Responsabilizarse del acopio de la fibra, licitando públicamente su transformación en\ntela y venta de la misma, de acuerdo a reglamento específico.\n93\n● Realizar regularmente el Censo Nacional de la Vicuña, en coordinación con autoridades\ndepartamentales, y emitir el resultado oficial.\n● Coordinar y desarrollar acciones integradas con instituciones afiines relativas a la\nconservación de los Camélidos Sudamericanos.\n● Velar por el derecho de las comunidades campesinas a los beneficios derivados del\naprovechamiento de la fibra de vicuña y apoyar su organización para que éstos sean\ndistribuidos en forma equitativa entre las comunidades.\n● En coordinación con el Ministerio de Relaciones Exteriores, representar al país a nivel\ninternacional en el Convenio para la Conservación y Manejo de la Vicuña, la Convención sobre\nComercio Internacional de Especies Amenazadas de Flora y Fauna Silvestres (CITES) y otros\nconvenios internacionales relacionados con la conservación de la vicuña.\nConservación Internacional Bolivia (2024) señala que la vicuña es una de las pocas especies\nque ha tenido atención tanto a nivel nacional, regional como mundial. En Bolivia, existen\ndisposiciones legales para su protección desde 1900, pero es a partir de la firma del Convenio\npara la Conservación de la Vicuña firmado en 1969 entre Perú y Bolivia, y al que\nposteriormente se incorporaron Argentina, Chile y Ecuador, que las medidas de protección\ntuvieron un mayor efecto. De una etapa de protección estricta, en 1979 se pasó a una fase\nen la que se inicia el aprovechamiento de la especie a partir la esquila de animales vivos; en\nBolivia esta etapa se emprende experimentalmente en 1998.\nLa vicuña en el país cuenta con una normativa específica y su conservación se realiza bajo el\nPrograma Nacional para el Aprovechamiento Sustentable de la Vicuña. Al presente, sus\npoblaciones se encuentran en tres grandes tipos de áreas: protegidas, con aprovechamiento,\ny sin manejo alguno; aunque en la mayor parte de las áreas protegidas se realiza su\naprovechamiento para la obtención de la fibra (Conservación Internacional Bolivia 2024).\nUna característica importante en el manejo de la vicuña en Bolivia es que éste se realiza en\nsilvestría y su aprovechamiento es exclusivo de las Comunidades Manejadoras de Vicuña\n(CMV). Sin embargo, el manejo en silvestría por sí solo no garantiza su sustentabilidad, éste\nse ha centrado esencialmente en la obtención de fibra de la especie y se han descuidado otros\naspectos; en este sentido es necesario abordar la conservación de la vicuña bajo un enfoque\nintegral, reconociendo el valor ecológico de la especie y no solamente su valor económico\n(Conservación Internacional Bolivia 2024).\nDesde 1980, se han registrado vicuñas en 38 zonas de los altos Andes bolivianos. Estas zonas\nfueron propuestas para su inclusión en las Áreas de Protección de la Vicuña (APV) nacionales\ny agrupadas en nueve Unidades de Conservación y Manejo, pero ya no se tienen en cuenta.\nPara el censo de 2009 se han definido tres nuevas categorías: 1) Áreas protegidas, 2) Áreas\nen uso y 3) Áreas sin manejo. Actualmente el aprovechamiento racional de vicuñas se realiza\nen 3 de las 4 áreas protegidas. Las poblaciones de vicuñas en Bolivia siguen siendo inseguras,\nprincipalmente debido a prácticas inadecuadas de uso de la tierra que contribuyen a la\ndegradación del hábitat, algo exacerbado por el cambio climático. Otra amenaza importante\nes la caza furtiva, cuyo control es complejo debido a la gran extensión de las zonas donde se\nencuentran las vicuñas (Acebes et al. 2018).\ni. Perú\nPerú es el país con mayor número de vicuñas, con más de la mitad de la población mundial.\nAunque su conservación se ha enfrentado a dificultades, los estudios realizados por diferentes\nentidades del Ministerio de Agricultura en 70.000 km2 informaron de 66.559 vicuñas en 1994,\n103.161 en 1997, 118.678 en 2000 y 208.899 en 2012. En 2016 se estimó una población total\nde 218 000 vicuñas (Acebes et al. 2018).\n94\nLa vicuña en Perú se distribuye entre los 3.200 y 4.600 metros sobre el nivel del mar en la\nProvincia biogeográfica de la Puna. El clima de esta región posee un régimen pluviométrico\nestival, un período largo de aridez, notables variaciones térmicas diarias, humedad baja y\nvientos que aumentan la sequedad y el frío (Lichtenstein et al. 2002).\nEn Perú, las vicuñas se encuentran en los departamentos de Ayacucho, Puno, Huancavelica,\nJunín, Cusco, Arequipa, Apurimac y Lima, representando el 96% de la población total del país.\nEl 4% restante se encuentra en los departamentos de Ica, Moquegua, Cajamarca, Tacna,\nPasco, La Libertad, Ancash y Huánuco. La población total de vicuñas en Perú se estima entre\n208.899 (Ministerio de Agricultura 2012) y 218.000 (Ministerio de Agricultura 2016).\n3. Estado de conservación\nLa especie en Perú está clasificada como Casi Amenazada (MINAGRI 2014, Acebes et al.\n2018).\n4. Estrategias de conservación y actores locales\nActualmente, las vicuñas se encuentran en 6 áreas protegidas (Reserva Nacional Pampa\nGaleras Bárbara D\'Achille, Parque Nacional Huascarán, Reserva Nacional Salinas y Aguada\nBlanca, Reservas Paisajísticas Nor Yauyos - Cochas y Sub Cuenca del Cotahuasi, y Santuario\nHistórico de Chacamarca) que suman 1.427.654 hectareas y 20.122 vicuñas (10% de la\npoblación total) (Acebes et al. 2018)(Tabla 5).\nTabla 5. Superficie (ha) y número de Vicuñas por Área Protegida.\nÁrea protegida Superficie (ha) Nº vicuñas\nReserva Nacional Pampa Galeras - Bárbara D-Achille 6.500 3.921\nReserva Paisajística Nor Yauyos – Cochas 221.268 518\nReserva Paisajística Sub Cuenca del Cotahuasi 490.450 234\nParque Nacional Huascarán 340.000 526\nSantuario Histórico de Chacamarca 2.500 298\nReserva Nacional Salinas y Agua Blanca 366.936 14.625\nTotal 1.427.654 20.122\nEn 1965, cuando se creía que no existían más de 10.000 vicuñas, Perú creó la Reserva\nNacional de la Vicuña Pampa Galeras en Ayacucho (posteriormente rebautizada Bárbara\nD\'Achille en honor a la conservacionista peruana). La estrategia de conservación se basó en\nla protección mediante guardaparques armados y, posteriormente, en la utilización racional\nmediante un sacrificio controlado que provocó un debate internacional y la privación de\nderechos de las comunidades indígenas. A pesar de estas dificultades, las poblaciones\naumentaron, contabilizándose 63.223 vicuñas en Pampa Galeras y la región circundante en\nun estudio que abarcó 2.985.757 ha en 1997. Ese mismo año, las poblaciones de los\ndepartamentos de Ayacucho, Junín, Puno y Arequipa pasaron a formar parte del Apéndice II\nde la CITES, lo que abrió el comercio internacional de fibra de vicuña esquilada viva. La política\nde conservación se orientó hacia la utilización sostenible mediante la esquila en vivo y la venta\nde fibra por parte de las comunidades andinas con tierras en el área de distribución de la\nvicuña. Se establecieron nuevas reservas de vicuña en Salinas y Aguada Blanca, en Arequipa,\ny en el Parque Nacional Huascarán, en Ancash (Acebes et al. 2018).\nEl Proyecto Especial de Aprovechamiento Racional de la Vicuña del Ministerio de Agricultura\n(1978-1993) fue reemplazado por el Consejo Nacional de Camélidos Sudamericanos -\nCONACS, institución integrada por representantes del Ministerio de Agricultura, instituciones\nde investigación en camélidos, gobiernos regionales, comunidades campesinas y la Sociedad\nNacional de Criadores de Vicuña. Como entidad multisectorial, el CONACS tenía la\nresponsabilidad de supervisar la conservación de la vicuña, la esquila en vivo y el comercio de\nfibra de vicuña. Dos grandes problemas asociados a la administración de CONACS han sido el\n95\naumento de la crianza en cautiverio (30% de todas las vicuñas en 2012) y la transferencia\nindiscriminada de vicuñas entre poblaciones genéticamente distintas (Wheeler et al. 2001)\nque requieren un manejo separado. Desde el cierre de CONACS en febrero 2007, la\nresponsabilidad de la conservación de la vicuña se ha fracturado (Acebes et al. 2018).\nLas funciones ejecutivas del CONACS fueron transferidas a 16 Gobiernos Regionales, cada uno\nbajo la dirección de la autoridad nacional del Servicio Nacional Forestal y de Fauna Silvestre.\nA nivel nacional, se ha subdividido la responsabilidad de la conservación de la vicuña.\nActualmente, el Servicio Nacional Forestal y de Fauna Silvestre, organismo dependiente del\nMinisterio de Agricultura y Riego, tiene a su cargo la política, regulación y control de las\nactividades relacionadas con el manejo, conservación y aprovechamiento de los camélidos\nsilvestres y es la autoridad Administrativa CITES (Acebes et al. 2018).\nEl Ministerio del Ambiente a través del Servicio Nacional de Áreas Naturales Protegidas -\nSERNANP tiene la responsabilidad de proteger a las vicuñas dentro del sistema de parques,\nreservas nacionales y es la autoridad científica CITES. Esta fragmentación de la autoridad\ncomplica y dificulta los esfuerzos de conservación, aunque las poblaciones de vicuñas siguen\ncreciendo en Perú con un total de 208.899 reportadas en 2012 (Acebes et al. 2018).\nComo una de las políticas de conservación de la especie, Perú ha adaptado la reintroducción\no repoblación de vicuñas en áreas donde la especie se dio en el pasado, o donde existen\npoblaciones pequeñas y/o vulnerables, y en áreas donde los pastos naturales y el agua\ngarantizan la supervivencia de la especie, beneficiando también a las comunidades locales\norganizadas (Acebes et al. 2018).\niv. Ecuador\nEcuador ratificó en 1982 la adhesión al Convenio Internacional de Conservación y Manejo de\nla Vicuña. En este marco, se realizó la introducción de vicuñas en la meseta de Chimborazo\nque dio origen a la Reserva de Producción Faunística Chimborazo (1987). En el año 2004 se\naprobó el "Reglamento para el Manejo y Conservación de la Vicuña en el Ecuador" que sirvió\nde base para el "Plan de Acción Nacional para la Conservación y Manejo de la Vicuña" como\nrequisito para el cambio de la población de vicuñas al Apéndice II de CITES, que fue aprobado\nformalmente en el año 2013 (Acebes et al. 2018).\nEn el Ecuador la iniciativa estatal de reintroducción de camélidos sudamericanos inició en\n1984, siguiendo las recomendaciones del estudio “Prospección del hábitat de llama en\nterritorio ecuatoriano”1, que buscaba un hábitat similar a la puna alto andina para el manejo\nde camélidos sudamericanos. A partir de ese estudio, el Departamento de Parques y Vida\nSilvestre emprendió dos proyectos: “Reintroducción de la vicuña” y “Fomento de camélidos\nsudamericanos en el Ecuador” (Baptista 2009, Hofstede 2001, White 2001, FAO 2005, MAE\n2006).\nLas vicuñas que se introdujeron en la Reserva de Producción Faunística de Chimborazo\n(58.560 ha) fueron gracias a las donaciones de 200 individuos de Chile y Perú en 1988, y 77\nde Bolivia en 1993. Esta área protegida está ubicada en las provincias de Chimborazo, Bolívar\ny Tungurahua, creada específicamente para la conservación de la vicuña. Los censos\nrealizados durante 2000 - 2016 mostraron una tasa de crecimiento exponencial anual del 11%\nalcanzando los 7.185 individuos en 2016 (MAE 2016), lo que sugiere que ni la depredación ni\nla capacidad de carga están regulando actualmente la especie en la zona (McLaren et al.\n2018).\n96\nEn Ecuador existen dos poblaciones aisladas, un grupo de individuos introducidos en la\nReserva de Producción de Fauna Chimborazo (RPFCH) y otro grupo en terrenos comunales de\nla comunidad San José de Tipín, en la provincia de Chimborazo (Renaudeau d’Arc 2003,\nLichtenstein et al. 2002, Vilá 1999).\nDentro de la Reserva de Producción de Fauna Chimborazo, Albán (2009) identificó tres\nsectores habitados por las vicuñas y que corresponden a los sitios iniciales de liberación.\n● Páramos de Mechahuasca, Carihuairazo y Rio Colorado, donde las vicuñas comparten\nhábitat con camélidos domésticos y rebaños de ovinos.\n● Páramos de El Arenal y Culebrillas, utilizado únicamente por la vicuña.\n● Páramos de El Sinche, Pachancho y Rumipata, habitat compartido con camélidos\ndomésticos y ovinos.\nDe acuerdo a observaciones de Albán (2009), las vicuñas tienen preferencia por dos especies:\nFestuca dilichophylla y Gentiana sedifolia, mientras que Paepalanthus ensifolius es rara vez\nconsumida.\ne. Ñandú de Darwin (Rhea pennata)\nRhea pennata se extiende desde el sur de Perú hasta la Patagonia en Chile. Para Rhea pennata\nse describen tres subspecies: R. p. pennata en el sur de Chile, centro-oeste y sur de Argentina,\nR. p. tarapacensis en el norte de Chile y R. p. garleppi en el sur de Perú, suroeste de Bolivia\ny noroeste de Argentina.\nFigura 37. Ñandú de Darwin (Rhea pennata)\nEl límite geográfico entre tarapacensis y garleppi no es claro, de hecho algunos autores\ndesconocen la condición de subespecie de garleppi, sugiriendo unirla a tarapacensis\natribuyendo las diferencias fenotípicas sólo a variaciones locales (Hellmayr 1932, Hellmayr &\nConover 1942). Incluso se ha propuesto diferenciar este grupo (tarapacensis-garleppi) como\nuna especie separada de R. pennata (Folch 1992). La subespecie denominada pennata se\n97\nencuentra desde el Estrecho de Magallanes y el sur de Chile hasta el centro sur de Argentina.\nLa subespecie tarapacensis se encuentra en el norte de Chile, mientras que la subespecie\ngarleppi se encuentra desde el sur de Perú hasta el suroeste de Bolivia y el noroeste de\nArgentina. Una población muy pequeña de la subespecie pennata fue introducida al norte de\nTierra del Fuego (Schmitt et al . 2022).\nEl tamaño de la población mundial no ha sido cuantificado. La subespecie pennata se describe\ncomo bastante común a nivel local (Schmitt et al. 2022). Teniendo en cuenta la cantidad de\nregistros de observación en eBird (2022), es probable que la población sea muy grande. La\npoblación combinada de las dos subespecies tarapacensis y garleppi probablemente sea\nmenor. Se ha sugerido que la población total de ambas subespecies es tan baja como varios\ncientos de aves.\nEn año 1983, la población peruana se estimó en 18 individuos, con números muy bajos en el\nnorte de Chile, principalmente en el Parque Nacional Lauca (Jaramillo in litt. 1999) y en el\naltiplano de Bolivia. En general, se piensa que estas cifras son demasiado bajas, con al menos\nmuchos cientos en Chile, desde la frontera peruana hasta las tierras altas de Antofagasta\n(Jaramillo in litt. 2014) mientras que la población en Perú se estima en 350 individuos (SERFOR\n2018). Una estimación preliminar indica que la población combinada de tarapacensis y garleppi\npodría estar dentro del rango de 1.000 a 2.499 individuos maduros, pero esto requiere\nconfirmación.\nFigura 38. Distribución de Rhea pennata en Sudamérica (SAGP 1999)\ni. Ecosistemas representados en su distribución\nLa distribución de la especie abarca una superficie de 130 mil kilómetros cuadrados. La\nsubespecie pennata habita en estepas, matorrales, estepas arbustivas y humedales hasta los\n1.500 metros sobre el nivel del mar (Bellis et al. 2006) y nidifica en herbazales (bunch-grass)\nde altura (del Hoyo et al. 1992).\n98\nLas subespecies del norte tarapacensis y garleppi habitan en desiertos, puna salada, llanuras\nde pumicita, turberas y tola (Lepidophyllum) en el altiplano, entre 3.000 y 4.500 metros sobre\nel nivel del mar, hasta los 2.000 metros en la parte oriental de la Cordillera de Los Andes y\nhasta 1.220 metros en La Rioja, Argentina, donde frecuenta el ecosistema Monte desértico,\nexclusivo de Argentina (Pearman in litt. 2014). Suele encontrarse en grupos de 5 a 30\nindividuos, con un macho siempre acompañado de varias hembras. Durante la época de\nreproducción las hembras ponen hasta 50 huevos en un solo nido, que el macho incuba solo.\nLa especie es completamente herbívora y se alimenta de hojas, frutos y semillas de especies\nvegetales de hábito herbáceos y arbustivo (Marinero et al. 2017)\nLa distribución de Rhea pennata abarca un total de 15 ecorregiones terrestres (Figura 39).\nHabita principalmente la ecorregión Estepa patagónica (42%), Monte bajo (16%), Puna árida\n(14%) y Puna (8%) de los Andes centrales. En menor proporción, habita la ecorregión Estepa\nde los Andes del sur (4,7%), Bosque templado valdiviano (2,3%) y Bosque subpolar\nmagallánico (2,8%).\nFigura 39. Ecorregiones terrestres en distribución de Rhea pennata\nii. Estado de conservación y amenazas globales\nLa especie Rhea pennata tiene un área de distribución extremadamente grande y, por lo tanto,\nno se acerca a los umbrales de Vulnerable según el criterio de tamaño de área de distribución\n(extensión de ocurrencia <20 000 km² combinada con una disminución o fluctuación del\ntamaño de su área de distribución, extensión/calidad del hábitat o tamaño de la población y\nun número pequeño de ubicaciones o fragmentación severa).\n99\nSe sospecha que la especie está experimentando una disminución, impulsada por la pérdida\nde hábitat debido a la conversión para la agricultura y los asentamientos humanos, el pastoreo\nexcesivo, la caza y la recolección de huevos.\nEl estado de conservación de Rhea pennata ha sido calificado como PREOCUPACIÓN MENOR\nLC) (Birdlife International 2022). A pesar de que la tendencia poblacional parece estar\ndisminuyendo, no se cree que la disminución sea lo suficientemente rápida como para\nacercarse a los umbrales de VULNERABLE según el criterio de tendencia poblacional (>30%\nde disminución en diez años o tres generaciones). El tamaño de la población no ha sido\ncuantificado, pero no se cree que se acerque a los umbrales de VULNERABLE según el criterio\nde tamaño de la población (<10.000 individuos maduros con una disminución continua\nestimada en >10% en diez años o tres generaciones, o con una estructura poblacional\nespecífica).\nSe cree que las principales amenazas para la especie son la presión de la caza para obtener\nalimento y medicina tradicional, así como la recolección de huevos (Borghi et al. 2017). La\npérdida y degradación del hábitat para la conversión a usos agrícola, ganadero y/o urbano,\npueden representar amenazas adicionales en sectores de su área de distribución (Pedrana et\nal. 2011, Baldi et al. 2015). La especie se caza para alimentación y por sus plumas, que se\nutilizan como plumeros o para medicina y trajes tradicionales (Schmitt et al. 2022). Los huevos\nse recolectan como alimento.\nEntre las acciones de conservación implementadas, ha habido un programa de cría en\ncautiverio en Perú, pero no es seguro si ha continuado (Barrio in litt. 2014), y habita al menos\ntres parques nacionales de Argentina (Pearman in litt. 2014). El estado de conservación de la\nespecie ha sido calificado EN PELIGRO CRíTICO (CR) a nivel nacional en Perú (SERFOR 2018),\ncomo VULNERABLE (VU) en Argentina (MAyDS y AA 2017) y EN PELIGRO (EN) en Chile.\nSe han propuesto las siguientes acciones para la conservación de la especie:\n● Cuantificar el tamaño de la población y monitorear la tendencia de la población.\n● Mantener los hábitats de mallín (pradera) en condiciones adecuadas como sitios de\nanidación (Bellis et al. 2006, Barri et al. 2008, 2009).\n● Prevenir la caza ilegal y la recolección de huevos, mientras se desarrollan programas\nalternativos de recolección sostenible (Barri et al. 2008).\n● Cosechar huevos huérfanos (huevos puestos esporádicamente fuera de los nidos) para\nsu uso en programas de reproducción en cautiverio y reintroducción (Barri et al. 2008).\n● Desarrollar campañas para crear conciencia y reducir la caza, la recolección de huevos\ny la domesticación de aves silvestres inmaduras.\niii. Chile\nRhea pennata tarapacensis\nEn Chile, el suri (Rhea pennata tarapacensis) vive en ambientes de bofedal, estepa y matorral\ndel altiplano, generalmente sobre los 4.000 m de altitud, desde el límite norte con Perú hasta\nel sector de Alto Huasco, en la cordillera de Vallenar (Región de Atacama). Se supone que la\nsubespecie también viviría en el sur del Perú, aunque la literatura señala que, para Perú, así\ncomo también Bolivia y Argentina, sería Rhea pennata garlepii la forma presente. El límite\n100\ngeográfico entre tarapacensis y garleppi no es claro, de hecho algunos autores desconocen la\ncondición de subespecie de garleppi, sugiriendo unirla a tarapacensis atribuyendo las\ndiferencias fenotípicas sólo a variaciones locales (Hellmayr 1932).\nA pesar que la distribución del suri en Chile comprende un amplio sector del altiplano, su área\nde distribución se encuentra fraccionada (Galaz 1998). El acceso a muchos de estos sitios es\ndifícil, y frecuentemente se encuentran asociados a pequeños hábitats de bofedales y salares\nexistentes en la puna chilena (Galaz 1998).\nExiste discrepancia en cuanto a la altitud a la cual puede encontrarse el suri en Chile. Algunos\nautores lo mencionan sobre los 3.500 metros (Jaramillo 2003) y 3.600 metros (Johnson 1965),\nmientras que otros lo mencionan sobre los 4.000 metros en la zona altiplánica (Galaz 1998).\nAltitudes bajo los 4.000 metros han sido reportadas como fuera del hábitat natural (Plenge\n1982). Este mismo autor indica que el suri normalmente se encuentra entre los 4.000 y 4.200\nmetros (Ministerio del Medio Ambiente 2019). La Tabla 6 presenta la evaluación de la\npoblación de suris en área de censo de vicuñas en la Provincia de Parinacota entre el año\n1977 y 2007 (Galaz 1998, Corporación Nacional Forestal 2008).\nTabla 6. Evaluación de población de Suri en área de censo de Vicuñas (1977-2007)\nRhea pennata pennata\nLa subespecie R. p. pennata habita en las estepas de la precordillera y meseta patagónica\nhasta los 2.000 metros sobre el nivel del mar. En Chile su distribución está limitada a reducidos\nsectores de la Región de Aysén y, más ampliamente, a los ambientes de estepa y mallín de la\nRegión de Magallanes, particularmente en áreas de uso agropecuario en las provincias de\nMagallanes, comunas de Laguna Blanca, San Gregorio y la porción norte de la comuna Punta\nArenas, por una parte, y la provincia Ultima Esperanza, comuna Torres del Paine, por la otra\n(Ministerio del Medio Ambiente 2018).\nDe acuerdo a comunicación personal de Julio Cerda, Encargado de Recursos Naturales en el\nServicio Agrícola y Ganadero Región de Aysén, la distribución para la Región de Aysén es muy\ndistinta, pudiendo considerarse como marginal y restringida a sólo dos poblaciones. La primera\nde ellas, corresponde a Entrada Baker, ubicada en la naciente del Río Chacabuco cerca del\nlímite con Argentina, unos 60 kilómetros al sur de Chile-Chico, donde se encontrarían entre\n101\n60 y 100 individuos; la segunda localidad corresponde a la estancia Baño Nuevo, ubicada en\nla naciente del río Ñirehuao, unos 50 kilómetros al noreste de Coyhaique y unos 20 kilómetros\nal norte de Coyhaique Alto, donde habría unos 200 a 250 individuos. En otros ambientes con\nhábitat potencial, como Balmaceda y Coyhaique Alto, la especie tuvo presencia en el pasado,\npero ya no se encuentra, situación debida posiblemente a la gran cantidad de cercos\nexistentes (Ministerio del Medio Ambiente 2018).\nDe acuerdo con las observaciones realizadas por Jurgen Rottmann y Gladys Milic, un factor\nimportante en la reducción de las poblaciones de ñandú fue en el pasado la caza y la cosecha\nde huevos para consumo local, seguida por la depredación por zorros, pumas y perros, los\nasentamientos humanos, los cercos, la explotación petrolera y minera y los fenómenos\nclimáticos extremos (SAG 2002).\nBarri y colaboradores (2008) estudiaron distintas amenazadas para la subespecie,\nconcluyendo que la caza y la colecta de huevos tendrían un efecto mayor sobre las poblaciones\nque el sobrepastoreo y la densidad y éxito reproductivo de la especie.\nLas amenazas potenciales sobre la subespecie patagónica se estima que no son significativas\nhoy en día, ya que la especie ha demostrado estabilidad poblacional junto a la actividad\nganadera, tanto en el orden sanitario y también se ha mostrado estable frente a presiones\ncomo la infraestructura (cercos, pasos de ganado, perros ovejeros, etc.) como aquellas que\ndicen relación al deterioro del pastizal como hábitat producto de la incorporación de una carga\nsignificativa de biomasa (ganado) en su hábitat. Por otro lado, las presiones de caza o colecta\nde huevos de que han sido objeto en el pasado, han disminuido (SAG 2002).\nEn Aysén, para el caso de la estancia Baño Nuevo, en Coyhaique alto, la principal amenaza es\nel cercado de la propia estancia que dificulta el desplazamiento de la población de ñandúes\nchilenos hacia Argentina y el guardaganado, que es una barrera entre los grupos que quedan\ndentro de los predios de la estancia. Para el caso del Valle de Chacabuco, las amenazas son\nel cercado entre el límite predial del Parque Patagonia y el Predio de Carabineros y el límite\nentre éste y el Predio Militar Baker, el cual a su vez está limitado con la frontera Argentina.\nAsí mismo, la presencia de perros en el predio Militar Baker y predio de Carabineros en paso\nRoballos, es una amenaza para la pequeña población de ñandúes del valle de Chacabuco.\nOtra amenaza muy relevante es el aislamiento de las dos únicas poblaciones presentes en la\nregión de Aysén, entre sí y con poblaciones argentinas (CEA 2017).\n1. Estado de conservación\nRhea pennata tarapacensis En el marco del Séptimo Proceso de Clasificación de Especies\n(RCE), el Comité de Clasificación concluye incluir a la especie en la categoría: VULNERABLE\nVU A2a Dado que: A2 Una reducción del 30% en la población inferida en los últimos 30 años\ncorrespondiente a tres generaciones; basada en el punto (a). A2a Reducción poblacional\nbasada en datos obtenidos de los censos realizados en una zona extrapolable al resto de la\npoblación.\nRhea pennata pennata . Según el Reglamento de Clasificación de Especies Silvestres, el Comité\nconcluye que su Categoría de Conservación es: VULNERABLE (VU) [Rebajado desde En Peligro\nEN B1ab(iii)+2ab(iii)]. Para categoría En Peligro Dado que: B1 Extensión de presencia menor\na 5.000 km . B1a Se conoce en menos de 5 localidades. B1b(iii) Disminución de la calidad del\nhábitat debido a ganadería y caza ilegal. B2 Área de Ocupación menor a 500 km . B2a Se\nconoce en menos de 5 localidades (Ministerio del Medio Ambiente 2018).\nEl Comité concluye que su Categoría de Conservación, para Chile en la Región de Aysén, según\nReglamento de Clasificación de Especies Silvestres (RCE) es: EN PELIGRO (EN) [Rebajado\n102\ndesde En Peligro Crítico (CR) CR B1ab(iii)+2ab(iii)] Para categoría En Peligro Crítico (CR) Dado\nque: B1 Extensión de presencia menor a 100 km . B1a Existe en una sola localidad. B1b(iii)\nDisminución en la calidad del hábitat debido a ganadería (cercos) y caza ilegal.\n2. Estrategias de conservación y actores locales\nEn el año 2019, Round River Conservation Studies publicó el Informe técnico: Conservación\ndel Ñandú (Rhea pennata pennata) en el sector Entrada Baker. El estudio tiene por objetivo\ngeneral apoyar la conservación y restauración del ñandú en Chile, colaborando con diversos\nactores, incluidos el Ejército de Chile, el Ministerio de Medio Ambiente, la Corporación Nacional\nForestal, Conservación Patagónica y Carabineros de Chile.\nEl estudio se plantea los siguientes objetivos específicos.\n● Monitorear la población en Entrada Baker, su demografía y estructura poblacional, a\ntravés de un censo anual.\n● Documentar su uso de hábitat, identificando áreas núcleo y corredores actuales y\npotenciales.\n● Dilucidar factores que puedan influenciar en la biología (e.g., reproducción,\nsobrevivencia) y ecología (e.g., movimiento) del ñandú, y ofrecer recomendaciones de\nmanejo.\n● Desarrollar en conjunto con organizaciones asociadas una estrategia integrada para la\nrestauración del ñandú en Entrada Baker.\n●\nEl estudio plantea las siguientes recomendaciones para la conservación y restauración de la\nespecie en Entrada Baker:\n● REMOVER O REDUCIR CERCOS INNECESARIOS\nNuestras investigaciones indican que los cercos están influenciando los movimientos\nde los ñandúes, posiblemente contribuyendo a una tasa elevada de mortalidad y\nprohibiendo su dispersión libre fuera de Predio Ñandú. La fragmentación de hábitat y\nel aislamiento geográfico son factores de riesgo significativos para cualquier especie,\ny el ñandú no es una excepción. Por esto, recomendamos remover secciones de los\ncercos que no sean absolutamente necesarias para el funcionamiento de los Predios,\nespecialmente considerando que ya no hay ganadería ovina en la zona. La mejor\nopción sería dejar los postes como demarcadores de los predios, pero quitarles el\nalambre.\nPor otra parte, para los cercos que hay que mantener, por ejemplo, los potreros de\ncaballo en el Predio Carabineros. Se podría reducir la amenaza que presentan\nmodificándolos para que sean más amigables para la fauna. Por ejemplo, se podría\nreemplazar el alambre de púas con alambre liso, o quitar unos hilos para que los\nanimales pasen sin enredarse. Con la colaboración de actores locales, creemos que se\npodría identificar una solución aceptable. Ofrecemos nuestro apoyo científico y laboral\npara lograr una solución.\n● ELIMINAR EL IMPACTO DE LOS PERROS DOMÉSTICOS.\nLos perros domésticos pueden llegar a ser la fuente principal de depredación a los\nñandúes, más que depredadores nativos como el puma. Y aunque no los depreden,\nlos pueden perseguir y estresar, afectando su anidación y reproducción (Navarro &\nMartella 2002; Cortez et al. 2014).\nEn este momento, entre Predio Militar y el Retén de Carabineros hay un estimado 10-\n15 perros, quienes sirven de mascota, guardián, o históricamente para la actividad\npecuaria. Independiente del cuidado del dueño, la presencia de perros en Entrada\nBaker constituye una amenaza a la población de ñandúes, especie protegida en Chile.\n103\nRecomendamos que los propietarios retiren los perros de sus Predios, o al menos los\nreduzcan al número mínimo que sea necesario.\n● PROTEGER LOS MALLINES.\nLos mallines son hábitat crítico para la anidación y alimentación de los ñandúes. Hay\nuna gran extensión de mallines en Entrada Baker, especialmente en las partes norte\nde Predio Militar y el Retén de Carabineros, que hasta el momento ha sido poco\nexplotada por el ñandú.\nCon la finalización de la ganadería ovina en el Predio Militar, se elimina una fuente de\ndegradación de los mallines y se abre la posibilidad de remover los cercos; como\nconsecuencia, se aumenta el potencial de estas áreas para el ñandú.\n● CREAR UN ÁREA DE CONSERVACIÓN DEL ÑANDÚ ENTRADA BAKER.\nLos esfuerzos de Conservación Patagónica, el Ejército de Chile, Carabineros de Chile,\nel Ministerio de Medio Ambiente, el Servicio Agrícola y Ganadero, y otros para\nconservar el ñandú en Entrada Baker son considerables y merecen reconocimiento.\nPara una especie de amplio rango como es el ñandú, el espacio disponible en Entrada\nBaker es limitado, lo que destaca la importancia y necesidad de formular estrategias\nunificadas para su conservación.\nPara asegurar la conservación de la fauna nativa en Entrada Baker, proponemos la\ncreación de un Área de Conservación del Ñandú, Entrada Baker. Un primer paso sería\nla integración de una junta administrativa con los actores involucrados; en conjunto,\nse podría definir metas y acciones colaborativas dirigidas a la conservación. Ofrecemos\nnuestras capacidades para generar, en primer lugar, un plan de monitoreo. Una acción\ncolaborativa de esta Área de Conservación sería la habilitación de un corredor biológico\nentre Predio Ñandú y Predio Militar y el Retén de Carabineros. Eventualmente, la\npoblación debería expandirse hasta Valle Chacabuco adentro y la frontera con\nArgentina, donde hay otras poblaciones - una a solo 30 kilómetros - sin conexión actual\na Chile (Barri et al. 2009; CEA 2017). Además de su misión de conservar esta especie\ncarismática, un Área de Conservación ampararía a otras especies de la estepa\npatagónica, ecosistema poco conocido y poco protegido en Chile. También proveería\nuna plataforma para lanzar acciones de educación y concientización a la gente local,\nniños, y turistas sobre el estado del ñandú en Chile, la historia de la caza y recolección\nde huevos, y el programa de recuperación del ñandú en Valle Chacabuco. Hoy en día,\nhay escaso conocimiento del ñandú en Aysén, incluso en Cochrane, Chile Chico, y Baño\nNuevo que son los pueblos más cercanos (CEA 2017).\nEl conocimiento es el primer paso hacia la conservación, formando la fundación para valorar\ny después tomar acciones. Creemos que la propuesta Área de Conservación del Ñandú\ncumpliría la función importante de empoderar a la comunidad a que se involucren activamente\nen la conservación y conozcan a esta especie y su ecosistema.\nIntegrantes de Round River Conservation Studies contribuidores a este proyecto:\n● Shalynn Pack, MS/MPP, Bióloga, Investigadora Principal\n● Mateo Pomilia, MS, Biólogo, Director para América Latina\n● Fernando Iglesias L., MS, Biólogo, Coordinador en Chile\n● Adam Spencer, BS, Periodista, Técnico Audiovisual\n● Elizabeth Brunner, MS, Bióloga Marina, Científica\n● Valeria Briones, BS, Bióloga, Científica\n● Scott Braddock, MS, Glaciólogo, Científico\n● Kim Heinemeyer, PhD, Bióloga, Directora de Ciencia\nESTUDIO DE ABUNDANCIA Y FACTORES DE AMENAZA PARA LA CONSERVACIÓN DEL ÑANDÚ\nEN LA REGIÓN DE AYSÉN (2016-2017).\n104\nObjetivo: Establecer el estado actual de conservación de las poblaciones de ñandú en la región\nde Aysén. Objetivos específicos: (a) Identificar los factores de amenaza que afectan a las\npoblaciones de ñandú, (b) Estimar la abundancia y distribución del ñandú en Aysén y (c)\nPromover medidas de conservación y protección del ñandú entre las comunidades aledañas.\nRECUPERANDO AL ÑANDÚ EN EL PARQUE NACIONAL PATAGONIA.\nEn la región de Aysén el ñandú se encuentra presente solo en dos sectores: Ñirehuao, 100\nkm al norte de Coyhaique, y en el Valle Chacabuco que hoy forma parte del Parque Nacional\nPatagonia. En este valle se desarrolló una ganadería ovina extensiva hasta el 2008, haciendo\nque una población de unos 20 ñandúes haya estado aislada por más de un siglo por la barrera\nque representan los cercos ganaderos y por ello expuestos a un alto riesgo de extinción.\nPara revertir esta tendencia, en 2014 iniciamos un programa de Conservación y Recuperación\ndel Ñandú, estableciendo una primera guardería, Puesto Ñandú, para otorgar protección a\nesta especie y realizar acciones de monitoreo orientadas a identificar las amenazas,\npredadores naturales y mejorar el conocimiento de la población del área. Hacia fines de ese\nmismo año, durante un patrullaje realizado por Carabineros del retén fronterizo Entrada Baker\nse rescataron dos charitos (polluelos de los ñandúes) huérfanos, que se convirtieron en los\nprimeros integrantes del Centro de Reproducción de Ñandú, que inició su funcionamiento de\nacuerdo a las disposiciones de la Ley de Caza.\nEste centro es el primero en su tipo en Aysén y entre sus principales objetivos están: evitar la\nextinción local y aumentar la distribución del ñandú como especie en peligro en el Parque\nNacional Patagonia; desarrollar un monitoreo sistemático de la población silvestre de ñandúes,\na través de la realización de censos y el registro de individuos, indicadores reproductivos\n(nidos y nidadas) y un seguimiento de la tendencia poblacional, vinculando la conservación\nin-situ en el medio silvestre con técnicas de manejo en cautiverio y liberaciones para el\nfortalecimiento de la población de ñandúes entre otros.\nEl centro de reproducción cuenta con dos guarderías y un equipo de guardafaunas\nespecializados, además de voluntarios y practicantes. Además, se han instalado 15 cámaras\ntrampas y se han marcado seis ñandúes con radio collar.\nEn marzo del 2015 se sumaron diez charitos al centro de reproducción, provenientes de un\ncriadero comercial con base genética magallánica, los cuales fueron trasladados en avioneta,\nen un operativo sin precedentes. Con este núcleo fundador se estableció la población inicial\ndel centro. Adicionalmente, hacia fines del 2015, cuatro charitos huérfanos del medio silvestre\nlocal fueron rescatados nuevamente por Carabineros, los que fueron incorporados a esta\niniciativa.\nPara los períodos reproductivos de 2017-2018-2019 se trasladaron huevos obtenidos de nidos\ndel medio silvestre desde la Estancia Baño Nuevo (Ñirehuao) para enriquecer la genética de\nindividuos a ser liberados desde el centro de reproducción. Estos huevos se recolectan en el\nmes de octubre y luego son puestos en incubadora en Coyhaique. Posteriormente, durante el\nverano se hace el traslado de los charitos nacidos hasta el parque, donde son mantenidos en\ncorrales y adoptados por los machos adultos que son los que crían a los charitos. Una vez que\nalcanzan su desarrollo óptimo, en otoño se realiza su liberación.\nTambién, en colaboración con el Centro de Reproducción de la Reserva Quimán el año 2021\nse trasladaron diez charitos desde Futrono, Región de los Ríos, al parque por vía aérea, a fin\n105\nde ser incorporados a los grupos de ñandúes a ser liberados al medio silvestre, reforzando la\nrecuperación del ñandú en las estepas del Parque Nacional Patagonia.\nUn aspecto relevante observado en los dos últimos años, ha sido los registros recurrentes de\nindividuos silvestres de ñandú en sectores donde antes no se observaban, lo que se debe al\nretiro de alambrados y cercos ganaderos iniciado en los años 2014-2015.\nA consecuencia de las liberaciones realizadas (64 ejemplares a Mayo de 2021) y las acciones\nde protección, la población de ñandúes se ha incrementado en más de tres veces su número\ny en más de 30% el área inicial de su distribución al interior del Parque Nacional. También se\nha loUgrado el involucramiento y participación activa de diferentes actores locales claves como\nCarabineros, el Ejército de Chile, estancieros, y por supuesto CONAF, SAG y la comunidad en\ngeneral.\nEl último censo (marzo 2021) arrojó 68 ñandúes adultos y 24 charitos libres en el Parque\nNacional Patagonia. La meta es aumentar la población a 100 ñandúes adultos en vida libre lo\nque representa una oportunidad real de reproducción y por lo tanto de recuperación numérica\npoblacional, lo que permite su recuperación funcional en el ecosistema como herbívoros\ndispersores de semillas y como especie clave de la estepa patagónica junto al guanaco.\niv. Bolivia\nEn Bolivia el Rhena pennata está registrada en los departamentos de la Paz, Oruro y Potosí\n(Ergueta y Morales 1991). En La Paz, en las provincias de Pacajes, Oruro provincias Sabaya,\nSajama, Litoral, y Potosí por el salar de Uyuni. También en los más conocidos parques\nnacionales de Sajama, y Eduardo Avaroa (Colque, 2003). El Avestruz andino habita en\ndesiertos, suelos salinos, estepas arbustivas de Lepidophylum, áreas poco inundadas y\nbofedales (Fjeldsa & Krabbe 1990).\nEl suri es el ave símbolo de las altiplanicies andinas, desde hace siglos, ya formaba parte de\nla vida cotidiana del habitante altiplánico, así ́ lo manifiestan los vestigios de arte rupestre,\ndonde se representaban suris junto a cazadores, camélidos o pumas (Koepcke y Koepcke,\n1963).\nA nivel nacional tiene dos fuentes amenazas, que causan la reducción de sus poblaciones:\n● La caza indiscriminada de ejemplares adultos, para la extracción de plumas, materia\nprima utilizada para la confección de trajes folklóricos de los Suri Sicuris y tobas. En\nlos últimos años se ha incrementado la fabricación de plumeros (Rocha et al. 2003).\n● La recolección masiva de huevos para su venta en ferias locales y para consumo\ndoméstico en la elaboración de panes y pasteles en el mes de noviembre para la fiesta\nde “todos santos” (Mamani 1997). El precio de cada huevo es de 25 a 30 bs\ndependiendo de la demanda (Quiroga 2000).\n● También se considera amenaza la competencia alimentaria por parte del ganado\ndoméstico y la creciente población de vicuñas sobre los humedales altiplánicos.\n● Intervención humana sobre su hábitat, producto del turismo, la explotación minera y\ndel aumento de la microcirculación en las áreas de alimentación y reproducción.\n● Efectos directos sobre la fertilidad de la población a causa de la cosecha y depredación\nde huevos, alteración del hábitat en estación reproductiva, entre otras. El Suri reviste\ngran importancia en la vida del poblador de la región alto andina, ya que esta especie\nes utilizada en su alimentación (aprovechando su carne y huevos); en la medicina\nnatural y en actividades artesanales (grasa y plumas), siendo una especie\neconómicamente rentable (Belon 1981).\n106\n● La carne del Suri es comestible y agradable, también se practica bastante la recolección\nde huevos para el consumo directo, ó para utilizarlo en la medicina tradicional, por el\npoder que se le atribuye para la calcificación de los huesos, esto por su alto contenido\nde calcio, también controla las hemorragias. También se utiliza la cascara del huevo\npara controlar diarreas y cólicos (Montes de Oca 1985).\nFigura 40. Distribución de Suri en Bolivia (Ministerio del Medio Ambiente y Aguas 2009)\n1. Estado de Conservación\nEl Suri, es una especie que Bolivia se encuentra EN PELIGRO (EN) (Ministerio del Medio\nAmbiente y Aguas 2009).\nFigura 41. Proyecto BOSNI (1996) World Wildlife Fund Bolivia.\n107\n2. Estrategias de conservación y actores locales\nEl avestruz andino o Suri es una especie protegida en la Reserva Natural de Fauna Andina\nEduardo Abaroa y en el Parque Nacional Sajama. Está incluida en el Apéndice I de la\nConvención sobre el Comercio Internacional de Especies Amenazadas de Fauna y Flora\nSilvestre (CITES) y dentro del Decreto Supremo de Veda General Indefinida.\nA nivel regional (Bolivia, Chile y Perú), como medidas de conservación propuestas, se ha\nformado la Red de Conservación del Suri (2005). Para el año 2009 estuvo prevista la\nrealización de un proyecto sobre la situación del Suri en Bolivia, con datos poblaciones\nglobales, aspecto que se desconoce. Una meta por lograr es que la especie pase a la categoría\nII del CITES para iniciar proyectos de manejo sostenible.\nv. Perú\nEn el Perú, el Suri se distribuye en los departamentos de Puno, Moquegua y Tacna, sobre los\n4.000 metros sobre el nivel del mar, en un área de 10.849 kilómetros cuadrados, con 37%\npara el departamento de Moquegua, 33% para el departamento de Puno y 30% para el\ndepartamento de Tacna.\nEn Puno han sido registrados en el distrito de Capazo, en las comunidades de Tupala, San\nJosé y Rosario de Ancomarca, Chua, Chichillapi, Viluta, Llusta, Patjata, Alto Llallahua y Jihuaña.\nEn Tacna, las localidades de Mamuta, Kallapuma, Mamaraya y Vilacota son los sitios donde se\navista con mayor frecuencia (Cruz 2013).\n108\nFigura 42. Mapa distribución de Suri en el Perú (INRENA 2007)\nSegún la tradición oral de los pueblos de la sierra del sur del Perú, en la época del Incanato,\nlas poblaciones de Suri eran bastantes densas, y conformaban numerosas bandadas de 100\na 120 ejemplares. Además, la especie era considerada propia del estado incaico y estaba\nprohibida su caza, así ́como la recolección de sus huevos. Luego, el poco interés de parte de\nlas autoridades durante la época de la Colonia, el Virreinato y, posteriormente, la República,\ntrajo como consecuencia el decrecimiento de sus poblaciones (Pulido, 1991).\n1. Estado de conservación\nAunque posee una distribución relativamente más extensa que otras especies amenazadas,\nque incluye a varios países de América del Sur, en la actualidad está considerada como en\nPeligro Crítico (CR) en Perú.\n2. Estrategias de conservación y actores locales\nPara conocer el real estado de la población del suri, la Dirección de Conservación de la\nBiodiversidad del Instituto Nacional de Recursos Naturales (INRENA), realizó el Primer Censo\n109\nNacional de Rhea pennata Suri. Con participación de la Red Nacional para la Conservación del\nSuri (Rhea pennata).\nFigura 43. Resultado evaluación poblacional de Rhea pennata a nivel nacional (2008)\nEl Ministerio de Agricultura y Riego (MINAGRI) a través del Servicio Nacional Forestal y de\nFauna Silvestre (SERFOR) realizó el II Censo Nacional del Suri (Rhea pennata), del 8 al 15 de\njunio del 2016 en las regiones de Moquegua, Puno y Tacna, a más de 4.000 metros sobre el\nnivel del mar, contándose con datos preliminares de avistamiento de un total de 350\nindividuos, distribuidos por departamentos: Tacna (180), Puno (98) y Moquegua (72) (Figura\n44).\nFigura 44. Evolución del tamaño poblacional de Suri (Rhea pennata)\nEl Suri se encuentra protegida legalmente:\n● Con D.S. No 158-77-AG (31/03/1977) se aprueba (Reglamento de Conservación de\nFlora y Fauna Silvestre), para los fines de protección, se clasificará las especies\nsilvestres de la flora y fauna en:\na. Especies en vías de extinción: aquellas que están en peligro inmediato de\ndesaparición, y cuya supervivencia es imposible si los factores causantes\ncontinúan actuando.\nb. Especies Vulnerables: aquellas que, por exceso de caza, por destrucción del\nhábitat y por otros factores son susceptibles de pasar a la situación de especies\nen vías de extinción.\nc. Especies Raras: aquellas cuyas poblaciones naturales son escasas por su\ncarácter endémico u otras razones y que podrían llegar a ser vulnerables:\n110\nd. Especies en Situación Indeterminada: cuya situación actual se desconoce con\nexactitud, en relación a las categorías anteriores, las que sin embargo\nrequieren la debida protección; y\ne. Especies Fuera de Peligro: no situada en las categorías anteriores y que no\nestán amenazadas.\nPor Resolución Ministerial, se establecerá́ la lista de especies protegidas de flora y\nfauna silvestres según la categorización señalada. Dicha lista será ́actualizada cada dos\naños si fuera necesario.\n● Con D.S. No 002-96-AG el hábitat del Suri se declara la Zona Reservada Aymara-\nLupaca ZRAL (categoría transitoria para Área Natural Protegida), para la Protección y\nManejo de Flora y Fauna Silvestre, en los distritos de Zepita, Huacullani, Desaguadero,\nKelluyo, Pizacoma, SantaRosa y Capaso, con 300.000 hectáreas.\n● Con D.S. N° 013-99-AG (19/05/1999), se considera al "Suri" (Pterocnemia pennata)\ncomo una Especie de faunasilvestre envías de extinción, prohibiéndose sucaza,\nextracción, transporte y/o exportación con fines comerciales de todo espécimen,\nproductos y/o subproductos.\n● El 16/09/2004 mediante D.S. N° 034-2004-AG (Categorización de especies\namenazadas de fauna silvestre y prohíben su caza, captura, tenencia, transporte o\ncomercialización. El Suri (Rheapennata) fue considerado en la catecategoríaPeligro\nCrítico(CR), prprohibiéndoseu caza, captura, tenencia, transporte o eexportacióncon\nfines comerciales, aasí como productos y/o subproductos provenientes de la especie.\n● Con Ordenanza Regional Nro. 016-2009-CR/GOB.REG.TACNA (27/04/2009) el\nGobierno Regional de Tacna, Declara al suri (Pterocnemia pennata) como ave\nrepresentativa de la Región Tacna.\n● El 22/10/2013 con Ordenanza Regional No 018 - 2013-GRP-CRP, el Gobierno Regional\nde Puno, Declaró de interés regional la preservación del “Suri o ñandú́ andino” (Rhea\npennata); para evitar su extinción y contribuir con su protección, conservación y\nreintroducción a su hábitat natural; por ser una especie de prioridad regional,\nambiental, social y económica para la zona alto andina de la Región Puno.\n● El 07/04/2014 con D.S. N° 004-2014-MINAGRI (Actualización de la lista de clasificación\ny categorización de las especies amenazadas de fauna silvestre legalmente\nprotegidas), el “Suri” (Rhea pennata) fue considerada en la categoría En Peligro Crítico\n(CR), prohibiéndose su caza, captura, tenencia, transporte o exportación con fines\ncomerciales, así ́como los productos y/o sub productos de la especie.\n● Mediante Resolución de Dirección Ejecutiva N°139-2015-SERFOR-DE (4/11/2015) se\naprobó́ el Plan Nacional de Conservación del Suri (Rhea pennata) en el Perú, durante\nel periodo de 2015-2020, para garantizar la conservación y el manejo sostenible del\nSuri (Rhea pennata) y sus hábitats.\nEl Servicio Nacional Forestal de Fauna Silvestre elaboró en el año 2015 el Plan Nacional para\nla Conservación del Suri (Rhea pennata) para un período de 5 años. Su objetivo general es\ngarantizar la conservación y el manejo sostenible del Suri (Rhea pennata) y sus hábitats,\nmientras que sus objetivos específicos se indican a continuación:\n● Garantizar el control y vigilancia oportunos para la conservación del Suri en el ámbito\nde su distribución natural.\n● Generar conocimiento sobre las poblaciones in situ y ex situ del Suri.\n● Disminuir el riesgo de pérdida de hábitat con desarrollo de conciencia y gestión\nparticipativa para la conservación del Suri.\n111\nEl Plan Nacional señala que actualmente se han implementado las siguientes medidas de\nconservación:\n● Conservación in situ: El Suri se encuentra protegido en las siguientes Áreas Naturales\nProtegidas:\n○ Área de Conservación Regional (ACR) Vilacota – Maure (Tacna) (124.313\nhectáreas).\n○ Área de Conservación Privada (ACP) Taypipiña (Puno) (651 hectáreas)\n○ Área de Conservación Privada (ACP) Checca (Puno) (560 hectáreas).\n● Conservación ex situ: El Suri se encuentra manejado en cautividad en dos centros de\nrescate con fines de reintroducción, ubicados en Puno y Lambayeque, y en un proyecto\nde centro de rescate ubicado en Puno:\n○ Centro de rescate Sumac Kantati. Conducido por el Instituto Mallku para el\nDesarrollo Sostenible.\n○ Centro de rescate Proyecto Especial Binacional Lago Titicaca – PEBLT.\n○ Centro de rescate Suri-Sican. Ubicado en el Sector Rural Baldera – Pimentel,\nChiclayo, Lambayeque, aprobado para el rescate e investigación en aspectos\nfisiológicos reproductivos y de manejo en cautividad mediante incubación\nartificial de esta especie.\nEl Plan Nacional propone la realización de actividades en 7 líneas de acción según los objetivos\nespecíficos planteados, a saber:\n1. Investigación y monitoreo de la especie y su hábitat\na. Identificación y monitoreo de sitios de nidificación\nb. Evaluaciones del hábitat actual, distribución histórica e identificación de áreas\npotenciales\nc. Realización de Censos Nacionales del Suri\n2. Control y vigilancia\na. Control sanitario y vigilancia de transmisión de enfermedades de animales\ndomésticos.\nb. Implementación e estrategias para el establecimiento de comités de control y\nvigilancia participativa.\nc. Control y vigilancia a través de guardaparques en Áreas Nacionales Protegidas\n3. Manejo en libertad\na. Estudios de caracterización genética y morfología de la especie\nb. Estudios sobre requerimientos de la especie incluyendo alimento, agua, refugio\ny lugares de nidificación y cría.\nc. Análisis de viabilidad poblacional\nd. Identificación de áreas prioritarias para la conservación del Suri\ne. Realización de diagnósticos en áreas donde se encuentra el Suri que tengan\nalto grado de perturbación\nf. Identificación y propuesta de remediación de actividades antropogénicas que\nafecten a la conservación de las poblaciones silvestres del Suri.\ng. Restauración de hábitats degradados y desarrollo de estrategias de manejo de\npastizales o pastos mejorados\n4. Manejo en cautividad para la reintroducción y repoblamiento\na. Diagnóstico situacional de los especímenes mantenidos en cautiverio\nb. Implementación de planes de manejo ex situ\nc. Desarrollo marco normativo para el uso comercial de subproductos del Suri\nd. Análisis genético de las poblaciones en cautividad para determinar su viabilidad\ne. Realizar evaluaciones técnicas de incubación artificial y desarrollo de protocolos\n112\nf. Evaluar y mejorar el plano nutricional del plantel reproductor y especímenes\npotenciales para repoblamiento\ng. Evaluar y mejorar los programas sanitarios y de bioseguridad\nh. Desarrollar técnicas de biotecnología reproductiva\n5. Repoblamiento y reintroducción\na. Elaboración de documento de planificación: Plan de reintroducción o\nrepoblamiento\nb. Definir áreas para repoblamiento o reintroducción de especímenes\nreproducidos en cautividad\nc. Ejecución de estrategias de concientización y sensibilización a autoridades y\npoblación local en áreas de repoblamiento o reintroducción delimitadas\nd. Ejecución de acciones de repoblamiento o reintroducción\ne. Monitoreo de especímenes liberados\n6. Capacitación y difusión\na. Mejorar la capacidad técnica y profesional de los trabajadores de los centros\nde manejo ex situ\nb. Actividades de sensibilización a público en general respecto a las normas de\nprotección de la especie y su importancia socio económica y ambiental\nc. Elaboración de manuales técnicos, folletos informativos, trípticos, dípticos,\nposters, videos, entre otros.\n7. Gestión participativa\na. Establecer convenios para gestionar recursos económicos y técnicos de\ncooperación\nb. Desarrollo de estudios de factibilidad económica de proyectos turísticos\nrelacionados con el Suri\nc. Establecer y promover estrategias turísticas con el Suri en beneficio de los\npobladores rurales\nd. Reactivar y fortalecer la Red Nacional para la Conservación del Suri\ne. Identificación de actividades productivas diversificadas de bajo impacto que\nbeneficien a la conservación de la especie y a las comunidades campesinas\nf. Diagnóstico situacional de las comunidades campesinas en contacto directo con\nla especie\ng. Involucramiento de las comunidades campesinas en contacto directo con la\nespecie en la ejecución del Plan de Conservación del Suri.\nLos autores del Plan de Conservación del Suri pertenecen al Servicio Nacional Forestal y de\nFauna Silvestre SERFOR, a la Dirección de Gestión Sostenible del Patrimonio Forestal y de\nFauna Silvestre y a la Dirección de Políticas y Regulación.\nvi. Argentina\nEn Argentina, Rhea pennata pennata posee una amplia distribución, encontrándosela desde\nlas Provincia de Mendoza y sur de la Provincia de Buenos Aires hasta el Estrecho de\nMagallanes.\nLa especie se encuentra en 26 áreas protegidas, a saber:\n1. Parque Nacional Bosques Petrificados de Jaramillo\n2. Parque Nacional Los Glaciares\n3. Parque Nacional Laguna Blanca\n4. Parque Nacional Perito Moreno\n5. Parque Nacional Lanín\n6. Parque Nacional Talampaya\n113\n7. Parque Nacional Nahuel Huapi\n8. Monumento Natural Laguna de los Pozuelos\n9. Parque Nacional El Leoncito\n10. Parque Nacional San Guillermo\n11. Reserva de Biósfera Pozuelos\n12. Reserva Natural Provincial Laguna Blanca\n13. Reserva Provincial Alto Andina de la Chinchilla\n14. Reserva de Fauna y Flora Olaroz-Cauchari\n15. R.Vicuñas y Protec.Ecosistemas Laguna Brava\n16. Reserva Provincial de Fauna Los Andes\n17. Parque Provincial Ischigualasto\n18. Refug.Privado de Vida Silvestre Los Morrillos\n19. Parque Provincial Cumbres Calchaquíes\n20. Parque Nacional Monte León\n21. Área Natural Protegida Bahía de San Antonio\n22. Área Natural Protegida Meseta de Somuncurá\n23. Reserva Natural de la Defensa Punta Buenos Aires\n24. Parque Nacional Patagonia\n25. Parque Nacional Islote Lobos\n26. Parque Interjurisdiccional Marino Makenke\nf. Huemul (Hippocamelus bisulcus)\nEl huemul es endémico de Chile y Argentina y actualmente sólo habita en los Andes del sur\nde Chile y Argentina (Vila et al. 2006). La subpoblación de la zona de Nevados de Chillán (VIII\nRegión de Chile) es la más aislada, con una distancia de unos 400 km de la subpoblación más\ncercana al sur, en el Parque Nacional Nahuel Huapi (Argentina, 40°30\'S, SIB-Administración\nde Parques Nacionales, www.sib.gov.ar). La parte sur del Parque Nacional Lanín (Argentina)\naún puede tener una subpoblación, pero los últimos estudios no detectaron la presencia de la\nespecie (Pastore et al. 2013).\n114\nFigura 45. Huemul (Hippocamelus bisulcus)\nSin embargo, se reportaron restos óseos en Laguna Fría, Parque Nacional Lanín. Un macho\nfue fotografiado en el Parque Nacional Nahuel Huapi y se han reportado avistamientos en este\nparque (SIB- Administración de Parques Nacionales, www.sib.gov.ar). La distribución actual\npresenta un alto grado de fragmentación, siendo las poblaciones costeras de la Patagonia\nchilena las menos fragmentadas, y el tramo más continuo de poblaciones se encuentra en\nzonas casi sin presencia humana (Corti et al. 2005). Sin embargo, el grado de aislamiento de\nlas subpoblaciones en gran parte de la región, o sus efectos, siguen sin estar claros.\nEl área de distribución histórica del Huemul cubría un rango latitudinal de 20 grados a lo largo\nde unos 2.000 km. En el sur de la Patagonia el Huemul llegaba hasta el Atlántico, y aunque\nse daba en la estepa patagónica hacia el norte, actualmente no se sabe con certeza hasta\ndónde podrían haber llegado hacia el este (Díaz y Smith-Flueck 2000). Antiguamente, el\nhuemul se encontraba a lo largo de los Andes al sur del río Cachapoal (34°) hasta el estrecho\nde Magallanes (54°S) en Chile, y desde aproximadamente 36° 50\'S hasta el sur de la provincia\nde Santa Cruz, Argentina (Díaz y Smith-Flueck 2000). Sin embargo, incluso recientemente un\nHuemul fue fotografiado a 36° 41\'S cerca de la frontera con Argentina (Vidoz 2012). Como\nresultado de los acontecimientos pre y postcolombinos, hay pocos documentos históricos de\nla existencia del huemul en paisajes extraandinos (revisados en Huemul Task Force 2012),\npero la idoneidad de las elevaciones más bajas para el huemul está evidenciada por restos\nfósiles (Pérez y Batres 2008) e informes anecdóticos (véase Díaz 1993, 2000).\ni. Ecosistemas representados en su distribución\nEn la actualidad, el huemul se encuentra principalmente en la cordillera de los Andes, desde\nel nivel del mar hasta los 3.000 metros de altitud. Habita los bordes boscosos y en especial\nde los bosques de Nothofagus sp. Localmente, el huemul sigue encontrándose en una gran\nvariedad de hábitats: desde llanuras de valles hasta laderas empinadas de montañas, desde\n115\npraderas abiertas hasta hábitats arbustivos o boscosos cerrados, incluyendo hábitats post-\nincendio o mixtos. Se ha observado que el patrón de uso de los distintos componentes del\nhábitat varía y depende de la disponibilidad, la estación, la fenología, la presencia de otros\nherbívoros y depredadores o las perturbaciones, y se refleja en su amplio espectro dietético\n(véase más adelante). Se ha estimado que el tamaño anual del área de campeo en algunos\nhábitats utilizados actualmente es de unas 350-650 ha, con distancias de desplazamiento\ndiarias de hasta 8 km, pero raramente de más de 5 km (Díaz y Smith-Flueck 2000, Gill et al.\n2008).\nSerret (2001) postuló que en Argentina el hábitat óptimo era la transición entre el bosque y\nla estepa, pero la introducción de la ganadería ovina y bovina y la urbanización en esta\necorregión desplazaron a las poblaciones de huemul a las zonas boscosas. Mucho antes, Onelli\nobservó en 1897 que la mayoría de las zonas de tierras bajas que visitó ya habían perdido\nHuemul debido a la presencia humana y a la caza excesiva (citado en Gigoux 1929), y Magne\nde la Croix (1937) consideraba que la presión humana era responsable de que el Huemul sólo\npermaneciera en las altas montañas en aquella época. El desplazamiento general del huemul\nde las zonas tradicionales de invierno, las tierras bajas o los hábitats alejados de los Andes\nboscosos ha sido resumido por el Grupo de Trabajo sobre el Huemul (2012) y Flueck y Smith-\nFlueck (2011a, 2012a). En el pasado, el huemul también se encontraba en zonas\ncompletamente desarboladas de los pastizales patagónicos (Díaz 1993, 2000, Frid 1994,\nHuemul Task Force 2012).\nLas estimaciones de población para esta especie son de un mínimo de 1.048 y un máximo de\n1.500 (López et al. 1998, Povilitis 1983, Díaz y Smith-Flueck 2000). La especie también está\nincluida en el criterio C porque hay menos de 2.500 individuos maduros y existe una\ndisminución continua y prevista del número de individuos maduros (Vila et al. 2006, López et\nal. 1998, Povilitis 1983, Díaz y Smith-Flueck 2000).\nLa distribución de Huemul abarca una superficie 130.000 kilómetros cuadrados y 4\necorregiones. Se distribuye principalmente en las ecorregiones de los bosques magallánicos\nsubpolares (45%) y los bosques templados valdivianos (34%). En menor proporción, se\ndistribuye en la ecorregión estepa patagónica (11%) y hielos y rocas (11%) (Figura 46).\nFigura 46. Ecorregiones en el área de distribución de Huemul\n116\nii. Estado de conservación y amenazas globales\nLa especie ha sido calificada EN PELIGRO (EN). Su clasificación se justifica por que la especie\nse encuentra en un declive continuo debido a factores naturales y antropogénicos (por\nejemplo, pérdida de hábitat, caza, caza furtiva y depredación), reducción de su área de\ndistribución (área de ocupación) y porque las poblaciones restantes son pequeñas y están\nfragmentadas (Black-Decima et al. 2016).\nAunque en 1992 se plantearon varias hipótesis para explicar la falta de recuperación del\nhuemul (ganado, árboles exóticos, silvicultura irracional, animales exóticos, caza ilegal,\nenfermedades, perros, reducción del número de ejemplares, pérdida de las praderas de\ninvierno), cada una de ellas por separado resulta problemática como explicación clave de la\nfalta general de recuperación (Flueck y Smith-Flueck 2006, 2011a).\n117\nLa reducción generalizada de su número y área de distribución en toda la extensión de su\nárea de distribución histórica (Redford y Eisenberg 1992) se debió probablemente a una\ncombinación de exceso de población, exceso de ganado doméstico (animales asilvestrados y\ncontrolados), conversión de tierras para fines agrícolas y construcción de ciudades y\ncarreteras. Este proceso se inició antes de la llegada de los españoles y alcanzó su punto\nálgido antes de que se realizaran los primeros recuentos sistemáticos (Miller 1980), por lo que\nquedan más detalles por dilucidar. Basándonos en la cronología de los asentamientos\nhumanos, el impacto histórico habría sido más temprano en la porción norte que en la sur de\nla distribución, y más temprano posiblemente en la porción noroeste, que es el valle central\nde Chile.\nLa considerable reducción de su número y distribución provocó una mayor fragmentación de\nla población. Las subpoblaciones resultantes siguen viéndose afectadas por diversos factores,\nque mantienen su número bajo o en descenso. En estas circunstancias locales específicas, un\nsunnúmero de factores biofísicos pueden resultar cruciales: infraestructuras humanas,\npastoreo de ganado, agricultura, caza furtiva, depredadores, nuevas enfermedades, perros\nincontrolados y/o asilvestrados, o turismo no regulado. Es de esperar que las subpoblaciones\nde huemules de una variedad tan grande de hábitats y circunstancias tengan una condición\nfísica media diferente y, por tanto, puedan responder de forma distinta a cualquier factor.\nUna importante amenaza omnipresente es que Chile y Argentina tienen mecanismos débiles\npara proteger al Huemul en zonas no protegidas, e incluso dentro de las zonas protegidas.\nLas numerosas actividades problemáticas en las zonas que aún contienen Huemul están\nrelacionadas principalmente con la producción ganadera, los productos forestales, la minería\ny el turismo de todo tipo, incluida la pesca y la caza.\nOtra amenaza omnipresente y continua es la falta de áreas de invernada adecuadas. Mientras\nque algunas subpoblaciones tienen acceso a un rango altitudinal suficiente dentro de un área\npequeña (debido a lo escarpado del terreno), otras necesitarían migrar a distancias mucho\nmás largas, particularmente en las laderas orientales de los Andes. En todos los casos, si el\nárea de invernada está básicamente ocupada por el hombre, una subpoblación puede ver\ndificultada su recuperación. La mayoría de las áreas de invernada históricas de la vertiente\noriental son privadas y se utilizan intensamente para la producción ganadera y/o la caza.\nEsto incluye muchas zonas protegidas, incluidas las reservas nacionales de los parques\nnacionales. Excepciones notables son los parques nacionales de Torres del Paine (Chile) y\nPerito Moreno (Argentina): se eliminó la producción ganadera y el huemul acabó recolonizando\nlas tierras bajas, incluso en zonas esteparias (Guineo et al. 2008, Mirabelli 2010). Sin embargo,\nen los primeros, los caballos y el ganado siguen pastando libremente en los pastizales de\nHuemul (Jiménez, obs. pers.). Además de la pérdida de los pastizales de invierno, también se\nhan eliminado los patrones de comportamiento migratorio, ya que los huemules que llegaban\na esos pastizales de invierno eran sacrificados con regularidad.\nLas circunstancias locales de una subpoblación determinarían la necesidad de una\ninvestigación específica para abordar los problemas y encontrar medidas adecuadas para\ncontrarrestarlos (Corti et al. 2005).\nEn la actualidad, pero sin duda en el pasado, Huemul formaba parte de un sistema natural\nmultiherbívoro. Como en cualquier sistema de este tipo, lo que interesa es la presión\ncombinada de los herbívoros sobre el forraje. Las dietas del huemul y del ciervo rojo en un\nhábitat de bosque de lenga se solapaban entre el 42 y el 62%, dependiendo de la estación\n(Smith-Flueck 2003). Algunas poblaciones de huemul persisten, incluso después de haber\nestado en presencia de la producción ganadera durante más de 110 años (Flueck 2010).\n118\nLa amplia dieta del huemul y la variedad de entornos ocupados, histórica y simultáneamente,\ncorroboran la coexistencia del huemul con el pudú nativo, el guanaco y el ganado asilvestrado\ndurante varios cientos de años (Flueck 2010).\nEn Argentina, los registros veterinarios indican la presencia de enfermedades peligrosas cerca\nde las poblaciones de Huemul, ya que la cría de ganado es una de las principales economías\nde la región. En Chile, el cribado de 18 huemules en busca de agentes infecciosos no detectó\nanticuerpos contra el herpesvirus bovino-1 ni contra Brucella abortus, y solo dos huemules\ntenían anticuerpos contra la diarrea vírica bovina, a pesar de que esta población había estado\nexpuesta al ganado ovino y bovino durante al menos 80 años (Corti et al. 2013).\nCorti et al. (2010) informaron de que los perros eran responsables del 16% de las mortalidades\nobservadas de huemules marcados, basándose en huellas, excrementos, pelo, estado del\ncadáver y avistamientos de depredadores (Corti et al. 2013). Sin embargo, otras\nsubpoblaciones han disminuido en ausencia de perros, y debe determinarse la naturaleza de\nlas amenazas locales para cada subpoblación.\nCuando la depredación es grave, incluso por parte de depredadores autóctonos, es posible\nque las pequeñas subpoblaciones de huemules no puedan recuperarse sin una intervención\nde gestión (Wittmer et al. 2014).\nLa recuperación de las poblaciones de huemul afectadas por la depredación podría requerir la\nreducción de las presas primarias abundantes y la reducción simultánea de los depredadores,\nal menos temporalmente (Wittmer et al. 2013b). El zorro culpeo fue identificado como una\nfuente importante de mortalidad de cervatillos de huemul durante un estudio con radiocollar\nen el sur de Argentina (Corti et al. 2010), pero no durante un estudio sobre la dieta del zorro\nen la misma región (Zapata et al. 2005). Asimismo, Jiménez y Martínez (2010) no encontraron\npruebas de que los Huemules depredaran o carroñearan en la Reserva Nacional de Tamango\nal examinar 409 excrementos de Culpeo a lo largo de un año en una zona de alta densidad\nreproductora de Huemules. Se justifica realizar más estudios sobre el origen de la mortalidad\nde los cervatillos.\nDado que el 63% de todas las subpoblaciones están fuera de zonas protegidas (y otro 9%\nestán parcialmente fuera), es urgente establecer planes de gestión para la mayoría de las\nsubpoblaciones de huemul restantes. El huemul está clasificado como En Peligro en los Libros\nRojos de Datos de Vertebrados de Chile y Argentina (Glade 1988, Díaz & Ojeda 2000) y\ntambién figura en el Apéndice I de los Convenios CITES y PNUMA/CMS. Esta especie está\nprotegida por ley desde 1929 en Chile y desde 1989 en partes de Argentina (Díaz y Smith-\nFlueck 2000). Para promover la conservación del huemul se han celebrado seis talleres\nbinacionales desde 1992. En 2001, ambos países elaboraron sus planes nacionales de\nconservación del huemul (Chile comenzó con una actualización en 2007), pero las limitaciones\nde financiación han impedido hasta ahora su aplicación.\nAlgunas de las medidas de conservación actualmente priorizadas por los organismos\ngubernamentales de ambos países (Smith-Flueck et al. 2014) incluyen:\n● aumentar los esfuerzos para obtener más información sobre las subpoblaciones de\nHuemul, como la distribución actual, la abundancia y las amenazas;\n● fomentar una protección más eficaz de las subpoblaciones identificadas (haciendo\nhincapié en un aumento de la protección en las regiones VIII y XI de Chile y en la\nprovincia de Chubut de Argentina);\n119\n● promover la creación de áreas protegidas privadas con presencia de huemul (o hábitat\nadecuado) para facilitar la conectividad y la dispersión;\n● promover la formación para mejorar las habilidades locales en técnicas de gestión y\nseguimiento de la vida silvestre;\n● y fomentar actividades educativas y campañas en los medios de comunicación para\naumentar la concienciación sobre el estado del huemul .\nLa consecución de estas medidas sería más probable mediante la coordinación (también\nbinacional) entre las diversas jurisdicciones administrativas, los propietarios privados y las\ncomunidades locales.\nEl estado actual del huemul, con su alto grado de fragmentación espacial, los pequeños\ntamaños de las subpoblaciones y el bajo número total (Vila et al. 2006), indica que la situación\nno es viable, y puede que lo sea menos en Argentina, donde sólo quedan unos pocos\ncentenares de huemules. La tendencia sigue una pérdida continua de subpoblaciones, es\ndecir, una reducción del número y del área de ocupación, incluso dentro de los parques\nnacionales (Franke 1949, Povilitis 1998, Serret 2001).\nEl objetivo es la recuperación de la especie (por ejemplo, el Plan Nacional de Conservación y\nRecuperación del Huemul de Argentina, 2001), lo que implica un aumento de su número y\ndistribución hasta un nivel viable. Para que la recuperación tenga éxito, es necesario\ncomprender las amenazas que pesan sobre las subpoblaciones individuales de huemules que\nquedan (Corti et al. 2005).\nLa toma de decisiones sobre medidas correctoras debería basarse en la comprensión de estas\namenazas, y llevaría la conservación más allá de la creación de zonas protegidas. La\ninformación básica sobre la especie y sobre la mayoría de las subpoblaciones es muy escasa,\nlo que complica la interpretación de algunas observaciones. Una estrategia de recuperación\npara el huemul también debe incluir herramientas ex situ, ya que, para muchas de las\npreguntas, el enfoque más eficiente, y a veces el único, serían los estudios controlados de\nanimales semicautivos (en Chile existe un exitoso centro de cautividad desde 2005, Vidal et\nal. 2011). También proporcionaría oportunidades para estudiar grupos reintroducidos\n(procedentes del centro de cría en cautividad), adoptando un enfoque de gestión adaptativa\n(Flueck & Smith-Flueck 2006, Armstrong & Seddon 2007).\n120\ng. Taruca (Hippocamelus antisensis)\nLa taruca habita las zonas con clima húmedo en los Andes orientales (Jungius 1974, Barrio\n2004) y en zonas con clima seco en los Andes occidentales (Merkt 1985, Contreras et al. 1986,\nBarrio 1998). En varias secciones de su distribución, las subpoblaciones de Taruca viven en\nporciones fragmentadas del área de distribución (Cajal 1983, Barrio 1999).\ni. Ecosistemas representados en su distribución\nLa especie ocurre entre los 2.000 y 5.000 metros sobre el nivel del mar. En Argentina la\nespecie se registra entre los 2.000 y 3.500 metros (Cajal 1983), en el norte de Chile entre los\n2.500 y 4.600 metros (Contreras et al. 1986) y entre 3.500 y 5.000 metros en las tierras altas\nde Perú y Bolivia (Jungius 1974, Merkt 1985, Yensen et al. 1994, Barrio 1998, Barrio 2004).\n121\nEn Bolivia, esta especie también ocurre a altitudes más bajas, a 2.300 m.s.n.m. en el valle\ninterandino llamado Araca, cubierto en su mayor parte por árboles ralos (Nuñez 2008).\nLas tarucas suelen encontrarse por encima del límite arbóreo en laderas de montañas\ncaracterizadas por afloramientos rocosos y acantilados en medio de vegetación de pastizales\n(Jungius 1974, Merkt 1985, Merkt 1987, Barrio 2004). Parecen preferir zonas rocosas de\nvegetación escasa con fuentes de agua cercanas, normalmente un pequeño barranco, laguna\no pantano (Merkt 1985, Barrio 2004), sin embargo, se han observado en matorrales densos\ncerca de ríos y dentro de bosques de Polylepis sp. (Barrio en prep.).\nLa Taruca se distribuye en una superficie 424 mil kilómetros cuadrados y abarca 10\necorregiones terrestres (Figura 47). Ocupa principalmente la ecorregión Puna andina central\n(35,6%) y Puna andina central húmeda (23,8%). En menor proporción, destacan las\necorregiones: Yungas peruanas (13,8%) y Puna andina central seca (10,3%).\nFigura 47. Ecorregiones en la distribución de Taruca (Hippocamelus antisensis)\n122\nii. Estado de conservación y amenazas globales\nLa especie ha sido calificada como VULNERABLE (VU) (Barrio et al. 2017).\nLas amenazas para la especie incluyen la competencia con ganado doméstico, la destrucción\ndel hábitat, la caza ilegal y la depredación por perros domésticos (Miller et al. 1973, Merkt\ncom. pers.). En Bolivia, las principales amenazas son la destrucción del hábitat y la caza ilegal\n(Nuñez 2009, Rechberger et al. 2014). Las astas se utilizan en la medicina tradicional para\ncurar la parálisis facial (Tarifa com. pers.) y la carne seca es utilizada por las poblaciones\nrurales (CDC 1987). Las amenazas en Chile incluyen conflictos con los agricultores locales,\ndepredación por perros domésticos y desplazamiento de su hábitat anterior (quebradas con\ncursos de agua) a zonas más secas (Fuentes-Allende et al. 2016).\nLa especie está incluida en el Apéndice I de la CITES y está presente en varias zonas\nprotegidas de su área de distribución.\nLas acciones de conservación recomendadas para la especie incluyen:\n● Estudios sistemáticos para determinar el estado y la extensión de su distribución\ngeográfica; apoyo a estudios ecológicos continuados de la especie en toda su área de\ndistribución;\n● Refuerzo de la gestión de las áreas protegidas; mejora de la gestión ganadera\nmediante proyectos de demostración de educación de los ganaderos.\n● Se necesitan programas de seguimiento de las tendencias de la población. Sugerimos\nque se incluyan al menos tres lugares de estudio por país, considerando el uso de un\nmétodo estandarizado, que probablemente incluya observaciones directas, y el rastro.\nAl menos uno de los lugares debería estar dentro de un área protegida de cada país.\nEsta especie ha sido evaluada como EN PELIGRO (EN) en Bolivia , basándose en un estudio\nexhaustivo realizado en el país (Nuñez 2009). Hippocamelus antisensis ha sido declarado\nMONUMENTO NATURAL NACIONAL por la Ley N° 24.702 en Argentina, desde el año 1996.\nEsto permitió la protección del hábitat de la taruca en Argentina.\nLas tarucas están consideradas EN PELIGRO (EN) en Chile, por la Ley N° 19.300 y su caza\nestá prohibida por la Ley 19.473.\nTambién existe un Plan Nacional para su conservación desde 2006 (CONAF 2006), pero hasta\nahora no se han desarrollado acciones y su hábitat está poco representado en las áreas\nprotegidas (Matta com. pers.).\nFundación Sudamérica Diversa. Trabajando por la biodiversidad a través de proyectos de\ninvestigación, manejo, educación y divulgación científica. Panguipulli, Región de Los Ríos.\nNicolás Fuentes Allendes (Chile) Especialista en ciervos UICN. Punto focal Taruca en Chile.\nProyecto Chile, Perú para el Modelamiento y marcaje de Taruca.\nttps://www.instagram.com/sudamericadiversa/\n123\nh. Flamencos (Phoenicopterus sp.)\nTres especies del género Phoenicopterus habitan en Chile, el Flamenco chileno\n(Phoenicopterus chilensis), el Flamenco andino y el Flamenco de James.\ni. Flamenco chileno (Phoenicopterus chilensis)\nPhoenicopterus chilensis es una especie nativa en Chile, Argentina, Bolivia, Perú, Ecuador,\nParaguay, Uruguay y Brasil. Del Hoyo (1992) y Valqui et al. (2000) estimaron la población\ntotal en 200.000 individuos. Sin embargo, un censo coordinado realizado en el año 2010\nresultó en 283.000 individuos y dio una estimación de la población total de 300.000 individuos\n(Marconi et al. 2011).\nPhoenicopterus chilensis se reproduce en Perú central, aparentemente de manera errática,\nirregular y en pequeñas cantidades (Plenge in litt. 1999), en Bolivia, Argentina, Chile. Tal vez\nse reproduce erráticamente en Paraguay, donde al menos hay un registro de reproducción y\ntal vez se encuentre en aumento en el Chaco, con 5.200 invernando en el año 2005 (Clay in\nlitt. 2000, Lesterhuis et al. 2008), con unos pocos invernantes en Uruguay y el sudeste de\nBrasil y algunos errantes en Ecuador y las Islas Malvinas (Falkland Islands).\n124\n1. Ecosistemas representados en su distribución\nLa distribución del Flamenco chileno abarca 36 ecorregiones terrestres, donde destacan\nEstepa patagónica (15%), Chaco árido (15%) y Pampas húmedas (10%). En menor\nproporción, abarca las ecorregiones Monte bajo (9%), Espinal (6%), Puna (6%) y Puna árida\nandina central (6%).\nFigura 48. Distribución de Flamenco chileno (Phoenicopterus chilensis).\n2. Estado de conservación y amenazas globales\nEl Flamenco chileno está clasificado como CASI AMENAZADA (NT) porque se sospecha que\nsufrirá un declive poblacional moderadamente rápido en las próximas tres generaciones\ndebido a la recolección de huevos, la caza, las perturbaciones y la degradación de su hábitat\n(Birdlife International 2018). A mediados de la década de 1970, la población se estimaba en\n500.000 aves, pero cifras más recientes estiman 100.000 individuos en Argentina, 30.000 en\nChile y decenas de miles en Perú y Bolivia, las que sugirieron que podrían persistir no más de\n200.000 individuos. No obstante, estudios coordinados realizados el año 2010 reportaron\n283.000 individuos y estimaron la población total en 300.000 individuos (Marconi et al. 2011).\nLa especie ha sido objeto, probablemente, de una intensa recolección de huevos desde la\nllegada del hombre a Sudamérica y, en los últimos años, los recolectores de huevos han sido\nresponsables del fracaso parcial o total de las colonias en Bolivia (del Hoyo 1992, Flamingo\nCAP Questionnaire 1998). Mar Chiquita, en Argentina, es quizás el lugar de cría más\nimportante y está amenazado por la extracción de agua para proyectos de regadío. La minería\n125\nha provocado una gran alteración del hábitat y la especie también sufre las presiones de la\ncaza y el turismo (Flamingo CAP Questionnaire 1998).\nLos estudios recientes no indican una disminución actual de la población global (Marconi et\nal. 2011), pero se sospecha que la población sufrirá una disminución moderadamente rápido\nen las próximas tres generaciones debido a la recolección de huevos, la caza, las\nperturbaciones y la degradación de los hábitats de la especie. La tendencia actual de la\npoblación se califica en DISMINUCIÓN (Birdlife International 2018).\nLas acciones para la conservación de la especie incluyen las propuestas por CITES como\nampliar y continuar las prospecciones simultáneas durante la época de cría para controlar la\npoblación e introducir medidas para controlar la recolección intensiva de huevos (Birdlife\nInternational 2018).\nii. Flamenco andino (Phoenicoparrus andinus)\nPhoenicoparrus andinus habita en las altas mesetas andinas de Perú, Chile, Bolivia y\nArgentina. Se reproduce en varias localidades, especialmente en la Laguna Colorada y otros\nlagos salados del suroeste de Bolivia, la Laguna de Salinas (Perú) y el Salar de Atacama (Chile)\n(Rocha 1994, Cuestionario del Plan de Acción del Flamenco 1998, Rocha in litt. 2000).\nOtros sitios de reproducción en Argentina son Laguna Mar Chiquita, Laguna Blanca, Salar de\nLlullaillaco, Salar de Incahuasi, Salar de Antofalla y Laguna Carachipampa (Torres et al. 2019).\nSu distribución está en gran medida restringida a las lagunas alcalinas y saladas de alta\nmontaña, a los 2.300 y 4.500 metros sobre el nivel del mar. Puede ser nómada en busca de\nsuministros de alimentos, principalmente diatomeas (del Hoyo 1992, Polla et al. 2018).\nSe reproduce colonialmente, poniendo un solo huevo entre los meses de diciembre y febrero\n(del Hoyo 1992, Rocha in litt. 2000)(Birdlife International 2018).\n1. Ecosistemas representados en su distribución\nLa distribución de Flamenco andino abarca un total de 13 ecorregiones, entre las cuales\ndestacan Puna seca de los Andes centrales (63%) y Puna de los Andes centrales (21%) (Figura\n&&).\nEn menor proporción se representan las ecorregiones Estepa de los Andes del sur (3,9%),\nChaco árido (2,5%) y Desierto Sechura (2,2%) (Figura 49).\n126\nFigura 49. Distribución Flamenco andino (Phoenicoparrus andinus).\n2. Estado de conservación y amenazas globales\nLas evaluaciones de la población son difíciles y varían mucho (Hurlbert 1978, 1981, Scott &\nCarbonell 1986, Cuestionario del Plan de Acción para los Flamencos 1998). En el Censo\nSimultáneo Internacional realizado en el año 2010 se contaron 38.675 individuos (Marconi et\nal. 2011). En un reconocimiento aéreo de la Laguna Mar Chiquita en el verano del año 2018\nse registraron 11.607 individuos (Cabaña et al. 2018). Sin embargo, debido a la alta\nincertidumbre, no se ha cuantificado el tamaño total de la población (Birdlife International\n2018).\nEl estado de conservación de la especie está calificado como VULNERABLE (VU) porque ha\nsufrido un rápido declive de la población en las últimas tres generaciones, debido a la\nexplotación y a la disminución de la calidad del hábitat. La explotación ha disminuido y los\ndatos de estudios recientes sugieren que la población es estable en la actualidad, aun que\nsigue estando muy mermada en comparación con las cifras del pasado (Birdlife International\n2018).\nLa recolección de huevos para venderlos como alimento fue intensiva a mediados del siglo XX\ny principios de la década de 1980, con miles de capturas anuales (Johnson 1965, Hurlbert\n1981). Los niveles de agua desfavorables (debido al clima y a la manipulación), la erosión de\n127\nlos lugares de nidificación y las perturbaciones humanas también pueden afectar a la\nproductividad (Cuestionario del Plan de Acción para los Flamencos 1998).\nLa amenaza que suponen las explotaciones mineras en los humedales andinos está\naumentando en los últimos años: Además de la minería de oro, sal y arenas silíceas, el llamado\n"triángulo del litio", con grandes reservas de salmuera de litio, se solapa con importantes\nlugares de reproducción de la especie (Gutiérrez et al. 2019, Stacey 2019, Arengo in litt.\n2020). La minería puede conducir a una extracción de aguas superficiales, la contaminación\nde los humedales y el aumento de los desarrollos industriales dentro del hábitat crítico de\nreproducción. Fuera de las áreas protegidas en Bolivia, existe un bajo nivel de caza para\nalimento, aceites y plumas, especialmente dirigida a inmaduros y juveniles (Rocha & Quiroga\n1997, Rocha in litt. 2000).\nDesde mediados de los 80 hasta mediados de los 90, la población disminuyó de unos 50.000-\n100.000 individuos a 34.000 (Rocha & Quiroga 1997), lo que indica un rápido declive. El éxito\nreproductivo parece ser consistentemente bajo (Cuestionario del Plan de Acción del Flamenco\n1998), y por lo tanto las disminuciones pueden continuar durante muchos años, ya que los\nflamencos tienen una alta longevidad (20-50 años) (del Hoyo 1992). Sin embargo, los datos\ndel Censo Simultáneo Internacional y el Censo Simultáneo de Sitios de la Red, incluyendo más\nde 38.000 individuos registrados en 2010 (Marconi et al. 2011), sugieren que la población\npuede haber sido estable al menos durante 1997 - 2010. La tendencia actual de la población\nes Decreciente (Birdlife International 2018).\nLas acciones de conservación en curso se indican a continuación:\n● Se reproduce en la Reserva Natural de Salinas y Aguada Blanca, Perú (Ugarte-Nunez\ny Mosaurieta-Echegaray 2000), la Reserva Nacional de Flamencos Salar de Atacama\n(del Hoyo 1992), Chile, la Reserva Natural Provincial Las Chinchillas, Argentina, y la\nReserva Nacional de Fauna Eduardo Avaroa, Bolivia, con un sitio protegido no\nreproductivo en el Monumento Natural Laguna de los Pozuelos.\n● Argentina (Cuestionario del Plan de Acción del Flamenco 1998). Se están llevando a\ncabo acciones de conservación a nivel local, incluyendo la gestión del hábitat, la\nprevención de la recolección de huevos y la sensibilización del público (Cuestionario\ndel Plan de Acción del Flamenco 1998, Rocha in litt. 2000). El Grupo de Conservación\nFlamencos Altoandinos (GCFA) coordina las acciones de investigación, seguimiento y\nconservación de esta especie en Argentina, Bolivia, Chile y Perú, incluyendo un censo\nexhaustivo de toda el área de distribución cada cinco años (Arengo in litt. 2020).\n●\niii. Flamenco James (Phoenicoparrus jamesi)\nPhoenicoparrus jamesi está presente en las mesetas altoandinas de Perú, Chile, Bolivia y\nArgentina, con pequeñas poblaciones en los alrededores de la Laguna Mar Chiquita, en las\ntierras bajas de Argentina (Cobos et al. 1999).\nLos sitios clave incluyen la Laguna Grande y las Lagunas de Vilama en Argentina, la Laguna\nColorada en Bolivia y el Salar de Surire en Chile. En el año 2010, estos 4 humedales albergaban\nel 50% de la población total (Marconi et al. 2011). En particular, la Laguna Colorada, dentro\nde la Reserva Nacional Eduardo Avaroa, ha llegado a albergar hasta 41.000 aves (con más de\n25.000 en la reserva en 2010) y ha sido un lugar clave para el reclutamiento (Rocha 1994,\nCuestionario CAP del Flamenco 1998, Caziani et al. 2007, Marconi et al. 2011).\n1. Ecosistemas representados en su distribución\nSe encuentra principalmente en lagos salinos en las mesetas alto andinas, donde se alimenta\nprincipalmente de diatomeas, pero también es un migrante elevacional parcial que se desplaza\n128\na lagos de menor altitud en la temporada no reproductiva. Sistemas: Terrestre, Agua dulce\n(Birdlife International 2016).\nSu distribución abarca 11 ecorregiones, principalmente Puna árida de los Andes centrales\n(65%) y Puna de los Andes centrales (21%). En menor proporción, abarca las ecorregiones\nDesierto Sechura (5%) y Estepa de los Andes del sur (3%) (Figura 50).\nFigura 50. Distribución Flamenco de James (Phoenicoparrus jamesi).\n2. Estado de conservación y amenazas globales\nEsta especie está clasificada como CASI AMENAZADA (NT) porque se sospecha que sufrirá un\ndeclive poblacional moderadamente rápido en las próximas tres generaciones debido\nprincipalmente a la pérdida y degradación del hábitat (Birdlife International 2016). Un total\nde 106.000 individuos contados en un censo coordinado en 2010 sugiere que la población\npuede haberse estabilizado (Marconi et al. 2011); sin embargo, el éxito reproductivo varía\nmucho de un año a otro y las amenazas afectan sobre todo a la productividad. La población\nprobablemente disminuyó rápidamente durante el siglo XX (Cuestionario CAP del flamenco\n1998) pero ha empezado a aumentar (Rocha in litt. 2000) presumiblemente debido al éxito\nde los programas de conservación. Un censo coordinado en 2005 estimó la población en\n100.000 aves (información no publicada proporcionada por los Grupos de Especialistas de\nWetlands International 2006). Los niveles de diatomeas pueden verse afectados por el cambio\nclimático en detrimento de los recursos alimenticios de los flamencos. La recolección de\n129\nhuevos y la caza fueron intensivas durante el siglo XX (Johnson 1965, Hurlbert 1981) pero se\nhan controlado en las áreas protegidas. La actividad minera y la demanda de agua asociada,\nasí como el turismo, son otras amenazas para algunos humedales (Birdlife International 2016).\nAcciones implementadas para la conservación de la especie: El área protegida clave es la\nReserva Nacional de Fauna Eduardo Avaroa, Bolivia (Rocha in litt. 2000). Se han organizado\nprogramas de conservación nacionales e internacionales en los cuatro países (Cuestionario\nCAP sobre el flamenco 1998) (Rocha in litt. 2000) y es de esperar que sigan fomentando el\ncrecimiento de la población. Apéndice II de CITES. Apéndices I y II de la CMS.\nAcciones propuestas para la conservación de la especie: Continuar los estudios simultáneos\ndurante la época de cría para controlar la población. Aumentar la red de áreas protegidas para\nincluir sitios vitales en Argentina (Caziani et al. 2007). Investigar la viabilidad de crear una\nreserva trinacional que integre la gestión de sitios en Argentina, Bolivia y Chile para proteger\nlas colonias de cría y los sitios de congregación clave (Caziani et al. 2007).\ni. Otras especies de interés\nA continuación, se listan otras especies de interés a considerar en los esfuerzos de\nconservación de especies y hábitats en la Cordillera de los Andes.\ni) Pudú (Pudu puda)\n130\nii) Gato andino (Leopardus jacobita)\n131\niii) Güiña (Leopardus guigna)\n132\niv) Chinchilla (Chinchilla chichilla)\n133\nv) Chinchilla (Chinchilla lanigera)\nvi) Vizcacha (Legidium viscacia)\n134\n135\nvii) Vizcacha (Legidium wolffsohni)\n136\nviii) Quirquincho de la Puna (Chaetophractus vellerosus)\nix) Piche (Zaedyus pichiy)\n137\nx) Yaca del Norte (Thylamys pallidior)\n138\nxi) Picaflor de Arica (Eulidia yarrellii)\n139\n140\nxii) Canquén colorado (Chloephaga rubidiceps)\n141\nxiii) Piuquén (Chloephaga melanoptera)\n142\nxiv) Pato cortacorrientes (Merganetta armata)\n143\nxv) Chorlo chileno (Charadius modestus)\n144\nxvi) Lagarto gruñidor (Pristidactylus volcanensis)\n145\nxvii) Rana del Loa (Telmatobius dankoi)\n146\nxviii) Sapo de Philippi (Telmatobius philippi)\n147\nxix) Ranita Darwin (Rhinoderma darwinii)\n148\nxx) Orestia de Chungará (Orestias chungarensis)\n149\nxxi) Orestia de Parinacota (Orestias parinacotesis)\n150\nxxii) Orestia del Lauca (Orestias laucaensis)\n151\nxxiii) Polylepis sp.\n152\nxxiv) Ciprés de la cordillera (Austrocedrus chilensis)\n153\nxxv) Araucaria (Araucaria araucana)\n154\n4. Entrevistas\n1. Eduardo Pavez (BioAmérica consultores)\nEntrevista realizada en 9 de julio de 2024.\nAl consultar por especies propias del corredor de conservación que conforma la Cordillera de\nLos Andes, Eduardo Pavez reconoce que el Cóndor es una especie andina propiamente tal,\ncomo las especies Flamenco chileno, Flamenco andino y Flamenco de James, no así el Puma.\nEn relación al Cóndor, señala la importante relación con el Guanaco por su condición de mayor\nherbívoro sudamericano. La ausencia de grandes herbívoros presiona a la especie a depender\nde la existencia de ganado doméstico como fuente de alimentación y plantea analizar la\nnecesidad de la presencia de ganadería extensiva para su conservación. Destaca la experiencia\nde Colombia en la conservación del Cóndor andino.\nEntre otras especies de interés, menciona al Aguilucho chico (Buteo albigula) especie calificada\nde preocupación menor (LC) en su estado de conservación y la única especie nativa con una\nruta migratoria de sur a norte (Pavez 2000).\n2. Miguel Díaz (Corporación Nacional Forestal)\nGerencia de Áreas Silvestres Protegidas. Entrevista realizada el 24 de julio de 2024.\nAl consultar sobre especies de interés destacó la experiencia de la Corporación Nacional\nForestal, desde la Región de Arica y Parinacota, en el manejo y reintroducción de Vicuña.\nRespecto al Guanaco, destaca los problemas sanitarios asociados a la sarna en la zona norte.\nSobre el Ñandú de Darwin, destaca el trabajo en Perú del Servicio Nacional de Áreas Naturales\nProtegidas (SERNANP) y recomienda el contacto con Estela Martínez, Coordinadora de\nMonitoreo de la Biodiversidad en las Áreas Nacionales Protegidas.\nEntre otras especies de interés andino, destaca el Quirquincho de la Puna, el Gato Andino, la\nYaca del Norte (Tilamis), los Gansos altoandinos y destaca el buen estado de conservación de\nlos Patos altoandinos en la Laguna de Cotacotani.\nTambién destacan los flamencos que se reproducen en los salares del altiplano y se\nencuentran amenazadas por la presión existente sobre el agua dada la presencia de la\nindustria minera y el cambio climático, lo que puede alterar la presencia de diatomeas,\nprincipales elementos de la dieta de las Parinas. Por último, menciona la importancia de las\nespecies de fauna íctica del género Orestias que habitan las lagunas altiplánicas y se enfrentan\na las presiones de especies ícticas exóticas invasoras.\n155\n3. Álvaro Promis (Universidad de Chile)\nFacultad de Ciencias Forestales y de la Conservación de la Naturaleza. Departamento de\nSilvicultura y Conservación de la Naturaleza. Entrevista realizada el 26 de julio de 2024.\nDesde el punto de vista biogeográfico, destaca la clasificación de regiones boscosas para\nSudamérica elaborada por Hueke (1978). En el mapa se destacan las regiones boscosas y\naquellas donde el bosque es pobre o está ausente. Recomienda la revisión del trabajo Fuentes-\nCastillo y colaboradores (2020) sobre los efectos del cambio climático en hotspots de\nbiodiversidad en Sudamérica y la Iniciativa Andina de Montañas, plataforma integrada por los\nsiete países que comparten un territorio común: La Cordillera de los Andes. Al consultar por\nespecies vegetales andinas de interés, especialmente leñosas, menciona a las del género\nPolylepis que se distribuyen desde el norte de Chile hasta Venezuela por las alturas de la\nregión andina. Destaca la importancia de conservar los bosques de Araucaria (Araucaria\naraucana) se extienden desde las zonas húmedas de Chile y hacia las zonas secas del Este,\nasí como el Ciprés de la Cordillera (Austrocedrus chilensis), cuyas poblaciones en Argentina\npermiten dar continuidad a su distribución.\n4. Benito González (Universidad de Chile)\nEntrevista realizada el 2 de agosto de 2024.\nEn relación a las especies andinas, comenta que dada la orgánica de trabajo de la organización\nsin duda deben estar presentes Cóndor, Puma, Guanaco, Huemul – Taruca, Ñandú.\nCon respecto a la Taruca, menciona a Nicolás Fuentes, quien es el contacto ¿IUCN? de la\nespecie en Chile. Comenta del trabajo (Perú) de un ONG y un gringo en modelamiento y\neventual marcaje. Respecto de los gansos, menciona que todos son interesantes en el\ncorredor, entre otras por las amenazas que presentan.\nEntre los felinos, destaca la especie Gato Andino y la Alianza Gato Andino, la especie Guiña y\nlos trabajos de Nicolás Gálvez en Pucón, Araucanía. Menciona la falta de información de la\nespecie en la zona central.\nDestaca la relevancia del Canquén Colorado. También destaca la importancia del Pato\nCortacorrientes. Menciona la importancia que presentan el Picaflor de Arica (Valle de\nCamarones) y el Picaflor de Juan Fernández (Isla Robinson Crusoe), dado el alto grado de\namenaza que presentan.\nRespecto de las especies de anfibios, destaca el trabajo de Gabriel Lobos, del Zoológico\nMetropolitano, en la Rana del Loa. Menciona la importancia de los lagartos gruñidores por su\nalto nivel de endemismo.\nRespecto al guanaco, menciona que hay un grupo en Perú trabajando en la especie, Jane\nWheeler de ONG norteamericana y Universidad de Lima y otro grupo de trabajo en Arequipa.\nWildlife Conservation Society trabaja en las especies Vicuña y Guanaco en Perú y Bolivia, pero\nprincipalmente por el tema sanitario por la problemática de la sarna. Hay un convenio con el\nServicio Nacional Forestal y de Fauna Silvestre (SERFOR) del Perú.\nEl grupo de especialistas de camélidos sudamericanos (GECS) de guanacos es un grupo\nreactivo e interactúa en algún grado con Wildlife Conservation Society. En el límite norte del\nguanaco en Perú, hay pocos individuos, principalmente por la caza y la Reserva Nacional de\n156\nCalipuy tiene estos guanacos (1.000 - 1.500). En un par de lugares costeros al sur de Lima\nquedan unos pocos individuos.Los guanacos en Parque Nacional Llanos de Challe y Parque\nNacional Pan de Azúcar están disminuyendo por problemática de perros asilvestrados. Wildlife\nConservation Society trabaja con guanacos en Karukinka, Tierra del Fuego y la coordinación\ngeneral en la zona central. También está involucrada en el Plan de Manejo del río Colorado\n(Santiago?).\nLa especie Vicuña cuenta con un marco internacional en el que participa la Corporación\nNacional Forestal (CONAF). En la temática de guanacos, el Servicio Agrícola y Ganadero y la\nCorporación Nacional Forestal (CONAF) son aliados relevantes en Chile y muy importantes en\nla Región de Valparaíso.\n5. Charif Tala (Ministerio del Medio Ambiente)\nMinisterio del Medio Ambiente. División de Recursos Naturales y Biodiversidad. Departamento\nde Conservación de Especies. Entrevista realizada el 9 de agosto de 2024.\nEn relación a las especies propone poner énfasis en otros grupos de especies de baja\nmovilidad, como la Chinchilla, en estado más crítico que guanaco o puma, el que considera\nno tiene grandes problemas pues habita distintos de ambientes. Considera que una de las\nmejores herramientas para conservar territorios es poder protegerlos, aunque tiene sus límites\ny no siempre es posible.\nReconoce que la Vizcacha patagónica es por sí de interés al estar presente en la zona del Valle\ndel río Chacabuco. La Vizcacha de la zona centro y norte es una especie bastante común e\ninteresante para soportar poblaciones de carnívoros, como gato andino, por ser fuente\nimportante de su dieta. En la Chichilla las poblaciones son bastante menos móviles, pensar en\nprotección de territorios puede ser interesante. En Illapel, en la zona de AUCO, la Reserva\nNacional Las Chinchillas tiene un entorno de predios con otros intereses, donde se puede\npromover el Rewilding.\nLos Flamencos sin duda especies importantes. El Flamenco chileno llega hasta la Estancia\nChacabuco. Considera interesantes los flamencos altoandinos y menciona que existe un\nProyecto del Zoológico Nacional en Flamencos altoandinos y también en Cóndor. Existe un\ngrupo de trabajo de Flamencos altoandinos de Chile, Perú y Bolivia con un grupo de\ninvestigadores activo. El Zoológico Nacional también tiene un proyecto en Chinchilla de cola\ncorta, también de baja movilidad, que podría estar incluida con la Chinchilla de cola larga, por\nestar ambas muy amenazadas.\nRespecto a los anfibios, destaca el género Telmatobius. La ranita del Loa es una especie de\nTelmatobius icónica del Loa, donde recientemente ocurrieron incendios. Comenta que es una\nespecie prácticamente extinta pues no se a avistado en mucho tiempo. Señala que es un caso\ncasi perdido. Hay ejemplares en cautiverio como parte de un proyecto del Zoológico Nacional\ny en Calama existe un Centro de Biodiversidad, financiado por CODELCO y la Municipalidad\nde Calama, que recibirá ejemplares para posibles acciones de repoblamiento. No hay hábitat\ndisponibles. Hay dos especies focales de Telmatobius de Ollagüe consideradas en proyecto de\nconservación de anfibios, Telmatobius philippi y Telmatobius ascotanensis. Ocurren en el salar\nde Ascotán, Salar de Carcote, donde comparten hábitat con Orestias sp.\nEn relación a la Taruca, no está protegida en áreas silvestres Tiene un serio conflicto con la\nagricultura andina, compite con llamas, alpacas y burros.\n157\nReleva la importancia de la creación de corredores en áreas con otros usos. Política Nacional\nPara la Gestión Sustentable de Montañas en Chile. Comité Nacional para las Montañas. En\nMinisterio de Medio Ambiente en contacto fue Jaime Rovira. Elaborada en el marco de la\nAlianza Andina de Montañas (2017). En relación al GEF Montaña, está concluido, los\ndocumentos se encuentran dispuestos en plataforma y Daniel Álvarez es el contacto más\ncercano al proyecto aún en el Ministerio del Medio Ambiente.\n6. Cristián Estades (Universidad de Chile)\nFacultad de Ciencias Forestales y de la Conservación de la Naturaleza. Departamento de\nManejo de Recursos Naturales. Entrevista realizada el 7 de agosto de 2024.\nLa fundación, y su probado modelo, puede iniciar un proceso de intercambio de experiencias\nen beneficio de Chile y Sudamérica. Un aspecto crucial y necesario es tener la capacidad de\ngestionar recursos para el manejo y la promoción de la gestión efectiva de las áreas\nprotegidas.\nCon relación al Picaflor de Arica, señala que corresponde a una especie crítica, con solo 300\nindividuos en el Valle de Camarones en la Región de Arica y Parinacota. En Perú ya ha sido\ndeclarada extinta, reconocida bajo el nombre de Picaflor de Tacna. Hace 20 años la población\nalcanzaba aproximadamente 2.000 individuos. Actualmente hay falta de financiamiento y\nrequerimientos para la protección de algunos lugares claves para su conservación. El hábitat\ndel Picaflor de Arica se encuentra casi en su totalidad al interior de terrenos privados. A la\nfecha se han protegido áreas muy pequeñas de hábitat potencial.\nExistió una ONG American Bird Conservancy (ABC), manejada por una persona en Bolivia, que\nha trabajado de manera poco activa y equivocadamente.El valor de los terrenos de hábitat\ndel Picaflor de Arica alcanza los 50-60 millones de pesos chilenos por hectárea y el hecho de\nser tan elevados ha jugado en contra. por ejemplo con esta ONG en la compra de terreno, y\ndonde se van esos capitales a zonas donde pueden comprar muchas más tierra con esa misma\nplata.\nLa Familia Ariztía es, casi, el único dueño del Valle de Camarones, donde también hay cóndores\ny áreas naturales donde habita el Cachudito de cresta blanca. El Valle de Azapa está muy\ndeteriorado y casi no hay picaflores. Una acción impulsada por la UNORCH con él fue el\nestablecimiento de una red de micro reservas de 5 a 10 hectáreas en lugares muy buenos\npara los picaflores y así mejorar las condiciones para la conservación de la especie.\nSeñala se requiere ensayar, facilitar materiales para la construcción de nidos artificiales,\nmejorar la nutrición de las hembras, proveer agua, entre otras acciones.\nLa reproducción en cautiverio es una acción necesaria de desarrollar. Se piensa en una primera\netapa experimentar con el Picaflor de Cora para desarrollar conocimiento. Se ha trabajado en\ngenerar una maternidad de alto estándar a través de suplementos, agua para bañarse,\nmateriales para la casa e ir transformando las 5 hectáreas en fuentes poblacionales. Los nidos\nde los machos son inamovibles y son los que hay que proteger. Alfredo Ugarte fue un potencial\ndonador para este proyecto de reproducción, pero finalmente no resultó.\nDesde el Ministerio del Medio Ambiente (MMA) Charif Tala ha estado apoyando con el\nfinanciamiento de algunas acciones, como también lo hizo antes desde el Servicio Agrícola y\nGanadero (SAG). Anualmente, el Estado aporta ~15 millones de pesos chilenos. En Arica\nexisten Organizaciones No Gubernamentales (ONG) en torno a la especie. Ministerio del Medio\n158\nAmbiente es quien ha liderado el trabajo con la especie y la Secretaría Regional Ministerial del\nMedio Ambiente. La especie cuenta con Plan RECOGE.\nHay 3 lugares de micro reservas. Una de ellas la administra la Corporación Nacional Forestal\n(CONAF) y cuenta con un Guardaparque. Hay terrenos del Ministerio de Bienes Nacionales.\nUn Olivar sin manejo rodeado con chañares es un lugar que posee buenas características y\nque ha llegado a tener 15 hembras en maternidad. Un lugar característico con condiciones\napropiadas puede generar una zona reproductiva para el Picaflor de Arica. Se estima que en\nAzapa deben haber habido alrededor de 1.000. El Picaflor de Arica reúne muchos atributos\nque cierran muy bien con el Rewilding.\nCon relación al Guanaco, la migración altitudinal de los guanacos es un desafío, colocar énfasis\nen el fenómeno completo no solo en la especie. También considerar la triada Cóndor-Puma-\nGuanaco y la búsqueda de su equilibrio. En la estepa herbácea de Magallanes y asociadas a\nlos predios ganaderos y del hidrógeno verde destacan la Perdiz Copetona y la Perdiz Austral,\nespecies de interés en este enfoque de renaturalizar sistemas que han estado intervenidos.\nEl Canquén Colorado es otra especie en estado crítico. Con relación al Chorlo Chileno, dentro\ndel paisaje de la estepa herbácea de Magallanes, Pali Aike es muy chico, por ejemplo, y el\nChorlo Chileno, la Perdiz Austral y la Perdiz Copetona están en el mismo lugar. Chorlo chileno\npodría haber una subespecie, pero por el momento no tiene problemas de conservación.\n7. Claudio Cunazza (Corporación Nacional Forestal)\nGerencia Áreas Silvestres Protegidas (R). Entrevista realizada el 9 de agosto de 2024.\nRespecto del guanaco, este no es relevante en Magallanes, pero sin duda, en un espectro\nmás amplio, en la zona central, en la Reserva Nacional Río Cipreses y en el norte del país, es\nimportante. Es una especie icónica, muy relevante, es un herbívoro que está presente a lo\nlargo de todo el país.\nEl huemul ha mermado en el Parque Nacional Torres del Paine. Es una especie icónica del\npaís y para la conservación, así como para conseguir apoyo y recursos, lo que significa más\ndel punto de vista patriótico y porque está presente en las Regiones de Aysén y Magallanes.\nEs importante mejorar su estado poblacional a lo largo del país y profundizar en las razones\nde su merma poblacional.\nEl zorro chilote es escaso y es una especie que puede despertar mucho interés dada su\ncondición de amenaza. Falta que las instituciones se movilicen. De las aves, la principal es el\nCanquén Colorado, muy escasa en Magallanes y con serios problemas de conservación. Los\ngatos silvestres en general son de interés por su carisma, su importancia ecológica y su valor\nestético. El Puma es una especie significativa, hoy asociada al turismo de intereses especiales.\nEl cóndor también es interesante por su componente patriótico, es una especie atractiva. En\nel Valle del Colca, en Perú, estuvo en el sector de unos cañones, 10 a 15 cóndores sobre un\nguanaco muerto. Tamaño poblacional es más crítico. Con relación al Flamenco, en Magallanes\nhabía una población grande. Recomienda hablar con un Ingeniero Forestal de CONAF\nO\'Higgins, Alejandro Santoro. Él sabe de flamencos, hizo la crónica sobre los flamencos en la\nRN Flamencos y es el lugar donde están los tres flamencos presentes.\nHablar con Miguel Díaz. Hablar con Nicolás Soto del SAG Magallanes, hay ahí conocimiento\nmás allá de Magallanes pero de la institución misma y su injerencia en todo lo que es vida\nsilvestre.\n159\n8. Federico Luebert (Universidad de Chile)\nFacultad de Agronomía. Entrevista realizada el 2 de agosto de 2024.\nConsultado sobre el contexto biogeográfico sudamericano, comenta que las ecorregiones de\nOlson y colaboradores (2010) son adecuadas para representar unidades ecosistémicas en el\námbito de la conservación. Los biomas sudamericanos terrestres vistos como geo complejos\nno tiene expresión espacial.\nRecomienda no intentar definir la Cordillera de los Andes por lo complejo de la discusión. No\nobstante, menciona que puede ser de interés la revisión de la publicación: Una definición de\nlas montañas y sus cinturones bioclimáticos para la comparación global de datos sobre\nbiodiversidad (Körner et al. 2011).\nEn relación a la flora de la Cordillera de Los Andes menciona que puede ser de interés el\nartículo: Los Andes a través del tiempo: evolución y distribución de la flora andina (Pérez-\nEscobar 2022).\nLa publicación presenta una síntesis evolutiva y florística de la diversidad y evolución de las\nplantas andinas a través del tiempo y el espacio. La elevación de los Andes varió en el tiempo\ny el espacio. En particular, las rápidas tasas de elevación entre 8 y 5 Ma en los Andes\nseptentrionales pueden haber favorecido la diversificación de las plantas. Utilizando bases de\ndatos de especímenes en línea, sugieren que la flora andina comprende al menos 28.691\nespecies. Identifican los bosques montanos del norte de los Andes como la zona\npotencialmente más rica en especies.\nUtilizando un análisis biogeográfico sobre un conjunto de datos de 14 501 especies\nneotropicales en 194 clados, revelan que los Andes son tanto una fuente como un sumidero\nclave de la biodiversidad de plantas vasculares neotropicales. Desvelan fuertes vínculos\nbiogeográficos entre los Andes, la Amazonia y América Central.\nDestacan una serie de lagunas críticas en la investigación, en particular que los principales\ngrupos de plantas andinas aún están poco estudiados y que existen menos estudios para los\nAndes centrales y meridionales. Llenar estas lagunas permitirá una comprensión más holística\nde las floras andinas y proporcionará herramientas esenciales para su conservación.\n160\nLos Andes son la cadena montañosa con mayor biodiversidad del mundo y abarcan una\ncompleja variedad de ecosistemas, desde selvas tropicales hasta hábitats alpinos.\nProporcionamos una síntesis de la diversidad de plantas vasculares andinas mediante la\nestimación de una lista de todas las especies con registros disponibles públicamente, que\nintegramos con un conjunto de datos filogenéticos de 14.501 especies de plantas\nneotropicales en 194 clados. Descubrimos que (i) la flora andina comprende al menos 28.691\nespecies georreferenciadas documentadas hasta la fecha, (ii) los bosques nubosos de altitud\nmedia de los Andes septentrionales son los ecosistemas andinos más ricos en especies, (iii)\nlos Andes son una fuente y un sumidero clave de diversidad de plantas neotropicales, y (iv)\nlos Andes, la Amazonia y otros biomas neotropicales han tenido una cantidad considerable de\nintercambio biótico a lo largo del tiempo.\nGeology and uplift history of the Andes\n161\n(A) Geological map highlighting the three main Andean regions (Northern, Central, Southern)\nand the main Quaternary volcanic zones and tectonic processes. Adapted, with permission,\nfrom Ramos [17.].\n(B) Apatite fission tracks (AFTs) across the Andes, showing the cooling ages of the rocks (not\ntheir uplift) across the range. Red lines represent plate boundaries (convergent or subduction,\nline with red triangles; divergent and transform, red lines without symbols); white lines in the\nsea are seafloor fabric and magnetic lineations. Black lines in the continent correspond to\ncountry boundaries. (C–K) Reconstruction of Andean paleoelevation; adapted, with\npermission, from Boschman [23.].\n(C) At 80 Ma, the majority of the north-western edge of South America was still below sea\nlevel, the Central Andes were characterized by moderate topography in the continental margin\narc, and the Southern Andes have already uplifted gradually since 100 Ma.\n(D) At the Cretaceous–Paleogene boundary (66 Ma), uplift has started in the Northern Andes\n(NAN) and is occurring in the Western Cordillera (WC) of the Central Andes. Large marine\nforeland basins cover the interior of the continent, and marine incursions flood in the Neuquén,\nSan Gorge gulf, and Austral basin in the southeast of South America.\n(E) At 55 Ma, Western Patagonia has reached modern elevations.\n(F) By 34 Ma, uplift in the Northern Andes migrates northward, and uplift in the Central Andes\n(CAN) migrates eastward, resulting in the rise of local ranges in the Eastern Cordillera (EC).\n(G) At the start of the Miocene (23 Ma), marine incursions flood the San Gorge gulf and Austral\nbasin again.\n(H) At 15 Ma, uplift in the Northern Andes continues to migrate north, and from now on also\nmigrates east. Uplift in the Central Andes is focused in the Eastern Cordillera, and the foreland\nbasins become briefly marine again. In the Southern Andes the orogenic front in Patagonia\nmigrates east.\n(I) In the late Miocene uplift is focused in the Northern Andes and the eastern cordilleras and\nsub-Andean zone of the Central and Southern Andes, and the Altiplano experiences a\nparticularly rapid phase of uplift.\n(J) The final stages of uplift are predominantly in three Andean regions: the Eastern Cordillera\nand the Mérida Andes in the Northern Andes, the sub-Andes and the Sierras Pampeanas in\nthe Central Andes, and Eastern Patagonia in the Southern Andes. (K) Present-day elevation.\n162\nDistribución y muestreo de 29.843 especies de plantas vasculares andinas.\n163\nDensidad de los registros fósiles del Cenozoico en los Andes septentrionales, centrales y\nmeridionales y para angiospermas, helechos y gimnospermas (véase el conjunto de datos S3\ny Materiales y métodos en la información suplementaria en línea).\nAbreviaturas: Mya, hace millones de años.\nPhylogenetic insights into Andean plant diversification (Luebert & Weigend 2014)\nResumen. La orogenia andina está considerada como uno de los eventos más importantes\npara el desarrollo de la diversidad vegetal actual en Sudamérica. Comparamos los estudios\nfilogenéticos disponibles y las estimaciones del tiempo de divergencia para los linajes de\nplantas que pueden haberse diversificado en respuesta a la orogenia andina. La influencia de\nlos Andes en la diversificación de las plantas se divide en cuatro grandes grupos: Los Andes\ncomo fuente de nuevos hábitats de gran altitud, como barrera vicariante, como corredor\nNorte-Sur y como generador de nuevas condiciones ambientales fuera de los Andes. También\nse consideran las relaciones biogeográficas entre los Andes y otras regiones. Las estimaciones\ndel tiempo de divergencia indican que los linajes de alta elevación se originaron y diversificaron\ndurante o después de las principales fases de elevación andina (del Mioceno medio al\nPlioceno), aunque hay algunas excepciones.\n164\nComo era de esperar, los linajes andinos de altitud media tienden a ser más antiguos que los\ngrupos de altitud alta. La mayoría de los clados con distribución disjunta a ambos lados de los\nAndes divergieron durante el levantamiento andino. Los clados del interior de los Andes\ntambién tienden a divergir durante o después del levantamiento andino. Esto se interpreta\ncomo una prueba de vicarianza. Se ha demostrado que la dispersión a lo largo de los Andes\nse produce en ambas direcciones, aunque en la mayoría de los casos data de después del\nlevantamiento andino. Las estimaciones del tiempo de divergencia de los grupos de plantas\nfuera de los Andes abarcan un rango más amplio de edades, indicando que los Andes pueden\nno ser necesariamente la causa de estas diversificaciones. Los Andes están\nbiogeográficamente relacionados con todas las áreas vecinas, especialmente Centroamérica,\ncon intercambios florísticos en ambas direcciones desde el Mioceno temprano. Los estudios\nfilogenéticos también han demostrado relaciones biogeográficas directas entre los Andes y\notras regiones disjuntas, especialmente con las tierras altas del este de Brasil y Norteamérica.\nLa historia de la flora andina es compleja y la diversificación de las plantas ha sido impulsada\npor una variedad de procesos, incluyendo el cambio ambiental, la adaptación y las\ninteracciones bióticas.\nFigure 1. Left panel: South American map showing the major geographical Andean units\ndiscussed in the text and approximate location of the most commonly used geographical areas.\nBrown area are elevations above 3000 m. Right panel: Selected high Andean plants. (A)\nGentianella thyrsoidea (Gentianaceae); (B) Perezia pinnatifida (Asteraceae); (C) Azorella\ncompacta (Apiaceae); (D) Lupinus weberbaueri (Fabaceae); (E) Draba weberbaueri\n(Brassicacae); (F) Valeriana globularis (Valerianaceae). Photos by H. H. Hilger.\n165', 'description': 'ÑANDÚ DE DARWIN', 'parent_drive_file_id': '1JnsD4zgWKVAEymxe40m3NH-w-6SDejJ5', 'children': []}, {'id': '9f6d347c-4729-4511-b0d8-7e801617e7a1', 'drive_file_id': '1j4wnUt9MlKYeTg8THLdViVFBtOsgwj_n', 'name': 'PPT Rewilding Corredor Andino 2025.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1j4wnUt9MlKYeTg8THLdViVFBtOsgwj_n/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 38, 33, 568000, tzinfo=datetime.timezone.utc), 'text_content': 'Corredor Andino:\nUna visión continental para el Rewilding:\nSOMOS EL LEGADO DE\nTOMPKINS CONSERVATION\nPASADO PRESENTE\n11,8 MILL HÁ\n7,4 MILL HÁ\nPROTEGIDAS\nPROTEGIDAS\n17\n10\nPARQUES\nPARQUES\nNACIONALES\nNACIONALES\nRECUPERACIÓN DE ESPECIES CLAVES EN LOS ECOSISTEMAS\n¿QUÉ HACEMOS?\n¿CUÁLES SON LAS ESPECIES CLAVE?\nGrandes carnívoros, herbívoros y frugívoros como el puma, el huemul,\nel guanaco, el ñandú , el cóndor y otras especies con las que se\ndesarrollan estrategias basadas en el Rewilding\nCORREDOR\nNACIONAL\nDEL HUEMUL\nINAUGURACIÓN\nCENTRO DE\nRESCATE DEL\nHUEMUL\nCENTRO DE RESCATE Y\nREHABILITACIÓN\nDEL HUEMUL\nCorredor Andino\n¿Qué busca el Rewilding?\n- Restaurar la integridad ecológica a gran\nescala mediante un enfoque integral que\nabarca: especies clave, conectividad\necológica y áreas protegidas.\n- Concepto dinámico y multifacético, con\nvisión de futuro, que ha sido adaptado y\nreinterpretado en distintos contextos\nalrededor del mundo.\n“El rewilding es el elemento más reciente en la historia del movimiento\ncientífico de la conservación. Sin embargo, no se debe utilizar como un\nenfoque aislado. Más bien, complementa a otros métodos que buscan\nestablecer redes de largo alcance de protección de la naturaleza, poniendo\nénfasis en la importancia de la conectividad y la gran escala.\nA diferencia de otros enfoques, facilita el diseño y la gestión de áreas\nprotegidas evitando que se aborden a las especies de manera individual.\nDe esta manera, el rewilding es en tanto un fin, en el sentido de corregir\nnuestros errores pasados en el manejo, como una estrategia para\ngarantizar la viabilidad de las unidades de conservación. Esta\ncombinación inusual de ser un fin y una estrategia a la vez es, quizás, su\ncaracterística intelectualmente más atractiva.”\nMICHAEL SOULÉ Y JOHN TERBORGH (1999)\nECOSISTEMA COMPLETO\n- Tiene todas las especies que allí\nevolucionaron, mayormente\nextinguidas en los últimos 200\naños por causas humanas.\n- Restituirlas a todas a veces es\nimposible y por ello se prioriza\nreintroducir a LAS ESPECIES\nCLAVE.\nPUMAS AUMENTAN LA SALUD DE LOS ECOSISTEMAS Y LA BIODIVERSIDAD\n✓ Nutrientes y hábitat para invertebrados\n✓ Enriquecen el suelo y la diversidad de plantas\n✓ Aumenta el acceso al alimento de pequeños mamíferos (armadillos)\n✓ Proveen de alimentos a otros carroñeros y carnívoros\n✓ Aves y armadillos se alimentan de gusanos e insectos en las carroñas\nEcosistemas\ncompletos y\nfuncionales\nEspecies claves,\nroles\necológicos,\nextinciones\necológicas y\nfuncionales e\ninteracciones\nCasos emblemáticos de Rewilding – Década de los 90 (US)\nEl Cóndor de California Reintroducción de Lobos en el Parque Nacional Yellowstone\n22 individuos - 360 31 lobos, 1995. PNY\n1988: Colaboración transfronteriza (Chile – Perú – Bolivia) para la reintroducción de la\nvicuña en Ecuador\n270 vicuñas\ndonadas que\nconforman hoy\nuna población de\n6.000\n2019: Rescate de la Rana del Loa. Herpetólogos y Zoológico Nacional\nEn Oasis de Calama herpetólogos encuentran los últimos 74\nindividuos e intervención de maquinaria pesada.\nRescate 1 - 60 ranas son trasladadas a la quebrada Ojo de\nOpache\nRescate 2 - 14 ranas trasladadas al Zoo Nacional de Chile. Se\nencontraban en muy mal estado de salud.\nPrograma de rehabilitación y crianza en acuarios\nespecialmente acondicionados con agua\npurificada y dieta variada de invertebrados.\nReproducción exitosa de algunas parejas produciendo 600\nrenacuajos. Proceso de recuperación incluyó\nasistencia nutricional, adaptacion a la vida en\ncautiverio y estimulo de la reproduccion.\nLa reproducción en cautiverio será inútil si no se reintroducen\nen su hábitat natural, por lo que resulta crucial\ntrabajar en la restauración de su hábitat.\n2004 – 2018:Conversión Estancia Valle Chacabuco en el Parque Nacional\nPatagonia\nDesde la Ruta de los Parques de la Patagonia al Corredor Andino:\nLa Patagonia chilena ha sido históricamente nuestro ámbito de\nacción.\nFrente a crecientes tasas de defaunación y pérdida de hábitats\nen todo el continente, nos hemos propuesto ampliar nuestro\nimpacto hacia nuevos territorios.\nProyectamos nuestro trabajo hacia el Corredor Andino,\nentendido como el área de influencia de la cordillera de los\nAndes, desde Colombia y Venezuela hasta el Cabo de Hornos\nen la Patagonia.\nMediante alianzas estratégicas, buscaremos expandir la\nrecuperación de otras especies amenazadas y ecosistemas para\nintegrar el rewilding como una estrategia de conservación a\nescala andina.\nSexta extinción masiva\nPredicción de los Riesgos de Extinción de Especies Globales\n• Predicción para el año 2100\nde las extinción de distintas\nespecies.\n• Puntos de mayor riesgo de\nextinción son Sudamérica,\nAustralia y Nueva Zelanda.\n• Se destaca la Cordillera de los\nAndes\nLiu, Runya, Haruka Ohashi, Akiko Hirata, Longlong Tang, Tetsuya Matsui, Kousuke Terasaki, Ryuzo Furukawa, and Norihiro Itsubo. 2024. "Predicting the Global Extinction Risk for 6569 Species by\nApplying the Life Cycle Impact Assessment Method to the Impact of Future Land Use Changes" Sustainability 16, no. 13: 5484. https://doi.org/10.3390/su16135484\nCorredor Andino:\nuna visión continental\npara el rewilding\nEscalar su impacto y expandir esta visión\nConcentraremos esfuerzos en las 5 especies\nemblemáticas presentes a lo largo del\nCorredor Andino: el cóndor, el huemul, el\nguanaco, el ñandú y el puma.\nCorredor Andino\n• Visión de conservación continental de los\necosistemas asociados a la Cordillera de los\nAndes, especies claves y en condición de\namenaza.\n• Desde Venezuela hasta la confluencia de los\nOcéanos Pacífico, Atlántico y Antártico por el\nsur.\n• Revisión del estado de conservación global y\nlocal de especies y estrategias de conservación\nimplementadas.\n• Mapa de actores involucrados en estas\nCordillera de Los Andes 9.000 Km\niniciativas para aumentar la red de\n7 países: Argentina, Chile, Bolivia, Perú,\ncolaboración.\nEcuador, Colombia y Venezuela.\nCordillera terrestre más larga\n• Avanzar hacia los objetivos de biodiversidad al\nSegunda más alta del planeta, después\n2030.\ndel Himalaya.\nAproximación del Corredor Andino\n• Foco en especies amenazadas y los\necosistemas que requieren\n• Evaluación de la matriz del territorio\n• Colaboración interinstitucional\n• Involucramiento público-privado\n• Carácter transfronterizo\n• Enfoque continental\n• Participación de comunidades y la\nsociedad en general\n• Compromiso del Estado\nCÓNDOR\nVultur gryphus\nGAVIOTÍN\nCHICO\nSternula lorata\nOBJETIVOS DE\nLARGO PLAZO\nPUDÚ\nPudu mephistophiles\nRANA DEL LOA\n1 Telmatobius dankoi\nPUMA\nConsolidar la Ruta de los\nPuma concolor\nParques de la Patagonia como\nun referente de conservación a\nnivel continental\nHUEMUL VIZCACHA DE LA\nHippocamelus bisulcus MONTAÑA\nLagidium viscacia\n2\nSURI\nExpandir el rewilding hacia el Rhea pennata tarapacensis\nCorredor Andino\nTARUCA\nHippocamelus antisensis\nPICAFLOR DE ARICA\nEulidia yarrellii\nGUANACO\nLama guanicoe\nCHUNGUNGO\nCHINCHILLA Lontra provocax\nChinchilla chinchilla\nEspecies de amplia distribución, equivalentes ecológicos y amenazadas\nTurismo Naturaleza en la Red de Santuarios de la RMS utilizando al guanaco como\n“especie bandera en la restauración del paisaje de montaña\nPrograma Piloto - Repoblamiento\nguanacos zona central y turismo de naturaleza\n→ Restauración de subpoblaciones de guanaco\nen la Región Metropolitana\n→ Turismo de naturaleza en la Red de Santuarios\nde la Región Metropolitana\n→Guanaco como especie bandera en la\nrestauración del paisaje de montaña.\n→Red de Santuarios de la Naturaleza – Santuario\nLagunillas - Santuario El Plomo - Santuario\nCascada – Fac. Cs.. Forestales y Cons. Naturaleza,\nU. de Chile – GORE Metropolitano – Fundación\nRewilding Chile.\n→ Conaf, MMA, SAG, cámaras de turismo y\nmunicipios de Barnechea y San José de Maipo.\n→ Convenio de colaboración para establecer\ncentros de reproducción de guanacos.\nREPOBLAMIENTO GUANACOS\nCONSERVACIÓN A GRAN ESCALA\nAlianza colaborativa por el Cóndor Andino\nProyecto Manku\nhttp://www.icesi.edu.co/wiki_aves_colombia/show_image.php?id=580\nOtros aspectos a ser considerados por el Rewilding\n• Iniciamos con ecosistemas\n• Personas se identifican con\nespecies carismáticas\n• Especies claves y paraguas\n• Fauna tiene más restricciones\npara manejo\n• Flora amenazada es importante\n• Rewilding en áreas costeras y\nmarinas\nCorredor Andino - Alcances y Proyecciones\nUn continuo con gradientes y diferentes contextos\n•\nAbordaje por especies con visión ecosistémica\n•\nGran escala y expansión, mayor impacto\n•\nSe busca consolidar el rewilding como estrategia\n•\nen la conservación de la naturaleza de Chile y\nSudamérica.\nNecesidad de escalar su impacto y expandir esta\n•\nvisión más allá de la Patagonia.\nEl Rewilding en Chile y el Corredor Andino\n• Red colaborativa que se extiende desde la\nPatagonia y sus mares para proteger y restaurar\necosistemas completos.\n• Abordar la recuperación de especies amenazadas y\nel restablecimiento de interacciones ecológicas\nclaves.\n• Promover sinergias entre países para optimizar\nrecursos, compartir aprendizajes y amplificar el\nimpacto.\n• Enfoque integral para establecer corredores y\náreas silvestres protegidas, restauración de\nhábitats críticos, manejo activo, reintroducciones y\nrefuerzos poblacionales,', 'description': None, 'parent_drive_file_id': '1JnsD4zgWKVAEymxe40m3NH-w-6SDejJ5', 'children': []}, {'id': '7c905353-eda6-44f3-bc38-e8d7275d87f8', 'drive_file_id': '16aL8p9RIlGjibtPW6a9HkYRws2lKL9T8', 'name': 'Resumen Dcto Extendido Corredor Andino_02.08.25.docx', 'mime_type': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/16aL8p9RIlGjibtPW6a9HkYRws2lKL9T8/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 22, 18, 38, 36, 612000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1JnsD4zgWKVAEymxe40m3NH-w-6SDejJ5', 'children': []}, {'id': '686ceb43-683c-48bc-8908-9d8f01c2f76b', 'drive_file_id': '1QyhcOXvZPaoFIEhWY5EbpWY_tY9dX55o', 'name': 'Doc. Extendido_Corredor Andino Sudamericano (120526).docx', 'mime_type': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/1QyhcOXvZPaoFIEhWY5EbpWY_tY9dX55o/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 22, 18, 38, 10, 286000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1JnsD4zgWKVAEymxe40m3NH-w-6SDejJ5', 'children': []}]}, {'id': '41cf0b76-bd1a-4709-ad3b-172cc66c15d5', 'drive_file_id': '1MwQ-fk-wcDZpgifvrpszG4FSkVkYrFNt', 'name': 'Cóndor', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1MwQ-fk-wcDZpgifvrpszG4FSkVkYrFNt', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 50, 95000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': [{'id': '2d85141b-8eae-455a-b2b3-486c84090e2f', 'drive_file_id': '1kpMsRjhsPF22Rl6aB3f1Mn2Qb0jEzXPe', 'name': 'Colombia', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1kpMsRjhsPF22Rl6aB3f1Mn2Qb0jEzXPe', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 53, 84000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1MwQ-fk-wcDZpgifvrpszG4FSkVkYrFNt', 'children': [{'id': 'fea097a5-10f6-41e4-9bd9-02cc0cb50ee8', 'drive_file_id': '15guUK6b8F6XsgQzI1VTSeMQG8Q39_bg5', 'name': 'Informe tema Condor Colombia_12.06.26 IECS.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/15guUK6b8F6XsgQzI1VTSeMQG8Q39_bg5/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 38, 42, 916000, tzinfo=datetime.timezone.utc), 'text_content': 'INFORME TERRENO COLOMBIA – FUNDACIÓN JAIME DUQUE\nPROGRAMA CONDOR ANDINO,\n20-26 MAYO DEL 2026\nHacia fines del mes de mayo estuvimos en una gira técnica visitando y conociendo in situ el proyecto\ncompleto de la Fundación Parque Jaime Duque (FPJD). Esto como parte de la iniciativa del Corredor\nAndino que como Fundación Rewilding Chile venimos impulsando, de manera de fortalecer la\ncolaboración entre instituciones para el desarrollo y fortalecimiento de las estrategias para la\nrecuperación poblacional de cóndores en Colombia en el extremo norte de la Cordillera de los Andes.\nEl programa del cóndor andino se enmarca bajo el alero del proyecto Manku (AvesChile de la Unión\nde Ornitólogos de Chile y el Centro de Rehabilitación de Aves Rapaces), liderado por Eduardo Pávez,\nquien también participó de la gira y reuniones realizadas.\nTuvimos la oportunidad de conocer y compartir experiencias del trabajo de FRC con la representante\nde la IUCN - específicamente con Mayerlin Ramos - Coordinadora de los Centros para la\nSupervivencia de las Especies con quien extendimos nuestra conversación a nuestros proyectos y en\nespecífico interesada en el tema de repoblamiento de guanaco en la cordillera de los Andes en la\nRM-Chile, y también con Michael Clifford el director de Estrategia de Reverse the Red (una iniciativa\nglobal que se apoya en la Unión Internacional para la Conservación de la Naturaleza - UICN). Sobre\neste último su trabajo se centra en frenar extinciones, a través de la coordinación con coaliciones\ninternacionales para evaluar el declive de especies y asegurar su recuperación en estado natural.\nEstas reuniones en el marco de nuestra participación en el último día del congreso de la Asociación\nLatinoamericana de Parque Zoológicos y Acuarios 2026, el cuál reunió en Colombia a líderes,\ncientíficos, educadores y tomadores de decisiones de los principales zoológicos y parques de\nconservación de América Latina. Tuvimos la oportunidad de presentar el trabajo de FRC, la historia\ny los proyectos que desarrollamos, además de profundizar en lo relativo al Corredor Andino y\npresentar la primera versión de este video, así como el de Ruta de los Parques y Cabo Froward, todo\nlo cual fue muy bien recibido por los distintos asistentes.\nEn los días que siguieron estuvimos recorriendo con un intenso programa y conociendo a fondo el\ntrabajo y los ámbitos de la FPJD. Del equipo de la FPJD pudimos compartir con Rafael Torres, Luz\nEsthella, Diego Torres, Estefania Gómez, Orlando Feliciano, así como diferentes miembros de su\nequipo. Todos entregaron mucho tiempo y dedicación para contarnos todos los detalles del origen\nde la fundación, el bioparque, los proyectos sociales y de conservación.\nLa fundación se dedica a:\n- Conservación de la familia y la labor social.\n- Conservación de la naturaleza.\n- Conservación de la cultura.\nVIVERO-RESTAURACION\nDesarrollan un programa de restauración, construyeron viveros para sus propios terrenos para\nrepoblar y plantar árboles, pero hoy mantienen el vivero para el repoblamiento con árboles en los\nalrededores en las comunidades, a la fecha han plantado 300.000 árboles en las localidades aledañas\na través de implementación de diferentes programas asegurando el futuro de las plantas con\nevaluación de las especies más adecuadas de acuerdo con las características de cada sitio.\nTambién conocimos todos los ámbitos de trabajo de la fundación, pero principalmente\nprofundizamos en conocer los dos proyectos emblemáticos de conservación de vida silvestre: el\nprograma de conservación del cóndor de los Andes y el Santuario de Oso de Anteojos.\nSANTUARIO OSO DE ANTEOJOS\nEn el caso del Osos de anteojos manejan un centro de rehabilitación en el mismo Santuario de\nNaturaleza. El Santuario es una estrategia de la FPJD que aporta a la conservación de esta especie,\nproporcionando un espacio natural y seguro, con atención integral a los individuos de oso\ndecomisados, recuperados, enfermos y/o de avanzada edad; protegiendo el hábitat natural y\ntrabajando con las comunidades que cohabitan con el oso.\nLos objetivos principales están relacionados a la rehabilitación y bienestar, investigación científica,\nprotección del hábitat y trabajo comunitario.\nPudimos recorrer parte del Santuario y conocer el centro de rescate y la infraestructura con que\ncuenta (grandes encierros metálicos muy bien construidos cubriendo aproximadamente unas 5 ha\ninterconectados por túneles, salas de alimentación), lo que además nos permitió conocer el hábitat\ndel oso, una zona de la cordillera de los Andes que posee el bosque alto andino y un sector de\ntransición hacia el páramo, un bosque lluvioso de altura donde pudimos observar muchas\nsimilitudes de especies y géneros que se comparten con los bosques siempreverdes del sur de Chile,\ncompartiendo además los altos niveles de pluviometría e incluso algunas especies de mirtáceas y\nrastreras.\nPROGRAMA CONSERVACIÓN DEL CONDOR ANDINO – COLOMBIA 24 DE MAYO\nEn el caso del cóndor, pudimos conocer a Lorena que está a cargo de los cóndores, lleva más de 4\naños en el programa y nos mostró las incubadoras, la zona de alimentación, pudimos ver a un pichón\nde 25 días de cóndor siendo alimentado con un títere de cóndor para evitar la impronta. También a\nlo lejos, porque no se puede visitar el lugar de encierro de aclimatación y crecimiento de Rafiki el\ncóndor que nació en el centro y que tiene 1 año y medio y es donde van independizando y\nsocializando a los cóndores que han ido naciendo y que vienen más atrás en el proceso.\nAdquirieron un predio de 300 hectáreas que le llaman la reserva natural del cóndor, con fondos que\npostularon y fueron aprobados por la IUCN. Ahora están explorando en esa misma zona más tierras\npotenciales de comprar incluso en una de estas, han registrado el primer nido de cóndor natural que\nestán monitoreando. En esta zona hay venados que constituye la base alimentaria original de los\ncóndores y la cual ha sido reemplazada por ganado doméstico menor y mayor.\nTienen otros terrenos en vista en esa zona, pero su idea no es cubrir un paño inmenso, pero si poder\nadquirir una red de algunos predios en pro de la conservación del cóndor. Ahora el objetivo es\ncomprar las 330 hectáreas donde han encontrado este primer nido de cóndores.\nEl domingo 24 de mayo sostuvimos ya una reunión completa sobre Cóndor más en detalle, y el plan\nque se fue revisando y los temas a donde se fue apuntando la conversación fue:\n1. Captura de cóndores silvestres y su monitoreo, esto con el objetivo de entender sus movimientos,\nlos hábitats que utilizan. En este punto se está trabajando con el MMA de Colombia para actualizar\nel plan nacional del cóndor con la metodología de IUCN de manera que sirva de respaldo a las\nacciones que se han venido realizado, así como las que se proyectan.\nEn el caso de la traslocación de cóndores desde Chile, hay un tema con la genética de los cóndores,\npor lo que se les hace el seguimiento de la filogenia, pero es importante señalar que los cóndores\nde Colombia ya tienen genes de Chile y Argentina (por las liberaciones realizadas desde cóndores\ntraídos desde USA hace algunas décadas), por lo tanto, con esto es relativamente fácil como\nargumentación frete a los genetistas extremos.\n2. Ampliar la Reserva con nuevos predios. Este nuevo lugar la reserva la idea es constituirlo como\nuna base de capturas, liberaciones y monitoreo.\nEl tema ahora es la gripe o influenza aviar para trasladar cóndores de Chile a Colombia, lo cual ya\nestá siendo abordado con la autoridad sanitaria animal de Colombia (Instituto Colombiano\nAgropecuario, ICA).\nEl objetivo es lograr hacer la primera liberación de un grupo de cóndores combinando los nacidos\nen cautiverio y el que se traslade desde Chile en el área de Santander-Reserva. Además, también se\nproyecta la captura de 4 cóndores silvestres ya que se dispone de 4 trasmisores y liberarlos marcados\npara estudiar sus patrones de movimientos y áreas de acción, lo cual entregará información relativa\na dormideros, posaderos, lugares de alimentación y de las rutas de vuelo de los cóndores en el\nterritorio ampliado, lo que permitirá incorporar esta información a las estrategias de trabajo.\n3. Reproducción. Una conclusión clave que expone Orlando F. es la necesidad de pensar en que\nnecesitamos muchas parejas reproductoras para hacer número, y que así estos núcleos puedan\ncontar con más individuos, considerar todas las opciones desde huevos fértiles, pichones, juveniles\npara de esta forma lograr generar y contar con un mayor número de cóndores.\nEn la zona hay otras organizaciones comprando tierras por el Proyecto Titi y los ProCat, la idea es\nlograr de la zona un área de conservación con todas estas iniciativas.\n4. Educación ambiental o vinculación comunitaria, llevan un fuerte trabajo comunitario, fuimos\ntestigos visitando uno de los proyectos cercanos al santuario del oso de anteojos en fincas privadas\ncon monitoreo de oso de anteojos y promoción de la coexistencia con los ganaderos.\nComo conclusión de esta reunión fue: que proyecto Manku avanzará en la redacción inicial de un\nacuerdo marco con la FPJD, que será el alero del trabajo conjunto donde entra la Fundación\nRewilding Chile (FRC), y que a su vez nosotros avanzaremos en un acuerdo directo entre FRC y FPJD\ncon los temas puntuales de manera de operativizar la colaboración.\nREUNION CON EDUARDO PAVEZ – 28 MAYO 2026 (IE, CS)\nAcordamos que Eduardo va a preparar:\n- Anexo al convenio de colaboración que existe entre FRC, FCS, UNORCH en el marco del proyecto\nManku, donde se agregará las colaboraciones en este trabajo que sale de las fronteras de Chile a\nColombia (en adjunto).\n- Eduardo P. avanzaría en un borrador de convenio entre Manku y FPJD.\n- Fundación Rewilding Chile y FPJD avanzará en una reunión más en detalle de cuáles serán las\ncolaboraciones y estás quedarán amparadas en un convenio entre ambas instituciones.\nREUNION FPJD - FRC – 09 JUNIO 2026 (IE, CS)\nLa FPJD desarrolla 4 ejes principales por parte del programa de conservación del cóndor:\n1. Conservación in - situ\n2. Conservación ex - situ\n3. Áreas de buen vivir (trabajo con comunidades)\n4. Areas seguras del Cóndor (adquisición de tierras)\nEl proyecto del cóndor de FPJD ha ido creciendo en el tiempo haciendo cosas, pero recién el año\n2024 comienza con la tarea de recopilar información de lo desarrollado, formulando un nuevo\nprograma, planes de corto plazo, porque hoy el financiamiento proviene mayoritariamente del\nbioparque (90%). Ahora el 90% de los recursos son del bioparque, el 10% de otros ingresos como\npostulaciones IUCN u otras que les han permitido: financiar cámaras trampas, licencias ESRI, compra\nde tierras, también con comunidades donde por ejemplo lograron el financiamiento con 130.000\nUSD.\nEl personal asignado al programa cóndor no es exclusivo, Fernando y Lorena, así como otros\nintegrantes se apoyan con personal del equipo del bioparque.\nTrabajan en una zona proyectada llamada el Páramo del Almorzadero de 157.000 hectáreas que\nposee propiedades privadas y fiscales que corresponde al ecosistema andino de páramo, el cual no\ntiene figuras de protección. En esta zona se encuentra la reserva y existen 11 vecinos potenciales\nque les interesaría avanzar en compras que está siendo estudiadas y evaluadas. Están tratando de\nllegar a acuerdo ahora con una propiedad de 300 hectáreas. El precio de las propiedades fluctúa\nentre 980.000 - 2.000.000 pesos colombianos la hectárea ($255.000 - $520.000 pesos chilenos la\nhectárea). La reserva de Cruz de Piedra de 226 hectáreas que compraron con fondos de IUCN costó\n270.000.000 pesos colombianos (70.000.000 pesos chilenos).\nEl objetivo de estas propiedades es la base del monitoreo efectivo con gestión en cada una de estas\náreas a lo largo de un mosaico de propiedades y una red de áreas protegidas...\nSemanalmente están teniendo registros de venados de cola blanca, pumas, cóndores. Idealmente el\nobjetivo de conservación debe ser mayor, no solo el cóndor, sino del norte al sur ir conectando la\ntrama completa de las especies naturales y promover la coexistencia.\nEn base a estos temas las líneas potenciales de financiamiento que ayudaría en un trabajo\ncolaborativo con la FRC serían:\n- Construcción de instalaciones y recintos de preliberación.\n- Trámites y permisos asociados a los traslados de cóndores.\n- Los trasmisores satelitales y otros implementos para el monitoreo.\n- Personal relacionado en la reproducción in situ, aclimatación y monitoreo silvestre exclusivo en\nterreno.\nPor ejemplo, hace ya varios meses que vienen gestionando el traslado de 3 cóndores andinos desde\nUSA para emparejarse y además está considerado el traslado del joven cóndor Antuco desde el CRAR\nen Chile.\nOtros aspectos que se abordaron y que requieren contar apoyo son:\n- Un desafío es una priorización de las áreas a trabajar y en ellas considerar los kits de monitoreo,\nplataformas de alimentación y una red de cámaras trampas.\n- La construcción de recintos de preliberación, los cuales ya los tienen diseñados y el presupuesto\nes de 60.000.000 pesos colombianos (15.600.000 pesos chilenos), esto es parte del refugio.\n- Construcción de 3 plataformas de cóndores donde se les provee de alimento en la reserva y reduce\nconflictos. El diseño está listo y el presupuesto es de 28.000.000 pesos colombianos las 3 (7.200.000\npesos chilenos), un poco menos de 10 millones de pesos colombianos cada una.\n- Construcción de encierros en piso para la comida, esto se ocupa para los censos en la captura y\nrecaptura (1 vez al año), y sirve para proteger la carroña que se coloca para impedir que lleguen\nperros domésticos.', 'description': 'rewilding chile', 'parent_drive_file_id': '1kpMsRjhsPF22Rl6aB3f1Mn2Qb0jEzXPe', 'children': []}]}]}, {'id': 'cc91c642-fdf5-4540-962d-9d4ad4b6965f', 'drive_file_id': '1_XigDl3txUSdpJyT2EWDpRc-Tt-OcuXX', 'name': 'Informes de Exploración CA', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1_XigDl3txUSdpJyT2EWDpRc-Tt-OcuXX', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 19, 575000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': [{'id': '56502395-8712-4b0b-9558-977930e84d9b', 'drive_file_id': '1HTdWebXjVNWR-JswjYpHNAYxoddOHxkV', 'name': 'Condor Andino', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1HTdWebXjVNWR-JswjYpHNAYxoddOHxkV', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 28, 380000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1_XigDl3txUSdpJyT2EWDpRc-Tt-OcuXX', 'children': [{'id': 'c19aa05c-ac10-4780-a3d0-8e862faed592', 'drive_file_id': '1PitLiVPNz1-7J6lA8R580XKSb7XYI7XL', 'name': 'readme.txt', 'mime_type': 'text/plain', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1PitLiVPNz1-7J6lA8R580XKSb7XYI7XL/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 48, 160000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1HTdWebXjVNWR-JswjYpHNAYxoddOHxkV', 'children': []}]}, {'id': '6a0391ca-fe65-467e-9645-fbf3e7d73210', 'drive_file_id': '1_zwa8adUBWU6jvXkv79RZjcT4Dk_dV8N', 'name': 'Picaflor de Arica', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1_zwa8adUBWU6jvXkv79RZjcT4Dk_dV8N', 'modified_time': datetime.datetime(2026, 6, 22, 18, 36, 22, 455000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1_XigDl3txUSdpJyT2EWDpRc-Tt-OcuXX', 'children': [{'id': '3953cc09-55a6-48da-a06d-d353a74566ce', 'drive_file_id': '1Yz0vYkzVLXVmeko0uZ1-tVQtIT1IIxRI', 'name': 'readme.txt', 'mime_type': 'text/plain', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1Yz0vYkzVLXVmeko0uZ1-tVQtIT1IIxRI/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 47, 488000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1_zwa8adUBWU6jvXkv79RZjcT4Dk_dV8N', 'children': []}]}]}, {'id': '3986e1f5-55d2-49e7-9c9b-f10c7a813f53', 'drive_file_id': '1zZ8L3n2m7umR__Mld_j9CmB5YxpF2G77', 'name': 'Shaw Island - Agosto 2025', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1zZ8L3n2m7umR__Mld_j9CmB5YxpF2G77', 'modified_time': datetime.datetime(2026, 6, 22, 18, 35, 50, 872000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1xasld_VAB4n4AWOPCSOEAMCZV3JGcQpC', 'children': [{'id': '02831f3b-4584-47cc-8f48-d5404d617a5f', 'drive_file_id': '1i3nTKlTu-Jt3NhSoL_kX3XWoLxJwMscM', 'name': 'Doc. a Carolina CA_08.05.26', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1i3nTKlTu-Jt3NhSoL_kX3XWoLxJwMscM', 'modified_time': datetime.datetime(2026, 6, 22, 18, 35, 59, 364000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1zZ8L3n2m7umR__Mld_j9CmB5YxpF2G77', 'children': [{'id': '4c68adbe-cae9-4223-ba69-9381e49612ea', 'drive_file_id': '15KuLedOTcsexveQWW7dDS4lG64hHE356', 'name': 'Resumen Dcto Extendido Corredor Andino_02.08.25.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/15KuLedOTcsexveQWW7dDS4lG64hHE356/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 27, 692000, tzinfo=datetime.timezone.utc), 'text_content': "MINUTA DE DOCUMENTO ORIGINAL DE AGOSTO DEL 2024\nDel Corredor Andino a los mares del fin del mundo\nExpandiendo el impacto del Rewlding desde la Patagonia por Sudamérica\nTABLA DE CONTENIDOS\n1. Introducción\n2. Ecosistemas terrestres\n3. Ecosistemas marinos\n4. Corredor Andino: visión y desafíos\n5. Especies claves en el ecosistema del corredor andino\n6. Criterios de selección de especies, áreas y ecosistemas a abordar\n7. Transferencia de la experiencia de Rewilding Chile en Patagonia hacia el Corredor Andino\n8. Próximos pasos\nAgosto 2025\n1. INTRODUCCION\nRewilding Chile es una fundación sin fines de lucro y parte del legado de Douglas y Kristine Tompkins,\nquienes a inicios de los años 90 decidieron dedicar su vida a conservar la belleza y la biodiversidad\nde la Patagonia chilena para contrarrestar la crisis de extinción de especies y el cambio climático.\nTres décadas después, Rewilding Chile sigue profundamente comprometida con la visión de sus\nfundadores: los ecosistemas saludables y su complejidad de especies, interrelaciones y procesos\ndarán a los seres vivos una oportunidad de perpetuarse en el tiempo. Con esa visión, Fundación\nRewilding Chile y su socio Tompkins Conservation, han trabajado en la conservación de los\necosistemas de la Patagonia chilena para enfrentar los factores que amenazan global y localmente a\nla biodiversidad.\nEl rewilding es una estrategia para la conservación integral que incluye la implementación de\nacciones como: la creación de parques nacionales terrestres y marinos, la restauración de los\necosistemas, el manejo activo de especies amenazadas, la promoción del bienestar de las\ncomunidades locales, además del activismo y la educación pública para fomentar una cultura de\nconservación. A través del rewilding, la Fundación Rewilding Chile busca conservar ecosistemas\nsaludables y funcionales que permitan que las áreas de protección sean un motor para el desarrollo\nlocal, donde el turismo de naturaleza se constituye como un eje estratégico de este desarrollo.\nLa Fundación Rewilding Chile ha concentrado su área de trabajo en la Patagonia chilena, que\ncomprende la parte sur de la región de Los Lagos, la región de Aysén y la Región de Magallanes y\nAntártica chilena. La Ruta de Los Parques Nacionales de la Patagonia es un corredor de conservación\nimpulsado por Rewilding Chile y conformado por un grupo de 17 parques nacionales desde la ciudad\nde Puerto Montt (41ºS) al Cabo de Hornos (56ºS). Estos parques nacionales representan a 4\necorregiones terrestres: bosque magallánico sub antártico, bosque templado valdiviano, estepa\npatagónica y una gran superficie de rocas y hielos. La Fundación promueve la Ruta de los Parques de\nla Patagonia como una visión de conservación para el territorio, que plantea equilibrar la protección\nde la naturaleza con el desarrollo económico de sus comunidades a través del turismo como\nconsecuencia de la conservación.\nNos encontramos próximos al año 2030 y la biodiversidad sigue disminuyendo en todo el planeta.\nUna respuesta concreta a la actual crisis ambiental es asegurar que la conservación de la\nbiodiversidad permita proteger la capacidad de los ecosistemas de ofrecer bienestar y beneficios a\nlas personas y a otros seres vivos.\nEste documento es un resumen del original que tiene por objetivo compartir algunos antecedentes\nque permitan elaborar una visión de conservación continental y una propuesta para la conservación\nde los paisajes de la Cordillera de los Andes y sus especies características y sus hábitats, desde\nVenezuela por el norte hasta la confluencia de los Océanos Pacífico, Atlántico y Antártico por el sur,\nque permita alcanzar los objetivos de biodiversidad al año 2030. Para esto se requiere hacer una\nrevisión del estado de conservación global y local actual de algunas especies asociadas a la Cordillera\nde Los Andes, las estrategias de conservación implementadas para su conservación y los actores\ninvolucrados en estas iniciativas.\n2. ECOSISTEMAS TERRESTRES\nAmérica del Sur abarca una superficie de 17,9 millones de kilómetros cuadrados y alberga 215\necorregiones terrestres (Olson et al. 2001). Las ecorregiones terrestres reflejan las distribuciones de\nuna amplia gama de fauna y flora en todo el planeta y facilitan la planificación de la conservación a\nescala mundial y regional. Es un marco de clasificación basado en los conocimientos biogeográficos\nexistentes y cada ecorregión representa biotas distintas. Esta clasificación proporciona un marco\npara las comparaciones entre unidades y la identificación de hábitats y conjuntos de especies\nrepresentativas.\nEn específico, La Cordillera de Los Andes es una cadena montañosa ubicada en la costa occidental\ndel continente Sudamericano, la cual atraviesa el territorio de 7 países: Argentina, Chile, Bolivia,\nPerú, Ecuador, Colombia y Venezuela. Con más de 9.000 kilómetros de longitud, siguiendo la cadena\nmontañosa y más de 6.000 metros de altitud, es la cordillera terrestre más larga y la segunda más\nalta del planeta, después del Himalaya.\nLa Cordillera de los Andes se origina por la subducción de la placa continental sudamericana con una\nserie de placas oceánicas. Su morfología ha sido modelada a través del tiempo por procesos que\ntienen lugar en su superficie: el proceso glaciario dadas sus altas cumbres y otros procesos fluviales,\neólicos, volcánicos y de remoción en masa. La combinación de estos procesos le confieren la\ncaracterística de ser cordones montañosos separados por valles. Su mayor elevación corresponde al\nAconcagua que alcanza 6.960 metros de altitud en Argentina.\nEcorregiones de los países del corredor andino (Olson et al. 2001)\nLos países andinos (Chile, Argentina, Bolivia, Perú, Ecuador, Colombia, Venezuela) abarcan una\nsuperficie de ～8,8 millones de kilómetros cuadrados y albergan 136 ecorregiones, las que\nrepresentan el 63% del total de ecorregiones sudamericanas. Las ecorregiones Puna y Puna árida de\nlos Andes centrales son comunes a Chile, Argentina, Perú y Bolivia. Chile y Argentina comparten 5\necorregiones: Bosque subpolar magallánico, Bosque templado valdiviano, Estepa patagónica, Estepa\nandina del sur y hielos/rocas. Chile y Perú comparten únicamente la ecorregión Desierto de Sechura.\nPor último, Chile alberga 2 ecorregiones continentales que no se representan en los mencionados\npaíses, a saber: Desierto de Atacama y Matorral chileno.\nLos Andes se encuentran entre las regiones con mayor biodiversidad del planeta. Se calcula que la\nCordillera de los Andes alberga a unas 40.000 especies de plantas y miles de vertebrados, con niveles\nexcepcionalmente altos de endemismo. Además, sus bosques naturales, matorrales y pastizales\nproporcionan servicios ecosistémicos críticos, como la protección del suelo, el almacenamiento de\ncarbono y agua para millones de personas.\nSe prevé que el cambio climático afecte a la biodiversidad de las montañas desplazando las áreas de\ndistribución de las especies y los biomas que conforman. El alcance y la variación regional de estos\nefectos son aún poco conocidos, sobre todo en los Andes, de gran biodiversidad. Se prevé que los\ncambios climáticos futuros (2040 - 2070) sean más perceptibles en las zonas de mayor altitud de los\nAndes tropicales (hasta 4 °C según el RCP 8.5), mientras que en los Andes templados se prevé un\naumento de la temperatura de hasta 2 °C. En el peor escenario, se prevé que los bosques caducifolios\ntemplados y los pastizales y estepas de los Andes centrales y meridionales registren las mayores\npérdidas de espacio climático adecuado (30% y 17%-23%, respectivamente).\nLa gran vulnerabilidad de estos biomas contrasta con la escasa atención prestada por los\ninvestigadores al modelamiento de la distribución de las especies andinas. Entre los vacíos de\nconocimiento más importantes cabe citar la falta de un listado de plantas andinas, la insuficiente\ndensidad de las estaciones meteorológicas en zonas de gran altitud, la falta de climatologías de alta\nresolución que tengan en cuenta la compleja topografía y los procesos climáticos de los Andes, la\ninsuficiencia de datos para modelar procesos demográficos y ecológicos y escaso uso de datos\npaleográficos para modelar la distribución. Dado el largo rango latitudinal y elevacional escarpado,\nlos Andes tienen una alta variabilidad en el clima.\nComprender los vínculos entre el clima y la vegetación natural, y predecir el impacto del cambio\nclimático futuro, es por lo tanto importante tanto para la conservación como para el bienestar\nhumano en los Andes y las tierras bajas adyacentes.\nEn los países andinos existen alrededor de 2.400 áreas protegidas al año 2021, de las cuales\naproximadamente 1.356 tienen al menos el 50% de su extensión en la región andina. Chile es el país\nque empezó a establecer áreas protegidas más temprano, a principios del siglo XX. A partir del año\n2000 hay un incremento notable en el número de áreas protegidas cuya extensión tiene al menos el\n50% en la región andina, particularmente en Colombia. Antes del año 2000 la mayoría de las áreas\nprotegidas fueron establecidas principalmente en la región no andina, siendo esto más notorio en\nVenezuela. Sin embargo, en términos de extensión, es en la década de los años 1970s cuando más\nextensión de la región andina fue protegida, mientras que en la región no andina esto ocurrió en los\naños 1990s.\n3. ECOSISTEMAS MARINOS\nSudamérica que abarca una variedad de ecosistemas costeros, entre ellos, manglares, arrecifes de\ncoral, pastos marinos, marismas, lagunas costeras, playas de arena, praderas de algas y la región de\nlos fiordos del sur de Chile. Además, gran relevancia le confieren las islas oceánicas: Galápagos, Coco,\nMalpelo, así como las islas Malvinas y Antillas, que surgen en el sur Atlántico y Mar Caribe,\nrespectivamente. Las masas oceánicas que rodean a América del Sur aportan significativamente a la\ndiversidad y la productividad de los ecosistemas costeros de la región. Las que se encuentran frente\na las costas de Perú y Chile poseen las aguas de más alta productividad pesquera y sostienen una de\nlas cinco pesquerías comerciales más importantes del mundo.\nLas clasificaciones biogeográficas son esenciales para desarrollar sistemas ecológicamente\nrepresentativos de áreas protegidas, según lo exigen los acuerdos internacionales. También\npermiten determinar si existen muestras de cada ecorregión en las Áreas Marinas Protegidas y en\nqué proporción (Spalding et al. 2007, Ministerio del Medio Ambiente 2016). Los 7 países que\ncomponen el corredor andino (Chile, Argentina, Bolivia, Perú, Ecuador, Colombia, Venezuela)\nrepresentan 3 reinos, 6 provincias y 14 ecorregiones.\nEcorregiones marinas representadas en los países del corredor andino (Spalding et al. 2007).\nEl océano es dinámico y está en constante movimiento. El movimiento más intenso y visible ocurre\nen la superficie. Estos movimientos son las olas, mareas y las corrientes superficiales. Estos\nmovimientos promueven la mezcla de las aguas oceánicas y tiene efectos sobre la vida en los mares.\nLas corrientes y las olas están influenciadas por los vientos. Las corrientes marinas transportan\ngrandes cantidades de agua y energía en forma de calor, por lo que influyen en la distribución de la\nsalinidad y de la temperatura. Como resultado afecta el clima y la productividad de las aguas.\nHacia el extremo sur del continente americano confluyen masas de agua de diferente procedencia,\nlo que genera una enorme diversidad de condiciones ambientales. Las corrientes marinas de los\nOcéanos Pacífico, Atlántico y Antártico convergen en la Patagonia creando una explosión de vida.\nAguas del Pacífico, más frías y menos saladas penetran a través de los canales oceánicos y se\nencuentran con aguas atlánticas, más cálidas y salinas, dando lugar a un gradiente de salinidad y\ntemperatura a través de los senos, fiordos y bahías.\nEl aporte de agua dulce procedente de las fuertes precipitaciones en la costa oeste, de los ríos y del\ndeshielo de los glaciares de la Cordillera de Darwin también contribuye a esta variabilidad,\ngenerando un sistema de estuario en la capa más superficial que difiere de las condiciones en las\nzonas más profundas de las aguas magallánicas. El agua antártica de la corriente Circumpolar\nAntártica, fría y más profunda, conecta estos dos océanos a través del Paso de Drake, en su límite\nmás austral. Esta heterogeneidad oceanográfica convierte este lugar en un mosaico dinámico de\ncomunidades marinas que se interrelacionan entre sí a escalas que van desde los pocos centímetros\na largas distancias de cientos de kilómetros y que sostienen procesos ecológicos vitales, siendo una\nreserva de vida y un patrimonio de gran riqueza.\nLa Corriente de Humboldt, es una corriente oceánica fría que fluye en dirección norte a lo largo de\nla costa occidental de Sudamérica, también se la conoce como Corriente Peruana o Corriente del\nPerú. Es una de las más importantes del mundo y ejerce influencia determinante sobre el clima de\nla costa peruana con cielos cubiertos de neblinas, ausencia de lluvias y temperaturas templadas\ndurante el invierno. Por la latitud, el clima debería corresponder a la zona intertropical; pero las\naguas frías enfrían a su vez a la atmósfera. La corriente ocurre desde la isla de Chiloé (Chile) hacia el\nnorte, pero principalmente a lo largo del litoral peruano.\n4. CORREDOR ANDINO: VISION Y DESAFIOS\nLa Patagonia chilena se presenta como un modelo de rewilding, donde todavía existen fragmentos\nextensos de naturaleza relativamente intacta, en muchos de los cuales se han logrado grandes\navances en la consolidación de vastas extensiones de parques nacionales, conformando áreas\nsilvestres bajo la más alta categoría de protección. La ejecución de proyectos de translocación de\nhuemules y ñandúes han demostrado no solo la viabilidad técnica para recuperar poblaciones\ndebilitadas o al borde de la extinción local, sino también la capacidad de generar efectos positivos\nen la biodiversidad a escala ecosistémica, ya que al restablecer estas especies clave se reactivan\nprocesos tróficos y se refuerzan cadenas de interacción que devuelven la salud a los sistemas\nnaturales. La creación y ampliación de parques nacionales ha sido clave para asegurar hábitat para\ntodas estas especies con una mirada de conservación a gran escala.\nTrasladar este modelo de éxito a otros tramos del Corredor Andino exige construir alianzas entre el\nmundo público, el sector privado y las comunidades locales en todos los países que lo conforman.\nExperiencias como el proyecto de repoblamiento de guanacos en la zona central, desarrollado en\ncolaboración con la red de Santuarios de la Naturaleza de la Región Metropolitana y la Universidad\nde Chile, ilustran cómo la restauración a escala de ecosistemas puede adaptarse a ambientes más\nfragmentados y con un historial de extinción local reciente. A partir de la acción coordinada, el\nmanejo de la especie en semicautiverio y un plan gradual de liberación, hoy se vislumbra un camino\nde esperanza para apoyar la recuperación del guanaco en la región más densamente poblada de\nChile y extender estas acciones a otros puntos de los Andes donde se requiera, generando así nuevas\noportunidades para el turismo de naturaleza y una integración a las economías locales.\nVarias especies en condición de extrema amenaza plantean desafíos urgentes que reclaman\nrespuestas técnicas y acciones inmediatas. Por ejemplo, el picaflor de Arica, ya extinto en Perú, y\ncuya población ha caído de unos 2.000 ejemplares hace dos décadas a apenas 300 en el valle de\nCamarones y valles aledaños, exige la implementación y protección de las áreas y refugios críticos\nque necesita, así como el desarrollo de iniciativas de manejo activo de la especie. Asimismo, la ranita\ndel Loa, recientemente rescatada desde su último refugio natural, refuerza la importancia de contar\ncon centros de reproducción en cautiverio que permitan su resguardo, mientras se gana tiempo para\ntomar medidas en las áreas en que puede habitar la especie a fin de evitar su extinción inminente.\nEn la misma línea, la ranita de Darwin, anfibio endémico de los bosques templados del cono sur, es\nposiblemente el segundo anfibio más amenazado de Chile, lo que refuerza el llamado a actuar en\nconjunto para su conservación frente a la preocupante pérdida de su hábitat, así como el avance del\nhongo quítrido.\nEl cóndor andino, muy amenazado especialmente en su distribución norte entre Colombia y Bolivia,\nrequiere de un sistema de monitoreo permanente y reducción de amenazas (entre las que se\nencuentran envenenamientos, colisiones, reducción de fuentes de alimento) y la puesta en marcha\nde translocaciones que aseguren un flujo de individuos desde las zonas donde su población\nabundante goza de mayor salud hacia las zonas donde sus números están gravemente reducidos.\nRecuperar al cóndor en la extensión de su distribución original, se presenta como uno de los grandes\ndesafíos para el continente, donde Chile, Argentina y Colombia ya han implementado iniciativas de\nreforzamiento poblacional utilizando el rescate y la reproducción de individuos en cautiverio, así\ncomo las liberaciones de individuos rescatados y rehabilitados.\nEn Sudamérica ya contamos con un valioso antecedente de rewilding transfronterizo para el\nCorredor Andino, donde Chile (junto a Perú y Bolivia) tomó un rol protagónico con la exitosa\nreintroducción de la vicuña en Ecuador. Este logro demuestra que, cuando los países andinos unen\nfuerzas, es posible implementar acciones para revertir tendencias de pérdida de biodiversidad más\nallá de las fronteras administrativas. Inspirados en este precedente, el Corredor Andino aspira a\npromover, replicar y ampliar iniciativas de rewilding, asegurando que la recuperación de especies\nclave de los ecosistemas, la restauración de hábitats y el control de amenazas se realicen de forma\nintegrada a lo largo de la extensión de la cordillera y donde se presenten los mayores desafíos para\nla conservación.\nEn Chile, estos desafíos son amplios, y se expresan con particular claridad al considerar el conjunto\ndiverso de especies que habitan los ecosistemas del Corredor Andino, desde las altas cumbres de\nlos Andes hasta la costa del océano Pacífico. Además de los casos destacados previamente, es\nfundamental actuar sobre las amenazas que afectan a otros grupos clave, recordando que el\nrewilding busca restituir la salud de ecosistemas completos. También se destacan los herbívoros de\nmontaña como las diferentes especies de vizcacha pertenecientes al género Lagidium, y especies\ncon alto grado de amenaza, como la taruca o huemul del norte (Hippocamelus antisensis), y el suri\no ñandú del norte (Rhea pennata tarapacensis), cuya recuperación es esencial para el equilibrio\necológico de los ecosistemas altoandinos.\nEn las zonas boscosas y de menor altitud, cobran relevancia especies como la guiña (Leopardus\nguigna) y el pudú del sur (Pudu puda), los cuales comparten amenazas similares vinculadas a la\nfragmentación del hábitat, la expansión urbana y el desplazamiento por animales domésticos. Los\nmustélidos semiacuáticos como el huillín (Lontra provocax) y el chungungo (L. felina) representan\nverdaderos centinelas de la salud de los ecosistemas ribereños y costeros, y su conservación requiere\nmedidas urgentes de preservación de hábitat, control de amenazas locales y monitoreo a largo plazo.\nEn estas líneas, el rewilding en ambientes costeros y marinos representa un elemento fundamental\ndentro de esta visión continental. La extensa costa chilena, desde la Región de Arica y Parinacota\nhasta la de Magallanes y la Antártica Chilena, donde destacan ecosistemas de alta relevancia como\nla Reserva Nacional Pingüino de Humboldt y los fiordos y canales de la Patagonia, ofrece desafíos\nparticulares para la protección y restauración a gran escala. Iniciativas orientadas a la recuperación\nde grandes especies clave y migratorias, como ballenas y tiburones, deben complementarse con la\nprotección de hábitats de alta relevancia como los bosques de macroalgas (Macrocystis pyrifera) y\nlos hotspots de biodiversidad bentónica.\nDe este modo, el rewilding en Chile se proyecta como el punto de partida del Corredor Andino, una\nred colaborativa que se extiende desde la Patagonia y sus mares por la espina dorsal del continente\npara proteger y restaurar ecosistemas completos. Al escalar hacia el norte la recuperación de\nespecies al borde de la extinción, así como el restablecimiento de interacciones ecológicas clave, es\nnecesario crear sinergias transfronterizas orientadas a optimizar recursos, compartir aprendizajes y\namplificar el impacto de cada acción. Este enfoque integral articula el manejo activo, las\nreintroducciones o refuerzos poblacionales, la restauración de hábitats críticos y el establecimiento\nde corredores en una matriz compuesta por áreas silvestres protegidas, sus zonas buffer y\ncomunidades rurales. Así, desde el extremo austral del mundo, el rewilding se perfila como una hoja\nde ruta continental para frenar la pérdida acelerada de biodiversidad, aquella que, como advertía\nDouglas Tompkins, constituye “la madre de todas las crisis”.\n5. ESPECIES CLAVES EN EL ECOSISTEMA DEL CORREDOR ANDINO\n5.1. ESPECIES Y TERRITORIOS EN LOS CUALES ESTAMOS TRABAJANDO:\nA. Cóndor (Vultur gryphus) - VU\nDistribución (países) según IUCN: Argentina, Bolivia, Chile, Colombia, Ecuador y Perú.\nTerritorios: Patagonia, Región Metropolitana, Ecuador y Colombia.\nOrganizaciones asociadas: Proyecto Manku (Chile), Parque Jaime Duque (Colombia), Proyecto\nFundación Cóndor Andino (Ecuador).\nAcuerdos actuales: Convenio de colaboración con UNORCH, convenio de colaboración con UNORCH,\nFundación Filantropía Cortes Solari y Fundación Meri.\nB. Guanaco (Lama guanicoe) - LC\nDistribución (países) según IUCN: Argentina, Bolivia, Chile, Paraguay y Perú.\nTerritorios: Patagonia y Región Metropolitana.\nOrganizaciones asociadas: Red de Santuarios de Naturaleza de la Región Metropolitana.\nAcuerdos actuales: Convenio de colaboración con Santuario Lagunilla, Santuario El Plomo y\nSantuario Cascadas. Convenio de colaboración con Santuario Lagunilla, Santuario El Plomo y\nSantuario Cascadas y Sopraval SPA.\nC. Suri (Rhea pennata tarapacensis) – LC / Ñandú (Rhea pennata) - LC\nDistribución (países) según IUCN: Argentina, Bolivia, Chile y Perú.\nTerritorios: Patagonia (Ñandú de Darwin - Rhea pennata) y Perú.\nOrganizaciones asociadas: Servicio Nacional Forestal y de fauna silvestre de Perú (SERFOR) y el\nCentro de Rescate del Proyecto Especial Binacional Lago Titicaca (PELT).\nAcuerdos actuales: pronto a firmar convenio de colaboración con SERFOR de Perú.\n5.5. ESPECIES Y TERRITORIOS A EVALUAR EN EL MEDIANO PLAZO Y LARGO PLAZO:\nA. Huemul (Hippocamelus bisulcus) - EN\nDistribución (países) según IUCN: Chile y Argentina.\nTerritorios: Ruta de los parques de la Patagonia y Nevado de Chillán.\nOrganizaciones asociadas: CONAF Ñuble.\nAcuerdos actuales: Ninguno.\nB. Taruca (Hippocamelus antisensis) - VU\nDistribución (países) según IUCN: Chile y Argentina.\nTerritorios: Ruta de los parques de la Patagonia y Nevado de Chillán.\nOrganizaciones asociadas: CONAF Ñuble.\nAcuerdos actuales: Ninguno.\nC. Picaflor de Arica (Eulidia yarrellii) - CR\nDistribución (países) según IUCN: Chile y Perú (posiblemente).\nTerritorios: Valle de Camarones en la Región de Arica y Parinacota.\nOrganizaciones asociadas: ROC y U. De Chile.\nAcuerdos actuales: Ninguno.\nD. Gaviotín chico (Sternula lorata) - EN\nDistribución (países) según IUCN: Ecuador, Chile y Perú, costa del Pacífico.\nTerritorios: Valle Camarones y Tacna.\nOrganizaciones asociadas: ROC.\nAcuerdos actuales: Ninguno.\nE. Aves nidificantes del desierto (Golondrinas de Mar y Gaviota de Garuma)\nla Golondrina de mar negra (Hydrobates markhami) está clasificada como En Peligro (EN), mientras\nque la Golondrina de mar peruana (Hydrobates tethys) y la Golondrina de mar de collar (Hydrobates\nhornbyi) están clasificadas como Vulnerable (VU). La Gaviota garuma (Leucophaeus modestus) se\nconsidera globalmente de Preocupación Menor según la IUCN.\nDistribución (países) según IUCN: Chile y Perú (posiblemente).\nTerritorios: Valle de Camarones en la Región de Arica y Parinacota.\nOrganizaciones asociadas: ROC y U. De Chile.\nAcuerdos actuales: Ninguno.\nF. Chungungo (Lontra felina) - EN / Huillín (Lontra provocax) - EN\nDistribución (países) según IUCN: Chungungo zona costera rocosa del océano Pacífico, desde el norte\nde Perú hasta el extremo sur de Chile y Argentina. El Huillín antiguamente se distribuía hasta la\nRegión de O'Higgins, pero actualmente se considera extinta hasta la del Bío Bío y se encuentra en\npeligro desde La Araucanía hasta Magallanes. El Huillín en Argentina, se distribuye a lo largo de los\nAndes, desde Tierra del Fuego hasta el sur de la provincia de Neuquén.\nTerritorios: Cabo Froward, Pumalin, zona central de chile.\nOrganizaciones asociadas: Fundación Lontra y Universidad Tierra del Fuego.\nAcuerdos actuales: Ninguno.\nG. Armadillos de Los Andes: Quirquincho de la puna (Chaetophractus vellerosus) - LC, el piche\n(Zaedyus pichiy) - LC, y el peludo (Chaetophractus villosus) - LC\nDistribución (países) según IUCN: Quirquincho de la Puna se encuentra en el norte de Chile,\nespecíficamente en el altiplano, desde Arica y Parinacota hasta Antofagasta. El Piche se distribuye\npor la zona centro-sur de Chile. El Peludo habita en la Patagonia, desde la región de Aysén hasta\nMagallanes, incluyendo Tierra del Fuego.\nTerritorios:\nOrganizaciones asociadas: Fundación Armadillos de Chile.\nAcuerdos actuales: Ninguno.\nH. Ciervos enanos de Los Andes: Pudú (Pudella mephistophiles) – VU / Pudú (Pudu pudu) -\nNT\nDistribución (países) según IUCN: en los Andes de Colombia, Ecuador y Perú; Chile y Argentina,\nrespectivamente.\nTerritorios: Perú, Colombia y Patagonia.\nOrganizaciones asociadas: Centro de Ornitología y Biodiversidad de Lima. Universidad del Cauca\nPopayán Colombia.\nAcuerdos actuales: Ninguno.\nI. Anfibios: Rana del Loa (Telmatobius dankoi) – CR / Ranita de Darwin (Rhinoderma\ndarwinii) - EN\nDistribución (países) según IUCN: Oasis del desierto de Atacama, Región de Antofagasta y la\nPatagonia, respectivamente.\nTerritorios: Desierto de Atacama y Patagonia, respectivamente.\nOrganizaciones asociadas: Zoo Metropolitano, UNAB, ONG Ranita de Darwin.\nAcuerdos actuales: Convenio por firmar con ONG Ranita de Darwin y UNAB. Convenio en\npreparación con el ZOO Metropolitano vinculado a Ranita de Darwin.\nJ. Chinchillídeos Andinos: Chinchilla cola corta (Chinchilla chinchilla) - CR y Chinchilla cola\nlarga (Chinchilla lanígera) - VU\nDistribución (países) según IUCN: La chinchilla de cola corta solo en Chile, aunque su distribución\noriginal era más amplia Chile, Perú, Bolivia y Argentina, habitando en la región Andina. La chinchilla\nde cola larga en Atacama y Coquimbo.\nTerritorios: Región de Coquimbo en la Reserva Nacional Las Chinchillas y sus alrededores.\nOrganizaciones asociadas: CONAF Coquimbo. Universidad de Tarapacá. Universidad San Sebastián.\nZoo Metropolitano.\nAcuerdos actuales: Ninguno.\nK. Chinchillídeos Andinos: Vizcacha de montaña (Legidium viscacia) - LC / Vizcacha Austral\n(Legidium wolffsohni) - DD\nDistribución (países) según IUCN: Ambas vizcachas habitan zonas rocosas de la Cordillera de los\nAndes. La vizcacha austral en el extremo sur de Argentina y Chile. La vizcacha de montaña se\nencuentra en el sur de Perú, oeste y centro de Bolivia, norte y centro de Chile y oeste de Argentina.\nOtras Vizcachas de la zona: Vizcacha andina (Lagidium peruanum) - LC, de Perú, Bolivia, Chile y\nArgentina. Vizcacha (Lagostomus maximus) - LC: Argentina, sur de Paraguay y Bolivia.\nTerritorios: Norte de Chile y Patagonia, respectivamente.\nOrganizaciones asociadas: Universidad de Tarapacá. Universidad San Sebastián.\nAcuerdos actuales: Ninguno.\nL. Flamencos (Phoenicopterus sp.)\nDistribución (países) según IUCN: Flamenco chileno en Chile (Phoenicopterus chilensis) - NT,\nArgentina, Bolivia, Perú, Ecuador, Paraguay, Uruguay y Brasil. Flamenco andino (Phoenicoparrus\nandinus) - VU está en Perú, Chile, Bolivia y Argentina. Flamenco James (Phoenicoparrus jamesi) - NT\nen las mesetas altoandinas de Perú, Chile, Bolivia y Argentina.\nTerritorios: Patagonia y altiplano Andino.\nOrganizaciones asociadas:\nAcuerdos actuales: Ninguno.\nM. Vicuña (Vicugna vicugna) – LC\nEl grupo de especialistas en camélidos sudamericanos de la IUCN que está Benito González.\nN. Puma (Puma concolor) - LC\nHay que trabajar el tema de la coexistencia. En el caso por ejemplo del proyecto repoblación de\nguanacos en la Región Metropolitana, será un tema que enfrentar.\nCATEGORIAS Y ESTADOS DE CONSERVACIÓN IUCN\n- Extinta (EX),\n- Extinta en estado silvestre (EW),\n- En peligro crítico (CR),\n- En peligro (EN),\n- Vulnerable (VU),\n- Casi amenazada (NT),\n- Preocupación menor (LC),\n- Datos insuficientes (DD) y\n- No evaluada (NE)\n6. CRITERIOS DE SELECCION DE ESPECIES, ÁREAS Y ECOSISTEMAS A ABORDAR\n- Capacidades instaladas y experticia en las especies y ecosistemas que viene trabajando FRC.\n- Capacidades instaladas y experticia los colaboradores con quienes hemos gestados acciones a\ndiferentes niveles: público, académico, ONG’s y organizaciones locales.\n- Urgencia frente al estado de conservación y nivel más alto de categoría de amenaza de la especie\n(en peligro crítico, en peligro de extinción, vulnerable) con una aproximación del Rewilding por\necorregiones a una determinada latitud, incluyendo variación altitudinal en algunos casos.\n- Existencia de áreas protegidas o con algún grado incipiente de avances en su protección e\ninterrelación con otras especies, ecosistemas o ecorregiones.\n- Oportunidad institucional relacionada a la conservación y manejo de una especie, territorio,\necosistema o ecorregión particular\n- Existencia de socios locales o regionales estratégicos con quienes se compartan valores,\nfundamentos y oportunidades de intercambio de modelos de trabajo y aprendizajes.\n7. TRANSFERENCIA DE LA EXPERIENCIA DE REWILDING CHILE EN LA PATAGONIA CHILENA HACIA\nEL CORREDOR ANDINO\nLas capacidades y fortalezas del equipo de la Fundación Rewilding Chile luego de estos 30 años\ntrabajando en el territorio de la Ruta de los Parques son múltiples y permitirían fortalecer las\ncapacidades de organizaciones locales o regionales que han desarrollado actividades relacionadas a\nalgunos ecosistemas y especies amenazadas en áreas del Corredor Andino. Desde los procesos\nrelacionados a la creación de parques, el análisis de la matriz de hábitat y la tenencia de la tierra,\nconstrucción y de propuestas y estrategias de conservación, abordaje de amenazas y monitoreo de\nla vida silvestre, propuestas de manejo e intervención, socialización con actores, gestión técnica y\ncolaborativa con las instituciones, privados y la incidencia en políticas de conservación.\n8. PROXIMOS PASOS\n- Revisar, evaluar y priorizar la lista de especies, ecosistemas y gradientes involucrados.\n- Visitas a terreno y reunión junto a organizaciones claves de algunos territorios. Como ejemplos:\nNorte: Picaflor de Arica, Golondrinas del desierto, Gaviotín chico, Suris y Tarucas.\n- Visita al área del Corredor Nevados de Chillan – Laguna del Laja para evaluar situación de\nhuemules en el sector, iniciativas existentes, y entender el trabajo de CONAF y otros actores en\nlos últimos años en este territorio.\n- Visita a las áreas de intervención de Fundación Lontra en Chile.\n- Explorar otros ámbitos de colaboración e interacción con el Zoológico Metropolitano referido a\nflamencos y chinchillas.", 'description': None, 'parent_drive_file_id': '1i3nTKlTu-Jt3NhSoL_kX3XWoLxJwMscM', 'children': []}, {'id': '683eb652-4692-4ba1-9720-c8febdbe4112', 'drive_file_id': '1VwRQmr0I8ubpApc83bKE0ayeLDkoxtPe', 'name': 'Talking Points Andean Corridor (esp 2) 04.03.26.docx', 'mime_type': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/1VwRQmr0I8ubpApc83bKE0ayeLDkoxtPe/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 31, 688000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1i3nTKlTu-Jt3NhSoL_kX3XWoLxJwMscM', 'children': []}, {'id': 'f91655f7-f7e4-4897-9409-6b1270f0895f', 'drive_file_id': '1LSbe6UAxfKu37XFFN8u1wjmPCDr4FCdL', 'name': 'Doc. Extendido_Corredor Andino Sudamericano (120526).docx', 'mime_type': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'is_folder': False, 'web_view_link': 'https://docs.google.com/document/d/1LSbe6UAxfKu37XFFN8u1wjmPCDr4FCdL/edit?usp=drivesdk&ouid=111967484170130169809&rtpof=true&sd=true', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 34, 32000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1i3nTKlTu-Jt3NhSoL_kX3XWoLxJwMscM', 'children': []}]}, {'id': 'fccbc73e-1dcb-4533-a284-355343920e3d', 'drive_file_id': '15qq7nMwZhhnlnwKVOhOET27Z9c_-8HwE', 'name': 'Doc. Shaw Island Corredor Andino', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/15qq7nMwZhhnlnwKVOhOET27Z9c_-8HwE', 'modified_time': datetime.datetime(2026, 6, 22, 18, 35, 53, 828000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1zZ8L3n2m7umR__Mld_j9CmB5YxpF2G77', 'children': [{'id': 'a89cf6a3-f9de-44a5-bd5a-2b399698d464', 'drive_file_id': '1_GAmr9ABSfklpA3B5PA1GLWNMWJ2OTRS', 'name': 'Mapa General Proyectos FRC_15.10.25.jpg', 'mime_type': 'image/jpeg', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1_GAmr9ABSfklpA3B5PA1GLWNMWJ2OTRS/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 7, 962000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '15qq7nMwZhhnlnwKVOhOET27Z9c_-8HwE', 'children': []}, {'id': '72a7cc1d-417b-4be8-8056-994f240456a8', 'drive_file_id': '1-ca4bfn2kG9S7I_Zw_53jWCBg2hUN_GO', 'name': 'Resumen Corredor Andino_02.08.25_V3.pdf', 'mime_type': 'application/pdf', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1-ca4bfn2kG9S7I_Zw_53jWCBg2hUN_GO/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 15, 501000, tzinfo=datetime.timezone.utc), 'text_content': "MINUTA DE DOCUMENTO ORIGINAL DE AGOSTO DEL 2024\nDel Corredor Andino a los mares del fin del mundo\nExpandiendo el impacto del Rewilding\ndesde la Patagonia por Sudamérica\nTABLA DE CONTENIDOS\n1. Introducción (p.2)\n2. Ecosistemas terrestres (p.3)\n3. Ecosistemas marinos (p.5)\n4. Corredor Andino: visión y desafíos (p.7)\n5. Especies claves en el ecosistema del corredor andino (p.9)\n6. Criterios de selección de especies, áreas y ecosistemas a abordar (p.14)\n7. Transferencia de la experiencia de Rewilding Chile en Patagonia hacia el Corredor Andino(p.14)\n8. Próximos pasos (p.14)\nAgosto 2025\n1\n1. INTRODUCCION\nRewilding Chile es una fundación sin fines de lucro y parte del legado de Douglas y Kristine Tompkins,\nquienes a inicios de los años 90 decidieron dedicar su vida a conservar la belleza y la biodiversidad\nde la Patagonia chilena para contrarrestar la crisis de extinción de especies y el cambio climático.\nTres décadas después, Rewilding Chile sigue profundamente comprometida con la visión de sus\nfundadores: los ecosistemas saludables y su complejidad de especies, interrelaciones y procesos\ndarán a los seres vivos una oportunidad de perpetuarse en el tiempo. Con esa visión, Fundación\nRewilding Chile y su socio Tompkins Conservation, han trabajado en la conservación de los\necosistemas de la Patagonia chilena para enfrentar los factores que amenazan global y localmente a\nla biodiversidad.\nEl rewilding es una estrategia para la conservación integral que incluye la implementación de\nacciones como: la creación de parques nacionales terrestres y marinos, la restauración de los\necosistemas, el manejo activo de especies amenazadas, la promoción del bienestar de las\ncomunidades locales, además del activismo y la educación pública para fomentar una cultura de\nconservación. A través del rewilding, la Fundación Rewilding Chile busca conservar ecosistemas\nsaludables y funcionales que permitan que las áreas de protección sean un motor para el desarrollo\nlocal, donde el turismo de naturaleza se constituye como un eje estratégico de este desarrollo.\nLa Fundación Rewilding Chile ha concentrado su área de trabajo en la Patagonia chilena, que\ncomprende la parte sur de la región de Los Lagos, la región de Aysén y la Región de Magallanes y\nAntártica chilena. La Ruta de Los Parques Nacionales de la Patagonia es un corredor de conservación\nimpulsado por Rewilding Chile y conformado por un grupo de 17 parques nacionales desde la ciudad\nde Puerto Montt (41ºS) al Cabo de Hornos (56ºS). Estos parques nacionales representan a 4\necorregiones terrestres: bosque magallánico sub antártico, bosque templado valdiviano, estepa\npatagónica y una gran superficie de rocas y hielos. La Fundación promueve la Ruta de los Parques de\nla Patagonia como una visión de conservación para el territorio, que plantea equilibrar la protección\nde la naturaleza con el desarrollo económico de sus comunidades a través del turismo como\nconsecuencia de la conservación.\nNos encontramos próximos al año 2030 y la biodiversidad sigue disminuyendo en todo el planeta.\nUna respuesta concreta a la actual crisis ambiental es asegurar que la conservación de la\nbiodiversidad permita proteger la capacidad de los ecosistemas de ofrecer bienestar y beneficios a\nlas personas y a otros seres vivos.\nEste documento es un resumen del original que tiene por objetivo compartir algunos antecedentes\nque permitan elaborar una visión de conservación continental y una propuesta para la conservación\nde los paisajes de la Cordillera de los Andes y sus especies características y sus hábitats, desde\nVenezuela por el norte hasta la confluencia de los Océanos Pacífico, Atlántico y Antártico por el sur,\nque permita alcanzar los objetivos de biodiversidad al año 2030. Para esto se requiere hacer una\nrevisión del estado de conservación global y local actual de algunas especies asociadas a la Cordillera\nde Los Andes, las estrategias de conservación implementadas para su conservación y los actores\ninvolucrados en estas iniciativas.\n2\n2. ECOSISTEMAS TERRESTRES\nAmérica del Sur abarca una superficie de 17,9 millones de kilómetros cuadrados y alberga 215\necorregiones terrestres (Olson et al. 2001). Las ecorregiones terrestres reflejan las distribuciones de\nuna amplia gama de fauna y flora en todo el planeta y facilitan la planificación de la conservación a\nescala mundial y regional. Es un marco de clasificación basado en los conocimientos biogeográficos\nexistentes y cada ecorregión representa biotas distintas. Esta clasificación proporciona un marco\npara las comparaciones entre unidades y la identificación de hábitats y conjuntos de especies\nrepresentativas.\nEn específico, La Cordillera de Los Andes es una cadena montañosa ubicada en la costa occidental\ndel continente Sudamericano, la cual atraviesa el territorio de 7 países: Argentina, Chile, Bolivia,\nPerú, Ecuador, Colombia y Venezuela. Con más de 9.000 kilómetros de longitud, siguiendo la cadena\nmontañosa y más de 6.000 metros de altitud, es la cordillera terrestre más larga y la segunda más\nalta del planeta, después del Himalaya.\nLa Cordillera de los Andes se origina por la subducción de la placa continental sudamericana con una\nserie de placas oceánicas. Su morfología ha sido modelada a través del tiempo por procesos que\ntienen lugar en su superficie: el proceso glaciario dadas sus altas cumbres y otros procesos fluviales,\neólicos, volcánicos y de remoción en masa. La combinación de estos procesos le confieren la\ncaracterística de ser cordones montañosos separados por valles. Su mayor elevación corresponde al\nAconcagua que alcanza 6.960 metros de altitud en Argentina.\nEcorregiones de los países del corredor andino (Olson et al. 2001)\n3\nLos países andinos (Chile, Argentina, Bolivia, Perú, Ecuador, Colombia, Venezuela) abarcan una\nsuperficie de ～8,8 millones de kilómetros cuadrados y albergan 136 ecorregiones, las que\nrepresentan el 63% del total de ecorregiones sudamericanas. Las ecorregiones Puna y Puna árida de\nlos Andes centrales son comunes a Chile, Argentina, Perú y Bolivia. Chile y Argentina comparten 5\necorregiones: Bosque subpolar magallánico, Bosque templado valdiviano, Estepa patagónica, Estepa\nandina del sur y hielos/rocas. Chile y Perú comparten únicamente la ecorregión Desierto de Sechura.\nPor último, Chile alberga 2 ecorregiones continentales que no se representan en los mencionados\npaíses, a saber: Desierto de Atacama y Matorral chileno.\nLos Andes se encuentran entre las regiones con mayor biodiversidad del planeta. Se calcula que la\nCordillera de los Andes alberga a unas 40.000 especies de plantas y miles de vertebrados, con niveles\nexcepcionalmente altos de endemismo. Además, sus bosques naturales, matorrales y pastizales\nproporcionan servicios ecosistémicos críticos, como la protección del suelo, el almacenamiento de\ncarbono y agua para millones de personas.\nSe prevé que el cambio climático afecte a la biodiversidad de las montañas desplazando las áreas de\ndistribución de las especies y los biomas que conforman. El alcance y la variación regional de estos\nefectos son aún poco conocidos, sobre todo en los Andes, de gran biodiversidad. Se prevé que los\ncambios climáticos futuros (2040 - 2070) sean más perceptibles en las zonas de mayor altitud de los\nAndes tropicales (hasta 4 °C según el RCP 8.5), mientras que en los Andes templados se prevé un\naumento de la temperatura de hasta 2 °C. En el peor escenario, se prevé que los bosques caducifolios\ntemplados y los pastizales y estepas de los Andes centrales y meridionales registren las mayores\npérdidas de espacio climático adecuado (30% y 17%-23%, respectivamente).\nLa gran vulnerabilidad de estos biomas contrasta con la escasa atención prestada por los\ninvestigadores al modelamiento de la distribución de las especies andinas. Entre los vacíos de\nconocimiento más importantes cabe citar la falta de un listado de plantas andinas, la insuficiente\ndensidad de las estaciones meteorológicas en zonas de gran altitud, la falta de climatologías de alta\nresolución que tengan en cuenta la compleja topografía y los procesos climáticos de los Andes, la\ninsuficiencia de datos para modelar procesos demográficos y ecológicos y escaso uso de datos\npaleográficos para modelar la distribución. Dado el largo rango latitudinal y elevacional escarpado,\nlos Andes tienen una alta variabilidad en el clima.\nComprender los vínculos entre el clima y la vegetación natural, y predecir el impacto del cambio\nclimático futuro, es por lo tanto importante tanto para la conservación como para el bienestar\nhumano en los Andes y las tierras bajas adyacentes.\nEn los países andinos existen alrededor de 2.400 áreas protegidas al año 2021, de las cuales\naproximadamente 1.356 tienen al menos el 50% de su extensión en la región andina. Chile es el país\nque empezó a establecer áreas protegidas más temprano, a principios del siglo XX. A partir del año\n2000 hay un incremento notable en el número de áreas protegidas cuya extensión tiene al menos el\n50% en la región andina, particularmente en Colombia. Antes del año 2000 la mayoría de las áreas\nprotegidas fueron establecidas principalmente en la región no andina, siendo esto más notorio en\nVenezuela. Sin embargo, en términos de extensión, es en la década de los años 1970s cuando más\nextensión de la región andina fue protegida, mientras que en la región no andina esto ocurrió en los\naños 1990s.\n4\n3. ECOSISTEMAS MARINOS\nSudamérica que abarca una variedad de ecosistemas costeros, entre ellos, manglares, arrecifes de\ncoral, pastos marinos, marismas, lagunas costeras, playas de arena, praderas de algas y la región de\nlos fiordos del sur de Chile. Además, gran relevancia le confieren las islas oceánicas: Galápagos, Coco,\nMalpelo, así como las islas Malvinas y Antillas, que surgen en el sur Atlántico y Mar Caribe,\nrespectivamente. Las masas oceánicas que rodean a América del Sur aportan significativamente a la\ndiversidad y la productividad de los ecosistemas costeros de la región. Las que se encuentran frente\na las costas de Perú y Chile poseen las aguas de más alta productividad pesquera y sostienen una de\nlas cinco pesquerías comerciales más importantes del mundo.\nLas clasificaciones biogeográficas son esenciales para desarrollar sistemas ecológicamente\nrepresentativos de áreas protegidas, según lo exigen los acuerdos internacionales. También\npermiten determinar si existen muestras de cada ecorregión en las Áreas Marinas Protegidas y en\nqué proporción (Spalding et al. 2007, Ministerio del Medio Ambiente 2016). Los 7 países que\ncomponen el corredor andino (Chile, Argentina, Bolivia, Perú, Ecuador, Colombia, Venezuela)\nrepresentan 3 reinos, 6 provincias y 14 ecorregiones.\nEcorregiones marinas representadas en los países del corredor andino (Spalding et al. 2007).\n5\nEl océano es dinámico y está en constante movimiento. El movimiento más intenso y visible ocurre\nen la superficie. Estos movimientos son las olas, mareas y las corrientes superficiales. Estos\nmovimientos promueven la mezcla de las aguas oceánicas y tiene efectos sobre la vida en los mares.\nLas corrientes y las olas están influenciadas por los vientos. Las corrientes marinas transportan\ngrandes cantidades de agua y energía en forma de calor, por lo que influyen en la distribución de la\nsalinidad y de la temperatura. Como resultado afecta el clima y la productividad de las aguas.\nHacia el extremo sur del continente americano confluyen masas de agua de diferente procedencia,\nlo que genera una enorme diversidad de condiciones ambientales. Las corrientes marinas de los\nOcéanos Pacífico, Atlántico y Antártico convergen en la Patagonia creando una explosión de vida.\nAguas del Pacífico, más frías y menos saladas penetran a través de los canales oceánicos y se\nencuentran con aguas atlánticas, más cálidas y salinas, dando lugar a un gradiente de salinidad y\ntemperatura a través de los senos, fiordos y bahías.\nEl aporte de agua dulce procedente de las fuertes precipitaciones en la costa oeste, de los ríos y del\ndeshielo de los glaciares de la Cordillera de Darwin también contribuye a esta variabilidad,\ngenerando un sistema de estuario en la capa más superficial que difiere de las condiciones en las\nzonas más profundas de las aguas magallánicas. El agua antártica de la corriente Circumpolar\nAntártica, fría y más profunda, conecta estos dos océanos a través del Paso de Drake, en su límite\nmás austral. Esta heterogeneidad oceanográfica convierte este lugar en un mosaico dinámico de\ncomunidades marinas que se interrelacionan entre sí a escalas que van desde los pocos centímetros\na largas distancias de cientos de kilómetros y que sostienen procesos ecológicos vitales, siendo una\nreserva de vida y un patrimonio de gran riqueza.\nLa Corriente de Humboldt, es una corriente oceánica fría que fluye en dirección norte a lo largo de\nla costa occidental de Sudamérica, también se la conoce como Corriente Peruana o Corriente del\nPerú. Es una de las más importantes del mundo y ejerce influencia determinante sobre el clima de\nla costa peruana con cielos cubiertos de neblinas, ausencia de lluvias y temperaturas templadas\ndurante el invierno. Por la latitud, el clima debería corresponder a la zona intertropical; pero las\naguas frías enfrían a su vez a la atmósfera. La corriente ocurre desde la isla de Chiloé (Chile) hacia el\nnorte, pero principalmente a lo largo del litoral peruano.\n6\n4. CORREDOR ANDINO: VISION Y DESAFIOS\nLa Patagonia chilena se presenta como un modelo de rewilding, donde todavía existen fragmentos\nextensos de naturaleza relativamente intacta, en muchos de los cuales se han logrado grandes\navances en la consolidación de vastas extensiones de parques nacionales, conformando áreas\nsilvestres bajo la más alta categoría de protección. La ejecución de proyectos de translocación de\nhuemules y ñandúes han demostrado no solo la viabilidad técnica para recuperar poblaciones\ndebilitadas o al borde de la extinción local, sino también la capacidad de generar efectos positivos\nen la biodiversidad a escala ecosistémica, ya que al restablecer estas especies clave se reactivan\nprocesos tróficos y se refuerzan cadenas de interacción que devuelven la salud a los sistemas\nnaturales. La creación y ampliación de parques nacionales ha sido clave para asegurar hábitat para\ntodas estas especies con una mirada de conservación a gran escala.\nTrasladar este modelo de éxito a otros tramos del Corredor Andino exige construir alianzas entre el\nmundo público, el sector privado y las comunidades locales en todos los países que lo conforman.\nExperiencias como el proyecto de repoblamiento de guanacos en la zona central, desarrollado en\ncolaboración con la red de Santuarios de la Naturaleza de la Región Metropolitana y la Universidad\nde Chile, ilustran cómo la restauración a escala de ecosistemas puede adaptarse a ambientes más\nfragmentados y con un historial de extinción local reciente. A partir de la acción coordinada, de\nterritorios protegidos, del manejo de la especie en semicautiverio y un plan gradual de liberación,\nhoy se vislumbra un camino de esperanza para apoyar la recuperación del guanaco en la región más\ndensamente poblada de Chile y extender estas acciones a otros puntos de los Andes donde se\nrequiera, generando así nuevas oportunidades para el turismo de naturaleza y una integración a las\neconomías locales.\nVarias especies en condición de extrema amenaza plantean desafíos urgentes que reclaman\nrespuestas técnicas y acciones inmediatas. Por ejemplo, el picaflor de Arica, ya extinto en Perú, y\ncuya población ha caído de unos 2.000 ejemplares hace dos décadas a apenas 300 en el valle de\nCamarones y valles aledaños, exige la implementación y protección de las áreas y refugios críticos\nque necesita, así como el desarrollo de iniciativas de manejo activo de la especie. Asimismo, la ranita\ndel Loa, recientemente rescatada desde su último refugio natural, refuerza la importancia de contar\ncon centros de reproducción en cautiverio que permitan su resguardo, mientras se gana tiempo para\ntomar medidas en las áreas en que puede habitar la especie a fin de evitar su extinción inminente.\nEn la misma línea, la ranita de Darwin, anfibio endémico de los bosques templados del cono sur, es\nposiblemente el segundo anfibio más amenazado de Chile, lo que refuerza el llamado a actuar en\nconjunto para su conservación frente a la preocupante pérdida de su hábitat, así como el avance del\nhongo quítrido.\nEl cóndor andino, muy amenazado especialmente en su distribución norte entre Colombia y Bolivia,\nrequiere de un sistema de monitoreo permanente y reducción de amenazas (entre las que se\nencuentran envenenamientos, colisiones, reducción de fuentes de alimento) y la puesta en marcha\nde translocaciones que aseguren un flujo de individuos desde las zonas donde su población\nabundante goza de mayor salud hacia las zonas donde sus números están gravemente reducidos.\nRecuperar al cóndor en la extensión de su distribución original, se presenta como uno de los grandes\ndesafíos para el continente, donde Chile, Argentina y Colombia ya han implementado iniciativas de\nreforzamiento poblacional utilizando el rescate y la reproducción de individuos en cautiverio, así\ncomo las liberaciones de individuos rescatados y rehabilitados.\n7\nEn Sudamérica ya contamos con un valioso antecedente de rewilding transfronterizo para el\nCorredor Andino, donde Chile (junto a Perú y Bolivia) tomó un rol protagónico con la exitosa\nreintroducción de la vicuña en Ecuador. Este logro demuestra que, cuando los países andinos unen\nfuerzas, es posible implementar acciones para revertir tendencias de pérdida de biodiversidad más\nallá de las fronteras administrativas. Inspirados en este precedente, el Corredor Andino aspira a\npromover, replicar y ampliar iniciativas de rewilding, asegurando que la recuperación de especies\nclave de los ecosistemas, la restauración de hábitats y el control de amenazas se realicen de forma\nintegrada a lo largo de la extensión de la cordillera y donde se presenten los mayores desafíos para\nla conservación.\nEn Chile, estos desafíos son amplios, y se expresan con particular claridad al considerar el conjunto\ndiverso de especies que habitan los ecosistemas del Corredor Andino, desde las altas cumbres de\nlos Andes hasta la costa del océano Pacífico. Además de los casos destacados previamente, es\nfundamental actuar sobre las amenazas que afectan a otros grupos clave, recordando que el\nrewilding busca restituir la salud de ecosistemas completos. También se destacan los herbívoros de\nmontaña como las diferentes especies de vizcacha pertenecientes al género Lagidium, y especies\ncon alto grado de amenaza, como la taruca o huemul del norte (Hippocamelus antisensis), y el suri\no ñandú del norte (Rhea pennata tarapacensis), cuya recuperación es esencial para el equilibrio\necológico de los ecosistemas altoandinos.\nEn las zonas boscosas y de menor altitud, cobran relevancia especies como la guiña (Leopardus\nguigna) y el pudú del sur (Pudu puda), los cuales comparten amenazas similares vinculadas a la\nfragmentación del hábitat, la expansión urbana y el desplazamiento por animales domésticos. Los\nmustélidos semiacuáticos como el huillín (Lontra provocax) y el chungungo (L. felina) representan\nverdaderos centinelas de la salud de los ecosistemas ribereños y costeros, y su conservación requiere\nmedidas urgentes de preservación de hábitat, control de amenazas locales y monitoreo a largo plazo.\nEn estas líneas, el rewilding en ambientes costeros y marinos representa un elemento fundamental\ndentro de esta visión continental. La extensa costa chilena, desde la Región de Arica y Parinacota\nhasta la de Magallanes y la Antártica Chilena, donde destacan ecosistemas de alta relevancia como\nla Reserva Nacional Pingüino de Humboldt y los fiordos y canales de la Patagonia, ofrece desafíos\nparticulares para la protección y restauración a gran escala. Iniciativas orientadas a la recuperación\nde grandes especies clave y migratorias, como ballenas y tiburones, deben complementarse con la\nprotección de hábitats de alta relevancia como los bosques de macroalgas (Macrocystis pyrifera) y\nlos hotspots de biodiversidad bentónica.\nDe este modo, el rewilding en Chile se proyecta como el punto de partida del Corredor Andino, una\nred colaborativa que se extiende desde la Patagonia y sus mares por la espina dorsal del continente\npara proteger y restaurar ecosistemas completos. Al escalar hacia el norte la recuperación de\nespecies al borde de la extinción, así como el restablecimiento de interacciones ecológicas clave, es\nnecesario crear sinergias transfronterizas orientadas a optimizar recursos, compartir aprendizajes y\namplificar el impacto de cada acción. Este enfoque integral articula el manejo activo, las\nreintroducciones o refuerzos poblacionales, la restauración de hábitats críticos y el establecimiento\nde corredores en una matriz compuesta por áreas silvestres protegidas, sus zonas buffer y\ncomunidades rurales. Así, desde el extremo austral del mundo, el rewilding se perfila como una hoja\nde ruta continental para frenar la pérdida acelerada de biodiversidad, aquella que, como advertía\nDouglas Tompkins, constituye “la madre de todas las crisis”.\n8\n5. ESPECIES CLAVES EN EL ECOSISTEMA DEL CORREDOR ANDINO\n5.1. ESPECIES Y TERRITORIOS EN LOS CUALES ESTAMOS TRABAJANDO:\nA. Cóndor (Vultur gryphus) - VU\nDistribución (países) según IUCN: Argentina, Bolivia, Chile, Colombia, Ecuador y Perú.\nTerritorios: Patagonia, Región Metropolitana, Ecuador y Colombia.\nOrganizaciones asociadas: Proyecto Manku (Chile), Parque Jaime Duque (Colombia), Proyecto\nFundación Cóndor Andino (Ecuador).\nAcuerdos actuales: Convenio de colaboración con UNORCH, convenio de colaboración con UNORCH,\nFundación Filantropía Cortes Solari y Fundación Meri.\nB. Guanaco (Lama guanicoe) - LC\nDistribución (países) según IUCN: Argentina, Bolivia, Chile, Paraguay y Perú.\nTerritorios: Patagonia y Región Metropolitana.\nOrganizaciones asociadas: Red de Santuarios de Naturaleza de la Región Metropolitana.\nAcuerdos actuales: Convenio de colaboración con Santuario Lagunilla, Santuario El Plomo y\nSantuario Cascadas. Convenio de colaboración con Santuario Lagunilla, Santuario El Plomo y\nSantuario Cascadas y Sopraval SPA.\nC. Suri (Rhea pennata tarapacensis) – LC / Ñandú (Rhea pennata) - LC\nDistribución (países) según IUCN: Argentina, Bolivia, Chile y Perú.\nTerritorios: Patagonia (Ñandú de Darwin - Rhea pennata) y Perú.\nOrganizaciones asociadas: Servicio Nacional Forestal y de fauna silvestre de Perú (SERFOR) y el\nCentro de Rescate del Proyecto Especial Binacional Lago Titicaca (PELT).\nAcuerdos actuales: pronto a firmar convenio de colaboración con SERFOR de Perú.\n9\n5.5. ESPECIES Y TERRITORIOS A EVALUAR EN EL MEDIANO PLAZO Y LARGO PLAZO:\nA. Huemul (Hippocamelus bisulcus) - EN\nDistribución (países) según IUCN: Chile y Argentina.\nTerritorios: Ruta de los parques de la Patagonia y Nevado de Chillán.\nOrganizaciones asociadas: CONAF Ñuble.\nAcuerdos actuales: Ninguno.\nB. Taruca (Hippocamelus antisensis) - VU\nDistribución (países) según IUCN: Chile y Argentina.\nTerritorios: Ruta de los parques de la Patagonia y Nevado de Chillán.\nOrganizaciones asociadas: CONAF Ñuble.\nAcuerdos actuales: Ninguno.\nC. Picaflor de Arica (Eulidia yarrellii) - CR\nDistribución (países) según IUCN: Chile y Perú (posiblemente).\nTerritorios: Valle de Camarones en la Región de Arica y Parinacota.\nOrganizaciones asociadas: ROC y U. De Chile.\nAcuerdos actuales: Ninguno.\nD. Gaviotín chico (Sternula lorata) - EN\nDistribución (países) según IUCN: Ecuador, Chile y Perú, costa del Pacífico.\nTerritorios: Valle Camarones y Tacna.\nOrganizaciones asociadas: ROC.\nAcuerdos actuales: Ninguno.\n10\nE. Aves nidificantes del desierto (Golondrinas de Mar y Gaviota de Garuma)\nla Golondrina de mar negra (Hydrobates markhami) está clasificada como En Peligro (EN), mientras\nque la Golondrina de mar peruana (Hydrobates tethys) y la Golondrina de mar de collar (Hydrobates\nhornbyi) están clasificadas como Vulnerable (VU). La Gaviota garuma (Leucophaeus modestus) se\nconsidera globalmente de Preocupación Menor según la IUCN.\nDistribución (países) según IUCN: Chile y Perú (posiblemente).\nTerritorios: Valle de Camarones en la Región de Arica y Parinacota.\nOrganizaciones asociadas: ROC y U. De Chile.\nAcuerdos actuales: Ninguno.\nF. Chungungo (Lontra felina) - EN / Huillín (Lontra provocax) - EN\nDistribución (países) según IUCN: Chungungo zona costera rocosa del océano Pacífico, desde el norte\nde Perú hasta el extremo sur de Chile y Argentina. El Huillín antiguamente se distribuía hasta la\nRegión de O'Higgins, pero actualmente se considera extinta hasta la del Bío Bío y se encuentra en\npeligro desde La Araucanía hasta Magallanes. El Huillín en Argentina, se distribuye a lo largo de los\nAndes, desde Tierra del Fuego hasta el sur de la provincia de Neuquén.\nTerritorios: Cabo Froward, Pumalin, zona central de chile.\nOrganizaciones asociadas: Fundación Lontra y Universidad Tierra del Fuego.\nAcuerdos actuales: Ninguno.\nG. Armadillos de Los Andes: Quirquincho de la puna (Chaetophractus vellerosus) - LC, el piche\n(Zaedyus pichiy) - LC, y el peludo (Chaetophractus villosus) - LC\nDistribución (países) según IUCN: Quirquincho de la Puna se encuentra en el norte de Chile,\nespecíficamente en el altiplano, desde Arica y Parinacota hasta Antofagasta. El Piche se distribuye\npor la zona centro-sur de Chile. El Peludo habita en la Patagonia, desde la región de Aysén hasta\nMagallanes, incluyendo Tierra del Fuego.\nTerritorios:\nOrganizaciones asociadas: Fundación Armadillos de Chile.\nAcuerdos actuales: Ninguno.\n11\nH. Ciervos enanos de Los Andes: Pudú (Pudella mephistophiles) – VU / Pudú (Pudu pudu) -\nNT\nDistribución (países) según IUCN: en los Andes de Colombia, Ecuador y Perú; Chile y Argentina,\nrespectivamente.\nTerritorios: Perú, Colombia y Patagonia.\nOrganizaciones asociadas: Centro de Ornitología y Biodiversidad de Lima. Universidad del Cauca\nPopayán Colombia.\nAcuerdos actuales: Ninguno.\nI. Anfibios: Rana del Loa (Telmatobius dankoi) – CR / Ranita de Darwin (Rhinoderma\ndarwinii) - EN\nDistribución (países) según IUCN: Oasis del desierto de Atacama, Región de Antofagasta y la\nPatagonia, respectivamente.\nTerritorios: Desierto de Atacama y Patagonia, respectivamente.\nOrganizaciones asociadas: Zoo Metropolitano, UNAB, ONG Ranita de Darwin.\nAcuerdos actuales: Convenio por firmar con ONG Ranita de Darwin y UNAB. Convenio en\npreparación con el ZOO Metropolitano vinculado a Ranita de Darwin.\nJ. Chinchillídeos Andinos: Chinchilla cola corta (Chinchilla chinchilla) - CR y Chinchilla cola\nlarga (Chinchilla lanígera) - VU\nDistribución (países) según IUCN: La chinchilla de cola corta solo en Chile, aunque su distribución\noriginal era más amplia Chile, Perú, Bolivia y Argentina, habitando en la región Andina. La chinchilla\nde cola larga en Atacama y Coquimbo.\nTerritorios: Región de Coquimbo en la Reserva Nacional Las Chinchillas y sus alrededores.\nOrganizaciones asociadas: CONAF Coquimbo. Universidad de Tarapacá. Universidad San Sebastián.\nZoo Metropolitano.\nAcuerdos actuales: Ninguno.\nK. Chinchillídeos Andinos: Vizcacha de montaña (Legidium viscacia) - LC / Vizcacha Austral\n(Legidium wolffsohni) - DD\nDistribución (países) según IUCN: Ambas vizcachas habitan zonas rocosas de la Cordillera de los\nAndes. La vizcacha austral en el extremo sur de Argentina y Chile. La vizcacha de montaña se\nencuentra en el sur de Perú, oeste y centro de Bolivia, norte y centro de Chile y oeste de Argentina.\n12\nOtras Vizcachas de la zona: Vizcacha andina (Lagidium peruanum) - LC, de Perú, Bolivia, Chile y\nArgentina. Vizcacha (Lagostomus maximus) - LC: Argentina, sur de Paraguay y Bolivia.\nTerritorios: Norte de Chile y Patagonia, respectivamente.\nOrganizaciones asociadas: Universidad de Tarapacá. Universidad San Sebastián.\nAcuerdos actuales: Ninguno.\nL. Flamencos (Phoenicopterus sp.)\nDistribución (países) según IUCN: Flamenco chileno en Chile (Phoenicopterus chilensis) - NT,\nArgentina, Bolivia, Perú, Ecuador, Paraguay, Uruguay y Brasil. Flamenco andino (Phoenicoparrus\nandinus) - VU está en Perú, Chile, Bolivia y Argentina. Flamenco James (Phoenicoparrus jamesi) - NT\nen las mesetas altoandinas de Perú, Chile, Bolivia y Argentina.\nTerritorios: Patagonia y altiplano Andino.\nOrganizaciones asociadas:\nAcuerdos actuales: Ninguno.\nM. Vicuña (Vicugna vicugna) – LC\nEl grupo de especialistas en camélidos sudamericanos de la IUCN que está Benito González.\nN. Puma (Puma concolor) - LC\nHay que trabajar el tema de la coexistencia. En el caso por ejemplo del proyecto repoblación de\nguanacos en la Región Metropolitana, será un tema que enfrentar.\nCATEGORIAS Y ESTADOS DE CONSERVACIÓN IUCN\n- Extinta (EX),\n- Extinta en estado silvestre (EW),\n- En peligro crítico (CR),\n- En peligro (EN),\n- Vulnerable (VU),\n- Casi amenazada (NT),\n- Preocupación menor (LC),\n- Datos insuficientes (DD) y\n- No evaluada (NE)\n13\n6. CRITERIOS DE SELECCION DE ESPECIES, ÁREAS Y ECOSISTEMAS A ABORDAR\n- Capacidades instaladas y experticia en las especies y ecosistemas que viene trabajando FRC.\n- Capacidades instaladas y experticia de los colaboradores con quienes hemos gestados acciones\na diferentes niveles: público, académico, ONG’s y organizaciones locales.\n- Urgencia frente al estado de conservación y nivel más alto de categoría de amenaza de la especie\n(en peligro crítico, en peligro de extinción, vulnerable) con una aproximación del Rewilding por\necorregiones a una determinada latitud, incluyendo variación altitudinal en algunos casos.\n- Existencia de áreas protegidas o con algún grado incipiente de avances en su protección e\ninterrelación con otras especies, ecosistemas o ecorregiones.\n- Oportunidad institucional relacionada a la conservación y manejo de una especie, territorio,\necosistema o ecorregión particular.\n- Existencia de socios locales o regionales estratégicos con quienes se compartan valores,\nfundamentos y oportunidades de intercambio de modelos de trabajo y aprendizajes.\n7. TRANSFERENCIA DE LA EXPERIENCIA DE REWILDING CHILE EN LA PATAGONIA CHILENA HACIA\nEL CORREDOR ANDINO\nLas capacidades y fortalezas del equipo de la Fundación Rewilding Chile luego de estos 30 años\ntrabajando en el territorio de la Ruta de los Parques son múltiples y permitirían fortalecer las\ncapacidades de organizaciones locales o regionales que han desarrollado actividades relacionadas a\nalgunos ecosistemas y especies amenazadas en áreas del Corredor Andino. Desde los procesos\nrelacionados a la creación de parques, el análisis de la matriz de hábitat y la tenencia de la tierra,\nconstrucción de propuestas y estrategias de conservación, abordaje de amenazas y monitoreo de la\nvida silvestre, propuestas de manejo e intervención, socialización con actores, gestión técnica y\ncolaborativa con las instituciones, privados y la incidencia en políticas de conservación.\n8. PROXIMOS PASOS\n- Revisar, evaluar y priorizar la lista de especies, ecosistemas y gradientes involucrados.\n- Visitas a terreno y reunión junto a organizaciones claves de algunos territorios. Como ejemplos:\n1) Norte: Picaflor de Arica, Golondrinas del desierto, Gaviotín chico, Suris y Tarucas.\n2) Visita al área del Corredor Nevados de Chillan – Laguna del Laja para evaluar situación de\nhuemules en el sector, iniciativas existentes, y entender el trabajo de CONAF y otros actores en\nlos últimos años en este territorio.\n- 3) Visita a las áreas de intervención de Fundación Lontra en Chile.\n- 4) Explorar otros ámbitos de colaboración e interacción con el Zoológico Metropolitano referido\na flamencos y chinchillas.\n14", 'description': None, 'parent_drive_file_id': '15qq7nMwZhhnlnwKVOhOET27Z9c_-8HwE', 'children': []}, {'id': 'd19aedc7-fd57-455e-849d-520e15a5342d', 'drive_file_id': '1zlRQTvobD_3o0_B4jv0fnqqw4iOsdYTF', 'name': 'Corredores - sps_10.10.25.jpg', 'mime_type': 'image/jpeg', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1zlRQTvobD_3o0_B4jv0fnqqw4iOsdYTF/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 20, 658000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '15qq7nMwZhhnlnwKVOhOET27Z9c_-8HwE', 'children': []}, {'id': 'd476267b-156b-4ab7-b994-78d33177864e', 'drive_file_id': '1fs2skIx3hyVZSuYl9J0YqGP6VPTcDjCQ', 'name': 'Mapa Corredor Andino_15.10.25.jpg', 'mime_type': 'image/jpeg', 'is_folder': False, 'web_view_link': 'https://drive.google.com/file/d/1fs2skIx3hyVZSuYl9J0YqGP6VPTcDjCQ/view?usp=drivesdk', 'modified_time': datetime.datetime(2026, 6, 22, 18, 37, 26, 863000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '15qq7nMwZhhnlnwKVOhOET27Z9c_-8HwE', 'children': []}]}]}]}]}]
