odified_time': datetime.datetime(2026, 6, 30, 16, 33, 25, 490000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '1jX6Ecq8qd74p1OoHZUTpQHLbHY0HTlz1', 'children': [{'id': '765c3d96-e3c9-4995-b1c1-bc615211d3d0', 'drive_file_id': '14S4vJ8C5zr5J5rNmIt1fA_dS8F2-UCqG', 'name': '1. Pumalín', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/14S4vJ8C5zr5J5rNmIt1fA_dS8F2-UCqG', 'modified_time': datetime.datetime(2026, 6, 30, 16, 33, 26, 748000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '11FMU8cYNNZtszuQQqlWz6V3OznBrQ-4_', 'children': []}]}]}, {'id': 'b75aa682-749a-4bcd-9d41-62b2272878ae', 'drive_file_id': '10J6naQYV-wz4iXf2OPiHXgf5Vm-NO9Z0', 'name': '01. Creación de parques', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/10J6naQYV-wz4iXf2OPiHXgf5Vm-NO9Z0', 'modified_time': datetime.datetime(2026, 6, 30, 16, 52, 37, 938000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '16j0klxJnQspJ1mvafpnMaRx7Xd1SRIDO', 'children': [{'id': '270e5da9-5849-4442-a6d0-bfbaf67abfe7', 'drive_file_id': '1uPDu5uh_tnQk-ft9I7Jc26JW52hl7DsK', 'name': '2. Ampliación PN Cerro Castillo', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_view_link': 'https://drive.google.com/drive/folders/1uPDu5uh_tnQk-ft9I7Jc26JW52hl7DsK', 'modified_time': datetime.datetime(2026, 6, 22, 18, 19, 30, 924000, tzinfo=datetime.timezone.utc), 'text_content': None, 'description': None, 'parent_drive_file_id': '10J6naQYV-wz4iXf2OPiHXgf5Vm-NO9Z0', 'children': []}, {'id': 'fb7e7778-80b4-457d-9356-eb98c1583f6e', 'drive_file_id': '1Q8GeG9ZGqFwp1B34Vo1JygWyRE9aJk7Y', 'name': '1. Proyecto Red de PN de la Patagonia Chilena', 'mime_type': 'application/vnd.google-apps.folder', 'is_folder': True, 'web_v